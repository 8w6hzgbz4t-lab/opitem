return {
    {id="item47",name="Kirby Sword",model="kirby_sword",tier=3,price=3500,income=62,spawnWeight=1,power="pulse",ability="Copy Sword Slash",radius=10,windup=.5,cooldown=15,category="Relic"},
    {id="item48",name="SpongeBob Golden Spatula",model="golden_spatula",tier=4,price=12500,income=180,spawnWeight=1,power="slam",ability="Golden Flip",radius=10,windup=.7,cooldown=18,category="Relic"},
    {id="item49",name="Krabby Patty",model="krabby_patty",tier=1,price=150,income=4,spawnWeight=1.2,power="shield",ability="Secret Recipe Ward",radius=3,windup=0,cooldown=20,category="Relic"},
