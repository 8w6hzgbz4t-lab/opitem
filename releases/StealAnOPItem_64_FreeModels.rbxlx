return {
 detailed_workbench={Name="Detailed workbench", Family="WorkshopBuildings", PartBudget=320, AlignBase=true, ReferenceRequired=false},
 power_console={Name="Power selection and upgrade console", Family="WorkshopBuildings", PartBudget=280, AlignBase=true, ReferenceRequired=false},
 clash_crown_tower={Name="Clash Royale crown tower", Family="WorkshopBuildings", PartBudget=500, AlignBase=true, ReferenceRequired=false},
 blue_shell={Name="Mario Kart Blue Shell", Family="NintendoItems", PartBudget=240, AlignBase=true, ReferenceRequired=false, ItemId="item05"},
 kirby_sword={Name="Kirby Sword", Family="NintendoItems", PartBudget=240, AlignBase=true, ReferenceRequired=false},
 golden_spatula={Name="SpongeBob Golden Spatula", Family="NintendoItems", PartBudget=240, AlignBase=true, ReferenceRequired=false},
 krabby_patty={Name="Krabby Patty", Family="NintendoItems", PartBudget=240, AlignBase=true, ReferenceRequired=false},
 gary_shell={Name="Gary Shell", Family="NintendoItems", PartBudget=240, AlignBase=true, ReferenceRequired=false},
 super_star={Name="Mario Super Star", Family="NintendoItems", PartBudget=240, AlignBase=true, ReferenceRequired=false},
 fire_flower={Name="Mario Fire Flower", Family="NintendoItems", PartBudget=240, AlignBase=true, ReferenceRequired=false},
