						<ProtectedString name="Source">local C={}
C.Tiers={"Common","Uncommon","Rare","Epic","Legendary","Mythic","Ethereal"}
C.Colors={{166,180,203},{78,215,145},{75,153,255},{180,108,255},{255,196,73},{255,88,126},{113,248,255}}
