</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_FreeModels_64_ExtraItems"><Properties><string name="Name">ExtraItems</string><ProtectedString name="Source">-- Extra collectible designs. Empty costume shells and display models only.
local M = {}
local V, C, A = Vector3.new, CFrame.new, CFrame.Angles
local pi = math.pi
local METAL, PLASTIC = Enum.Material.Metal, Enum.Material.SmoothPlastic
local BLACK = Color3.fromRGB(23, 22, 24)
local SILVER = Color3.fromRGB(173, 185, 190)
local DARKSTEEL = Color3.fromRGB(64, 73, 79)

local function cylinderY(b, name, p, diameter, height, color, material)
    return b:cylinder(name, V(height, diameter, diameter), C(p) * A(0, 0, pi / 2), color, material)
end

local function cylinderZ(b, name, p, diameter, depth, color, material)
    return b:cylinder(name, V(depth, diameter, diameter), C(p) * A(0, pi / 2, 0), color, material)
end

local function ellipse(b, name, center, rx, ry, thickness, color, segments)
    segments = segments or 16
    for i = 0, segments - 1 do
        local a, c = i * 2 * pi / segments, (i + 1) * 2 * pi / segments
        b:line(name .. i, center + V(math.cos(a) * rx, math.sin(a) * ry, 0),
            center + V(math.cos(c) * rx, math.sin(c) * ry, 0), thickness, thickness, color, PLASTIC)
    end
end

local function dragonballs(b)
    local ORANGE = Color3.fromRGB(245, 137, 30)
    local STAR = Color3.fromRGB(174, 33, 24)
    local GOLD = Color3.fromRGB(205, 145, 48)
    local layout = {
        V(0, 2.45, 0), V(-1.01, 1.48, 0), V(0, 1.48, 0), V(1.01, 1.48, 0),
        V(-1.01, .51, 0), V(0, .51, 0), V(1.01, .51, 0),
    }
    local starLayout = {
        { { 0, 0 } },
        { { -.15, 0 }, { .15, 0 } },
        { { 0, .16 }, { -.16, -.12 }, { .16, -.12 } },
        { { -.15, .15 }, { .15, .15 }, { -.15, -.15 }, { .15, -.15 } },
        { { -.17, .17 }, { .17, .17 }, { 0, 0 }, { -.17, -.17 }, { .17, -.17 } },
        { { -.18, .16 }, { 0, .16 }, { .18, .16 }, { -.18, -.16 }, { 0, -.16 }, { .18, -.16 } },
        { { 0, 0 }, { 0, .22 }, { .19, .11 }, { .19, -.11 }, { 0, -.22 }, { -.19, -.11 }, { -.19, .11 } },
    }
    b:box("DragonBallDisplayBase", V(3.13, .12, 1.02), C(0, .07, .08), Color3.fromRGB(66, 36, 26), PLASTIC)
    b:box("DisplayGoldEdge", V(3.16, .045, 1.05), C(0, .145, .08), GOLD, METAL)
    for number, center in ipairs(layout) do
        local orb = b:ball("DragonBall_" .. number, .86, C(center), ORANGE, Enum.Material.Glass)
        orb.Transparency = .14
        orb.Reflectance = .17
        b:ball("GlassHighlight_" .. number, V(.085, .11, .017), C(center + V(-.18, .23, -.33)), Color3.fromRGB(255, 221, 142), PLASTIC).Transparency = .16
        cylinderY(b, "OrbStand_" .. number, center + V(0, -.46, .035), .54, .075, GOLD)
        -- Every sphere has its exact number of legible five-line stars.
        for starIndex, offset in ipairs(starLayout[number]) do
            local r = number == 1 and .135 or .078
            local points = {}
            for i = 0, 4 do
                local t = -pi / 2 + i * 2 * pi / 5
                points[i + 1] = center + V(offset[1] + math.cos(t) * r, offset[2] + math.sin(t) * r, -.431)
            end
            for i = 1, 5 do
                local other = ((i + 1) % 5) + 1
                b:line("Ball" .. number .. "Star" .. starIndex .. "Stroke" .. i, points[i], points[other], .019, .014, STAR, PLASTIC)
            end
        end
    end
end

local function duelrunner(b)
    local RED = Color3.fromRGB(172, 28, 40)
    local REDLIGHT = Color3.fromRGB(221, 45, 51)
    local RUBBER = Color3.fromRGB(28, 29, 31)
    local BLUE = Color3.fromRGB(58, 192, 226)
    local WHITE = Color3.fromRGB(223, 228, 224)
    local wheels = { { "Front", -1.61 }, { "Rear", 1.61 } }
    for _, data in ipairs(wheels) do
        local name, z = data[1], data[2]
        b:cylinder(name .. "Tire", V(.41, 1.17, 1.17), C(0, .64, z), RUBBER, PLASTIC)
        b:cylinder(name .. "Axle", V(.68, .19, .19), C(0, .64, z), SILVER)
        for _, side in ipairs({ -1, 1 }) do
            local frame = C(side * .225, .64, z) * A(0, pi / 2, 0)
            b:ring(name .. "WheelRim" .. side, frame, .42, .055, SILVER, 12)
            b:cylinder(name .. "WheelHub" .. side, V(.055, .27, .27), C(side * .259, .64, z), DARKSTEEL)
            for i = 0, 5 do
                local t = i * pi / 3
                b:line(name .. "Spoke" .. side .. "_" .. i,
                    V(side * .255, .64, z),
                    V(side * .255, .64 + math.cos(t) * .4, z + math.sin(t) * .4), .035, .045, SILVER)
            end
        end
        for i = 0, 11 do
            local t = i * pi / 6
            b:box(name .. "TireTread" .. i, V(.37, .024, .085),
                C(0, .64 + math.cos(t) * .586, z + math.sin(t) * .586) * A(t, 0, 0), Color3.fromRGB(46, 47, 48), PLASTIC)
        end
    end
    b:box("MainChassis", V(.63, .45, 2.48), C(0, .93, .12), DARKSTEEL)
    b:box("EngineBlock", V(.71, .63, .87), C(0, .82, .37), BLACK)
    b:box("CentralTank", V(.76, .46, 1.2), C(0, 1.45, -.16) * A(-.12, 0, 0), RED)
    b:box("TankSpine", V(.17, .07, 1.04), C(0, 1.72, -.16) * A(-.12, 0, 0), REDLIGHT)
    b:box("RiderSeat", V(.63, .16, .78), C(0, 1.45, .79) * A(.05, 0, 0), BLACK, PLASTIC)
    b:box("SeatBack", V(.65, .25, .24), C(0, 1.56, 1.19) * A(-.22, 0, 0), RED)
    b:wedge("LongFrontNose", V(.58, .48, 1.26), C(0, 1.24, -1.67) * A(0, pi, 0), RED)
    b:box("FrontNoseStripe", V(.13, .045, .8), C(0, 1.485, -1.72), WHITE)
    b:box("FrontTip", V(.39, .16, .31), C(0, 1.02, -2.36), REDLIGHT)
    b:box("Headlight", V(.29, .085, .035), C(0, 1.09, -2.527), BLUE, Enum.Material.Neon)
    b:box("RearTail", V(.58, .28, .75), C(0, 1.44, 1.58) * A(.12, 0, 0), RED)
    b:box("RearBrakeLight", V(.39, .08, .045), C(0, 1.44, 1.98), REDLIGHT, Enum.Material.Neon)
    for _, side in ipairs({ -1, 1 }) do
        b:line("FrontFork" .. side, V(side * .28, .65, -1.61), V(side * .38, 1.47, -.82), .095, .095, SILVER)
        b:line("RearSwingArm" .. side, V(side * .29, .64, 1.61), V(side * .4, .87, .48), .12, .13, DARKSTEEL)
        b:box("FrontFairing" .. side, V(.18, .7, 1.42), C(side * .49, 1.18, -.94) * A(-.13, side * -.12, side * .13), RED)
        b:wedge("SideNoseWing" .. side, V(.13, .43, .9), C(side * .49, 1.02, -1.96) * A(0, pi, 0), REDLIGHT)
        b:box("LowerFairing" .. side, V(.12, .34, 1.34), C(side * .47, .65, -.07) * A(.09, 0, 0), RED)
        b:box("FairingStripe" .. side, V(.025, .09, .91), C(side * .599, 1.29, -.93) * A(-.1, 0, 0), WHITE)
        for i = 1, 5 do
            b:box("EngineVent" .. side .. "_" .. i, V(.035, .27, .048), C(side * .417, .87, -.02 + i * .115), SILVER)
        end
        b:line("ExhaustPipe" .. side, V(side * .4, .68, .65), V(side * .47, .84, 1.54), .13, .13, DARKSTEEL)
        cylinderZ(b, "ExhaustMouth" .. side, V(side * .47, .84, 1.58), .13, .035, BLACK)
        b:line("Handlebar" .. side, V(0, 1.7, -.67), V(side * .55, 1.74, -.59), .075, .075, SILVER)
        b:line("HandleGrip" .. side, V(side * .55, 1.74, -.59), V(side * .68, 1.74, -.46), .11, .11, BLACK, PLASTIC)
        b:line("BrakeLever" .. side, V(side * .55, 1.78, -.63), V(side * .72, 1.78, -.54), .025, .025, SILVER)
        b:box("FootRest" .. side, V(.26, .065, .16), C(side * .54, .49, .56), SILVER)
        b:box("SideDeckSlot" .. side, V(.11, .33, .53), C(side * .47, 1.44, .77), REDLIGHT)
    end
    b:box("Dashboard", V(.49, .12, .27), C(0, 1.74, -.71) * A(.26, 0, 0), DARKSTEEL)
    b:box("DashboardScreen", V(.34, .018, .17), C(0, 1.81, -.72) * A(.26, 0, 0), BLUE, Enum.Material.Neon)
    local windscreen = b:box("Windscreen", V(.53, .42, .04), C(0, 1.77, -.99) * A(.36, 0, 0), Color3.fromRGB(82, 121, 132), Enum.Material.Glass)
    windscreen.Transparency = .48
end

local function emptyBearSuit(b, golden)
    local FUR = golden and Color3.fromRGB(173, 139, 44) or Color3.fromRGB(124, 76, 40)
    local LIGHT = golden and Color3.fromRGB(218, 184, 82) or Color3.fromRGB(177, 126, 76)
    local DARK = golden and Color3.fromRGB(107, 82, 29) or Color3.fromRGB(79, 47, 29)
    local prefix = golden and "GoldenFreddy" or "Freddy"
    local torsoY = golden and 1.3 or 1.93
    local headY = torsoY + .97
    -- Body is a costume shell. There are no humanoids, eyes, or internal machinery.
    b:ball(prefix .. "BackShell", V(1.17, 1.3, .44), C(0, torsoY, .24), FUR, PLASTIC)
    for _, side in ipairs({ -1, 1 }) do
        b:ball(prefix .. "BodySide" .. side, V(.38, 1.12, .66), C(side * .48, torsoY, .03), FUR, PLASTIC)
        b:box(prefix .. "ChestPanel" .. side, V(.42, .77, .11), C(side * .23, torsoY + .04, -.35) * A(0, side * .1, 0), LIGHT, PLASTIC)
        b:line(prefix .. "TorsoSeam" .. side, V(side * .46, torsoY - .4, -.38), V(side * .46, torsoY + .43, -.37), .018, .018, DARK, PLASTIC)
    end
    b:box(prefix .. "BodyLowerRim", V(.86, .13, .57), C(0, torsoY - .57, .02), FUR, PLASTIC)
    cylinderY(b, prefix .. "DarkEmptyNeck", V(0, torsoY + .65, .01), .49, .08, BLACK, PLASTIC)
    b:ring(prefix .. "NeckOpeningRim", C(0, torsoY + .7, .01) * A(pi / 2, 0, 0), .25, .07, FUR, 12, PLASTIC)
    b:ball(prefix .. "ButtonUpper", .11, C(0, torsoY + .19, -.432), BLACK, PLASTIC)
    b:ball(prefix .. "ButtonLower", .11, C(0, torsoY -.1, -.432), BLACK, PLASTIC)
    -- Hollow face: front features surround open sockets. The rear is recessed.
    b:ball(prefix .. "HeadBackShell", V(1.35, 1.18, .54), C(0, headY + .11, .28), FUR, PLASTIC)
    b:box(prefix .. "RecessedHeadInterior", V(1.02, .73, .035), C(0, headY + .05, -.005), BLACK, PLASTIC)
    b:box(prefix .. "Forehead", V(1.19, .25, .38), C(0, headY + .58, -.19), FUR, PLASTIC)
    for _, side in ipairs({ -1, 1 }) do
        b:ball(prefix .. "Temple" .. side, V(.3, .75, .54), C(side * .63, headY + .18, -.14), FUR, PLASTIC)
        ellipse(b, prefix .. "OpenEyeSocket" .. side .. "_", V(side * .32, headY + .28, -.405), .22, .225, .055, DARK, 12)
        b:box(prefix .. "Brow" .. side, V(.4, .075, .1), C(side * .32, headY + .57, -.44) * A(0, 0, side * -.09), BLACK, PLASTIC)
        b:ball(prefix .. "Muzzle" .. side, V(.48, .25, .29), C(side * .225, headY -.055, -.47), LIGHT, PLASTIC)
        b:ball(prefix .. "Ear" .. side, V(.39, .41, .22), C(side * .61, headY + .76, .03), FUR, PLASTIC)
        b:ball(prefix .. "EarInset" .. side, V(.24, .25, .045), C(side * .61, headY + .76, -.105), DARK, PLASTIC)
        for j = 1, 3 do
            b:ball(prefix .. "MuzzleFreckle" .. side .. "_" .. j, .027, C(side * (.13 + j * .06), headY -.065, -.618), DARK, PLASTIC)
        end
    end
    b:ball(prefix .. "Nose", V(.28, .17, .19), C(0, headY + .055, -.625), BLACK, PLASTIC)
    ellipse(b, prefix .. "OpenMouthRim_", V(0, headY -.29, -.38), .46, .16, .08, DARK, 12)
    b:box(prefix .. "LowerJaw", V(.86, .12, .38), C(0, headY -.465, -.2), FUR, PLASTIC)
    for i = 1, 4 do
        b:box(prefix .. "CostumeTooth" .. i, V(.075, .07, .045), C(-.23 + i * .092, headY -.183, -.428), Color3.fromRGB(213, 200, 165), PLASTIC)
    end
    cylinderY(b, prefix .. "HatBrim", V(0, headY + .795, .02), .92, .095, BLACK, PLASTIC)
    cylinderY(b, prefix .. "TopHat", V(0, headY + 1.025, .02), .6, .39, BLACK, PLASTIC)
    cylinderY(b, prefix .. "HatBand", V(0, headY + .89, .02), .618, .075, DARK, PLASTIC)
    b:ball(prefix .. "BowKnot", .15, C(0, torsoY + .48, -.43), BLACK, PLASTIC)
    for _, side in ipairs({ -1, 1 }) do
        b:triangle(prefix .. "BowTie" .. side, V(side * .035, torsoY + .48, -.44),
            V(side * .29, torsoY + .63, -.44), V(side * .29, torsoY + .34, -.44), BLACK, .06, PLASTIC)
        local shoulderY = torsoY + .35
        local elbowY = torsoY -.18
        local handY = torsoY -.71
        b:ball(prefix .. "ShoulderShell" .. side, V(.47, .48, .5), C(side * .77, shoulderY, .02), FUR, PLASTIC)
        b:ball(prefix .. "UpperArmShell" .. side, V(.41, .61, .43), C(side * .85, shoulderY -.32, .01) * A(0, 0, side * .1), FUR, PLASTIC)
        b:ball(prefix .. "ElbowCloth" .. side, .24, C(side * .89, elbowY -.14, .01), DARK, PLASTIC)
        b:ball(prefix .. "ForearmShell" .. side, V(.38, .48, .42), C(side * .91, elbowY -.4, -.02), FUR, PLASTIC)
        b:ball(prefix .. "EmptyGlove" .. side, V(.4, .31, .4), C(side * .92, handY -.25, -.05), FUR, PLASTIC)
        for j = 1, 3 do
            b:line(prefix .. "GloveSeam" .. side .. "_" .. j,
                V(side * (.78 + j * .065), handY -.2, -.245), V(side * (.78 + j * .065), handY -.31, -.23), .014, .014, DARK, PLASTIC)
        end
        if golden then
            b:ball(prefix .. "SeatedUpperLeg" .. side, V(.46, .47, .76), C(side * .3, .64, -.23), FUR, PLASTIC)
            b:ball(prefix .. "SeatedLowerLeg" .. side, V(.43, .36, .54), C(side * .34, .34, -.64), FUR, PLASTIC)
            b:ball(prefix .. "SeatedFoot" .. side, V(.53, .26, .71), C(side * .35, .2, -.92), LIGHT, PLASTIC)
        else
            b:ball(prefix .. "UpperLegShell" .. side, V(.45, .64, .47), C(side * .29, 1.06, .01), FUR, PLASTIC)
            b:ball(prefix .. "KneeCloth" .. side, .24, C(side * .29, .76, .01), DARK, PLASTIC)
            b:ball(prefix .. "LowerLegShell" .. side, V(.42, .55, .46), C(side * .29, .48, .01), FUR, PLASTIC)
            b:ball(prefix .. "EmptyFoot" .. side, V(.55, .28, .76), C(side * .29, .17, -.19), LIGHT, PLASTIC)
        end
    end
    b.model:SetAttribute("EmptyCostume", true)
    b.model:SetAttribute("ContainsCharacter", false)
end

local builders = {
    dragonballs = dragonballs,
    duelrunner = duelrunner,
    freddysuit = function(b) emptyBearSuit(b, false) end,
    goldenfreddysuit = function(b) emptyBearSuit(b, true) end,
}

function M.build(b, key)
    local build = builders[key]
    if not build then return false end
    build(b)
    return true
end

return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_FreeModels_64_FactoryIntegration"><Properties><string name="Name">FactoryIntegration</string><ProtectedString name="Source">-- Install before collectible templates are built. Replaces visual construction only.
-- Original item definitions, economy, transactions, and Millennium Puzzle remain intact.
local FreeModels = require(script.Parent.FreeModels)
local M = {}
local installed = setmetatable({}, {__mode="k"})
local replacements = {item05="blue_shell",item43="dragon_balls"}

function M.install(factory)
    assert(type(factory)=="table" and type(factory.create)=="function", "A ModelFactory table is required")
    if installed[factory] then return factory end
    local originalCreate = factory.create
    factory.create = function(definition, parent)
        -- The existing, approved Millennium Puzzle must always use its original builder.
        if definition.id == "item08" then return originalCreate(definition, parent) end
        local key = replacements[definition.id] or definition.model
        if FreeModels.supports(key) then
            return FreeModels.create(parent, {model=key,itemId=definition.id,name=definition.name})
        end
        return originalCreate(definition, parent)
    end
    installed[factory] = true
    return factory
end

return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_FreeModels_64_FreeModels"><Properties><string name="Name">FreeModels</string><ProtectedString name="Source">-- Complete native Roblox geometry. No generated asset IDs or paid API required.
local P=require(script.Parent.Primitives)
local Assets=require(script.Parent.Assets)
local Labels=require(script.Parent.Labels)
local families={
 NintendoItems=require(script.Parent.NintendoItems),
 RelicItems=require(script.Parent.RelicItems),
 WarriorModels=require(script.Parent.WarriorModels),
 WorkshopBuildings=require(script.Parent.WorkshopBuildings),
 CardDecor=require(script.Parent.CardDecor),
 HoOhModel=require(script.Parent.HoOhModel),
 ExtraItems=require(script.Parent.ExtraItems),
}
local F={Assets=Assets}
function F.supports(key) return Assets[key]~=nil end
function F.create(parent,options)
 options=options or {}
 local key=options.model or options.key
 local entry=assert(Assets[key],"Unknown free model: "..tostring(key))
 local copy={}
 for k,v in pairs(options) do copy[k]=v end
 copy.name=copy.name or entry.Name
 copy.itemId=copy.itemId or entry.ItemId or key
 copy.partBudget=copy.partBudget or entry.PartBudget
 if copy.alignBase==nil then copy.alignBase=entry.AlignBase end
 local b=P.new(parent,copy)
 local buildKey=key=='dragon_balls' and 'dragonballs' or key
 assert(families[entry.Family].build(b,buildKey),"Free model builder missing: "..key)
 b.model:SetAttribute("ArtSource","NativeRobloxParts")
 b.model:SetAttribute("FreeModelKey",key)
 b.model:SetAttribute("ReferenceRequired",entry.ReferenceRequired)
 local model=b:finish()
 Labels.apply(model,key)
 return model
end
return F
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_FreeModels_64_FreeWorld"><Properties><string name="Name">FreeWorld</string><ProtectedString name="Source">-- Optional native scenery replacement. Existing gameplay anchors retain their identity.
local FreeModels = require(script.Parent.FreeModels)
local Primitives = require(script.Parent.Primitives)
local HoOhAssembler = require(script.Parent.HoOhAssembler)
local W = {}
local V, C, A = Vector3.new, CFrame.new, CFrame.Angles

local function childrenCopy(parent)
 local copy = {}
 for _, child in ipairs(parent:GetChildren()) do copy[#copy + 1] = child end
 return copy
end

local function removeNamed(parent, names)
 if not parent then return end
 for _, child in ipairs(childrenCopy(parent)) do
  if names[child.Name] then child:Destroy() end
 end
end

function W.tower(parent)
 removeNamed(parent, {SunlitBellPagoda = true})
 return FreeModels.create(parent, {
  model = "hooh_bell_tower", name = "SunlitBellPagoda", cframe = C(44, 0, 113),
 })
end

local function moveRainbowAndRemoveClouds(aesthetics)
 local sky = aesthetics and aesthetics:FindFirstChild("PrismaticSky")
 if not sky then return end
 local transform = C(160, 0, 0) * A(0, math.pi / 2, 0) * C(0, 0, 165)
 for _, child in ipairs(childrenCopy(sky)) do
  if child.Name == "SoftCloud" then
   child:Destroy()
  elseif child:IsA("BasePart") and child.Name:match("^RainbowBand") then
   -- Repeated decoration builds must not move the already transformed rainbow.
   local original = child:GetAttribute("NativeArtOriginalCF")
   if not original then
    original = child.CFrame
    child:SetAttribute("NativeArtOriginalCF", original)
   end
   child.CFrame = transform * original
  end
 end
 sky:SetAttribute("RainbowLocation", "EastSky")
end

local function wristConnections(parent, aesthetics, circleCF)
 local guardian = aesthetics and aesthetics:FindFirstChild("FivePieceAncientGuardian")
 if not guardian then return end
 local b = Primitives.new(parent, {
  name = "GuardianWristConnections", model = "GuardianWristConnections",
  alignBase = false, partBudget = 260,
 })
 local chainColor = Color3.fromRGB(163, 141, 189)
 local gold = Color3.fromRGB(216, 163, 55)
 for _, entry in ipairs({{"LeftArm", V(-10, 21, -1.5)}, {"RightArm", V(10, 21, -1.5)}}) do
  local arm = guardian:FindFirstChild(entry[1])
  local palm = arm and arm:FindFirstChild("HandPalm", true)
  if palm and palm:IsA("BasePart") then
   local start, finish = circleCF * entry[2], palm.Position
   local delta = finish - start
   if delta.Magnitude &gt; .1 then
    local along = delta.Unit
    local side = along:Cross(V(0, 0, 1))
    if side.Magnitude &lt; .01 then side = along:Cross(V(0, 1, 0)) end
    side = side.Unit
    local normal = along:Cross(side).Unit
    local links = 7
    local halfLength = delta.Magnitude / (links - 1) * .62
    for index = 0, links - 1 do
     local t = index / (links - 1)
     local center = start:Lerp(finish, t) + V(0, -.35 * math.sin(t * math.pi), 0)
     local widthAxis = index % 2 == 0 and side or normal
     for segment = 0, 7 do
      local first, second = segment * math.pi / 4, (segment + 1) * math.pi / 4
      local a = center + along * (math.cos(first) * halfLength) + widthAxis * (math.sin(first) * .42)
      local c = center + along * (math.cos(second) * halfLength) + widthAxis * (math.sin(second) * .42)
      b:line(entry[1] .. "ChainLink_" .. index .. "_" .. segment, a, c, .17, .17, chainColor, Enum.Material.Metal)
     end
    end
   end
   b:ring(entry[1] .. "WristCuff", C(finish) * A(0, math.pi / 2, 0), 1.05, .28, gold, 10, Enum.Material.Metal)
  end
 end
 b.model:SetAttribute("DecorativeOnly", true)
 b.model:SetAttribute("ConnectedToGuardianWrists", true)
 return b:finish()
end

function W.decorate(world)
 assert(world and world.folder, "A built world is required for native scenery")
 local old = world.folder:FindFirstChild("NativeFreeArt")
 if old then old:Destroy() end
 local root = Instance.new("Folder")
 root.Name = "NativeFreeArt"
 root.Parent = world.folder
 root:SetAttribute("DecorativeOnly", true)
 root:SetAttribute("ArtSource", "NativeRobloxParts")

 -- DetailedArt still owns the racetrack, dragons, arena bounds and other landmarks.
 local landmarks = world.folder:FindFirstChild("DetailedLandmarks")
 removeNamed(landmarks, {godRa = true, godObelisk = true, CrownArenaTower = true, RiftArchiveCard = true})
 FreeModels.create(root, {
  model = "winged_dragon_ra", name = "DetailedWingedDragonOfRa", scale = 1.2,
  cframe = C(75, 34, 155),
 })
 FreeModels.create(root, {
  model = "obelisk_tormentor", name = "DetailedObeliskTheTormentor", scale = 1.2,
  cframe = C(-35, 34, 155),
 })
 for _, x in ipairs({-125, 125}) do
  FreeModels.create(root, {
   model = "clash_crown_tower", name = "DetailedCrownArenaTower", scale = 1.1,
   cframe = C(x, 24, 28),
  })
 end
 FreeModels.create(root, {
  model = "mtg_black_lotus_card", name = "DetailedBlackLotusCard",
  cframe = C(104, 38, 110),
 })

 local background = world.folder:FindFirstChild("BackgroundArt")
 removeNamed(background, {MirrorForceReflectionPlanet = true})
 FreeModels.create(root, {
  model = "mirror_force_card", name = "MirrorForceCardBackdrop",
  cframe = C(-60, 66, -149) * A(0, math.pi, 0),
 })
 local circleCF = C(-40, 29, -116) * A(0, math.pi, 0)
 FreeModels.create(root, {
  model = "exodia_spellbinding_circle_chains", name = "ExodiaSpellbindingCircle",
  cframe = circleCF,
 })
 local aesthetics = world.folder:FindFirstChild("Aesthetics")
 wristConnections(root, aesthetics, circleCF)
 moveRainbowAndRemoveClouds(aesthetics)

 -- Keep the original invisible, solid/queryable prompt anchors in place.
 -- Visual furniture never acquires collection, purchase or protection authority.
 for index, base in ipairs(world.bases or {}) do
  if base.upgrade then base.upgrade.Transparency = 1 end
  FreeModels.create(root, {
   model = "detailed_workbench", name = "NativeUpgradeWorkbench" .. index,
   scale = .8, cframe = base.cf * C(16, 1, -16),
  })
 end
 if world.powerShop then world.powerShop.Transparency = 1 end
 FreeModels.create(root, {
  model = "power_console", name = "NativePowerConsole", scale = .8,
  cframe = C(0, .1, 19),
 })
 HoOhAssembler.create(root, C(44, 39, 113) * A(0, math.pi, 0), 1.25)
 world.nativeArt = root
 return root
end
return W
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_FreeModels_64_HoOhAssembler"><Properties><string name="Name">HoOhAssembler</string><ProtectedString name="Source">-- Builds the articulated native-parts Ho-Oh. Animation is owned by the caller.
local FreeModels=require(script.Parent.FreeModels)
local Flight=require(script.Parent.HoOhFlight)
local Assembler={}

function Assembler.create(parent,originCFrame,scale)
 originCFrame=originCFrame or CFrame.new()
 scale=scale or 1.25
 assert(typeof(originCFrame)=="CFrame","Ho-Oh origin must be a CFrame")
 assert(type(scale)=="number" and scale&gt;0 and scale&lt;math.huge,"Ho-Oh scale must be finite and positive")
 local model=Instance.new("Model")
 model.Name="HoOh"
 local root=Instance.new("Part")
 root.Name="Root"
 root.Size=Vector3.new(.1,.1,.1)
 root.CFrame=originCFrame
 root.Transparency=1
 root.Anchored=true
 root.CanCollide=false
 root.CanQuery=false
 root.CanTouch=false
 root.CastShadow=false
 root.Material=Enum.Material.SmoothPlastic
 root.Parent=model
 model.PrimaryPart=root
 model:SetAttribute("FlightScale",scale)
 model:SetAttribute("FlightOrigin",originCFrame)
 model:SetAttribute("ArtSource","NativeRobloxParts")
 local epoch=0
 local ok,now=pcall(function() return workspace:GetServerTimeNow() end)
 if ok and type(now)=="number" then epoch=now end
 model:SetAttribute("FlightEpoch",epoch)
 -- Deliberately no Kind attribute: item animation caches must ignore this model.
 for _,component in ipairs({
  {"Body","hooh_body"},
  {"LeftWing","hooh_wing_left"},
  {"RightWing","hooh_wing_right"},
  {"Tail","hooh_tail"},
 }) do
  FreeModels.create(model,{
   name=component[1],model=component[2],scale=scale,alignBase=false,
  })
 end
 local count=0
 for _,part in ipairs(model:GetDescendants()) do
  if part:IsA("BasePart") then
   count=count+1
   assert(part.Anchored and not part.CanCollide and not part.CanQuery and not part.CanTouch,
    "Ho-Oh decoration must remain anchored and noncolliding")
  end
 end
 model:SetAttribute("PartCount",count)
 Flight.pose(model,originCFrame,0)
 model.Parent=parent
 return model
end
return Assembler
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_FreeModels_64_HoOhFlight"><Properties><string name="Name">HoOhFlight</string><ProtectedString name="Source">-- Pure decorative flight/pose functions. The caller owns its render connection.
-- Construct Body, LeftWing, RightWing and Tail as child Models with alignBase=false.
-- Every component's PrimaryPart is its original chest-origin Root. Do not reset
-- its pivot to the mesh bounds: the shoulder rotations use that shared origin.
local Flight={}
local TAU=math.pi*2
local V=Vector3.new
local SHOULDER_LEFT=V(-1.08,.61,.02)
local SHOULDER_RIGHT=V(1.08,.61,.02)
local TAIL_SOCKET=V(0,-.66,1.04)

-- origin is the top of the tower and faces the intended initial flight direction.
-- A 32-second uninterrupted ellipse passes close to the bell tower once per loop.
-- Bird faces travel direction; height and bank change gently along the route.
function Flight.position(origin,time)
 local theta=(time or 0)*TAU/32
 local function sample(a)
  return V(22*(1-math.cos(a)),8+3*math.sin(2*a),-20*math.sin(a))
 end
 local localPos=sample(theta)
 local nextPos=sample(theta+.012)
 local bank=-math.sin(theta)*math.rad(13)
 return origin*CFrame.lookAt(localPos,nextPos)*CFrame.Angles(0,0,bank)
end

local function pivotChild(model,name,cf)
 local child=model:FindFirstChild(name)
 if child and child:IsA("Model") then child:PivotTo(cf) end
end

-- Called client-side each frame. No gameplay authority, movement forces or remotes.
-- Decorative bird roots stay anchored and noncolliding throughout the animation.
function Flight.pose(model,origin,time)
 local t=time or 0
 local scale=model:GetAttribute("FlightScale") or 1
 assert(type(scale)=="number" and scale&gt;0,"FlightScale must be positive")
 local flightCF=Flight.position(origin,t)
 local beat=math.sin(t*TAU/1.8)
 local flap=math.rad(22)*beat+math.rad(5)
 local chestBob=CFrame.new(0,.11*math.cos(t*TAU/1.8),0)
 flightCF=flightCF*chestBob
 -- Update only the invisible parent pivot. PivotTo here would move articulated
 -- children a second time and cause their wing/tail transforms to accumulate.
 if model.PrimaryPart then model.PrimaryPart.CFrame=flightCF end
 pivotChild(model,"Body",flightCF)
 pivotChild(model,"LeftWing",flightCF*CFrame.new(SHOULDER_LEFT*scale)*CFrame.Angles(0,0,-flap)*CFrame.new(-SHOULDER_LEFT*scale))
 pivotChild(model,"RightWing",flightCF*CFrame.new(SHOULDER_RIGHT*scale)*CFrame.Angles(0,0,flap)*CFrame.new(-SHOULDER_RIGHT*scale))
 pivotChild(model,"Tail",flightCF*CFrame.new(TAIL_SOCKET*scale)*CFrame.Angles(math.rad(4)*math.sin(t*1.7),math.rad(3)*math.sin(t*.9),0)*CFrame.new(-TAIL_SOCKET*scale))
 return flightCF
end
return Flight
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_FreeModels_64_HoOhModel"><Properties><string name="Name">HoOhModel</string><ProtectedString name="Source">-- Native Roblox Ho-Oh sculpture. No mesh IDs, textures, paid services or NPC code.
-- All four components share the chest origin, facing -Z, with +Y up.
local M={}
local V,CF=Vector3.new,CFrame.new
local C=Color3.fromRGB
local SM=Enum.Material.SmoothPlastic
local RED=C(194,40,37)
local SCARLET=C(235,65,38)
local DARKRED=C(121,22,27)
local GREEN=C(31,127,93)
local TEAL=C(35,173,130)
local GOLD=C(248,197,58)
local PALE=C(255,231,135)
local IVORY=C(248,242,220)
local INK=C(23,31,38)

local function ellipsoid(b,name,a,c,width,thickness,color)
 local d=c-a
 return b:ball(name,V(width,thickness,d.Magnitude),CFrame.lookAt((a+c)*.5,c),color,SM)
end

-- A tapered feather with a colored shaft, pointed tip and lifted center ridge.
local function feather(b,name,a,c,width,color,ridge)
 local d=c-a
 local side=d:Cross(V(0,1,0))
 if side.Magnitude&lt;.01 then side=V(1,0,0) end
 side=side.Unit*width*.5
 local shoulder=a+d*.66
 local n=V(0,.018,0)
 b:triangle(name.."Left",a,shoulder-side,c,color,.075,SM)
 b:triangle(name.."Right",a,c,shoulder+side,color,.075,SM)
 b:line(name.."Shaft",a+n,c+n,.035,.035,ridge or color,SM)
end

local function body(b)
 b:ball("ScarletChest",V(2.45,2.8,2.15),CF(0,0,0),RED,SM)
 b:ball("WarmBreast",V(1.95,2.35,.8),CF(0,-.12,-.87),SCARLET,SM)
 b:ball("CreamBelly",V(1.72,1.9,.56),CF(0,-.67,-1.13),IVORY,SM)
 b:ball("CreamLowerBelly",V(1.3,.82,.85),CF(0,-1.38,-.7),IVORY,SM)
 b:ball("BackShoulders",V(2.3,1.6,1.7),CF(0,.62,.25),DARKRED,SM)
 b:ball("Neck",V(1.28,1.6,1.32),CF(0,1.13,-.42),RED,SM)
 b:ball("Head",V(1.6,1.5,1.6),CF(0,2.05,-.65),SCARLET,SM)
 b:ball("Forehead",V(1.25,.83,.7),CF(0,2.39,-1.16),RED,SM)

 -- Three swept golden crest prongs; the outline remains readable at distance.
 for i=-1,1 do
  local x=i*.37
  local a=V(x,2.55,-.55)
  local c=V(i*.65,3.58-math.abs(i)*.17,-.06)
  feather(b,"GoldenCrest"..i,a,c,.49,GOLD,PALE)
 end
 b:ball("CrestRoot",V(1.17,.32,.56),CF(0,2.65,-.44),GOLD,SM)

 -- Cream eye masks, dark eyes, pinpoint glints and expressive red brows.
 for _,s in ipairs({-1,1}) do
  b:ball("EyeMask"..s,V(.57,.57,.35),CF(s*.59,2.12,-1.24)*CFrame.Angles(0,s*.24,0),IVORY,SM)
  b:ball("DarkEye"..s,V(.25,.32,.15),CF(s*.64,2.16,-1.405),INK,SM)
  b:ball("EyeGlint"..s,V(.075,.1,.06),CF(s*.615,2.225,-1.482),C(255,255,255),SM)
  b:line("AngledBrow"..s,V(s*.36,2.46,-1.38),V(s*.86,2.37,-1.3),.15,.14,DARKRED,SM)
  feather(b,"CheekPlume"..s,V(s*.54,1.96,-1.06),V(s*1.05,1.5,-.45),.37,RED,SCARLET)
 end
 b:ball("UpperGoldenBeak",V(.66,.52,.97),CF(0,1.99,-1.68),GOLD,SM)
 b:ball("BeakHook",V(.43,.6,.47),CF(0,1.79,-2.04)*CFrame.Angles(.22,0,0),GOLD,SM)
 b:wedge("SharpBeakTip",V(.34,.42,.37),CF(0,1.61,-2.08)*CFrame.Angles(0,math.pi,0),PALE,SM)
 b:line("BeakSeam",V(-.29,1.81,-1.76),V(.29,1.81,-1.76),.035,.045,C(133,88,25),SM)
 for _,s in ipairs({-1,1}) do
  b:ball("Nostril"..s,V(.07,.055,.09),CF(s*.17,2.14,-1.99),C(125,81,24),SM)
 end

 -- Layered belly and flank feathers conceal the primitive intersections.
 for row=0,2 do
  for col=-2,2 do
   local x=col*(.30-row*.025)
   local a=V(x,-.16-row*.42,-1.12+row*.015)
   local c=a+V(col*.035,-.66,.04)
   feather(b,"BreastFeather"..row.."_"..col,a,c,.38,IVORY,C(220,211,183))
  end
 end
 for _,s in ipairs({-1,1}) do
  for j=0,3 do
   feather(b,"Flank"..s.."_"..j,V(s*.89,.13-j*.35,-.13),V(s*(1.15-j*.03),-.66-j*.3,.5),.44,SCARLET,GOLD)
  end
  b:ball("ShoulderSocket"..s,V(.72,.88,.9),CF(s*1.1,.58,.06),RED,SM)
  -- Visible bent legs and three curled gold talons, suitable for a flying pose.
  b:line("UpperLeg"..s,V(s*.57,-1.25,-.15),V(s*.68,-1.92,-.3),.29,.29,GOLD,SM)
  b:line("LowerLeg"..s,V(s*.68,-1.92,-.3),V(s*.72,-1.96,-.72),.23,.24,GOLD,SM)
  for k=-1,1 do
   local a=V(s*.72+k*.16,-1.96,-.72)
   local c=V(s*.72+k*.24,-2.11,-1.15+(k==0 and -.1 or 0))
   b:line("Toe"..s.."_"..k,a,c,.105,.105,GOLD,SM)
   b:line("Claw"..s.."_"..k,c,c+V(0,.035,-.18),.062,.062,INK,SM)
  end
  b:line("RearToe"..s,V(s*.72,-1.96,-.6),V(s*.88,-2.07,-.17),.095,.095,GOLD,SM)
 end
end

local function wing(b,s)
 local name=s&lt;0 and "Left" or "Right"
 local function p(x,y,z) return V(s*x,y,z) end
 -- A curved leading edge and broad red upper wing, with green trailing coverts.
 local shoulder=p(1.08,.61,.02)
 local elbow=p(3.25,1.05,.35)
 local wrist=p(5.25,.84,1.05)
 local tip=p(7.55,.28,2.04)
 ellipsoid(b,name.."UpperWing",shoulder,elbow,1.25,.68,RED)
 ellipsoid(b,name.."ForeWing",elbow,wrist,1.03,.49,SCARLET)
 b:triangle(name.."ScarletSailA",shoulder,wrist,p(3.3,.55,2.55),RED,.18,SM)
 b:triangle(name.."ScarletSailB",wrist,tip,p(5.8,.25,3.04),SCARLET,.15,SM)
 b:triangle(name.."GreenPanel",p(1.65,.47,.96),p(4.8,.59,1.8),p(3.2,.32,3.14),GREEN,.15,SM)
 b:line(name.."LeadingEdge1",shoulder,elbow,.16,.17,DARKRED,SM)
 b:line(name.."LeadingEdge2",elbow,wrist,.12,.14,GOLD,SM)
 b:line(name.."LeadingEdge3",wrist,tip,.09,.10,GOLD,SM)

 -- Eight long golden primaries give the broad, fingered wing outline.
 for i=0,7 do
  local t=i/7
  local a=p(3.45+t*3.48,.78-t*.40,.65+t*1.27)
  local c=p(3.07+t*4.87,.12-t*.14,3.6+t*.30)
  feather(b,name.."GoldenPrimary"..i,a,c,.64-t*.19,GOLD,PALE)
  -- White underside is visible from the arena beneath the flying bird.
  feather(b,name.."PrimaryUnderside"..i,a-V(0,.075,0),c-V(0,.075,0),.56-t*.18,IVORY,GOLD)
 end
 -- Fan of shorter secondary feathers with alternating red and green coverts.
 for i=0,4 do
  local x=1.55+i*.44
  feather(b,name.."Secondary"..i,p(x,.58,.55+i*.12),p(x+.12,.24,2.77+i*.12),.60,GOLD,PALE)
  feather(b,name.."GreenCovert"..i,p(x,.65,.35+i*.1),p(x+.34,.47,1.98+i*.1),.55,i%2==0 and GREEN or TEAL,GOLD)
 end
 for i=0,5 do
  local x=1.53+i*.78
  feather(b,name.."ScarletCovert"..i,p(x,.91,.1+i*.09),p(x+.24,.68,1.25+i*.17),.61,i%2==0 and RED or SCARLET,GOLD)
 end
end

local function tail(b)
 b:ball("TailRoot",V(1.24,.72,1.44),CF(0,-.66,1.04)*CFrame.Angles(-.2,0,0),DARKRED,SM)
 -- Seven long feathers make Ho-Oh's distinctive broad golden tail fan.
 for i=-3,3 do
  local a=V(i*.13,-.76,1.42)
  local c=V(i*.7,-.55+math.abs(i)*.12,5.98-math.abs(i)*.34)
  feather(b,"GoldenTailFeather"..i,a,c,.81,GOLD,PALE)
  -- Red bases and light terminal flashes add layers rather than plain rods.
  feather(b,"RedTailCovert"..i,a+V(0,.08,0),a+(c-a)*.38+V(0,.08,0),.65,SCARLET,DARKRED)
 end
 for i=-2,2 do
  feather(b,"SmallGreenTailCovert"..i,V(i*.15,-.62,1.3),V(i*.34,-.46,2.65),.44,GREEN,TEAL)
 end
end

function M.build(b,key)
 key=string.lower(key or "")
 if key=="hooh_body" then body(b)
 elseif key=="hooh_wing_left" then wing(b,-1)
 elseif key=="hooh_wing_right" then wing(b,1)
 elseif key=="hooh_tail" then tail(b)
 elseif key=="hooh_complete" then body(b); wing(b,-1); wing(b,1); tail(b)
 else return false end
 return true
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_FreeModels_64_Labels"><Properties><string name="Name">Labels</string><ProtectedString name="Source">-- Readable text belongs on real surfaces rather than floating billboards.
local L={}
L.Definitions={
 mtg_black_lotus_card={
  {part="TitleSurface",text="BLACK LOTUS",color={30,26,22},size=42,align="Left"},
  {part="TypeSurface",text="Artifact",color={30,26,22},size=30,align="Left"},
  {part="RulesSurface",text="Sacrifice Black Lotus: Add three mana of any one color.\n\nA rare bloom of extraordinary power.",color={42,35,28},size=25,align="Left"},
 },
 mirror_force_card={
  {part="TitleSurface",text="MIRROR FORCE",color={255,244,217},size=72,align="Left"},
  {part="CardTypeSurface",text="[TRAP CARD]",color={255,244,217},size=35,align="Right"},
  {part="EditionSurface",text="SPELLBINDING ARCHIVE",color={246,222,195},size=14,align="Left"},
  {part="RulesSurface",text="When an opponent's monster declares an attack:\nDestroy all your opponent's Attack Position monsters.",color={45,31,29},size=40,align="Left"},
 },
 power_console={
  {part="MonitorScreen",text="POWER\nLOADOUT",color={118,233,255},size=26,align="Right"},
 },
}
local suppressed={mtg_black_lotus_card={"LotusRules","LotusFlavor"},mirror_force_card={"MirrorRules"}}
function L.apply(model,key)
 for _,part in ipairs(model:GetDescendants()) do
  if part:IsA("BasePart") then
   for _,prefix in ipairs(suppressed[key] or {}) do
    if part.Name:sub(1,#prefix)==prefix then part.Transparency=1 end
   end
  end
 end
 -- Offline geometry recording has no Roblox GUI constructors.
 if not UDim2 then return end
 for index,definition in ipairs(L.Definitions[key] or {}) do
  local part=model:FindFirstChild(definition.part,true)
  if part then
   local gui=Instance.new("SurfaceGui")
   gui.Name="NativeText"..index;gui.Face=Enum.NormalId.Front
   gui.SizingMode=Enum.SurfaceGuiSizingMode.PixelsPerStud;gui.PixelsPerStud=35
   gui.LightInfluence=.15;gui.AlwaysOnTop=false;gui.MaxDistance=300
   local text=Instance.new("TextLabel")
   text.Name="Caption";text.BackgroundTransparency=1
   text.Position=UDim2.fromOffset(12,6);text.Size=UDim2.new(1,-24,1,-12)
   text.Text=definition.text;text.Font=Enum.Font.GothamBold
   text.TextSize=definition.size;text.TextScaled=false;text.TextWrapped=true
   text.TextColor3=Color3.fromRGB(definition.color[1],definition.color[2],definition.color[3])
   text.TextXAlignment=Enum.TextXAlignment[definition.align]
   text.TextYAlignment=Enum.TextYAlignment.Center
   text.Parent=gui;gui.Parent=part
  end
 end
end
return L
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_FreeModels_64_NintendoItems"><Properties><string name="Name">NintendoItems</string><ProtectedString name="Source">-- Handmade, native Roblox geometry. No generated assets, paid services, or IDs.
-- Front faces point toward -Z. Every detail scales with the shared art builder.
local M = {}
local V, C, A = Vector3.new, CFrame.new, CFrame.Angles
local pi = math.pi
local METAL, PLASTIC = Enum.Material.Metal, Enum.Material.SmoothPlastic
local WOOD, NEON = Enum.Material.Wood, Enum.Material.Neon
local white = Color3.fromRGB(251, 247, 224)
local ivory = Color3.fromRGB(228, 221, 192)
local black = Color3.fromRGB(21, 24, 34)
local gold = Color3.fromRGB(255, 192, 44)
local paleGold = Color3.fromRGB(255, 229, 117)
local darkGold = Color3.fromRGB(159, 92, 19)
local silver = Color3.fromRGB(215, 229, 242)
local steel = Color3.fromRGB(108, 133, 159)
local blue = Color3.fromRGB(31, 107, 233)
local navy = Color3.fromRGB(12, 39, 94)
local green = Color3.fromRGB(48, 157, 54)
local lime = Color3.fromRGB(121, 210, 64)
local red = Color3.fromRGB(217, 48, 43)

local function disc(b, name, p, diameter, depth, color, material)
    return b:cylinder(name, V(depth, diameter, diameter), C(p) * A(0, pi / 2, 0), color, material)
end

local function discY(b, name, p, diameter, depth, color, material)
    return b:cylinder(name, V(depth, diameter, diameter), C(p) * A(0, 0, pi / 2), color, material)
end

local function ellipse(b, name, cf, rx, ry, width, color, count, material)
    count = count or 20
    for i = 0, count - 1 do
        local t, u = i * 2 * pi / count, (i + 1) * 2 * pi / count
        b:line(name .. i, cf * V(rx * math.cos(t), ry * math.sin(t), 0),
            cf * V(rx * math.cos(u), ry * math.sin(u), 0), width, width, color, material)
    end
end

local function cone(b, name, base, tip, radius, color, count)
    count = count or 6
    local axis = (tip - base).Unit
    local ref = math.abs(axis.Y) &lt; .9 and V(0, 1, 0) or V(1, 0, 0)
    local x = axis:Cross(ref).Unit
    local z = axis:Cross(x).Unit
    for i = 0, count - 1 do
        local t, u = i * 2 * pi / count, (i + 1) * 2 * pi / count
        local a = base + (x * math.cos(t) + z * math.sin(t)) * radius
        local c = base + (x * math.cos(u) + z * math.sin(u)) * radius
        b:triangle(name .. i, a, c, tip, color, .025, PLASTIC)
    end
end

local function leaf(b, name, center, tip, spread, color, thickness)
    local mid = (center + tip) * .5
    local sideways = V(-(tip-center).Y, (tip-center).X, 0).Unit * spread
    local ridge = mid + V(0, 0, -.13)
    b:triangle(name .. "Left", center, mid + sideways, ridge, color, thickness or .06, PLASTIC)
    b:triangle(name .. "LeftTip", mid + sideways, tip, ridge, color, thickness or .06, PLASTIC)
    b:triangle(name .. "Right", center, mid - sideways, ridge, lime, thickness or .06, PLASTIC)
    b:triangle(name .. "RightTip", mid - sideways, tip, ridge, lime, thickness or .06, PLASTIC)
    b:line(name .. "Vein", center + V(0, 0, -.08), tip + V(0, 0, -.08), .045, .035, Color3.fromRGB(35, 104, 34), PLASTIC)
end

local function blueShell(b)
    b:ball("SapphireShellBody", V(2.85, 1.8, 2.5), C(0, .55, 0), blue, PLASTIC)
    b:ball("IvoryUnderside", V(3.05, .51, 2.72), C(0, -.04, 0), ivory, PLASTIC)
    b:ball("UndersideInset", V(2.54, .24, 2.2), C(0, -.26, 0), white, PLASTIC)
    ellipse(b, "ThickIvoryRim", C(0, .1, 0) * A(pi / 2, 0, 0), 1.47, 1.28, .17, white, 24, PLASTIC)
    ellipse(b, "BlueRimSeam", C(0, .26, 0) * A(pi / 2, 0, 0), 1.37, 1.17, .055, navy, 20, PLASTIC)
    -- Raised, curved shell panels separated by dark blue seams.
    for i = 0, 5 do
        local t = i * pi / 3
        local x, z = math.cos(t), math.sin(t)
        b:ball("RaisedShellPlate" .. i, V(.98, .53, .93), C(x * .69, 1.06, z * .6) * A(0, -t, 0),
            i % 2 == 0 and Color3.fromRGB(42, 133, 255) or Color3.fromRGB(30, 99, 221), PLASTIC)
        b:line("ShellPlateSeam" .. i, V(x * .44, 1.4, z * .39), V(x * 1.19, .82, z * 1.04), .052, .052, navy, PLASTIC)
    end
    b:ball("CrownPanel", V(1.03, .35, 1.03), C(0, 1.42, 0), Color3.fromRGB(70, 153, 255), PLASTIC)
    cone(b, "CrownSpike", V(0, 1.47, 0), V(0, 2.42, 0), .34, white)
    for i = 0, 3 do
        local t = pi / 4 + i * pi / 2
        local outward = V(math.cos(t), .43, math.sin(t))
        local base = V(math.cos(t) * .88, 1.12, math.sin(t) * .77)
        cone(b, "OuterSpike" .. i, base, base + outward * .88, .29, white)
    end
    -- Feathers form two fully dimensional, readable wings, rather than flat slabs.
    for _, s in ipairs({ -1, 1 }) do
        b:ball("WingShoulder" .. s, V(.5, .72, .68), C(s * 1.37, .72, .03) * A(0, 0, s * -.35), ivory, PLASTIC)
        b:ball("WingBody" .. s, V(.65, 1.38, .4), C(s * 1.81, 1.12, .06) * A(0, 0, s * -.55), white, PLASTIC)
        for j = 0, 5 do
            local x, y = 1.72 + j * .117, .77 + j * .145
            b:ball("LongFlightFeather" .. s .. "_" .. j, V(.21, 1.2 - j * .055, .22),
                C(s * x, y + .33, .02) * A(0, 0, s * (-.65 - j * .047)), white, PLASTIC)
            b:ball("FeatherRoot" .. s .. "_" .. j, V(.2, .58, .17),
                C(s * (x - .13), y + .03, -.145) * A(0, 0, s * -.73), ivory, PLASTIC)
        end
        b:line("WingLeadingEdge" .. s, V(s * 1.42, .48, -.17), V(s * 2.01, 1.95, -.17), .105, .105, white, PLASTIC)
    end
end

local function kirbySword(b)
    -- Sword-copy-ability blade: broad silver diamond section, blue handle, gold guard.
    local y0, shoulder, tip = -.12, 2.64, 3.22
    local left, right = V(-.4, y0, 0), V(.4, y0, 0)
    local shoulderLeft, shoulderRight = V(-.38, shoulder, 0), V(.38, shoulder, 0)
    local apex = V(0, tip, 0)
    for _, side in ipairs({ -1, 1 }) do
        local ridgeBase, ridgeTop = V(0, y0, side * .145), V(0, shoulder, side * .12)
        b:triangle("BladeLeftLower" .. side, left, shoulderLeft, ridgeBase, silver, .026, METAL)
        b:triangle("BladeLeftUpper" .. side, shoulderLeft, ridgeTop, ridgeBase, Color3.fromRGB(238, 246, 255), .026, METAL)
        b:triangle("BladeRightLower" .. side, right, shoulderRight, ridgeBase, steel, .026, METAL)
        b:triangle("BladeRightUpper" .. side, shoulderRight, ridgeTop, ridgeBase, silver, .026, METAL)
        b:triangle("BladeTipLeft" .. side, shoulderLeft, apex, ridgeTop, white, .026, METAL)
        b:triangle("BladeTipRight" .. side, shoulderRight, apex, ridgeTop, silver, .026, METAL)
        b:line("BladeCenterRidge" .. side, V(0, .08, side * .155), V(0, 2.67, side * .125), .025, .025, white, METAL)
        b:box("RicassoInset" .. side, V(.25, .24, .025), C(0, .01, side * .16), darkGold, METAL)
    end
    b:box("GoldGuardCore", V(.89, .26, .46), C(0, -.18, 0), gold, METAL)
    for _, s in ipairs({ -1, 1 }) do
        b:line("SweptCrossguard" .. s, V(s * .27, -.13, 0), V(s * .91, .03, 0), .23, .4, gold, METAL)
        b:triangle("GuardPoint" .. s, V(s * .62, -.22, -.22), V(s * 1.07, .12, -.22), V(s * .53, .12, -.22), paleGold, .08, METAL)
        b:ball("GuardTerminal" .. s, V(.23, .28, .4), C(s * .91, .03, 0), gold, METAL)
        b:line("GuardEngraving" .. s, V(s * .34, -.11, -.24), V(s * .83, .035, -.24), .025, .025, paleGold, METAL)
    end
    disc(b, "GuardBlueJewel", V(0, -.16, -.27), .35, .09, Color3.fromRGB(36, 150, 252), METAL)
    disc(b, "RearGuardBlueJewel", V(0, -.16, .27), .35, .09, blue, METAL)
    b:cylinder("BlueGrip", V(.99, .35, .35), C(0, -.84, 0) * A(0, 0, pi / 2), navy, PLASTIC)
    for j = 0, 7 do
        local y = -.4 - j * .119
        ellipse(b, "GripBinding" .. j, C(0, y, 0) * A(pi / 2, 0, 0), .19, .19, .04, blue, 6, PLASTIC)
    end
    b:cylinder("GripGoldCollar", V(.15, .43, .43), C(0, -.38, 0) * A(0, 0, pi / 2), gold, METAL)
    b:cylinder("PommelGoldCollar", V(.14, .43, .43), C(0, -1.4, 0) * A(0, 0, pi / 2), gold, METAL)
    b:ball("BluePommel", V(.55, .45, .5), C(0, -1.62, 0), blue, PLASTIC)
    b:ball("PommelHighlight", V(.17, .12, .055), C(-.11, -1.51, -.23), Color3.fromRGB(128, 203, 255), PLASTIC)
    ellipse(b, "PommelBand", C(0, -1.62, 0) * A(pi / 2, 0, 0), .275, .25, .055, gold, 12, METAL)
end

local function goldenSpatula(b)
    -- Built around real open slots: no black rectangles pretending to be holes.
    b:box("SpatulaHeadTop", V(1.55, .18, .18), C(0, 1.93, 0), paleGold, METAL)
    b:box("SpatulaHeadBottom", V(1.55, .2, .18), C(0, .71, 0), gold, METAL)
    for _, s in ipairs({ -1, 1 }) do
        b:box("HeadOuterRail" .. s, V(.19, 1.22, .18), C(s * .68, 1.32, 0), gold, METAL)
        b:ball("RoundedHeadCorner" .. s, V(.21, .21, .18), C(s * .67, 1.95, 0), paleGold, METAL)
        b:box("HeadEdgeBevel" .. s, V(.035, 1.14, .06), C(s * .78, 1.31, -.04), paleGold, METAL)
    end
    for i = -2, 2 do
        b:box("GoldSlotDivider" .. i, V(.11, 1.12, .16), C(i * .215, 1.31, 0), gold, METAL)
        b:box("DividerHighlight" .. i, V(.029, 1.04, .025), C(i * .215 - .025, 1.31, -.089), paleGold, METAL)
    end
    b:triangle("HeadNeckLeft", V(-.76, .62, 0), V(0, .19, 0), V(0, .62, 0), gold, .17, METAL)
    b:triangle("HeadNeckRight", V(.76, .62, 0), V(0, .19, 0), V(0, .62, 0), paleGold, .17, METAL)
    b:line("GoldShaft", V(0, .39, 0), V(0, -1.05, .07), .16, .16, gold, METAL)
    b:line("ShaftHighlight", V(-.042, .37, -.088), V(-.042, -.94, -.02), .03, .03, paleGold, METAL)
    b:ball("RoundedWoodHandle", V(.43, 1.24, .38), C(0, -1.41, .09), Color3.fromRGB(124, 62, 29), WOOD)
    for i = 0, 8 do
        local y = -.94 - i * .112
        ellipse(b, "GripRing" .. i, C(0, y, .09) * A(pi / 2, 0, 0), .19, .165, .025,
            i % 2 == 0 and Color3.fromRGB(164, 89, 40) or Color3.fromRGB(79, 39, 21), 6, WOOD)
    end
    b:cylinder("GripGoldFerrule", V(.15, .42, .38), C(0, -.84, .09) * A(0, 0, pi / 2), gold, METAL)
    b:cylinder("GripEndCap", V(.1, .34, .32), C(0, -2.01, .09) * A(0, 0, pi / 2), gold, METAL)
    ellipse(b, "HangingLoop", C(0, -2.23, .09), .16, .21, .06, gold, 12, METAL)
    disc(b, "HandlePin", V(0, -1.1, -.115), .11, .025, paleGold, METAL)
end

local function krabbyPatty(b)
    local bun = Color3.fromRGB(220, 143, 57)
    local toasted = Color3.fromRGB(169, 90, 30)
    local meat = Color3.fromRGB(88, 39, 24)
    b:ball("BottomBun", V(3.2, .55, 2.84), C(0, -.82, 0), bun, PLASTIC)
    b:ball("ToastedBottomCrust", V(3.11, .19, 2.73), C(0, -1.02, 0), toasted, PLASTIC)
    b:ball("GrilledPatty", V(3.12, .42, 2.76), C(0, -.43, 0), meat, PLASTIC)
    for i = 0, 13 do
        local t = i * 2 * pi / 14
        b:ball("PattyCrag" .. i, V(.39, .22, .32), C(math.cos(t) * 1.4, -.42, math.sin(t) * 1.22),
            i % 2 == 0 and Color3.fromRGB(115, 57, 31) or Color3.fromRGB(66, 30, 20), PLASTIC)
    end
    for j = -2, 2 do
        b:line("GrillMark" .. j, V(-.8, -.18, j * .24), V(.8, -.18, j * .24), .055, .045, Color3.fromRGB(44, 22, 17), PLASTIC)
    end
    b:box("CheeseSlice", V(2.45, .065, 2.45), C(0, -.15, 0) * A(0, .25, 0), Color3.fromRGB(255, 190, 18), PLASTIC)
    for _, s in ipairs({ -1, 1 }) do
        b:triangle("DroopingCheeseFront" .. s, V(s * .4, -.12, -1.39), V(s * 1.17, -.12, -1.19), V(s * .91, -.55, -1.46), gold, .045, PLASTIC)
        b:triangle("DroopingCheeseBack" .. s, V(s * .4, -.12, 1.39), V(s * 1.17, -.12, 1.19), V(s * .91, -.48, 1.43), gold, .045, PLASTIC)
    end
    for i = 0, 15 do
        local t = i * 2 * pi / 16
        b:ball("RuffledLettuce" .. i, V(.65, .18, .59), C(math.cos(t) * 1.25, .015 + (i % 2) * .04, math.sin(t) * 1.09) * A(.09 * math.cos(t), -t, .1 * math.sin(t)),
            i % 2 == 0 and green or lime, PLASTIC)
        b:line("LettuceVein" .. i, V(math.cos(t) * 1.03, .13, math.sin(t) * .9),
            V(math.cos(t) * 1.51, .15, math.sin(t) * 1.31), .035, .035, Color3.fromRGB(178, 224, 98), PLASTIC)
    end
    for _, x in ipairs({ -.62, .62 }) do
        discY(b, "TomatoSlice" .. x, V(x, .2, -.15), 1.45, .19, red, PLASTIC)
        discY(b, "TomatoFlesh" .. x, V(x, .304, -.15), 1.15, .025, Color3.fromRGB(245, 105, 67), PLASTIC)
    end
    for i = 0, 3 do
        local t = pi / 4 + i * pi / 2
        discY(b, "PickleSlice" .. i, V(math.cos(t) * .66, .41, math.sin(t) * .6), .66, .13, green, PLASTIC)
        discY(b, "PickleCenter" .. i, V(math.cos(t) * .66, .48, math.sin(t) * .6), .47, .018, Color3.fromRGB(164, 186, 79), PLASTIC)
    end
    b:ball("DomedSesameBun", V(3.2, 1.33, 2.84), C(0, .87, 0), bun, PLASTIC)
    b:ball("BunGoldenCrown", V(2.75, .69, 2.46), C(0, 1.24, 0), Color3.fromRGB(239, 175, 79), PLASTIC)
    for i = 0, 24 do
        local t = i * 2.399963
        local r = math.sqrt((i + .5) / 25) * .9
        local x, z = math.cos(t) * r * 1.4, math.sin(t) * r * 1.22
        local y = 1.43 + .15 * math.sqrt(math.max(0, 1 - r * r))
        b:ball("SesameSeed" .. i, V(.072, .04, .16), C(x, y, z) * A(0, t, .12), white, PLASTIC)
    end
end

local function garyShell(b)
    local pink = Color3.fromRGB(239, 149, 185)
    local rose = Color3.fromRGB(181, 48, 87)
    local purple = Color3.fromRGB(108, 70, 156)
    b:ball("PinkShellMass", V(2.99, 2.8, 1.72), C(0, .37, .16), pink, PLASTIC)
    b:ball("ShellBackRound", V(2.57, 2.45, .61), C(0, .39, .9), Color3.fromRGB(219, 118, 165), PLASTIC)
    -- Actual open mouth at lower right: its rim is a ring, not a covered disc.
    ellipse(b, "ThickOpeningLip", C(.92, -.54, -.68) * A(0, -.28, -.38), .56, .76, .17, Color3.fromRGB(244, 172, 199), 20, PLASTIC)
    b:ball("RecessedOpeningInterior", V(.91, 1.24, .12), C(.98, -.54, -.46) * A(0, -.28, -.38), Color3.fromRGB(69, 32, 60), PLASTIC)
    ellipse(b, "OpeningInnerLip", C(.94, -.53, -.72) * A(0, -.28, -.38), .44, .63, .065, Color3.fromRGB(193, 93, 143), 16, PLASTIC)
    local previous
    for i = 0, 39 do
        local t = i * .22
        local r = .075 + i * .028
        local p = V(-.16 + math.cos(t) * r, .51 + math.sin(t) * r, -.74 - .12 * math.sqrt(math.max(0, 1 - (r / 1.35)^2)))
        if previous then b:line("RaisedRedSpiral" .. i, previous, p, .092, .08, rose, PLASTIC) end
        previous = p
    end
    for i, p in ipairs({ V(-1.11, 1.02, -.54), V(-1.27, -.05, -.48), V(-.55, -.86, -.51), V(.69, 1.47, -.46), V(1.12, .86, -.51) }) do
        b:ball("VioletShellSpot" .. i, V(.27 + (i % 2) * .08, .4, .065), C(p) * A(0, 0, i * .43), purple, PLASTIC)
    end
    for i = 0, 14 do
        local t = i * 2 * pi / 15
        b:line("ShellGrowthRidge" .. i, V(math.cos(t) * 1.16, .37 + math.sin(t) * 1.06, .82),
            V(math.cos(t) * 1.39, .37 + math.sin(t) * 1.29, .45), .035, .035, Color3.fromRGB(244, 168, 199), PLASTIC)
    end
    for i = 0, 11 do
        local t = i * 2 * pi / 12
        b:ball("BackVioletSpot" .. i, V(.16, .2, .055), C(math.cos(t) * .94, .39 + math.sin(t) * .85, 1.21), purple, PLASTIC)
    end
end

local function superStar(b)
    local front, back = V(0, .12, -.39), V(0, .12, .35)
    local points = {}
    for i = 0, 9 do
        local t = pi / 2 + i * pi / 5
        local r = i % 2 == 0 and 1.62 or .76
        points[i + 1] = V(math.cos(t) * r, .12 + math.sin(t) * r, 0)
    end
    for i = 1, 10 do
        local j = i % 10 + 1
        local a, c = points[i], points[j]
        b:triangle("GoldFrontFacet" .. i, front, a + V(0, 0, -.09), c + V(0, 0, -.09), i % 2 == 0 and gold or paleGold, .035, METAL)
        b:triangle("GoldBackFacet" .. i, back, a + V(0, 0, .09), c + V(0, 0, .09), gold, .035, METAL)
        b:triangle("StarEdgeA" .. i, a + V(0, 0, -.09), c + V(0, 0, -.09), a + V(0, 0, .09), darkGold, .025, METAL)
        b:triangle("StarEdgeB" .. i, c + V(0, 0, -.09), c + V(0, 0, .09), a + V(0, 0, .09), gold, .025, METAL)
    end
    for _, s in ipairs({ -1, 1 }) do
        b:ball("OvalStarEye" .. s, V(.15, .48, .08), C(s * .31, .21, -.397), black, PLASTIC)
        b:ball("EyeCatchlight" .. s, V(.043, .12, .023), C(s * .31 - .025, .34, -.439), white, PLASTIC)
    end
    b:ball("GoldGlint", V(.12, .17, .025), C(-.57, .66, -.293), white, METAL)
end

local function fireFlower(b)
    local orange = Color3.fromRGB(255, 120, 21)
    local center = V(0, .95, 0)
    -- Lobed flower ring with a yellow inset face and two tall black eyes.
    for i = 0, 11 do
        local t = i * 2 * pi / 12
        b:ball("OrangePetal" .. i, V(.73, .76, .54), C(center + V(math.cos(t) * .71, math.sin(t) * .73, 0)), orange, PLASTIC)
        b:ball("RedPetalOutline" .. i, V(.83, .86, .42), C(center + V(math.cos(t) * .77, math.sin(t) * .79, .18)), red, PLASTIC)
    end
    b:ball("FlowerYellowFace", V(1.66, 1.76, .51), C(0, .95, -.18), Color3.fromRGB(255, 224, 65), PLASTIC)
    b:ball("BackFlowerCalyx", V(1.1, 1.18, .46), C(0, .89, .42), green, PLASTIC)
    for _, s in ipairs({ -1, 1 }) do
        b:ball("FlowerEye" .. s, V(.13, .47, .09), C(s * .25, 1.03, -.438), black, PLASTIC)
        b:ball("FlowerEyeGlint" .. s, V(.035, .1, .024), C(s * .25 - .018, 1.17, -.485), white, PLASTIC)
    end
    b:line("ThickFlowerStem", V(0, .15, .08), V(0, -1.61, .08), .24, .24, green, PLASTIC)
    b:line("StemHighlight", V(-.055, .1, -.052), V(-.055, -1.58, -.052), .055, .035, lime, PLASTIC)
    leaf(b, "LeftLeaf", V(-.04, -.91, .05), V(-1.28, -.41, .05), .35, green)
    leaf(b, "RightLeaf", V(.04, -1.23, .05), V(1.23, -.67, .05), .35, green)
    for _, s in ipairs({ -1, 1 }) do
        for i = 1, 4 do
            local p = V(s * (.16 + i * .185), -.91 + (s == -1 and 0 or -.32) + i * .072, -.12)
            b:line("LeafVein" .. s .. "_" .. i, p, p + V(s * .13, .17, .04), .025, .025, Color3.fromRGB(80, 141, 44), PLASTIC)
        end
    end
    b:ball("StemFoot", V(.36, .18, .3), C(0, -1.63, .08), green, PLASTIC)
end

local function hylianShield(b)
    local outline = { V(0, 2.08, 0), V(1.23, 1.73, 0), V(1.41, .68, 0), V(.99, -.8, 0), V(0, -1.82, 0), V(-.99, -.8, 0), V(-1.41, .68, 0), V(-1.23, 1.73, 0) }
    local centerFront, centerBack = V(0, .23, -.3), V(0, .23, .22)
    for i = 1, #outline do
        local j = i % #outline + 1
        local a, c = outline[i], outline[j]
        b:triangle("BlueShieldFace" .. i, centerFront, a * .86 + V(0, .025, -.08), c * .86 + V(0, .025, -.08), i % 2 == 0 and blue or navy, .075, METAL)
        b:triangle("SteelShieldBack" .. i, centerBack, a + V(0, 0, .1), c + V(0, 0, .1), steel, .08, METAL)
        b:line("SculptedSilverRim" .. i, a + V(0, 0, -.08), c + V(0, 0, -.08), .18, .27, silver, METAL)
        b:line("InnerRaisedRim" .. i, a * .86 + V(0, .025, -.13), c * .86 + V(0, .025, -.13), .064, .08, steel, METAL)
        b:ball("RimRivet" .. i, .13, C(a + V(0, 0, -.23)), white, METAL)
    end
    -- Raised Triforce, with the center triangle left blue.
    local ty, unit = 1.06, .33
    for i, p in ipairs({ V(0, ty + .35, -.27), V(-.34, ty - .23, -.32), V(.34, ty - .23, -.32) }) do
        b:triangle("Triforce" .. i, p + V(0, unit, 0), p + V(-unit, -.24, 0), p + V(unit, -.24, 0), gold, .09, METAL)
    end
    local scarlet = Color3.fromRGB(213, 35, 54)
    b:triangle("BirdBodyLeft", V(0, .44, -.36), V(-.24, -.34, -.36), V(0, -.64, -.36), scarlet, .07, METAL)
    b:triangle("BirdBodyRight", V(0, .44, -.36), V(.24, -.34, -.36), V(0, -.64, -.36), scarlet, .07, METAL)
    b:line("BirdNeck", V(0, .12, -.4), V(0, .62, -.36), .11, .06, scarlet, METAL)
    b:triangle("BirdHead", V(0, .61, -.35), V(.25, .56, -.35), V(0, .75, -.35), scarlet, .065, METAL)
    for _, s in ipairs({ -1, 1 }) do
        b:line("BirdWingSpine" .. s, V(s * .13, -.12, -.37), V(s * .92, .49, -.27), .115, .07, scarlet, METAL)
        for i = 0, 3 do
            local x, y = .34 + i * .18, -.05 + i * .14
            b:triangle("BirdWingFeather" .. s .. "_" .. i, V(s * x, y, -.36 + i * .025),
                V(s * (x + .13), y + .54, -.35 + i * .025), V(s * (x + .2), y + .14, -.35 + i * .025), scarlet, .06, METAL)
        end
        b:line("BirdTalon" .. s, V(s * .1, -.47, -.37), V(s * .36, -.69, -.31), .065, .06, scarlet, METAL)
        b:line("BirdLowerTail" .. s, V(s * .07, -.56, -.36), V(s * .27, -1.03, -.25), .08, .06, scarlet, METAL)
        -- Rear leather straps are genuinely raised off the back of the shield.
        b:line("RearStrapMount" .. s, V(s * .59, .88, .26), V(s * .59, -.72, .26), .2, .1, Color3.fromRGB(80, 44, 26), WOOD)
        b:line("RearStrapUpper" .. s, V(s * .59, .62, .29), V(s * .59, .26, .62), .19, .105, Color3.fromRGB(129, 76, 38), WOOD)
        b:line("RearStrapLower" .. s, V(s * .59, .26, .62), V(s * .59, -.48, .29), .19, .105, Color3.fromRGB(129, 76, 38), WOOD)
        for _, y in ipairs({ -.56, .7 }) do
            disc(b, "RearStrapStud" .. s .. y, V(s * .59, y, .33), .12, .05, gold, METAL)
        end
    end
end

local builders = {
    blue_shell = blueShell,
    kirby_sword = kirbySword,
    golden_spatula = goldenSpatula,
    krabby_patty = krabbyPatty,
    gary_shell = garyShell,
    super_star = superStar,
    fire_flower = fireFlower,
    hylian_shield = hylianShield,
}
function M.build(b, key)
    local build = builders[key]
    if not build then return false end
    build(b)
    return true
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_FreeModels_64_Primitives"><Properties><string name="Name">Primitives</string><ProtectedString name="Source">-- Shared procedural art. No external assets, remotes, or runtime scripts.
local P={}
local B={}; B.__index=B
function P.new(parent,options)
 options=options or {}
 options.parent=parent
 local scale=options.scale or 1
 assert(type(scale)=="number" and scale&gt;0 and scale&lt;math.huge,"Invalid art scale")
 local model=Instance.new("Model"); model.Name=options.name or options.model or "Collectible"
 model:SetAttribute("Kind",options.itemId or options.model or "art")
 model:SetAttribute("AnimatedCharacter",false)
 model:SetAttribute("ArtVersion",1)
 local root=Instance.new("Part"); root.Name="Root"; root.Size=Vector3.new(.1,.1,.1)
 root.CFrame=CFrame.new(); root.Transparency=1; root.Anchored=true
 root.CanCollide=false; root.CanTouch=false; root.CanQuery=false; root.Parent=model
 model.PrimaryPart=root
 return setmetatable({model=model,root=root,scale=scale,options=options,count=1,minY=math.huge},B)
end
function B:part(name,size,cf,color,material,shape,solid,class)
 assert(type(material)~="number","Material must be an Enum.Material, not a dimension")
 local p=Instance.new(class or "Part")
 p.Name=name; p.Size=size*self.scale
 p.CFrame=CFrame.new(cf.Position*self.scale)*(cf-cf.Position)
 p.Color=color or Color3.fromRGB(205,160,60); p.Material=material or Enum.Material.Metal
 if shape then p.Shape=shape end
 p.Anchored=true; p.CanCollide=solid==true; p.CanTouch=false; p.CanQuery=solid==true
 p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth
 p.Parent=self.model; self.count=self.count+1
 local x,y,z,r00,r01,r02,r10,r11,r12=p.CFrame:GetComponents()
 local half=.5*(math.abs(r10)*p.Size.X+math.abs(r11)*p.Size.Y+math.abs(r12)*p.Size.Z)
 self.minY=math.min(self.minY,y-half)
 return p
end
function B:box(name,size,cf,color,material,solid)
 return self:part(name,size,cf,color,material,Enum.PartType.Block,solid)
end
function B:ball(name,size,cf,color,material,solid)
 if type(size)=="number" then size=Vector3.new(size,size,size) end
 return self:part(name,size,cf,color,material,Enum.PartType.Ball,solid)
end
function B:cylinder(name,size,cf,color,material,solid)
 return self:part(name,size,cf,color,material,Enum.PartType.Cylinder,solid)
end
function B:line(name,a,c,thickness,depth,color,material,solid)
 local d=c-a; if d.Magnitude&lt;1e-7 then return end
 local up=d.Unit; local ref=Vector3.new(0,0,1)
 if math.abs(up:Dot(ref))&gt;.95 then ref=Vector3.new(1,0,0) end
 local right=up:Cross(ref).Unit; local back=right:Cross(up).Unit
 return self:box(name,Vector3.new(thickness,d.Magnitude,depth or thickness),CFrame.fromMatrix((a+c)*.5,right,up,back),color,material,solid)
end
function B:ring(name,cf,radius,thickness,color,segments,material)
 segments=segments or 20
 for i=0,segments-1 do
  local a=i*math.pi*2/segments; local c=(i+1)*math.pi*2/segments
  self:line(name.."_"..i,cf*Vector3.new(math.cos(a)*radius,math.sin(a)*radius,0),
   cf*Vector3.new(math.cos(c)*radius,math.sin(c)*radius,0),thickness,thickness,color,material)
 end
end
function B:wedge(name,size,cf,color,material,solid)
 return self:part(name,size,cf,color,material,nil,solid,"WedgePart")
end
function B:triangle(name,a,b,c,color,thickness,material)
 local ab,ac,bc=b-a,c-a,c-b
 if ab:Dot(ab)&gt;ac:Dot(ac) and ab:Dot(ab)&gt;bc:Dot(bc) then c,a=a,c
 elseif ac:Dot(ac)&gt;bc:Dot(bc) and ac:Dot(ac)&gt;ab:Dot(ab) then a,b=b,a end
 ab,ac,bc=b-a,c-a,c-b
 local normal=ac:Cross(ab); if normal.Magnitude&lt;1e-7 then return end
 local right=normal.Unit; local back=bc.Unit; local up=back:Cross(right).Unit
 local height=math.abs(ab:Dot(up)); thickness=thickness or .035
 local first,second=math.abs(ab:Dot(back)),math.abs(ac:Dot(back))
 if first&gt;1e-6 then self:wedge(name.."_A",Vector3.new(thickness,height,first),CFrame.fromMatrix((a+b)*.5,right,up,back),color,material) end
 if second&gt;1e-6 then self:wedge(name.."_B",Vector3.new(thickness,height,second),CFrame.fromMatrix((a+c)*.5,-right,up,-back),color,material) end
end
function B:finish()
 assert(self.count&lt;=(self.options.partBudget or 240),"Art part budget exceeded")
 if self.options.alignBase~=false and self.minY&lt;math.huge then
  for _,p in ipairs(self.model:GetChildren()) do
   if p:IsA("BasePart") and p~=self.root then p.CFrame=p.CFrame+Vector3.new(0,.04-self.minY,0) end
  end
 end
 self.model:SetAttribute("PartCount",self.count)
 self.model:PivotTo(self.options.cframe or CFrame.new())
 self.model.Parent=self.options.parent
 return self.model
end
return P
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_FreeModels_64_RelicItems"><Properties><string name="Name">RelicItems</string><ProtectedString name="Source">-- Original procedural collectible geometry: no paid services or external assets.
-- All parts are anchored, non-colliding display geometry built through Primitives.
local M={}
local V,CF,RGB=Vector3.new,CFrame.new,Color3.fromRGB
local METAL,GLASS,PLASTIC,NEON=Enum.Material.Metal,Enum.Material.Glass,Enum.Material.SmoothPlastic,Enum.Material.Neon
local TAU=math.pi*2

local function companionCube(b)
 local body,edge,panel,inset=RGB(98,106,113),RGB(178,188,195),RGB(153,164,170),RGB(50,58,66)
 local pink,darkPink=RGB(242,148,177),RGB(159,76,113)
 b:box("WeightedStorageCore",V(3.28,3.28,3.28),CF(0,1.9,0),body,METAL)
 -- Rounded-looking corner caps are layered independently from the six inset faces.
 for _,x in ipairs({-1,1}) do for _,y in ipairs({-1,1}) do for _,z in ipairs({-1,1}) do
  local p=V(x*1.57,1.9+y*1.57,z*1.57)
  b:box("CornerRecess",V(.66,.66,.66),CF(p),inset,METAL)
  b:box("CornerArmor",V(.52,.52,.52),CF(p+V(x*.09,y*.09,z*.09)),edge,METAL)
 end end end
 for _,a in ipairs({-1,1}) do for _,c in ipairs({-1,1}) do
  b:box("VerticalRecessSpine",V(.13,2.74,.13),CF(a*1.63,1.9,c*1.63),inset,METAL)
  b:box("HorizontalRecessSpineX",V(2.74,.13,.13),CF(0,1.9+a*1.63,c*1.63),inset,METAL)
  b:box("HorizontalRecessSpineZ",V(.13,.13,2.74),CF(a*1.63,1.9+c*1.63,0),inset,METAL)
 end end
 local faces={
  CF(0,1.9,-1.71)*CFrame.Angles(0,math.pi,0),CF(0,1.9,1.71),
  CF(-1.71,1.9,0)*CFrame.Angles(0,-math.pi/2,0),CF(1.71,1.9,0)*CFrame.Angles(0,math.pi/2,0),
  CF(0,3.61,0)*CFrame.Angles(-math.pi/2,0,0),CF(0,.19,0)*CFrame.Angles(math.pi/2,0,0),
 }
 for i,f in ipairs(faces) do
  local prefix="Face"..i
  b:box(prefix.."DarkInset",V(2.85,2.85,.10),f,inset,METAL)
  for _,x in ipairs({-1,1}) do for _,y in ipairs({-1,1}) do
   b:box(prefix.."Quadrant",V(1.22,1.22,.13),f*CF(x*.69,y*.69,.08),panel,METAL)
   b:box(prefix.."CornerBevel",V(.49,.49,.16),f*CF(x*1.29,y*1.29,.12)*CFrame.Angles(0,0,math.pi/4),edge,METAL)
   b:ball(prefix.."RecessedBolt",V(.085,.085,.035),f*CF(x*1.16,y*1.16,.165),inset,METAL)
  end end
  for _,s in ipairs({-1,1}) do
   b:box(prefix.."HorizontalArmor",V(2.36,.18,.15),f*CF(0,s*1.46,.10),edge,METAL)
   b:box(prefix.."VerticalArmor",V(.18,2.36,.15),f*CF(s*1.46,0,.10),edge,METAL)
  end
  b:cylinder(prefix.."EmblemPlate",V(.15,1.43,1.43),f*CF(0,0,.17)*CFrame.Angles(0,math.pi/2,0),RGB(186,189,190),METAL)
  b:ring(prefix.."EmblemRecess",f*CF(0,0,.265),.66,.065,inset,12,METAL)
  -- A fully three-dimensional heart emblem on every face, including top/bottom.
  b:ball(prefix.."HeartLobeLeft",V(.45,.45,.07),f*CF(-.19,.13,.294),pink,PLASTIC)
  b:ball(prefix.."HeartLobeRight",V(.45,.45,.07),f*CF(.19,.13,.294),pink,PLASTIC)
  b:triangle(prefix.."HeartTip",f*V(-.40,.13,.32),f*V(.40,.13,.32),f*V(0,-.47,.32),darkPink,.055,PLASTIC)
 end
end

local function cable(b,name,points,width,color)
 for i=1,#points-1 do b:line(name..i,points[i],points[i+1],width,width,color,METAL) end
end

local function protonPack(b)
 local black,charcoal,steel,brass=RGB(24,28,31),RGB(54,61,66),RGB(135,147,153),RGB(164,122,57)
 local red,blue=RGB(224,49,37),RGB(68,161,235)
 b:box("PackBackplate",V(2.5,3.82,.35),CF(0,2.46,.15),black,METAL)
 b:box("SteppedEquipmentBody",V(2.13,3.47,.67),CF(0,2.53,-.15),charcoal,METAL)
 b:box("UpperPowerBox",V(1.87,1.38,.28),CF(-.08,3.65,-.55),black,METAL)
 b:box("TopHandle",V(.90,.16,.25),CF(0,4.58,.05),steel,METAL)
 for _,s in ipairs({-1,1}) do
  b:box("CarryHandleBracket",V(.14,.33,.25),CF(s*.43,4.42,.05),black,METAL)
  b:box("BackplateSideRail",V(.16,3.48,.19),CF(s*1.17,2.49,.36),steel,METAL)
  b:box("LowerCornerArmor",V(.42,.28,.32),CF(s*.99,.75,-.03),black,METAL)
  -- Two broad straps remain visible from the player's side of the backpack.
  b:line("ShoulderStrapUpper",V(s*.72,4.1,.39),V(s*.73,3.30,.80),.22,.09,black,PLASTIC)
  b:line("ShoulderStrapLower",V(s*.73,3.30,.80),V(s*.69,1.1,.45),.22,.09,black,PLASTIC)
  b:box("StrapBuckle",V(.34,.34,.10),CF(s*.71,2.03,.71),steel,METAL)
  b:box("BuckleInset",V(.19,.19,.13),CF(s*.71,2.03,.735),black,METAL)
 end
 -- Concentric mechanical cyclotron, with exactly four red lens windows.
 local disc=CF(0,1.67,-.61)*CFrame.Angles(0,math.pi/2,0)
 b:cylinder("CyclotronOuterHousing",V(.24,2.22,2.22),disc,black,METAL)
 b:cylinder("CyclotronInsetFace",V(.29,1.93,1.93),disc,charcoal,METAL)
 b:ring("CyclotronRaisedRim",CF(0,1.67,-.80),1.055,.105,steel,20,METAL)
 b:ring("CyclotronInnerSeam",CF(0,1.67,-.815),.58,.038,black,16,METAL)
 b:cylinder("CyclotronCenter",V(.10,.56,.56),CF(0,1.67,-.83)*CFrame.Angles(0,math.pi/2,0),black,METAL)
 for i=0,3 do
  local a=math.pi/4+i*math.pi/2
  local p=V(math.cos(a)*.74,1.67+math.sin(a)*.74,-.84)
  b:ball("RedCyclotronLens"..i,V(.36,.36,.09),CF(p),red,NEON)
  b:ring("LensSteelBezel"..i,CF(p+V(0,0,-.045)),.205,.045,black,8,METAL)
 end
 -- Blue power-cell gauge, warning markings, and layered rear-side equipment.
 b:box("PowerCellFrame",V(.69,1.29,.22),CF(-.54,3.53,-.73),steel,METAL)
 b:box("PowerCellInset",V(.49,1.12,.24),CF(-.54,3.53,-.76),black,METAL)
 for i=0,7 do
  b:box("PowerCellSegment"..i,V(.34,.065,.04),CF(-.54,3.13+i*.115,-.91),i&lt;6 and blue or charcoal,i&lt;6 and NEON or METAL)
 end
 b:box("IonArmHousing",V(.58,1.6,.39),CF(.64,3.53,-.64),black,METAL)
 for i=0,4 do b:box("IonArmCoolingFin"..i,V(.71,.085,.52),CF(.64,2.96+i*.26,-.64),charcoal,METAL) end
 b:box("WarningLabelBacking",V(.63,.25,.035),CF(.62,4.00,-.93),RGB(218,190,83),PLASTIC)
 for i=0,3 do
  b:line("WarningStripe"..i,V(.36+i*.14,3.90,-.956),V(.47+i*.14,4.1,-.956),.045,.014,black,PLASTIC)
 end
 for _,s in ipairs({-1,1}) do
  for _,y in ipairs({.89,2.51,4.11}) do
   b:ball("HousingScrew",V(.075,.075,.04),CF(s*1.04,y,-.51),steel,METAL)
  end
 end
 for i=0,7 do
  b:box("SideVent"..i,V(.035,.11,.29),CF(-1.105,2.78+i*.12,-.17),black,METAL)
 end
 cable(b,"YellowInsulatedLead",{V(-1.13,3.82,-.57),V(-1.30,4.19,-.61),V(-1.07,4.39,-.61),V(.25,4.39,-.61),V(.45,4.15,-.69)},.075,RGB(205,171,64))
 cable(b,"RedAuxiliaryLead",{V(-.28,4.18,-.83),V(-.13,4.31,-.96),V(.1,4.24,-.97),V(.12,3.24,-.91),V(.38,3.02,-.87)},.055,red)
 -- Ribbed cable along the pack edge, clearly routed rather than floating.
 for i=0,17 do
  local a=-math.pi*.66+i/17*math.pi*1.18
  local p=V(-.25+math.cos(a)*1.17,2.42+math.sin(a)*1.66,-.67)
  local q=V(-.25+math.cos(a+.035)*1.17,2.42+math.sin(a+.035)*1.66,-.67)
  b:line("RibbedEdgeCable"..i,p,q,.14,.14,black,METAL)
 end
 -- Side-mounted neutrona wand, brass couplings, hand grip, and emitter muzzle.
 local wand=CF(1.69,2.60,-.20)*CFrame.Angles(0,0,-.12)
 b:box("WandMainBarrel",V(.38,2.21,.37),wand,charcoal,METAL)
 b:box("WandLowerGrip",V(.26,.89,.32),wand*CF(0,-1.02,.10),black,PLASTIC)
 b:box("WandTriggerGuard",V(.14,.48,.27),wand*CF(-.25,-.82,.08),steel,METAL)
 for i=0,6 do b:box("WandCoolingRib"..i,V(.44,.065,.43),wand*CF(0,-.09+i*.23,0),black,METAL) end
 for _,y in ipairs({-.50,.81,1.20}) do
  b:cylinder("WandBrassCoupling",V(.14,.49,.49),wand*CF(0,y,0)*CFrame.Angles(0,0,math.pi/2),brass,METAL)
 end
 b:cylinder("WandMuzzle",V(.20,.55,.55),wand*CF(0,1.39,0)*CFrame.Angles(0,0,math.pi/2),steel,METAL)
 b:cylinder("WandEmitterInset",V(.025,.32,.32),wand*CF(0,1.506,0)*CFrame.Angles(0,0,math.pi/2),black,METAL)
 b:box("WandRedToggle",V(.12,.16,.12),wand*CF(-.27,-.15,-.10),red,PLASTIC)
 local hose={}
 for i=0,13 do
  local t=i/13
  hose[#hose+1]=V(.79+1.0*t,.85-1.0*math.sin(t*math.pi)+.40*t,-.08)
 end
 cable(b,"MainWandHose",hose,.20,black)
 for i=1,#hose,2 do b:ball("HoseRib"..i,V(.23,.23,.23),CF(hose[i]),charcoal,METAL) end
 for _,p in ipairs({V(.79,.85,-.08),V(1.79,1.25,-.08)}) do
  b:cylinder("HoseBrassFitting",V(.28,.29,.29),CF(p)*CFrame.Angles(0,0,math.pi/2),brass,METAL)
 end
end

local stoneDefinitions={
 infinity_space={color=RGB(48,125,246),sides=8,height=2.3,rx=1.05,rz=.83,rings={{.0,.08},{.22,.83},{.73,1.0},{.90,.63},{1,.30}},rotation=math.pi/8},
 infinity_mind={color=RGB(248,210,57),sides=8,height=2.8,rx=.88,rz=.66,rings={{0,.03},{.20,.70},{.52,1},{.80,.70},{1,.03}},rotation=0},
 infinity_reality={color=RGB(208,39,63),sides=7,height=2.7,rx=.94,rz=.63,rings={{0,.08},{.21,.66},{.48,1},{.77,.60},{1,.02}},rotation=.22,irregular=true},
 infinity_power={color=RGB(154,73,231),sides=6,height=2.45,rx=1.06,rz=.95,rings={{0,.03},{.27,.83},{.64,1},{.86,.59},{1,.04}},rotation=math.pi/6},
 infinity_time={color=RGB(58,203,104),sides=10,height=2.3,rx=1.03,rz=.83,rings={{0,.08},{.23,.83},{.57,1},{.86,.71},{1,.27}},rotation=math.pi/10},
 infinity_soul={color=RGB(242,131,43),sides=8,height=2.6,rx=.94,rz=.73,rings={{0,.04},{.19,.68},{.54,1},{.84,.75},{1,.24}},rotation=math.pi/8},
}

local function infinityStone(b,key)
 local d=stoneDefinitions[key]
 if not d then return false end
 local rings={}
 for j,ring in ipairs(d.rings) do
  local points={}
  for i=0,d.sides-1 do
   local a=i*TAU/d.sides+d.rotation
   local modulation=d.irregular and (1+.13*math.sin(i*2.7+j*.4)) or 1
   local bend=d.irregular and .24*math.sin(ring[1]*math.pi*1.6) or 0
   points[i+1]=V(math.cos(a)*d.rx*ring[2]*modulation+bend,ring[1]*d.height,math.sin(a)*d.rz*ring[2]*modulation)
  end
  rings[j]=points
 end
 -- Closed crystalline geometry, with different cut proportions for all six stones.
 for j=1,#rings-1 do
  for i=1,d.sides do
   local k=i%d.sides+1
   local l=.09+((i*5+j*3)%9)*.039
   local shade=d.color:Lerp(RGB(255,255,255),l)
   local dark=d.color:Lerp(RGB(17,21,45),.13+((i+j)%3)*.055)
   local mat=(i+j)%4==0 and METAL or GLASS
   b:triangle("CrystalFacet"..j.."_"..i.."A",rings[j][i],rings[j+1][i],rings[j+1][k],shade,.025,mat)
   b:triangle("CrystalFacet"..j.."_"..i.."B",rings[j][i],rings[j+1][k],rings[j][k],dark,.025,GLASS)
  end
 end
 for _,j in ipairs({1,#rings}) do
  local centre=V(0,d.rings[j][1]*d.height,0)
  for i=1,d.sides do
   b:triangle("TerminalFacet"..j.."_"..i,centre,rings[j][i],rings[j][i%d.sides+1],d.color:Lerp(RGB(255,255,255),j==1 and .04 or .39),.025,GLASS)
  end
 end
 -- The narrow luminescent cut is embedded in the crystal, never a floating aura.
 local points=rings[3]
 local highlight=d.color:Lerp(RGB(255,255,255),.48)
 for i=1,d.sides do
  if i%3==0 then
   local k=i%d.sides+1
   b:line("IlluminatedGirdle"..i,points[i],points[k],.027,.027,highlight,NEON)
  end
 end
 b.model:SetAttribute("StoneType",key:sub(10))
 b.model:SetAttribute("CollectionFamily","InfinityStones")
 return true
end

function M.build(b,key)
 if key=="companion_cube" then companionCube(b)
 elseif key=="proton_pack" then protonPack(b)
 elseif stoneDefinitions[key] then return infinityStone(b,key)
 else return false end
 return true
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_FreeModels_64_WarriorModels"><Properties><string name="Name">WarriorModels</string><ProtectedString name="Source">-- Free, original native-part builders. No mesh service, textures or paid assets.
-- Front faces -Z. Figure sizes are collectible-sized; gods are scenic monuments.
local M = {}
local V, C, R = Vector3.new, CFrame.new, CFrame.Angles
local PI = math.pi
local METAL, NEON = Enum.Material.Metal, Enum.Material.Neon
local COL = Color3.fromRGB
local dark = COL(24, 23, 37)
local steel = COL(60, 63, 84)
local edge = COL(122, 127, 153)
local violet = COL(72, 43, 111)
local purple = COL(154, 73, 218)
local pink = COL(255, 93, 205)
local black = COL(8, 10, 18)
local gold = COL(219, 157, 39)
local paleGold = COL(255, 222, 120)
local goldShade = COL(125, 77, 18)
local ruby = COL(249, 45, 53)
local function box(b, n, x, y, z, sx, sy, sz, color, rot, material)
 return b:box(n, V(sx,sy,sz), C(x,y,z)*(rot or C()), color, material or METAL)
end
local function ball(b,n,x,y,z,sx,sy,sz,color,material)
 return b:ball(n,V(sx,sy,sz),C(x,y,z),color,material or METAL)
end
local function line(b,n,a,c,w,color,depth,material)
 return b:line(n,a,c,w,depth or w,color,material or METAL)
end
local function tri(b,n,a,c,d,color,t,material)
 return b:triangle(n,a,c,d,color,t or .045,material or METAL)
end
local function gem(b,n,x,y,z,r,depth,color)
 local tip=V(x,y,z-depth)
 for i=0,5 do
  local a=i*PI/3; local c=(i+1)*PI/3
  tri(b,n..i,tip,V(x+r*math.cos(a),y+r*math.sin(a),z),
   V(x+r*math.cos(c),y+r*math.sin(c),z),i%2==0 and color or color:Lerp(paleGold,.23),.025)
 end
end
local function horn(b,n,points,width,color,tipColor)
 for i=1,#points-1 do
  local w=width*(1-(i-1)/(#points-.25))
  line(b,n.."Segment"..i,points[i],points[i+1],w,color,w*.76)
  if i&lt;#points-1 then ball(b,n.."Joint"..i,points[i+1].X,points[i+1].Y,points[i+1].Z,w*.86,w*.86,w*.86,color) end
 end
 local p=points[#points]; local q=points[#points-1]
 local d=(p-q).Unit
 tri(b,n.."SharpTip",p-d*width*.7+V(width*.20,0,0),p-d*width*.7-V(width*.20,0,0),p+d*width*.42,tipColor or color,.045)
end
local function platedSegment(b,n,x,y,z,width,height,depth,color,trim)
 box(b,n.."JointCore",x,y,z,width*.76,height,depth*.76,dark)
 box(b,n.."Face",x,y,z-depth*.40,width*.78,height*.83,depth*.30,color)
 for _,s in ipairs({-1,1}) do
  box(b,n.."Bevel"..s,x+s*width*.42,y,z-depth*.26,width*.18,height*.84,depth*.37,
   s==-1 and trim or color,R(0,-s*.45,0))
 end
 box(b,n.."TopEdge",x,y+height*.40,z-depth*.37,width*.83,height*.095,depth*.25,trim)
end

local function armoredKnight(b,mega)
 local body=mega and COL(64,72,91) or violet
 local trim=mega and COL(131,145,159) or COL(132,112,161)
 local accent=mega and gold or purple
 local prefix=mega and "MegaKnight" or "PEKKA"
 -- Broad, fully segmented body with beveled individual armor courses.
 box(b,prefix.."TorsoCore",0,2.72,.06,1.48,1.26,.80,dark)
 box(b,prefix.."UpperChest",0,3.16,-.16,1.55,.28,.78,body,R(-.09,0,0))
 for _,s in ipairs({-1,1}) do
  box(b,prefix.."ChestHalf"..s,s*.37,2.95,-.43,.70,.52,.21,body,R(0,s*.12,-s*.06))
  box(b,prefix.."ChestRim"..s,s*.37,3.18,-.55,.75,.085,.07,trim,R(0,0,-s*.07))
  box(b,prefix.."ChestSeam"..s,s*.075,2.91,-.56,.035,.41,.035,trim)
  ball(b,prefix.."ChestBolt"..s,s*.60,3.06,-.58,.10,.10,.06,accent)
 end
 for row=0,2 do
  box(b,prefix.."AbdominalCourse"..row,0,2.58-row*.17,-.45,1.12-row*.12,.135,.19,body)
  box(b,prefix.."AbdominalRim"..row,0,2.64-row*.17,-.56,1.10-row*.12,.025,.045,trim)
 end
 box(b,prefix.."BackArmor",0,2.85,.47,1.37,.94,.19,body)
 box(b,prefix.."Belt",0,2.05,0,1.20,.20,.86,black)
 box(b,prefix.."BeltTrim",0,2.08,-.46,1.20,.13,.09,trim)
 box(b,prefix.."Buckle",0,2.08,-.55,.30,.24,.10,accent)
 for _,s in ipairs({-1,1}) do
  local x=s*.44
  box(b,prefix.."HipSkirt"..s,s*.56,1.88,.01,.55,.43,.78,body,R(0,0,-s*.15))
  box(b,prefix.."HipSkirtFace"..s,s*.55,1.88,-.43,.46,.30,.08,trim,R(0,0,-s*.15))
  platedSegment(b,prefix.."Thigh"..s,x,1.43,.05,.56,.71,.63,body,trim)
  ball(b,prefix.."KneeJoint"..s,x,1.04,.04,.43,.41,.43,dark)
  box(b,prefix.."KneeCap"..s,x,1.05,-.36,.63,.31,.24,body,R(-.10,0,0))
  box(b,prefix.."KneeEdge"..s,x,1.16,-.50,.58,.06,.07,trim)
  platedSegment(b,prefix.."Shin"..s,x,.65,.03,.53,.59,.60,body,trim)
  box(b,prefix.."Boot"..s,x,.25,-.18,.66,.35,.99,body)
  box(b,prefix.."Sole"..s,x,.085,-.18,.69,.10,1.03,black)
  for toe=0,2 do box(b,prefix.."ToePlate"..s.."_"..toe,x+(toe-1)*.18,.27,-.70,.16,.22,.10,trim) end
  ball(b,prefix.."ShoulderJoint"..s,s*.88,3.13,0,.56,.56,.56,dark)
  box(b,prefix.."ShoulderBase"..s,s*1.01,3.26,.01,.84,.46,.94,body,R(0,0,-s*.14))
  box(b,prefix.."ShoulderTop"..s,s*1.03,3.45,-.02,.76,.13,.88,trim,R(0,0,-s*.14))
  box(b,prefix.."ShoulderFrontLip"..s,s*1.03,3.21,-.48,.79,.24,.10,body)
  platedSegment(b,prefix.."UpperArm"..s,s*1.12,2.77,.02,.44,.57,.52,body,trim)
  ball(b,prefix.."Elbow"..s,s*1.17,2.43,0,.35,.35,.35,dark)
  if mega then
   -- Huge spiked fist gauntlets are the silhouette-defining feature.
   box(b,prefix.."WristCuff"..s,s*1.22,2.31,-.04,.72,.23,.73,trim)
   box(b,prefix.."Gauntlet"..s,s*1.25,1.96,-.12,.84,.68,.86,body)
   box(b,prefix.."GauntletBack"..s,s*1.25,2.02,-.57,.76,.49,.14,trim)
   for finger=0,3 do
    box(b,prefix.."Finger"..s.."_"..finger,s*1.25+(finger-1.5)*.18,1.83,-.58,.15,.35,.21,body)
    box(b,prefix.."Knuckle"..s.."_"..finger,s*1.25+(finger-1.5)*.18,2.08,-.68,.16,.16,.11,trim)
   end
   box(b,prefix.."Thumb"..s,s*.79,1.96,-.23,.20,.39,.32,body,R(0,0,s*.22))
   for spike=0,2 do
    local sx=s*1.25+(spike-1)*.24
    tri(b,prefix.."FistSpike"..s.."_"..spike,V(sx-.12,2.20,-.65),V(sx+.12,2.20,-.65),V(sx,2.60,-.71),edge,.12)
   end
   for rivet=0,1 do ball(b,prefix.."GauntletBolt"..s..rivet,s*1.25+(rivet-.5)*.51,2.23,-.60,.10,.10,.07,gold) end
  else
   platedSegment(b,prefix.."Forearm"..s,s*1.17,2.13,-.01,.53,.54,.59,body,trim)
   box(b,prefix.."WristCuff"..s,s*1.17,1.84,-.05,.57,.14,.63,trim)
   box(b,prefix.."Hand"..s,s*1.17,1.64,-.11,.43,.33,.47,body)
   for finger=0,3 do box(b,prefix.."Finger"..s..finger,s*1.17+(finger-1.5)*.09,1.63,-.38,.075,.25,.10,trim) end
  end
 end
 -- Layered hollow face opening, cheeks and separate helmet crest.
 box(b,prefix.."Neck",0,3.51,.04,.49,.27,.49,dark)
 if mega then
  b:cylinder(prefix.."RoundSteelHelmet",V(.88,1.12,1.12),C(0,3.98,.02)*R(0,0,PI/2),body,METAL)
  ball(b,prefix.."RoundedHelmetCrown",0,4.29,.02,1.10,.40,.94,body)
  for i=0,5 do
   local a=i*PI/3
   box(b,prefix.."HelmetNeckRim"..i,math.cos(a)*.45,3.62,.02+math.sin(a)*.45,.43,.09,.16,trim,R(0,-a+PI/2,0))
  end
 else box(b,prefix.."HelmetCore",0,3.98,.02,1.11,.90,.88,body) end
 box(b,prefix.."FaceVoid",0,3.97,-.47,.86,.43,.09,black)
 box(b,prefix.."Brow",0,4.22,-.50,1.01,.14,.21,trim,R(-.10,0,0))
 for _,s in ipairs({-1,1}) do
  box(b,prefix.."Cheek"..s,s*.47,3.87,-.44,.22,.55,.24,body,R(0,s*.20,s*.10))
  box(b,prefix.."Eye"..s,s*.22,4.03,-.603,.27,.065,.035,mega and paleGold or pink,R(0,0,-s*.12),NEON)
  box(b,prefix.."JawPlate"..s,s*.23,3.65,-.43,.49,.21,.26,trim,R(0,0,s*.07))
  ball(b,prefix.."HelmetRivet"..s,s*.40,4.29,-.53,.085,.085,.05,accent)
 end
 box(b,prefix.."NoseGuard",0,3.95,-.57,.12,.39,.15,body)
 if mega then
  box(b,prefix.."HelmetCrest",0,4.47,.01,.20,.33,.86,trim)
  for rib=0,3 do box(b,prefix.."HelmetCrestRib"..rib,0,4.65,-.30+rib*.20,.27,.08,.09,body) end
  for _,s in ipairs({-1,1}) do
   horn(b,prefix.."ShoulderSpike"..s,{V(s*1.16,3.45,.10),V(s*1.29,3.78,.13),V(s*1.40,3.96,.14)},.20,edge)
  end
 else
  for _,s in ipairs({-1,1}) do
   horn(b,prefix.."CurvedHorn"..s,{V(s*.47,4.26,.05),V(s*.76,4.48,.08),V(s*.88,4.87,.03),V(s*.74,5.21,-.04)},.30,purple,COL(226,154,255))
  end
  -- Real sharp blade geometry, double beveled rather than a rectangular slab.
  local sx=-1.65
  box(b,prefix.."SwordGrip",sx,1.48,-.34,.17,.65,.18,black)
  for wrap=0,4 do box(b,prefix.."SwordWrap"..wrap,sx,1.28+wrap*.11,-.35,.20,.045,.20,accent) end
  box(b,prefix.."SwordGuard",sx,1.85,-.34,.82,.17,.27,trim)
  ball(b,prefix.."SwordPommel",sx,1.10,-.34,.27,.22,.25,trim)
  local base,tip=2.02,4.69
  tri(b,prefix.."BladeLeft",V(sx-.36,base,-.34),V(sx,tip,-.34),V(sx,base,-.48),edge,.075)
  tri(b,prefix.."BladeRight",V(sx,base,-.48),V(sx,tip,-.34),V(sx+.36,base,-.34),COL(192,199,216),.075)
  tri(b,prefix.."BladeRearLeft",V(sx-.36,base,-.34),V(sx,base,-.20),V(sx,tip,-.34),COL(81,83,106),.055)
  tri(b,prefix.."BladeRearRight",V(sx,base,-.20),V(sx+.36,base,-.34),V(sx,tip,-.34),trim,.055)
  line(b,prefix.."BladeFuller",V(sx,2.16,-.50),V(sx,4.28,-.41),.055,purple,.035,NEON)
 end
end

local function ra(b)
 -- A gold avian god with individually layered swept blade feathers.
 local shell=COL(233,173,43)
 local lit=COL(255,224,126)
 local shade=COL(151,92,17)
 ball(b,"RaTorsoCore",0,10.4,.5,5.0,7.4,3.6,shade)
 for _,s in ipairs({-1,1}) do
  box(b,"RaSculptedPectoral"..s,s*1.08,12.21,-1.13,2.14,1.70,1.03,shell,R(0,s*.16,-s*.14))
  box(b,"RaPectoralBevel"..s,s*1.06,12.84,-1.73,2.01,.28,.18,lit,R(0,0,-s*.14))
  line(b,"RaClavicle"..s,V(s*.13,13.22,-1.36),V(s*2.08,13.42,-.87),.32,lit,.27)
  ball(b,"RaShoulder"..s,s*2.5,12.87,.18,1.67,1.8,2.0,shell)
  box(b,"RaHipArmor"..s,s*1.54,7.79,-.24,1.51,1.45,2.00,shell,R(0,0,-s*.20))
  for stripe=0,2 do box(b,"RaHipEdge"..s..stripe,s*1.54,8.27-stripe*.35,-1.30,1.40,.10,.13,lit,R(0,0,-s*.20)) end
 end
 for row=0,5 do
  local w=3.42-row*.30
  box(b,"RaAbdominalScale"..row,0,11.08-row*.54,-1.34,w,.51,.45,row%2==0 and shell or gold)
  box(b,"RaAbdominalLip"..row,0,11.29-row*.54,-1.59,w*.94,.075,.10,lit)
 end
 gem(b,"RaHeart",0,12.28,-1.87,.59,.33,ruby)
 b:ring("RaHeartGoldSocket",C(0,12.28,-1.85),.66,.12,lit,12,METAL)
 -- Long segmented neck, hawk face and actual hooked beak.
 line(b,"RaNeckCore",V(0,13.10,.20),V(0,16.76,-.54),1.56,shade,1.45)
 for row=0,5 do
  local y=13.48+row*.53; local z=.1-row*.11
  box(b,"RaNeckCollar"..row,0,y,z,1.78-row*.045,.35,1.63,shell,R(-.17,0,0))
  box(b,"RaNeckFrontScale"..row,0,y,z-.92,1.55-row*.045,.25,.14,lit,R(-.17,0,0))
 end
 box(b,"RaHeadCore",0,17.35,-.65,2.08,1.72,2.28,shell,R(-.10,0,0))
 box(b,"RaCrownCenter",0,18.54,-.63,.49,1.18,1.85,lit,R(-.12,0,0))
 for _,s in ipairs({-1,1}) do
  box(b,"RaHeadCheek"..s,s*.97,17.12,-1.05,.43,1.04,1.58,shade,R(0,s*.13,s*.09))
  box(b,"RaEyeShadow"..s,s*.73,17.64,-1.83,.63,.34,.14,black,R(0,0,-s*.16))
  box(b,"RaRubyEye"..s,s*.74,17.66,-1.92,.42,.12,.07,ruby,R(0,0,-s*.16),NEON)
  box(b,"RaEyeBrow"..s,s*.73,17.93,-1.94,.81,.17,.19,lit,R(0,0,-s*.16))
  tri(b,"RaCheekBlade"..s,V(s*.96,17.43,-1.63),V(s*1.69,16.43,-.74),V(s*.80,16.42,-1.57),gold,.20)
  horn(b,"RaRoyalHorn"..s,{V(s*.75,18.08,-.12),V(s*1.36,18.95,.06),V(s*1.64,20.27,.20),V(s*1.30,21.30,.22)},.57,lit)
 end
 box(b,"RaBeakRoot",0,17.20,-2.07,.93,.69,.81,lit)
 tri(b,"RaUpperBeak",V(-.48,17.47,-2.20),V(.48,17.47,-2.20),V(0,17.08,-3.28),lit,.43)
 tri(b,"RaHookedBeak",V(-.25,17.17,-3.07),V(.25,17.17,-3.07),V(0,16.40,-2.97),gold,.27)
 line(b,"RaBeakMouth",V(-.33,16.94,-2.58),V(.33,16.94,-2.58),.075,black)
 box(b,"RaLowerBeak",0,16.73,-2.24,.75,.26,1.07,shade,R(.09,0,0))
 gem(b,"RaCrownRuby",0,18.25,-1.83,.29,.17,ruby)
 for _,s in ipairs({-1,1}) do
  -- Each wing has an arched structural arm and separate overlapping blades.
  local root=V(s*2.35,13.10,.68); local joint=V(s*6.6,16.48,.90)
  line(b,"RaWingUpperBone"..s,root,joint,.68,lit,.76)
  line(b,"RaWingLeadingEdge"..s,joint,V(s*13.45,20.45,1.17),.50,lit,.60)
  tri(b,"RaWingInnerArmor"..s,V(s*2.85,13.31,1.54),V(s*6.6,16.20,1.54),V(s*6.45,10.35,1.77),shade,.12)
  tri(b,"RaWingOuterArmor"..s,V(s*6.6,16.20,1.54),V(s*12.9,19.52,1.54),V(s*6.45,10.35,1.77),gold,.12)
  for i=0,10 do
   local t=i/10
   local a=V(s*(3.10+t*8.80),13.7+t*5.91,.77+t*.30)
   local tip=V(s*(6.0+t*10.20),8.0+t*12.0,1.7+math.sin(t*PI)*.36)
   local perp=V(s*.64,.36,0)
   local center=a:Lerp(tip,.50)-V(0,0,.11)
   tri(b,"RaPrimaryFeather"..s.."_"..i,a-perp,tip,center,i%2==0 and shell or gold,.13)
   tri(b,"RaPrimaryFeatherRidge"..s.."_"..i,center,tip,a+perp,lit,.12)
   line(b,"RaPrimaryFeatherShaft"..s.."_"..i,a,tip,.09,shade,.11)
  end
  for i=0,6 do
   local t=i/6
   local a=V(s*(2.8+t*5.8),13.18+t*3.45,.37)
   local tip=V(s*(5.3+t*5.65),10.8+t*4.0,.37)
   tri(b,"RaUpperCoverFeather"..s.."_"..i,a-V(s*.36,0,0),tip,a+V(s*.36,.24,0),lit,.16)
   line(b,"RaUpperCoverRidge"..s.."_"..i,a,tip,.09,goldShade,.07)
  end
  for i=0,4 do
   local a=V(s*(3.15+i*.91),13.34+i*.54,.04)
   local c=V(s*(4.35+i*.91),12.20+i*.60,.04)
   tri(b,"RaRaisedWingCover"..s..i,a-V(s*.38,0,0),c,a+V(s*.38,.28,0),shell,.17)
  end
  -- Open talons and armored legs rather than generic pedestals.
  line(b,"RaThigh"..s,V(s*1.24,7.26,.40),V(s*1.91,5.00,.26),1.15,shell,1.18)
  ball(b,"RaKnee"..s,s*1.91,5.00,.19,1.35,1.23,1.44,gold)
  line(b,"RaShin"..s,V(s*1.91,4.83,.27),V(s*2.10,2.20,-.30),.83,shell,.98)
  for row=0,4 do box(b,"RaShinScale"..s..row,s*(1.97+row*.035),4.50-row*.44,-.43-row*.08,.94,.22,.22,lit) end
  box(b,"RaAnkle"..s,s*2.11,1.93,-.32,1.12,.53,1.13,shade)
  for toe=0,2 do
   local tx=s*2.1+(toe-1)*.52
   line(b,"RaToe"..s..toe,V(tx,1.83,-.53),V(tx,1.20,-2.10),.35,shell,.40)
   tri(b,"RaTalon"..s..toe,V(tx-.17,1.37,-2.00),V(tx+.17,1.37,-2.00),V(tx,.81,-2.83),lit,.20)
  end
  line(b,"RaRearToe"..s,V(s*2.14,1.87,-.04),V(s*2.30,1.13,1.38),.32,gold,.34)
 end
 -- A sweeping armored tail is visible behind and below the body.
 local tail={V(0,7.57,1.21),V(0,6.08,3.19),V(0,4.81,5.76),V(0,3.35,7.20),V(0,2.28,8.41)}
 for i=1,#tail-1 do
  line(b,"RaTailSegment"..i,tail[i],tail[i+1],1.10-i*.17,gold,1.24-i*.19)
  local p=tail[i]:Lerp(tail[i+1],.5)
  box(b,"RaTailRidge"..i,p.X,p.Y+.34,p.Z,.58,.32,.60,lit,R(-.31,0,0))
 end
 for _,s in ipairs({-1,1}) do
  tri(b,"RaTailFin"..s,V(0,2.59,7.88),V(s*2.23,1.52,9.63),V(0,1.64,9.42),shell,.18)
 end
end

local function obelisk(b)
 local blue=COL(42,92,159)
 local mid=COL(66,128,196)
 local light=COL(112,177,227)
 local shade=COL(24,54,108)
 -- Broad tapered torso assembled as four sculpted armor courses.
 box(b,"ObeliskTorsoShadow",0,11.57,.40,5.72,7.15,3.04,shade)
 for _,s in ipairs({-1,1}) do
  box(b,"ObeliskPectoralCore"..s,s*1.77,13.55,-1.14,3.41,2.52,1.61,blue,R(0,s*.15,-s*.10))
  local pectoralRim={V(s*.28,14.57,-1.78),V(s*2.56,14.71,-1.69),V(s*3.34,13.76,-1.58),
   V(s*3.06,12.78,-1.73),V(s*1.38,12.37,-1.93),V(s*.28,12.79,-1.88)}
  local peak=V(s*1.63,13.55,-2.32)
  for i=1,#pectoralRim do
   tri(b,"ObeliskSculptedPectoral"..s.."_"..i,peak,pectoralRim[i],pectoralRim[i%#pectoralRim+1],
    i%2==0 and blue or blue:Lerp(mid,.34),.07)
  end
  box(b,"ObeliskPectoralUpperBevel"..s,s*1.77,14.58,-1.81,3.26,.42,.29,mid,R(0,0,-s*.10))
  box(b,"ObeliskPectoralOuterBevel"..s,s*3.04,13.40,-1.56,.55,2.14,.47,mid,R(0,s*.31,-s*.10))
  box(b,"ObeliskPectoralLowerRidge"..s,s*1.79,12.54,-1.85,2.85,.20,.24,light,R(0,0,s*.09))
  line(b,"ObeliskCollarBone"..s,V(s*.15,14.98,-1.04),V(s*3.43,15.18,-.67),.55,mid,.56)
  box(b,"ObeliskSideRib"..s,s*2.54,11.07,-.39,.97,2.81,1.57,blue,R(0,0,-s*.12))
  for row=0,3 do box(b,"ObeliskSerratus"..s..row,s*(2.36-row*.11),11.98-row*.57,-1.31,.84,.36,.26,mid,R(0,0,s*.20)) end
 end
 for row=0,3 do
  local w=1.38-row*.13
  for _,s in ipairs({-1,1}) do
   box(b,"ObeliskAbdominalMuscle"..s..row,s*(w*.52+.09),11.85-row*.76,-1.49,w,.64,.51,blue,R(0,s*.07,0))
   box(b,"ObeliskAbdominalEdge"..s..row,s*(w*.52+.09),12.10-row*.76,-1.77,w*.87,.095,.11,mid)
  end
 end
 box(b,"ObeliskPelvis",0,8.70,.27,4.32,1.40,2.90,shade)
 box(b,"ObeliskBelt",0,9.06,-.21,4.67,.47,3.08,blue)
 tri(b,"ObeliskBeltPoint",V(-1.10,9.22,-1.85),V(1.10,9.22,-1.85),V(0,7.57,-1.72),mid,.30)
 for _,s in ipairs({-1,1}) do
  -- Heavy plated thighs and strong clawed feet.
  local x=s*1.45
  box(b,"ObeliskHipBlade"..s,s*2.15,8.43,.15,1.24,1.65,3.13,blue,R(0,0,-s*.15))
  platedSegment(b,"ObeliskThigh"..s,x,6.94,.31,1.92,2.65,2.16,blue,mid)
  box(b,"ObeliskThighRidge"..s,x,7.06,-1.07,.31,2.20,.19,light,R(0,0,s*.08))
  ball(b,"ObeliskKneeJoint"..s,x,5.23,.20,1.56,1.56,1.71,shade)
  box(b,"ObeliskKneeShield"..s,x,5.29,-1.00,2.01,1.00,.49,mid,R(-.09,0,0))
  tri(b,"ObeliskKneePoint"..s,V(x-.86,5.34,-1.31),V(x+.86,5.34,-1.31),V(x,4.51,-1.39),blue,.23)
  platedSegment(b,"ObeliskShin"..s,x,3.43,.31,1.80,2.67,2.18,blue,mid)
  box(b,"ObeliskShinSpine"..s,x,3.48,-1.10,.31,2.41,.18,light)
  for row=0,2 do box(b,"ObeliskShinCourse"..s..row,x,4.21-row*.64,-1.16,1.56,.12,.10,mid) end
  box(b,"ObeliskFoot"..s,x,1.35,-.29,2.17,1.25,3.30,blue)
  box(b,"ObeliskHeel"..s,x,1.08,1.13,1.79,.89,.63,shade)
  for toe=0,2 do
   local tx=x+(toe-1)*.61
   box(b,"ObeliskToe"..s..toe,tx,1.30,-1.94,.54,.75,.63,mid)
   tri(b,"ObeliskToeClaw"..s..toe,V(tx-.24,1.52,-2.10),V(tx+.24,1.52,-2.10),V(tx,.89,-2.70),light,.20)
  end
  -- Oversized shoulder volumes, pointed pauldron and layered upper arms.
  ball(b,"ObeliskShoulder"..s,s*4.10,14.20,.11,3.32,3.47,3.26,blue)
  box(b,"ObeliskShoulderCap"..s,s*4.11,15.38,.01,3.39,.74,3.31,mid,R(0,0,-s*.14))
  box(b,"ObeliskShoulderFrontPlate"..s,s*4.12,14.49,-1.61,2.65,1.49,.32,blue,R(0,0,-s*.12))
  for plate=0,2 do
   local px=s*(3.40+plate*.67)
   tri(b,"ObeliskShoulderBevelFacet"..s..plate,V(px-s*.35,15.15,-1.70),V(px+s*.35,15.05,-1.70),V(px,14.07,-1.91),mid,.08)
  end
  tri(b,"ObeliskShoulderSpike"..s,V(s*3.40,15.52,-.05),V(s*4.91,15.31,-.05),V(s*5.01,17.57,-.05),mid,.65)
  box(b,"ObeliskBicepCore"..s,s*4.72,12.17,.12,2.12,3.04,2.27,shade,R(0,0,s*.07))
  ball(b,"ObeliskBicepMuscle"..s,s*4.73,12.40,-.73,2.07,2.66,1.71,blue)
  box(b,"ObeliskUpperArmOuterPlate"..s,s*5.53,12.30,.16,.35,2.48,1.88,mid,R(0,0,s*.07))
  ball(b,"ObeliskElbow"..s,s*4.90,10.61,.17,1.63,1.53,1.73,shade)
  box(b,"ObeliskElbowShield"..s,s*5.47,10.62,-.05,1.38,1.09,1.57,blue,R(0,0,-s*.28))
  box(b,"ObeliskForearmCore"..s,s*5.06,9.40,-.13,2.10,2.05,2.37,blue,R(-.09,0,0))
  box(b,"ObeliskForearmFace"..s,s*5.06,9.52,-1.38,1.95,1.79,.31,mid,R(-.09,0,0))
  for rib=0,2 do box(b,"ObeliskForearmRib"..s..rib,s*5.06,10.16-rib*.55,-1.61,1.74,.13,.16,light) end
  box(b,"ObeliskWristCuff"..s,s*5.06,8.28,-.28,2.27,.43,2.50,shade)
  box(b,"ObeliskFistCore"..s,s*5.04,7.23,-.45,2.55,1.88,2.56,blue)
  box(b,"ObeliskFistBackPlate"..s,s*5.04,7.58,-1.84,2.39,1.12,.37,mid)
  for finger=0,3 do
   local fx=s*5.04+(finger-1.5)*.56
   box(b,"ObeliskFinger"..s..finger,fx,6.94,-1.79,.49,1.17,.49,blue)
   box(b,"ObeliskKnuckle"..s..finger,fx,7.77,-1.99,.50,.51,.38,light)
   box(b,"ObeliskFingerJoint"..s..finger,fx,6.99,-2.05,.46,.095,.065,shade)
  end
  box(b,"ObeliskThumb"..s,s*3.55,7.25,-.70,.71,1.32,.95,mid,R(0,0,s*.27))
 end
 -- Detailed demonic face with separate teeth, brows and long curved horns.
 box(b,"ObeliskNeck",0,15.67,.31,2.24,1.37,2.18,shade)
 box(b,"ObeliskHeadCore",0,17.34,-.02,3.40,2.84,2.52,blue)
 box(b,"ObeliskCrown",0,18.64,.08,2.91,.62,2.44,mid)
 box(b,"ObeliskFaceVoid",0,17.22,-1.33,2.64,1.64,.21,shade)
 for _,s in ipairs({-1,1}) do
  box(b,"ObeliskCheekBone"..s,s*1.23,17.12,-1.34,.80,1.56,.65,mid,R(0,s*.18,s*.16))
  box(b,"ObeliskBrow"..s,s*.73,18.03,-1.61,1.41,.44,.43,mid,R(0,0,-s*.16))
  box(b,"ObeliskEyeSocket"..s,s*.72,17.75,-1.61,1.01,.34,.20,black,R(0,0,-s*.13))
  box(b,"ObeliskRedEye"..s,s*.72,17.77,-1.76,.69,.14,.07,ruby,R(0,0,-s*.13),NEON)
  box(b,"ObeliskJawSide"..s,s*.93,16.25,-1.30,.71,.79,.79,blue,R(0,0,s*.18))
  line(b,"ObeliskCheekScar"..s,V(s*1.36,17.51,-1.74),V(s*1.05,16.87,-1.78),.12,light,.08)
  horn(b,"ObeliskTempleHorn"..s,{V(s*1.35,18.16,.09),V(s*2.15,18.92,.23),V(s*2.74,20.42,.39),V(s*2.65,22.11,.36),V(s*2.19,23.23,.12)},.81,mid,light)
  horn(b,"ObeliskRearHorn"..s,{V(s*1.12,18.40,1.02),V(s*1.57,19.44,1.37),V(s*1.43,20.55,1.55)},.51,blue,mid)
 end
 tri(b,"ObeliskNoseBridge",V(-.31,18.20,-1.69),V(.31,18.20,-1.69),V(0,17.12,-2.08),light,.25)
 box(b,"ObeliskMouthVoid",0,16.72,-1.74,1.73,.47,.20,black)
 for tooth=0,5 do
  local x=(tooth-2.5)*.25
  tri(b,"ObeliskUpperTooth"..tooth,V(x-.095,16.94,-1.89),V(x+.095,16.94,-1.89),V(x,16.65,-1.91),COL(201,224,235),.11)
 end
 for tooth=0,4 do
  local x=(tooth-2)*.25
  tri(b,"ObeliskLowerTooth"..tooth,V(x-.09,16.50,-1.89),V(x+.09,16.50,-1.89),V(x,16.71,-1.91),COL(167,197,218),.10)
 end
 box(b,"ObeliskChin",0,16.03,-1.50,1.46,.43,.64,mid)
 tri(b,"ObeliskChinPoint",V(-.48,16.01,-1.86),V(.48,16.01,-1.86),V(0,15.46,-1.85),light,.21)
 for rib=0,4 do
  box(b,"ObeliskBackSpine"..rib,0,14.66-rib*1.12,2.18,.63,.65,.46,mid,R(.11,0,0))
  for _,s in ipairs({-1,1}) do
   box(b,"ObeliskBackRib"..s..rib,s*(1.61-rib*.13),14.56-rib*1.12,2.00,2.39-rib*.19,.28,.33,blue,R(0,0,s*.17))
  end
 end
end

function M.build(b,key)
 if key=="pekka" then armoredKnight(b,false)
 elseif key=="mega_knight" then armoredKnight(b,true)
 elseif key=="winged_dragon_ra" then ra(b)
 elseif key=="obelisk_tormentor" then obelisk(b)
 else return false end
 return true
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_FreeModels_64_WorkshopBuildings"><Properties><string name="Name">WorkshopBuildings</string><ProtectedString name="Source">-- Detailed original native geometry: no external meshes, paid services, or textures.
-- The host supplies invisible structural collision proxies where required.
local M = {}
local V, C, A = Vector3.new, CFrame.new, CFrame.Angles
local METAL, WOOD, STONE = Enum.Material.Metal, Enum.Material.WoodPlanks, Enum.Material.Slate
local PLASTIC, NEON, FABRIC = Enum.Material.SmoothPlastic, Enum.Material.Neon, Enum.Material.Fabric
local charcoal = Color3.fromRGB(27, 32, 43)
local steel = Color3.fromRGB(104, 123, 142)
local lightSteel = Color3.fromRGB(183, 200, 207)
local gold = Color3.fromRGB(218, 162, 46)
local paleGold = Color3.fromRGB(255, 218, 112)
local blue = Color3.fromRGB(29, 101, 208)
local lightBlue = Color3.fromRGB(71, 184, 255)
local cedar = Color3.fromRGB(130, 63, 34)
local redWood = Color3.fromRGB(151, 40, 35)
local ivory = Color3.fromRGB(239, 218, 175)

local function box(b, name, x, y, z, sx, sy, sz, color, material, cf)
 return b:box(name, V(sx, sy, sz), (cf or C()) * C(x, y, z), color, material)
end
local function cyl(b, name, x, y, z, height, diameter, color, material, cf)
 return b:cylinder(name, V(height, diameter, diameter), (cf or C()) * C(x, y, z) * A(0, 0, math.pi / 2), color, material)
end
local function line(b, name, a, c, thickness, color, material, cf, depth)
 cf = cf or C()
 return b:line(name, cf * a, cf * c, thickness, depth or thickness, color, material)
end
local function tri(b, name, a, c, d, color, material, cf, depth)
 cf = cf or C()
 b:triangle(name, cf * a, cf * c, cf * d, color, depth or .08, material)
end
local function quad(b, name, a, c, d, e, color, material, cf, depth)
 tri(b, name .. "A", a, c, d, color, material, cf, depth)
 tri(b, name .. "B", a, d, e, color, material, cf, depth)
end

local function detailedWorkbench(b)
 local oak = Color3.fromRGB(145, 96, 51)
 local oakLight = Color3.fromRGB(185, 135, 76)
 local handle = Color3.fromRGB(62, 44, 32)
 -- Five separate worn-looking top boards and a dark rounded-off perimeter.
 box(b, "SteelApron", 0, 3.35, 0, 10.2, .48, 4, charcoal, METAL)
 for index = 0, 4 do
  box(b, "OakWorktopBoard_" .. index, 0, 3.73, -1.64 + index * .82, 10.5, .38, .78,
   index % 2 == 0 and oakLight or oak, WOOD)
 end
 for _, side in ipairs({-1, 1}) do
  box(b, "EndCap_" .. side, side * 5.25, 3.66, 0, .18, .5, 4.22, steel, METAL)
  for _, z in ipairs({-1.6, 1.6}) do
   box(b, "BenchLeg_" .. side .. "_" .. z, side * 4.5, 1.7, z, .44, 3.1, .44, charcoal, METAL)
   box(b, "RubberFoot_" .. side .. "_" .. z, side * 4.5, .16, z, .8, .24, .8, charcoal, PLASTIC)
   box(b, "LegCollar_" .. side .. "_" .. z, side * 4.5, 2.7, z, .56, .32, .56, steel, METAL)
   cyl(b, "ApronBolt_" .. side .. "_" .. z, side * 4.7, 3.97, z, .08, .16, lightSteel, METAL)
  end
  line(b, "DiagonalLegBrace_" .. side, V(side * 4.5, .6, -1.6), V(side * 4.5, 2.85, 1.6), .21, steel, METAL)
 end
 box(b, "LowerShelfFrame", 0, .86, 0, 9, .26, 3.4, charcoal, METAL)
 for index = -2, 2 do
  box(b, "LowerShelfSlat_" .. index, 0, 1.06, index * .62, 8.7, .16, .54, oak, WOOD)
 end
 -- Open shelves and individually outlined drawers make the underside readable.
 box(b, "DrawerCabinet", -2.8, 2.37, .1, 2.9, 1.65, 3.1, charcoal, METAL)
 for row = 0, 2 do
  local y = 1.86 + row * .52
  box(b, "InsetDrawer_" .. row, -2.8, y, -1.51, 2.62, .43, .16, steel, METAL)
  box(b, "DrawerLabel_" .. row, -3.45, y, -1.61, .4, .15, .035, ivory, PLASTIC)
  box(b, "DrawerHandle_" .. row, -2.55, y, -1.7, .95, .09, .18, lightSteel, METAL)
 end
 -- Back tool rack: two posts, slatted backing, organized tools, raised hooks.
 for _, x in ipairs({-4.65, 4.65}) do
  box(b, "ToolRackPost_" .. x, x, 4.65, 1.65, .22, 2.4, .26, charcoal, METAL)
 end
 box(b, "ToolRackFrame", 0, 5.15, 1.72, 9.6, 1.65, .22, steel, METAL)
 box(b, "ToolRackInset", 0, 5.15, 1.55, 9.1, 1.28, .14, charcoal, METAL)
 for row = 0, 2 do
  for index = -5, 5 do
   box(b, "PegHole_" .. row .. "_" .. index, index * .76, 4.75 + row * .37, 1.46, .1, .1, .035, steel, METAL)
  end
 end
 for index = 0, 2 do
  local x = -3.35 + index * .85
  line(b, "WrenchStem_" .. index, V(x, 4.5, 1.29), V(x, 5.48, 1.29), .13, lightSteel, METAL)
  line(b, "WrenchJawLeft_" .. index, V(x, 5.48, 1.29), V(x - .21, 5.72, 1.29), .13, lightSteel, METAL)
  line(b, "WrenchJawRight_" .. index, V(x, 5.48, 1.29), V(x + .21, 5.72, 1.29), .13, lightSteel, METAL)
  b:ring("WrenchClosedEnd_" .. index, C(x, 4.5, 1.29), .15, .07, lightSteel, 8, METAL)
 end
 for index = 0, 2 do
  local x = .65 + index * .7
  box(b, "DriverHandle_" .. index, x, 4.81, 1.29, .21, .58, .22, index == 1 and blue or redWood, PLASTIC)
  box(b, "DriverShaft_" .. index, x, 5.37, 1.29, .07, .58, .07, lightSteel, METAL)
  box(b, "DriverTip_" .. index, x, 5.68, 1.29, .12, .1, .04, steel, METAL)
 end
 line(b, "HammerHandle", V(3.4, 4.48, 1.25), V(3.4, 5.5, 1.25), .16, oakLight, WOOD)
 box(b, "HammerHead", 3.4, 5.58, 1.25, .86, .28, .32, steel, METAL)
 -- A working-looking bench vise, rotated jaws and a long screw handle.
 box(b, "ViseMount", 3.6, 4.05, -1.15, 1.45, .24, 1.1, blue, METAL)
 box(b, "ViseBody", 3.6, 4.4, -1.15, 1.14, .5, .86, blue, METAL)
 for _, x in ipairs({3.15, 4.05}) do
  box(b, "ViseJaw_" .. x, x, 4.8, -1.15, .22, .55, 1.05, steel, METAL)
  box(b, "ViseJawFace_" .. x, x + (x &lt; 3.6 and .13 or -.13), 4.8, -1.15, .07, .35, .86, charcoal, METAL)
 end
 line(b, "ViseScrew", V(2.67, 4.4, -1.15), V(4.63, 4.4, -1.15), .16, lightSteel, METAL)
 line(b, "ViseHandle", V(4.72, 3.96, -1.15), V(4.72, 4.8, -1.15), .1, lightSteel, METAL)
 -- Blueprint, measured diagram, paint pot and a small parts tray on the top.
 box(b, "BlueprintPaper", -.2, 3.96, -.3, 3, .035, 2.1, Color3.fromRGB(40, 106, 157), PLASTIC)
 for index = -2, 2 do
  box(b, "BlueprintGridX_" .. index, -.2 + index * .5, 3.983, -.3, .018, .012, 1.9, lightBlue, PLASTIC)
  box(b, "BlueprintGridZ_" .. index, -.2, 3.983, -.3 + index * .38, 2.8, .012, .018, lightBlue, PLASTIC)
 end
 b:ring("BlueprintMachineOutline", C(-.2, 4, -.3) * A(math.pi / 2, 0, 0), .57, .045, ivory, 12, PLASTIC)
 box(b, "PartsTray", -3.6, 4.02, -.2, 1.5, .16, 1.2, steel, METAL)
 for _, x in ipairs({-4.32, -2.88}) do box(b, "PartsTraySide_" .. x, x, 4.16, -.2, .08, .22, 1.2, charcoal, METAL) end
 for index = 0, 3 do cyl(b, "LooseBolt_" .. index, -4.05 + index * .3, 4.16, -.22, .18, .15, lightSteel, METAL) end
 cyl(b, "PaintTin", -1.85, 4.22, 1, .5, .43, redWood, METAL)
 cyl(b, "PaintTinLid", -1.85, 4.5, 1, .07, .48, steel, METAL)
 box(b, "BenchFrontAccent", 0, 3.39, -2.08, 9.5, .08, .04, gold, METAL)
end

local function powerConsole(b)
 local purple = Color3.fromRGB(140, 70, 213)
 local cyan = Color3.fromRGB(61, 222, 255)
 box(b, "ConsoleFoot", 0, .22, 0, 6.5, .44, 4, charcoal, METAL)
 box(b, "ConsoleFootTrim", 0, .48, 0, 6.2, .12, 3.7, gold, METAL)
 for _, side in ipairs({-1, 1}) do
  local frame = C(side * 2.6, 2.2, 0)
  box(b, "TaperedSupport_" .. side, 0, 0, 0, .72, 3.2, 2.9, charcoal, METAL, frame)
  box(b, "SupportBlueInset_" .. side, side * .39, .1, -.2, .08, 2.1, 1.8, blue, METAL, frame)
  for index = 0, 3 do
   box(b, "SupportVent_" .. side .. "_" .. index, side * .45, -.6 + index * .32, -.15, .06, .1, 1.25, lightSteel, METAL, frame)
  end
 end
 box(b, "RecessedCabinet", 0, 1.9, .3, 4.6, 2.6, 2.3, steel, METAL)
 box(b, "CabinetFront", 0, 1.9, -.9, 4, 2, .12, charcoal, METAL)
 for index = -2, 2 do box(b, "FrontHeatSink_" .. index, index * .58, 1.8, -1.02, .16, 1.45, .12, steel, METAL) end
 box(b, "StatusLight", 1.6, 2.6, -1.02, .23, .1, .08, cyan, NEON)
 local panel = C(0, 3.7, -.15) * A(math.rad(-19), 0, 0)
 box(b, "AngledControlDeck", 0, 0, 0, 6.5, .45, 3.8, charcoal, METAL, panel)
 box(b, "DeckGoldBorder", 0, .25, 0, 6.2, .06, 3.5, gold, METAL, panel)
 box(b, "DeckBlueInset", 0, .3, 0, 5.9, .06, 3.2, Color3.fromRGB(24, 43, 77), METAL, panel)
 for index = 0, 7 do
  local x, z = -2.23 + (index % 4) * 1.48, -.91 + math.floor(index / 4) * 1.1
  box(b, "PowerButtonSocket_" .. index, x, .4, z, 1.05, .12, .77, steel, METAL, panel)
  box(b, "PowerButton_" .. index, x, .5, z, .87, .15, .6,
   ({blue, redWood, gold, purple, cyan, Color3.fromRGB(85, 179, 113), ivory, lightBlue})[index + 1], PLASTIC, panel)
  box(b, "PowerButtonLight_" .. index, x, .59, z - .19, .48, .02, .045, paleGold, NEON, panel)
 end
 -- Screen standing behind the control deck, with real bevelled side cheeks.
 local screen = C(0, 5.08, 1.05) * A(math.rad(12), 0, 0)
 box(b, "MonitorOuterFrame", 0, 0, 0, 5.25, 2.9, .4, charcoal, METAL, screen)
 box(b, "MonitorGoldBezel", 0, 0, -.23, 4.96, 2.65, .12, gold, METAL, screen)
 box(b, "MonitorBlueBezel", 0, 0, -.31, 4.7, 2.39, .07, blue, METAL, screen)
 box(b, "MonitorScreen", 0, 0, -.36, 4.42, 2.12, .04, Color3.fromRGB(11, 29, 53), PLASTIC, screen)
 for index = 0, 3 do
  box(b, "ScreenDataRow_" .. index, .66, .63 - index * .38, -.39, 2.1 - index * .26, .075, .025, index == 0 and cyan or blue, NEON, screen)
 end
 b:ring("ScreenPowerSeal", screen * C(-1.25, .1, -.41), .65, .065, purple, 16, NEON)
 line(b, "ScreenLightningA", V(-1.2, .68, -.44), V(-1.55, .04, -.44), .08, paleGold, NEON, screen)
 line(b, "ScreenLightningB", V(-1.55, .04, -.44), V(-1.13, .12, -.44), .08, paleGold, NEON, screen)
 line(b, "ScreenLightningC", V(-1.13, .12, -.44), V(-1.44, -.51, -.44), .08, paleGold, NEON, screen)
 for _, side in ipairs({-1, 1}) do
  box(b, "MonitorSideCheek_" .. side, side * 2.75, 4.8, 1.08, .25, 2.85, .8, steel, METAL)
  box(b, "CheekGlow_" .. side, side * 2.9, 4.8, .8, .07, 2, .08, cyan, NEON)
  for index = 0, 4 do box(b, "RearVent_" .. side .. "_" .. index, side * 1.38, 4.52 + index * .24, 1.42, 1.7, .08, .08, charcoal, METAL) end
 end
 box(b, "MonitorCrownTrim", 0, 6.56, 1.06, 5.8, .18, .67, gold, METAL)
end

local function crownEmblem(b, name, frame, width, height, color)
 -- Raised three-prong silhouette, with cuts between the peaks.
 local z, w = -.08, width / 2
 quad(b, name .. "Band", V(-w * .86, -height * .4, z), V(w * .86, -height * .4, z), V(w, -height * .08, z), V(-w, -height * .08, z), color, METAL, frame, .16)
 tri(b, name .. "LeftPeak", V(-w, -height * .1, z), V(-w * 1.08, height * .42, z), V(-w * .35, -height * .04, z), color, METAL, frame, .16)
 tri(b, name .. "MiddlePeak", V(-w * .45, -height * .04, z), V(0, height * .62, z), V(w * .45, -height * .04, z), color, METAL, frame, .16)
 tri(b, name .. "RightPeak", V(w * .35, -height * .04, z), V(w * 1.08, height * .42, z), V(w, -height * .1, z), color, METAL, frame, .16)
 box(b, name .. "BaseStripe", 0, -height * .23, z - .12, width * .79, height * .09, .08, paleGold, METAL, frame)
 box(b, name .. "BlueDiamond", 0, -height * .13, z - .18, height * .17, height * .17, .1, lightBlue, PLASTIC, frame * A(0, 0, math.pi / 4))
end

local function clashCrownTower(b)
 local rock = Color3.fromRGB(161, 166, 176)
 local lightRock = Color3.fromRGB(192, 196, 202)
 local darkRock = Color3.fromRGB(106, 116, 133)
 box(b, "BroadStoneFooting", 0, .65, 0, 15, 1.3, 15, darkRock, STONE)
 box(b, "BevelledFoundation", 0, 1.55, 0, 14, .5, 14, rock, STONE)
 box(b, "StoneCore", 0, 12.5, 0, 10.5, 21.5, 10.5, darkRock, STONE)
 -- Staggered large stone courses on all four sides.
 for side = 0, 3 do
  local frame = A(0, side * math.pi / 2, 0)
  for course = 0, 6 do
   for index = 0, 2 do
    local x = -3.45 + index * 3.45 + (course % 2 == 1 and .22 or -.1)
    box(b, "FaceStone_" .. side .. "_" .. course .. "_" .. index,
     x, 3.1 + course * 2.8, -5.28, 3.31, 2.64, .32,
     (course + index) % 3 == 0 and lightRock or rock, STONE, frame)
   end
  end
  box(b, "BlueBanner_" .. side, 0, 14.8, -5.58, 4.2, 8.5, .11, blue, FABRIC, frame)
  for _, x in ipairs({-2.02, 2.02}) do box(b, "BannerGoldEdge_" .. side .. "_" .. x, x, 14.8, -5.66, .13, 8.5, .08, gold, METAL, frame) end
  tri(b, "BannerPoint_" .. side, V(-2.1, 10.55, -5.58), V(0, 8.3, -5.58), V(2.1, 10.55, -5.58), blue, FABRIC, frame, .08)
  box(b, "BannerHanger_" .. side, 0, 19.3, -5.76, 5.5, .24, .25, gold, METAL, frame)
  crownEmblem(b, "BannerCrown_" .. side, frame * C(0, 15.5, -5.78), 3.25, 2.7, gold)
  -- A larger blue shield plaque below the upper battlement.
  box(b, "CrownPlaque_" .. side, 0, 22.6, -5.62, 6.6, 4.4, .3, charcoal, METAL, frame)
  box(b, "CrownPlaqueBlue_" .. side, 0, 22.6, -5.83, 6.15, 4, .15, blue, METAL, frame)
  crownEmblem(b, "GrandCrown_" .. side, frame * C(0, 22.5, -5.95), 4.8, 3.3, gold)
  for _, x in ipairs({-4.75, 4.75}) do
   line(b, "TimberBrace_" .. side .. "_" .. x, V(x, 2.5, -5.6), V(x * .7, 6.8, -5.6), .42, cedar, WOOD, frame)
  end
 end
 for _, x in ipairs({-5.28, 5.28}) do
  for _, z in ipairs({-5.28, 5.28}) do
   box(b, "CornerPillar_" .. x .. "_" .. z, x, 13, z, 1.15, 22.4, 1.15, lightRock, STONE)
   for y = 4, 22, 6 do box(b, "CornerStoneBand_" .. x .. "_" .. z .. "_" .. y, x, y, z, 1.42, .45, 1.42, darkRock, STONE) end
  end
 end
 box(b, "GoldCornice", 0, 25.1, 0, 13.4, .5, 13.4, gold, METAL)
 box(b, "UpperPlatform", 0, 25.7, 0, 14, .65, 14, lightRock, STONE)
 box(b, "CrownRoofInset", 0, 26.1, 0, 11.3, .17, 11.3, blue, METAL)
 for side = 0, 3 do
  local frame = A(0, side * math.pi / 2, 0)
  box(b, "BattlementWall_" .. side, 0, 26.6, -6.48, 13.6, .8, 1, rock, STONE, frame)
  for index = -2, 2 do
   box(b, "Crenel_" .. side .. "_" .. index, index * 2.73, 27.8, -6.45, 1.7, 1.7, 1.3, lightRock, STONE, frame)
   box(b, "CrenelCap_" .. side .. "_" .. index, index * 2.73, 28.72, -6.45, 1.86, .18, 1.5, gold, METAL, frame)
  end
 end
 -- A freestanding crown cap is readable from above and from every compass side.
 cyl(b, "CrownPedestal", 0, 27.3, 0, 2.3, 5.5, charcoal, METAL)
 cyl(b, "CrownLowerRim", 0, 28.5, 0, .65, 6.2, gold, METAL)
 cyl(b, "CrownBlueBand", 0, 29.05, 0, .45, 5.9, blue, METAL)
 for side = 0, 3 do
  local frame = A(0, side * math.pi / 2, 0) * C(0, 30.5, -2.6)
  crownEmblem(b, "RoofCrown_" .. side, frame, 5.2, 4.4, gold)
 end
end

local function pagodaRoof(b, label, y, width)
 local tile = Color3.fromRGB(39, 75, 80)
 local lightTile = Color3.fromRGB(58, 107, 104)
 -- Three hipped bands form a concave eave profile, rather than stacked flat slabs.
 local radii = {width * .18, width * .33, width * .46, width * .54}
 local heights = {2.35, 1.34, .63, 1.02}
 for side = 0, 3 do
  local frame = C(0, y, 0) * A(0, side * math.pi / 2, 0)
  for band = 1, 3 do
   local r1, r2, h1, h2 = radii[band], radii[band + 1], heights[band], heights[band + 1]
   quad(b, label .. "HippedTile_" .. side .. "_" .. band,
    V(-r1, h1, -r1), V(r1, h1, -r1), V(r2, h2, -r2), V(-r2, h2, -r2),
    band == 2 and lightTile or tile, STONE, frame, .16)
  end
  box(b, label .. "RedEave_" .. side, 0, .9, -width * .54, width * 1.08, .24, .3, redWood, WOOD, frame)
  box(b, label .. "GoldEave_" .. side, 0, 1.08, -width * .542, width * 1.09, .09, .13, gold, METAL, frame)
  -- Ribs follow both changes in the roof slope.
  for index = -1, 1, 2 do
   local fraction = index / 2
   for band = 1, 2 do
    line(b, label .. "TileRib_" .. side .. "_" .. index .. "_" .. band,
     V(radii[band] * fraction, heights[band] + .12, -radii[band]),
     V(radii[band + 1] * fraction, heights[band + 1] + .12, -radii[band + 1]), .07, lightTile, STONE, frame)
   end
  end
  for _, sign in ipairs({-1, 1}) do
   line(b, label .. "RaisedCorner_" .. side .. "_" .. sign,
    V(sign * width * .46, .7, -width * .46), V(sign * width * .57, 1.58, -width * .57), .2, gold, METAL, frame)
  end
 end
 box(b, label .. "UpperRoofDeck", 0, y + 2.33, 0, width * .36, .25, width * .36, tile, STONE)
end

local function hoohBellTower(b)
 local foundation = Color3.fromRGB(116, 116, 114)
 local bronze = Color3.fromRGB(159, 107, 41)
 local darkBronze = Color3.fromRGB(91, 57, 24)
 box(b, "GardenStoneFoundation", 0, .65, 0, 23, 1.3, 23, foundation, STONE)
 box(b, "FoundationRaisedCourse", 0, 1.5, 0, 20.5, .4, 20.5, Color3.fromRGB(171, 166, 150), STONE)
 for step = 0, 3 do
  box(b, "FrontStair_" .. step, 0, .2 + step * .38, -13 + step * .65, 10 - step * .35, .4, 1.5, foundation, STONE)
 end
 for _, side in ipairs({-1, 1}) do
  box(b, "GardenBed_" .. side, side * 9.1, 1.57, 1, 2, .25, 15.5, Color3.fromRGB(65, 91, 63), Enum.Material.Grass)
  for index = 0, 4 do
   box(b, "GardenBorder_" .. side .. "_" .. index, side * 10.4, 1.8, -5 + index * 3, .55, .55, 2.8, foundation, STONE)
  end
 end
 for tier = 1, 5 do
  local y = 1.8 + (tier - 1) * 7.2
  local width = 15.2 - (tier - 1) * 1.55
  local corner = width / 2 - .5
  box(b, "TierTimberDeck_" .. tier, 0, y, 0, width + .8, .4, width + .8, cedar, WOOD)
  for _, x in ipairs({-corner, corner}) do
   for _, z in ipairs({-corner, corner}) do
    box(b, "RedTimberPost_" .. tier .. "_" .. x .. "_" .. z, x, y + 2.6, z, .58, 5.2, .58, redWood, WOOD)
    box(b, "GoldPostShoe_" .. tier .. "_" .. x .. "_" .. z, x, y + .35, z, .74, .35, .74, gold, METAL)
   end
  end
  for side = 0, 3 do
   local frame = C(0, y, 0) * A(0, side * math.pi / 2, 0)
   box(b, "UpperTimberBeam_" .. tier .. "_" .. side, 0, 4.9, -corner, width, .5, .65, redWood, WOOD, frame)
   if tier &lt; 5 then
    box(b, "IvoryWallPanel_" .. tier .. "_" .. side, 0, 2.6, -corner, width - 1.4, 3.5, .2, ivory, PLASTIC, frame)
    box(b, "DarkLatticeWindow_" .. tier .. "_" .. side, 0, 2.8, -corner - .17, width * .48, 2.5, .15, charcoal, PLASTIC, frame)
    for index = -1, 1 do box(b, "WindowLattice_" .. tier .. "_" .. side .. "_" .. index, index * width * .12, 2.8, -corner - .28, .11, 2.55, .1, cedar, WOOD, frame) end
    box(b, "WindowSill_" .. tier .. "_" .. side, 0, 1.46, -corner - .26, width * .55, .16, .5, redWood, WOOD, frame)
   else
    -- The open upper pavilion exposes the bronze bell from every side.
    box(b, "BellPavilionHandrail_" .. side, 0, 1.25, -corner, width, .16, .22, redWood, WOOD, frame)
    box(b, "BellPavilionRailBase_" .. side, 0, .5, -corner, width, .15, .2, cedar, WOOD, frame)
    for index = -2, 2 do box(b, "BellPavilionBaluster_" .. side .. "_" .. index, index * width * .16, .88, -corner, .1, .7, .1, gold, METAL, frame) end
   end
  end
  pagodaRoof(b, "TierRoof_" .. tier, y + 5.15, width + 3)
 end
 -- Ringed hollow bell with a flared lip, dark underside, clapper and hanger.
 line(b, "BellHangingChain", V(0, 35.4, 0), V(0, 34.5, 0), .17, darkBronze, METAL)
 cyl(b, "BronzeBellCrown", 0, 34.25, 0, .45, 1.5, bronze, METAL)
 cyl(b, "BronzeBellShoulder", 0, 33.75, 0, .55, 2.4, bronze, METAL)
 cyl(b, "BronzeBellBody", 0, 32.8, 0, 1.5, 2.8, bronze, METAL)
 cyl(b, "BronzeBellLowerFlare", 0, 31.95, 0, .35, 3.35, bronze, METAL)
 cyl(b, "BellFlaredRim", 0, 31.67, 0, .2, 3.75, gold, METAL)
 cyl(b, "BellHollowUnderside", 0, 31.54, 0, .04, 3.05, darkBronze, METAL)
 for index = 0, 11 do
  local angle = index * math.pi / 6
  box(b, "BellEmbossedRib_" .. index, 0, 32.8, 0, .1, 1.6, .1, gold, METAL,
   C(math.cos(angle) * 1.39, 0, math.sin(angle) * 1.39))
 end
 line(b, "BellClapperStem", V(0, 32.2, 0), V(0, 31, 0), .14, gold, METAL)
 cyl(b, "BellClapperDisc", 0, 30.95, 0, .25, .7, bronze, METAL)
 -- A traditional spire composed of discs and a pointed finial, without floating orbs.
 cyl(b, "TopSpirePole", 0, 40.5, 0, 4.2, .26, gold, METAL)
 for index = 0, 4 do cyl(b, "SpireRing_" .. index, 0, 39.2 + index * .52, 0, .12, 1.35 - index * .17, gold, METAL) end
 tri(b, "SpireTip", V(-.3, 42.4, 0), V(0, 43.5, 0), V(.3, 42.4, 0), paleGold, METAL, C(), .14)
end

local builders = {
 detailed_workbench = detailedWorkbench,
 power_console = powerConsole,
 clash_crown_tower = clashCrownTower,
 hooh_bell_tower = hoohBellTower,
}
function M.build(b, key)
 local build = builders[key]
 if not build then return false end
 build(b)
 return true
end
return M
