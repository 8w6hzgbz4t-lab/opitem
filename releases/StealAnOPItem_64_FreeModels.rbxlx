 companion_cube={Name="Portal Companion Cube", Family="RelicItems", PartBudget=240, AlignBase=true, ReferenceRequired=false},
 proton_pack={Name="Ghostbusters Proton Pack", Family="RelicItems", PartBudget=240, AlignBase=true, ReferenceRequired=false},
 infinity_space={Name="Space Stone", Family="RelicItems", PartBudget=240, AlignBase=true, ReferenceRequired=false},
 infinity_mind={Name="Mind Stone", Family="RelicItems", PartBudget=240, AlignBase=true, ReferenceRequired=false},
 infinity_reality={Name="Reality Stone", Family="RelicItems", PartBudget=240, AlignBase=true, ReferenceRequired=false},
