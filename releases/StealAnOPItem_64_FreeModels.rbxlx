 infinity_soul={Name="Soul Stone", Family="RelicItems", PartBudget=240, AlignBase=true, ReferenceRequired=false},
 pekka={Name="Clash Royale P.E.K.K.A", Family="WarriorModels", PartBudget=240, AlignBase=true, ReferenceRequired=false},
 mega_knight={Name="Clash Royale Mega Knight", Family="WarriorModels", PartBudget=240, AlignBase=true, ReferenceRequired=false},
 dragon_balls={Name="Seven Dragon Balls collectible set", Family="ExtraItems", PartBudget=240, AlignBase=true, ReferenceRequired=false, ItemId="item43"},
 winged_dragon_ra={Name="The Winged Dragon of Ra monument", Family="WarriorModels", PartBudget=500, AlignBase=true, ReferenceRequired=false},
 obelisk_tormentor={Name="Obelisk the Tormentor monument", Family="WarriorModels", PartBudget=500, AlignBase=true, ReferenceRequired=false},
