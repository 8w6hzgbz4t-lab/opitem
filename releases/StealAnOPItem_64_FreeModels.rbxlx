				<Item class="ModuleScript" referent="RBX11d10de65240490283d04bb4434dcc1e">
					<Properties>
						<Content name="LinkedSource"><null /></Content>
						<ProtectedString name="Source">-- Additions preserve all original IDs. spawnWeight is conditional within a rarity tier.
