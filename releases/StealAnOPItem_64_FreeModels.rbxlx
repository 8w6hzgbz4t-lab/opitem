d"]="item41",["name"]="Infinity Gauntlet",["reference"]="Infinity Gauntlet",["franchise"]="Marvel",["model"]="gauntlet",["power"]="shield",["tier"]=6,["rarity"]="Mythic",["price"]=180000,["income"]=1800,["category"]="Relic",["visual"]="Golden articulated fist, six colored gems",["alternative"]="Silver three-ring astronomical armature",["rights"]="Unresolved",["acquisition"]="Market; rival vault theft",["animation"]="Slow turn and hover",["priority"]="P1 roster"},{["id"]="item42",["name"]="Requiem Heir",["reference"]="Giorno / Gold Experience Requiem",["franchise"]="JoJo Part 5",["model"]="giorno",["power"]="shield",["tier"]=6,["rarity"]="Mythic",["price"]=194400,["income"]=1908,["category"]="Character",["visual"]="Gold hair curls, magenta suit, gold aura",["alternative"]="Jade-haired guardian with spiral mantle",["rights"]="Unresolved",["acquisition"]="Market; rival vault theft",["animation"]="Breathing sway and arm idle",["priority"]="P1 roster"},{["id"]="item43",["name"]="Slime Sovereign",["reference"]="Rimuru Tempest",["franchise"]="That Time I Got Reincarnated as a Slime",["model"]="rimuru",["power"]="pull",["tier"]=6,["rarity"]="Mythic",["price"]=208800,["income"]=2016,["category"]="Character",["visual"]="Blue-haired humanoid, black coat, tiny slime companion",["alternative"]="Mint crystal shapeshifter",["rights"]="Unresolved",["acquisition"]="Market; rival vault theft",["animation"]="Breathing sway and arm idle",["priority"]="P1 roster"},{["id"]="item44",["name"]="Shadow Monarch",["reference"]="Sung Jinwoo",["franchise"]="Solo Leveling",["model"]="jinwoo",["power"]="shadow",["tier"]=6,["rarity"]="Mythic",["price"]=223200,["income"]=2124,["category"]="Character",["visual"]="Black spiked hair and coat, violet shadow",["alternative"]="White-cloaked astral ranger",["rights"]="Unresolved",["acquisition"]="Market; rival vault theft",["animation"]="Breathing sway and arm idle",["priority"]="P1 roster"},{["id"]="item45",["name"]="Demon Origin",["reference"]="Anos Vold