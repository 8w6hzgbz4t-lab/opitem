   local cylinder=p('RevolverCylinder',.4,.9,0,.45,.6,.45,dark);cylinder.Shape=Enum.PartType.Cylinder
   p('Trigger',.4,.45,0,.35,.3,.16,silver)
   for i=0,3 do ball('CylinderRivet',.65,.7+i*.12,-.1,.06,gold) end
