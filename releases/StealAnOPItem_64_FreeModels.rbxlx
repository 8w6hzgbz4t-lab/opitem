    {id="item61",name="Soul Stone",model="infinity_soul",tier=5,price=65000,income=700,spawnWeight=.65,power="shield",ability="Soul Ward",radius=3,windup=0,cooldown=20,category="Relic"},
    {id="item62",name="Clash Royale P.E.K.K.A",model="pekka",tier=5,price=58000,income=650,spawnWeight=.8,power="slam",ability="Armored Strike",radius=11,windup=.9,cooldown=20,category="Relic"},
