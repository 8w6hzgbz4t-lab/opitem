 for index = 0, 9 do
  local angle = index * math.pi / 5
  uprightCylinder(b, "ColumnFlute_" .. index, math.sin(angle) * 2.02, 16.8, math.cos(angle) * 2.02, 27.4, .37, slate, stone)
 end
 for _, y in ipairs({3.1, 11, 22.5, 30.4}) do
  uprightCylinder(b, "ColumnBand_" .. y, 0, y, 0, .45, 4.9, gold, metal)
 end
 uprightCylinder(b, "CapitalLower", 0, 31.2, 0, 1.2, 5.8, concrete, stone, true)
 box(b, "CapitalTop", 0, 32.2, 0, 7, .85, 7, concrete, stone, true)
 box(b, "CrownInset", 0, 32.8, 0, 5.7, .4, 5.7, dark, stone)
 b:ball("ArenaCrystal", V(1.5, 2.8, 1.5), C(0, 34.2, 0), purple, neon)
 for side = 0, 3 do
  local frame = C(0, 31.5, 0) * A(0, side * math.pi / 2, 0)
  b:box("CapitalInset_" .. side, V(2.4, .35, .1), frame * C(0, 0, -2.99), gold, metal)
 end
end

local function mtgCard(b)
 local jade = Color3.fromRGB(48, 94, 78)
 local black = Color3.fromRGB(26, 21, 35)
 box(b, "ArchiveCardFoot", 0, 1, 0, 34, 2, 9, dark, stone, true)
 box(b, "ArchiveCard", 0, 25, 0, 30, 46, 1.2, gold, metal)
 box(b, "JadeInset", 0, 25, -.71, 28.3, 44, .2, jade, metal)
 box(b, "DarkArtPanel", 0, 28.6, -.9, 24.5, 29, .2, black, stone)
 box(b, "TitlePlaque", 0, 45.4, -.95, 25, 2.5, .25, lightGold, metal)
 box(b, "RulesTablet", 0, 8.6, -.95, 24.5, 8.2, .25, Color3.fromRGB(177, 156, 112), stone)
 for _, x in ipairs({-14.35, 14.35}) do
  box(b, "ArchiveBorder_" .. x, x, 25, -.97, .34, 44.5, .34, lightGold, metal)
 end
 for _, y in ipairs({3.2, 46.8}) do
  box(b, "ArchiveBorder_" .. y, 0, y, -.97, 28.7, .34, .34, lightGold, metal)
 end
 -- Raised midnight lotus art replaces text-only scenery and requires no imported texture.
 for layer = 1, 3 do
  local amount = 10 - layer
  local radius = 5.8 - layer * 1.25
  for index = 0, amount - 1 do
   local angle = (index + layer * .28) * math.pi * 2 / amount
   local p = C(math.sin(angle) * radius, 29 + math.cos(angle) * radius, -1.6 - layer * .25) * A(0, 0, -angle)
   b:ball("ArchiveLotusPetal_" .. layer .. "_" .. index, V(2.6, 7.8 - layer, .75), p,
    index % 2 == 0 and Color3.fromRGB(51, 31, 75) or Color3.fromRGB(82, 48, 112), metal)
  end
 end
 b:ball("ArchiveLotusHeart", V(2.3, 2.3, .55), C(0, 29, -2.9), gold, metal)
 b:ring("ArchiveArtHalo", C(0, 29, -1.16), 10, .12, gold, 28, metal)
 for index = -3, 3 do rune(b, "ArchiveGlyph_" .. index, index * 3.2, 8.8, -1.15, 1.6, black) end
 for index = -2, 2 do
  b:ball("TitleGem_" .. index, V(.7, .7, .2), C(index * 2.6, 45.4, -1.15), jade, metal)
 end
end

local function clashTower(b)
 local blue = Color3.fromRGB(49, 111, 199)
 local pale = Color3.fromRGB(164, 164, 176)
 uprightCylinder(b, "TowerFoot", 0, 1, 0, 2, 18, dark, stone, true)
 uprightCylinder(b, "CastleTower", 0, 15, 0, 26, 13, pale, stone, true)
 for course = 1, 6 do
  local y = 2 + course * 4
  b:ring("MasonryCourse_" .. course, C(0, y, 0) * A(math.pi / 2, 0, 0), 6.56, .13, slate, 16, stone)
 end
 uprightCylinder(b, "TowerCapital", 0, 28.5, 0, 1.4, 16, slate, stone, true)
 for index = 0, 7 do
  local angle = index * math.pi / 4
  box(b, "SolidBattlement_" .. index, math.sin(angle) * 7, 30.4, math.cos(angle) * 7, 2.3, 3.1, 2.3, pale, stone, true, A(0, angle, 0))
 end
 uprightCylinder(b, "BlueRoof", 0, 30, 0, 1.1, 11.5, blue, metal, true)
 for index = 0, 3 do
  local angle = index * math.pi / 2
  local frame = C(0, 0, 0) * A(0, angle, 0)
  b:box("ArrowSlit_" .. index, V(.8, 4.5, .15), frame * C(0, 18.2, -6.56), dark, metal)
  b:box("Banner_" .. index, V(3.8, 7, .2), frame * C(0, 9.5, -6.64), blue, Enum.Material.Fabric)
  b:box("CrownBand_" .. index, V(2.2, .6, .24), frame * C(0, 10, -6.81), gold, metal)
  for point = -1, 1 do
   b:wedge("CrownPoint_" .. index .. "_" .. point, V(.65, 1.2 + (point == 0 and .45 or 0), .25),
    frame * C(point * .75, 10.7, -6.81), lightGold, metal)
  end
 end
 box(b, "FlagPole", 0, 34.2, 0, .3, 7, .3, gold, metal)
 box(b, "Flag", 2.1, 36, 0, 4, 2.1, .16, blue, Enum.Material.Fabric)
 b:ball("FlagFinial", .65, C(0, 38, 0), lightGold, metal)
end

local function skyFlower(b)
 local color = b.options.accent or Color3.fromRGB(220, 161, 233)
 local function point(t)
  local radius = 11 + 5 * math.cos(5 * t)
  return V(math.cos(t) * radius, math.sin(t) * radius, 0)
 end
 for index = 0, 59 do
  b:line("PetalOutline_" .. index, point(index * math.pi / 30), point((index + 1) * math.pi / 30), .55, .22, color, neon)
 end
 b:ring("FlowerCenter", C(), 2.05, .45, color, 20, neon)
 for index = 0, 4 do
  local angle = index * math.pi * 2 / 5
  b:ball("PetalAccent_" .. index, V(.65, .65, .22), C(math.cos(angle) * 13.3, math.sin(angle) * 13.3, -.2), lightGold, neon)
 end
end

local builders = {
 baseBuilding = baseBuilding, riftPortal = riftPortal, bellTower = bellTower,
 squidHouse = squidHouse, godSlifer = godSlifer, godObelisk = godObelisk,
 godRa = godRa, blackLotus = blackLotus, pancakes = pancakes,
 tournamentPillar = tournamentPillar,
 mtgCard = mtgCard, clashTower = clashTower, skyFlower = skyFlower,
}

function M.build(b, key)
 local build = builders[key]
 if not build then return false end
 build(b)
 return true
end

return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_DetailedArt_ExtraDecor"><Properties><string name="Name">ExtraDecor</string><ProtectedString name="Source">-- Native, anchored scenery. These sculptures never add NPCs, race controls or collision.
local P=require(script.Parent.Primitives)
local E={}
local V,C,A=Vector3.new,CFrame.new,CFrame.Angles
local NEON,METAL,SMOOTH=Enum.Material.Neon,Enum.Material.Metal,Enum.Material.SmoothPlastic
local function rgb(r,g,b) return Color3.fromRGB(r,g,b) end
local red,scarlet,gold=rgb(174,17,43),rgb(251,48,77),rgb(225,178,67)
local dark,white,cyan=rgb(17,23,37),rgb(227,226,218),rgb(85,225,255)

local function deck(b,name,a,c,width,height,color,material)
 local delta=c-a
 return b:box(name,V(width,height,delta.Magnitude+.08),CFrame.lookAt((a+c)*.5,c),color,material)
end

function E.racetrack(parent)
 local b=P.new(parent,{model="DuelCircuit",name="FiveDsDuelCircuit",alignBase=false,partBudget=300})
 local points={}
 local corners={{127,95,0},{-127,95,math.pi/2},{-127,-95,math.pi},{127,-95,math.pi*1.5}}
 for _,corner in ipairs(corners) do
  for step=0,8 do
   local angle=corner[3]+step/8*math.pi*.5
   points[#points+1]=V(corner[1]+math.cos(angle)*24,32.22,corner[2]+math.sin(angle)*24)
  end
 end
 for i,a in ipairs(points) do
  local c=points[i%#points+1]
  deck(b,"CircuitAsphalt_"..i,a,c,16,.4,dark,METAL)
  local right=(c-a).Unit:Cross(V(0,1,0))
  for _,side in ipairs({-1,1}) do
   local curb=right*(side*7.25)+V(0,.26,0)
   deck(b,"CircuitCurb_"..i.."_"..side,a+curb,c+curb,1.1,.25,i%2==0 and red or white,SMOOTH)
   local rail=right*(side*8.05)+V(0,1.2,0)
   deck(b,"CircuitEnergyRail_"..i.."_"..side,a+rail,c+rail,.18,.32,cyan,NEON)
  end
 end
 -- Angular double chevrons evoke a futuristic duel-runner circuit.
 for _,z in ipairs({-119,119}) do
  for _,x in ipairs({-80,-30,30,80}) do
   local sign=z&lt;0 and 1 or -1
   for tip=0,1 do
    local p=V(x+tip*3,32.46,z)
    b:line("CircuitChevronL_"..x.."_"..z.."_"..tip,p+V(-sign*2.3,0,-2),p,.22,.12,gold,NEON)
    b:line("CircuitChevronR_"..x.."_"..z.."_"..tip,p+V(-sign*2.3,0,2),p,.22,.12,gold,NEON)
   end
  end
 end
 -- The elevated ring stays visible above the perimeter wall. A few pylons support the silhouette.
 local supports={V(-151,0,-57),V(-151,0,57),V(151,0,-57),V(151,0,57),V(-80,0,-119),V(80,0,-119),V(-80,0,119),V(80,0,119)}
 for i,p in ipairs(supports) do
  b:box("CircuitSupportColumn_"..i,V(2.8,31.6,2.8),C(p+V(0,16,0)),dark,METAL)
  b:box("CircuitSupportBeacon_"..i,V(.22,24,.22),C(p+V(-1.5,17,0)),cyan,NEON)
 end
 -- This road lies below the existing belt; original item positions and collision stay authoritative.
 b:box("PortalRoadDeck",V(302,.22,12),C(0,.25,0),dark,METAL)
 for _,side in ipairs({-1,1}) do
  b:box("PortalRoadEnergyStrip_"..side,V(302,.1,.18),C(0,.42,side*5.6),cyan,NEON)
  b:box("PortalRoadShoulder_"..side,V(302,.12,.65),C(0,.34,side*6.2),red,METAL)
  for i=0,14 do
   b:box("PortalRoadDashedGold_"..side.."_"..i,V(7,.06,.18),C(-144+i*20,.43,side*4.8),gold,NEON)
  end
 end
 -- The ornamental climbing spur joins the low portal road to the visible high circuit east of the wall.
 local spurStart,spurEnd=V(125,.25,0),V(151,32.22,0)
 deck(b,"PortalClimbingSpur",spurStart,spurEnd,12,.35,dark,METAL)
 for _,side in ipairs({-1,1}) do
  local offset=V(0,.25,side*5.6)
  deck(b,"SpurEnergyStrip_"..side,spurStart+offset,spurEnd+offset,.24,.16,cyan,NEON)
  local shoulder=V(0,.16,side*6.2)
  deck(b,"SpurRedShoulder_"..side,spurStart+shoulder,spurEnd+shoulder,.6,.22,red,METAL)
 end
 -- Four trackside pylons frame the portal spur without closing the item opening.
 for _,x in ipairs({134,144}) do
  for _,z in ipairs({-9,9}) do
   b:box("DuelPylon_"..x.."_"..z,V(1.4,5,1.4),C(x,2.5,z),dark,METAL)
   b:box("DuelPylonLight_"..x.."_"..z,V(.22,3,.24),C(x-.75,3,z),scarlet,NEON)
   b:ball("DuelPylonCap_"..x.."_"..z,1,C(x,5.2,z),gold,METAL)
  end
 end
 local model=b:finish()
 model:SetAttribute("DecorativeOnly",true)
 model:SetAttribute("ConveyorGeometryUnchanged",true)
 return model
end

local function samplePath(points,count)
 local samples={}
 for i=0,count do
  local u=i/count*(#points-1)
  local segment=math.min(#points-1,math.floor(u)+1)
  local t=u-(segment-1)
  local p0,p1,p2,p3=points[math.max(1,segment-1)],points[segment],points[segment+1],points[math.min(#points,segment+2)]
  samples[#samples+1]=(p1*2+(p2-p0)*t+(p0*2-p1*5+p2*4-p3)*t*t+(-p0+p1*3-p2*3+p3)*t*t*t)*.5
 end
 return samples
end

local function serpentineBody(b,points,color,belly,spine,crimson)
 local path=samplePath(points,44)
 for i=1,#path-1 do
  local a,c=path[i],path[i+1]
  local t=i/(#path-1)
  local diameter=(1.3+math.sin(t*math.pi*.65)*3.3)
  local cf=CFrame.lookAt((a+c)*.5,c)
  b:ball("CoiledScaleSegment_"..i,V(diameter,diameter,(c-a).Magnitude+diameter*.55),cf,color,SMOOTH)
  b:ball("SegmentBelly_"..i,V(diameter*.74,diameter*.84,(c-a).Magnitude+diameter*.38),cf+V(0,0,-diameter*.37),belly,SMOOTH)
  if i%2==0 then
   local p=(a+c)*.5
   b:triangle("DorsalSpine_"..i,p+V(-.7,diameter*.4,.6),p+V(.2,diameter*(crimson and 1.35 or .95),.8),p+V(.9,diameter*.38,.6),spine,.3,METAL)
  end
  if i%3==0 then
   local p=(a+c)*.5
   b:line("ScaleHighlight_"..i,p+V(-diameter*.32,diameter*.27,-diameter*.55),p+V(diameter*.32,diameter*.27,-diameter*.55),.12,.12,crimson and scarlet or gold,crimson and NEON or METAL)
  end
 end
 return path[#path]
end

local function dragonHead(b,head,color,belly,crimson)
 local face=C(head)
 local function ball(name,size,offset,tint,material) return b:ball(name,size,face*C(offset),tint,material or SMOOTH) end
 local function box(name,size,offset,tint,material) return b:box(name,size,face*C(offset),tint,material or SMOOTH) end
 ball("DragonSkull",V(7.7,6.5,8),V(0,1,-1),color)
 ball("LongDragonMuzzle",V(5.7,3.4,8),V(0,-.2,-6),color)
 box("OpenMouthShadow",V(5.2,1.05,7.2),V(0,-1.1,-6.3),rgb(30,9,16))
 ball("LowerDragonJaw",V(5.5,1.2,7.2),V(0,-2,-5.8),belly)
 for _,side in ipairs({-1,1}) do
  ball("EyeSocket_"..side,V(1.4,1.9,2.5),V(side*3.25,1.7,-3.3),rgb(29,17,23))
  ball("DragonEye_"..side,V(.5,1.1,1.8),V(side*3.87,1.9,-3.55),crimson and rgb(255,230,102) or rgb(255,61,55),NEON)
  b:line("HeavyBrow_"..side,face*V(side*2.1,3,-5),face*V(side*4,2.8,-2.5),.75,.75,color,METAL)
  ball("Nostril_"..side,V(.7,.45,1.1),V(side*1.5,.7,-9.5),rgb(27,15,19))
  for tooth=1,3 do
   b:wedge("Fang_"..side.."_"..tooth,V(.55,1.15,.7),face*C(side*2.4,-1,-8.4+tooth*1.5)*A(0,side*math.pi*.5,math.pi),white,SMOOTH)
  end
  local hornColor=crimson and rgb(223,153,155) or rgb(151,106,61)
  local h0,h1,h2=face*V(side*2.6,3,.8),face*V(side*4.2,7,2),face*V(side*5.2,11,3.2)
  b:line("AntlerRoot_"..side,h0,h1,1.1,1.1,hornColor,METAL)
  b:line("AntlerTip_"..side,h1,h2,.65,.65,hornColor,METAL)
  b:triangle("PointedAntler_"..side,h2+V(-.4,0,0),h2+V(.4,0,0),h2+V(side*.5,2,1),hornColor,.6,METAL)
  if not crimson then
   b:line("AntlerBranch_"..side,h1,face*V(side*7,8,.1),.55,.55,hornColor,METAL)
   b:line("AntlerFork_"..side,face*V(side*6,7.7,.6),face*V(side*7.4,10,1.3),.35,.35,hornColor,METAL)
   local w0,w1,w2=face*V(side*2.6,-.2,-8.6),face*V(side*8,-1.2,-9.6),face*V(side*14,2,-9.3)
   b:line("WhiskerInner_"..side,w0,w1,.22,.22,gold,METAL)
   b:line("WhiskerOuter_"..side,w1,w2,.13,.13,gold,METAL)
  end
  b:triangle("FlaredCheek_"..side,face*V(side*2.7,.2,0),face*V(side*7,4.3,1),face*V(side*3.6,4.6,2.4),color,.6,METAL)
 end
 b:triangle("ForeheadCrest",face*V(-1,3.5,-.2),face*V(0,8,-.6),face*V(1,3.5,-.2),crimson and scarlet or gold,.6,METAL)
 if not crimson then
  ball("DragonBeard",V(3.8,2.2,2.4),V(0,-3,-5.5),white)
  for strand=-1,1 do
   b:line("BeardStrand_"..strand,face*V(strand*1,-3.4,-5),face*V(strand*1.5,-7,-3.5),.5,.5,white,SMOOTH)
  end
 end
end

local function limbs(b,anchor,color,claw,label)
 for _,side in ipairs({-1,1}) do
  local shoulder=anchor+V(side*1.5,0,0)
  local elbow=anchor+V(side*7,-5,-1)
  local wrist=anchor+V(side*10,-3,-5)
  b:line(label.."UpperArm_"..side,shoulder,elbow,1.8,1.8,color,SMOOTH)
  b:ball(label.."Elbow_"..side,2.1,C(elbow),color,SMOOTH)
  b:line(label.."Forearm_"..side,elbow,wrist,1.3,1.3,color,SMOOTH)
  b:ball(label.."Palm_"..side,V(3.6,1.3,2.2),C(wrist),color,SMOOTH)
  for finger=-1,1 do
   local a=wrist+V(finger*1.15,0,-.5)
   local c=a+V(finger*.4,-.7,-2)
   b:line(label.."Finger_"..side.."_"..finger,a,c,.45,.45,color,SMOOTH)
   b:triangle(label.."Claw_"..side.."_"..finger,c+V(-.27,0,0),c+V(.27,0,0),c+V(0,-.8,-1.3),claw,.25,METAL)
  end
 end
end

function E.crimsonDragon(parent,cf)
 local b=P.new(parent,{model="CrimsonDragon",name="CrimsonDragonMonument",alignBase=false,cframe=cf,partBudget=400})
 local points={V(27,-25,4),V(14,-17,5),V(-8,-18,1),V(-24,-6,2),V(-23,16,4),V(-7,27,3),V(12,19,1),V(14,3,2),V(1,1,2),V(-6,15,3),V(0,29,0)}
 local head=serpentineBody(b,points,red,rgb(255,126,133),scarlet,true)
 -- Broad jagged membranes make the crimson sculpture distinct from Shenron's long body.
 for _,side in ipairs({-1,1}) do
  local shoulder=V(side*4,23,3)
  local elbow=V(side*23,43,5)
  local tips={V(side*47,40,5),V(side*44,27,4),V(side*40,14,3),V(side*29,6,2)}
  b:line("WingUpperBone_"..side,shoulder,elbow,1.2,1.2,scarlet,METAL)
  for i,tip in ipairs(tips) do
   b:line("WingFinger_"..side.."_"..i,elbow,tip,.65,.65,scarlet,METAL)
   local nextTip=tips[i+1] or shoulder
   local membrane=b.count
   b:triangle("ScarletWingMembrane_"..side.."_"..i,elbow,tip,nextTip,i%2==0 and rgb(174,22,65) or rgb(222,37,76),.25,NEON)
   assert(b.count&gt;membrane,"Missing dragon wing")
  end
 end
 limbs(b,V(0,22,0),red,white,"Fore")
 limbs(b,V(-18,-1,1),red,white,"Hind")
 dragonHead(b,head,red,rgb(250,140,148),true)
 local model=b:finish();model:SetAttribute("DecorativeOnly",true);return model
end

function E.shenron(parent,cf)
 local b=P.new(parent,{model="Shenron",name="ShenronDragonMonument",alignBase=false,cframe=cf,partBudget=400})
 local green,belly=rgb(37,130,64),rgb(220,199,129)
 local points={}
 for i=0,13 do
  local t=i/13;local angle=-math.pi*.7+t*math.pi*3.1;local radius=26-t*11
  points[#points+1]=V(math.cos(angle)*radius,math.sin(angle)*radius+t*13,math.sin(angle*1.8)*4)
 end
 local head=serpentineBody(b,points,green,belly,rgb(45,75,43),false)
 limbs(b,points[7],green,white,"Hind")
 limbs(b,head+V(0,-7,2),green,white,"Fore")
 dragonHead(b,head,green,belly,false)
 local model=b:finish();model:SetAttribute("DecorativeOnly",true);return model
end

function E.mirrorForcePlanet(parent,cf)
 local b=P.new(parent,{model="MirrorForcePlanet",name="MirrorForceReflectionPlanet",alignBase=false,cframe=cf,partBudget=220})
 local blue,ice,violet=rgb(33,72,166),rgb(158,238,255),rgb(73,111,193)
 -- Flat face-on composition: luminous blue planet, reflected light and angular shards.
 b:cylinder("DeepBluePlanetDisc",V(.3,48,48),C()*A(0,math.pi*.5,0),blue,NEON)
 b:cylinder("ReflectivePlanetFace",V(.18,42,42),C(0,1,-.22)*A(0,math.pi*.5,0),violet,NEON)
 for i=1,5 do
  local radius=5+i*3.2
  local arcSegments=13
  for step=0,arcSegments-1 do
   local a=-math.pi*.08+step/arcSegments*math.pi*1.3
   local c=-math.pi*.08+(step+1)/arcSegments*math.pi*1.3
   b:line("ReflectedShieldArc_"..i.."_"..step,V(math.cos(a)*radius,math.sin(a)*radius,-2.6-i*.025),V(math.cos(c)*radius,math.sin(c)*radius,-2.6-i*.025),.19+i*.025,.15,i%2==0 and ice or rgb(94,168,255),NEON)
  end
 end
 local burst=V(-7,-6,-3)
 for i=0,17 do
  local angle=i/18*math.pi*2
  local ray=V(math.cos(angle),math.sin(angle),0)
  local start=burst+ray*(i%3==0 and 3 or 7)
  local finish=burst+ray*(i%3==0 and 31 or 22)
  b:line("MirrorReboundRay_"..i,start,finish,i%3==0 and .6 or .23,.14,ice,NEON)
  if i%2==0 then
   local perpendicular=V(-ray.Y,ray.X,0)
   local center=burst+ray*(17+i%4)
   b:triangle("FloatingMirrorShard_"..i,center+ray*5,center-ray*3+perpendicular*1.7,center-ray*1.2-perpendicular*2.6,i%4==0 and white or rgb(110,202,255),.14,NEON)
  end
 end
 b:ring("MirrorForceOuterHalo",C(0,0,-.75),26,.22,ice,32,NEON)
 b:ball("ReflectionBurstCore",V(6,6,.8),C(burst),white,NEON)
 b:line("ReflectionHorizontalFlare",burst-V(13,0,0),burst+V(13,0,0),.6,.18,white,NEON)
 b:line("ReflectionVerticalFlare",burst-V(0,13,0),burst+V(0,13,0),.6,.18,white,NEON)
 local model=b:finish();model:SetAttribute("DecorativeOnly",true);model:SetAttribute("FlatBackdrop",true);return model
end
return E
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_DetailedArt_ItemArt"><Properties><string name="Name">ItemArt</string><ProtectedString name="Source">-- Detailed visuals only; prices, rarity, income and abilities stay in the existing Catalog.
local P=require(script.Parent.Primitives)
local Puzzle=require(script.Parent.MillenniumPuzzle)
local families={
 Weapons=require(script.Parent.Weapons), Artifacts=require(script.Parent.Artifacts),
 Technology=require(script.Parent.Technology), Figures=require(script.Parent.Figures),
 ExtraItems=require(script.Parent.ExtraItems),
}
local A={}
A.Items={
 {id="item01",name="Minecraft Diamond Sword",model="pixel"},
 {id="item02",name="Infinity Gauntlet",model="gauntlet"},
 {id="item03",name="The One Ring",model="oneRing"},
 {id="item04",name="Green Chaos Emerald",model="emerald"},
 {id="item05",name="Mario Kart Blue Shell",model="shell"},
 {id="item06",name="Buster Sword",model="buster"},
 {id="item07",name="Portal Gun",model="portalgun"},
 {id="item08",name="Millennium Puzzle",model="puzzle"},
 {id="item09",name="Halo Energy Sword",model="energy"},
 {id="item10",name="Mjölnir",model="hammer"},
 {id="item11",name="Call of Duty Zombies Ray Gun",model="raygun"},
 {id="item12",name="Master Ball",model="masterball"},
 {id="item13",name="Exodia — Five-Card Set",model="cards"},
 {id="item14",name="Zeno's Button",model="zenobutton"},
 {id="item15",name="Link's Master Sword",model="master"},
 {id="item16",name="Doom BFG 9000",model="bfg"},
 {id="item17",name="Jellyfishing Net",model="jellyNet"},
 {id="item18",name="LeBron's Face Mask",model="faceMask"},
 {id="item19",name="Broly's Jewelry",model="brolyJewelry"},
 {id="item20",name="Poke Ball",model="pokeBall"},
 {id="item21",name="Thunder Evolution Stone",model="evolutionStone"},
 {id="item22",name="Rainbow Legendary Feather",model="legendFeather"},
 {id="item23",name="Millennium Rod",model="millenniumRod"},
 {id="item24",name="Duel Disk",model="duelDisk"},
 {id="item25",name="Exodia Head and Torso",model="exodiaHead"},
 {id="item26",name="Exodia Left Arm",model="exodiaLeftArm"},
 {id="item27",name="Exodia Right Arm",model="exodiaRightArm"},
 {id="item28",name="Exodia Left Leg",model="exodiaLeftLeg"},
 {id="item29",name="Exodia Right Leg",model="exodiaRightLeg"},
 {id="item30",name="Minecraft Diamond Axe",model="diamondAxe"},
 {id="item31",name="Enchanted Diamond Pickaxe",model="enchantedPickaxe"},
 {id="item32",name="End Crystal",model="endCrystal"},
 {id="item33",name="Command Block",model="commandBlock"},
 {id="item34",name="Sting",model="sting"},
 {id="item35",name="The Arkenstone",model="arkenstone"},
 {id="item36",name="Dwarven Treasure",model="dwarfTreasure"},
 {id="item37",name="Emerald Materia",model="materia"},
 {id="item38",name="Revolver Gunblade",model="gunblade"},
 {id="item39",name="Fire Evolution Stone",model="fireStone"},
 {id="item40",name="Water Evolution Stone",model="waterStone"},
 {id="item41",name="Iron Man Armor Suit",model="ironArmor"},
 {id="item42",name="Triforce",model="triforce"},
 {id="item43",name="Dragon Balls",model="dragonballs"},
 {id="item44",name="Yusei Fudo Red Duel Runner",model="duelrunner"},
 {id="item45",name="Freddy Fazbear Empty Suit",model="freddysuit"},
 {id="item46",name="Golden Freddy Empty Suit",model="goldenfreddysuit"},
}
local byId={}
for _,d in ipairs(A.Items) do byId[d.id]=d end
local routes={}
local function add(family,keys)
 for _,key in ipairs(keys) do routes[string.lower(key)]={family=family,key=key} end
end
add('Weapons',{'pixel','buster','master','energy','hammer','sting','pickaxe','diamondaxe','lightsaber','keyblade','gunblade'})
add('Artifacts',{'gauntlet','oneRing','emerald','shell','zenobutton','cards','materia','commandblock','endcrystal','arkenstone','deathnote','triforce','millenniumRod','dwarfTreasure'})
add('Technology',{'portalgun','raygun','bfg','omnitrix','facemask','jellynet','pegasus','nemesis','dueldisk'})
add('Figures',{'masterball','pokeball','evolutionstone','firestone','waterstone','legendfeather','missingno','ironman','megaknight','pekka','brolyjewelry','exodiahead','exodialeftarm','exodiarightarm','exodialeftleg','exodiarightleg'})
routes.enchantedpickaxe=routes.pickaxe
add('ExtraItems',{'dragonballs','duelrunner','freddysuit','goldenfreddysuit'})
routes.ironarmor=routes.ironman
local function key(value) return string.lower(tostring(value or '')):gsub('[^%w]','') end
function A.supports(model) return key(model)=='puzzle' or routes[key(model)]~=nil end
function A.create(parent,options)
 options=options or {};local copy={}
 for k,v in pairs(options) do copy[k]=v end
 local d=byId[copy.itemId or copy.id]
 if d then
  if not A.supports(copy.model) then copy.model=d.model end
  if not copy.name or copy.name==d.id then copy.name=d.name end
 end
 local modelKey=key(copy.model or (d and d.model))
 assert(modelKey=='puzzle' or routes[modelKey], 'No detailed art for '..tostring(copy.model))
 if modelKey=='puzzle' then return Puzzle.create(parent,copy) end
 local route=routes[modelKey];local builder=P.new(parent,copy)
 assert(families[route.family].build(builder,route.key),'Art route did not build')
 return builder:finish()
end
return A
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_DetailedArt_LandmarkArt"><Properties><string name="Name">LandmarkArt</string><ProtectedString name="Source">local P=require(script.Parent.Primitives)
local Architecture=require(script.Parent.Architecture)
local ItemArt=require(script.Parent.ItemArt)
local L={}
L.Keys={"baseBuilding","riftPortal","bellTower","squidHouse","godSlifer","godObelisk","godRa","blackLotus","pancakes","tournamentPillar","mtgCard","clashTower","skyFlower","guardian"}
local aliases={}
for _,key in ipairs(L.Keys) do aliases[string.lower(key)]=key end
function L.create(parent,options)
 options=options or {};local copy={}
 for k,v in pairs(options) do copy[k]=v end
 local key=assert(aliases[string.lower(tostring(copy.model or ""))],"Unknown landmark")
 copy.partBudget=copy.partBudget or 1000
 copy.alignBase=false
 local b=P.new(parent,copy)
 if key=="guardian" then
  local gold=Color3.fromRGB(199,149,52)
  local stone=Color3.fromRGB(45,39,58)
  b:box("GuardianPlinth",Vector3.new(8,1.2,5),CFrame.new(0,.6,0),stone,Enum.Material.Slate,true)
  b:box("GuardianPlinthLip",Vector3.new(8.2,.15,5.2),CFrame.new(0,1.25,0),gold)
  local scale=copy.scale or 1
  local function figure(id,name,cf)
   return ItemArt.create(b.model,{itemId=id,name=name,scale=scale,cframe=cf,partBudget=240})
  end
  figure("item25","DetailedHeadTorso",CFrame.new(0,4.6*scale,0))
  for _,side in ipairs({-1,1}) do
   figure(side&lt;0 and "item28" or "item29",side&lt;0 and "LeftLeg" or "RightLeg",CFrame.new(side*.68*scale,1.25*scale,0))
   figure(side&lt;0 and "item26" or "item27",side&lt;0 and "LeftArm" or "RightArm",
    CFrame.new(side*1.65*scale,6.15*scale,0)*CFrame.Angles(0,0,side*2.3)*CFrame.new(0,-3.45*scale,0))
  end
  local model=b:finish();local count=0
  for _,p in ipairs(model:GetDescendants()) do if p:IsA("BasePart") then count=count+1 end end
  model:SetAttribute("PartCount",count)
  return model
 end
 assert(Architecture.build(b,key),"Landmark did not build")
 return b:finish()
end
return L
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_DetailedArt_WorldArt"><Properties><string name="Name">WorldArt</string><ProtectedString name="Source">-- Static scenery upgrades. Gameplay anchors, state, prices and remotes are unchanged.
local L=require(script.Parent.LandmarkArt)
local P=require(script.Parent.Primitives)
local E=require(script.Parent.ExtraDecor)
local W={}
local V,C,A=Vector3.new,CFrame.new,CFrame.Angles
local function group(parent,name)
 local g=Instance.new("Model");g.Name=name;g.Parent=parent;return g
end
function W.pillars(parent)
 local root=group(parent,"CelestialArenaPillars")
 for _,x in ipairs({-126,126}) do
  for _,z in ipairs({-84,-42,42,84}) do
   L.create(root,{model="tournamentPillar",name="DetailedArenaPillar",cframe=C(x,0,z),scale=1.5})
  end
 end
end
function W.monument(parent)
 return L.create(parent,{model="guardian",name="FivePieceAncientGuardian",scale=5.7,cframe=C(-40,20,-108)*A(0,math.pi,0)})
end
function W.tower(parent)
 return require(script.Parent.Parent.FreeModels.FreeWorld).tower(parent)
end
function W.stoneHead(parent)
 return L.create(parent,{model="squidHouse",name="TidalStoneHead",scale=1.5,cframe=C(-94,14,-114)*A(0,math.pi,0)})
end
function W.roofs(parent,bases)
 local root=group(parent,"VaultRoofs")
 for i,base in ipairs(bases) do
  local m=L.create(root,{model="baseBuilding",name="BaseRoof"..i,cframe=base.cf,
   roofHeight=17.5,accent=Color3.fromHSV((i-1)/#bases,.48,.86)})
  m:SetAttribute("BaseCF",base.cf)
 end
end
function W.skyFlowers(parent)
 local root=group(parent,"PastelSkyFlowers")
 local sites={V(-118,90,-150),V(120,104,-155),V(-85,86,145),V(105,82,150)}
 for i,position in ipairs(sites) do
  L.create(root,{model="skyFlower",name="SkyFlower"..i,cframe=C(position),scale=.8+(i%2)*.15})
 end
end
function W.applyLighting()
 local lighting=game:GetService("Lighting")
 lighting.ClockTime=0.2;lighting.Brightness=2
 lighting.Ambient=Color3.fromRGB(135,111,156)
 lighting.OutdoorAmbient=Color3.fromRGB(115,91,145)
 lighting.ExposureCompensation=.12
 local atmosphere=lighting:FindFirstChildOfClass("Atmosphere")
 if not atmosphere then atmosphere=Instance.new("Atmosphere");atmosphere.Name="AestheticsAtmosphere";atmosphere.Parent=lighting end
 atmosphere.Density=.025;atmosphere.Offset=.05
 atmosphere.Color=Color3.fromRGB(164,137,193)
 atmosphere.Decay=Color3.fromRGB(65,37,94)
 atmosphere.Glare=0;atmosphere.Haze=.08
end
function W.domain(parent)
 local b=P.new(parent,{model="DomainDome",name="VioletDomainDome",alignBase=false,partBudget=800})
 local radius,height=260,180
 local bands,sectors=6,16
 local function point(row,column)
  local elevation=row/bands*math.pi*.5
  local angle=column/sectors*math.pi*2
  return V(radius*math.cos(elevation)*math.cos(angle),height*math.sin(elevation),
   radius*math.cos(elevation)*math.sin(angle))
 end
 for row=0,bands-1 do
  for col=0,sectors-1 do
   local a,c,d,e=point(row,col),point(row,col+1),point(row+1,col+1),point(row+1,col)
   local color=Color3.fromRGB(22+row*2,12+row,37+row*3)
   b:triangle("DomainPanelA_"..row.."_"..col,a,c,d,color,.5,Enum.Material.SmoothPlastic)
   b:triangle("DomainPanelB_"..row.."_"..col,a,d,e,color,.5,Enum.Material.SmoothPlastic)
  end
 end
 for col=0,sectors-1,2 do
  for row=0,bands-1 do
   b:line("DomainMeridian_"..col.."_"..row,point(row,col)*.997,point(row+1,col)*.997,.2,.2,
    Color3.fromRGB(94,43,143),Enum.Material.Neon)
  end
 end
 for i=1,34 do
  local angle=i*2.399963;local r=75+(i%5)*9
  local position=V(math.cos(angle)*r,137+(i%4)*5,math.sin(angle)*r)
  b:ball("DomainStar_"..i,.3+(i%3)*.12,C(position),Color3.fromRGB(235,202,255),Enum.Material.Neon)
 end
 -- A dark backstop fills any view outside the faceted hemisphere.
 for _,side in ipairs({-1,1}) do
  b:box("DomainBackstopX"..side,V(1,1200,1200),C(side*600,0,0),Color3.fromRGB(17,9,29),Enum.Material.Neon)
  b:box("DomainBackstopZ"..side,V(1200,1200,1),C(0,0,side*600),Color3.fromRGB(17,9,29),Enum.Material.Neon)
 end
 b:box("DomainBackstopTop",V(1200,1,1200),C(0,600,0),Color3.fromRGB(17,9,29),Enum.Material.Neon)
 return b:finish()
end
function W.buildBackground(world)
 local old=world.folder:FindFirstChild("BackgroundArt");if old then old:Destroy() end
 local root=group(world.folder,"BackgroundArt")
 W.domain(root)
 L.create(root,{model="riftPortal",name="OrnateRiftFrame",cframe=C(119,0,0)})
 E.mirrorForcePlanet(root,C(14,106,-152)*A(0,math.pi,0))
 return root
end
function W.addDecorations(world)
 local previous=world.folder:FindFirstChild("DetailedLandmarks")
 if previous then previous:Destroy() end
 local phase=world.folder:FindFirstChild("PhaseDecor")
 if phase then
  for _,name in ipairs({"MidnightLotus","LotusScenicPedestal","LotusGem","RiftArchiveCard"}) do
   local old=phase:FindFirstChild(name);if old then old:Destroy() end
  end
 end
 local root=group(world.folder,"DetailedLandmarks")
 L.create(root,{model="blackLotus",name="MidnightLotus",scale=2,cframe=C(-70,31,106)})
 L.create(root,{model="mtgCard",name="RiftArchiveCard",scale=1.5,cframe=C(104,38,110)})
 local cards={{"godSlifer",-105},{"godObelisk",-35},{"godRa",75}}
 for _,entry in ipairs(cards) do
  L.create(root,{model=entry[1],name=entry[1],scale=1.2,cframe=C(entry[2],34,155)})
 end
 for _,x in ipairs({-125,125}) do
  L.create(root,{model="clashTower",name="CrownArenaTower",scale=1.1,cframe=C(x,24,28)})
 end
 L.create(root,{model="pancakes",name="PancakeMonument",scale=2.5,cframe=C(105,26,93)})
 E.racetrack(root)
 E.crimsonDragon(root,C(-84,68,114))
 E.shenron(root,C(92,66,-120)*A(0,math.pi,0))
 return root
end
return W
</ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX_FreeCatalog_64"><Properties><string name="Name">FreeCatalog</string><ProtectedString name="Source">-- Append before Catalog builds ById/ByTier. Existing item01-item46 are unchanged.
