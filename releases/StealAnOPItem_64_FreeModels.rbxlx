					<BinaryString name="AttributesSerialize">AQAAAAkAAABDbGFzc05hbWUCDAAAAE1vZHVsZVNjcmlwdA==</BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Catalog</string>
					<BinaryString name="SerializedOverrides" />
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">73dc296d0ee214c70ae114fb00001ee0</UniqueId>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX9a338f3bda6740bab7b79dcc579e3b10">
				<Properties>
					<string name="Value">local Players=game:GetService('Players')
local RS=game:GetService('ReplicatedStorage')
local Run=game:GetService('RunService')
local CAS=game:GetService('ContextActionService')
local Tween=game:GetService('TweenService')
local Debris=game:GetService('Debris')
local p=Players.LocalPlayer
local net=RS:WaitForChild('OPItemNet'); local action=net:WaitForChild('Action'); local update=net:WaitForChild('Update')
local catalog=require(net:WaitForChild('Catalog')); local templates=net:WaitForChild('Models')
local gui=Instance.new('ScreenGui'); gui.Name='OPItemHUD'; gui.ResetOnSpawn=false; gui.Parent=p:WaitForChild('PlayerGui')
local screen=Instance.new('Frame'); screen.Name='Canvas'; screen.BackgroundTransparency=1; screen.Size=UDim2.fromOffset(1080,720); screen.AnchorPoint=Vector2.new(.5,.5); screen.Position=UDim2.fromScale(.5,.5); screen.Parent=gui
local scale=Instance.new('UIScale'); scale.Parent=screen
local function resize() local v=workspace.CurrentCamera.ViewportSize; scale.Scale=math.min(v.X/1100,v.Y/750,1.3) end
resize(); workspace.CurrentCamera:GetPropertyChangedSignal('ViewportSize'):Connect(resize)
local colors={bg=Color3.fromRGB(14,20,34),panel=Color3.fromRGB(25,34,53),ink=Color3.fromRGB(235,243,255),muted=Color3.fromRGB(153,172,198),cyan=Color3.fromRGB(77,224,230),gold=Color3.fromRGB(245,192,67)}
local function corner(x,r) Instance.new('UICorner',x).CornerRadius=UDim.new(0,r or 10) end
local function frame(parent,x,y,w,h)
 local f=Instance.new('Frame'); f.Position=UDim2.fromOffset(x,y); f.Size=UDim2.fromOffset(w,h); f.BackgroundColor3=colors.panel; f.BorderSizePixel=0; f.Parent=parent; corner(f); return f
end
local function text(parent,str,x,y,w,h,size,color)
 local l=Instance.new('TextLabel'); l.Position=UDim2.fromOffset(x,y); l.Size=UDim2.fromOffset(w,h); l.Text=str; l.TextColor3=color or colors.ink; l.Font=Enum.Font.GothamMedium; l.TextSize=size or 16; l.BackgroundTransparency=1; l.TextXAlignment=Enum.TextXAlignment.Left; l.TextWrapped=true; l.Parent=parent; return l
end
local function button(parent,str,x,y,w,h,cb)
 local b=Instance.new('TextButton'); b.Position=UDim2.fromOffset(x,y); b.Size=UDim2.fromOffset(w,h); b.Text=str; b.Font=Enum.Font.GothamBold; b.TextSize=15; b.TextColor3=colors.ink; b.BackgroundColor3=Color3.fromRGB(42,59,83); b.BorderSizePixel=0; b.Parent=parent; corner(b,8); b.Activated:Connect(cb); return b
end
local top=frame(screen,20,12,1040,78)
text(top,'STEAL AN OP ITEM',18,8,310,30,23,colors.gold)
text(top,'SESSION ALPHA  /  PROGRESS RESETS ON LEAVE',18,42,460,20,12,colors.muted)
local cash=text(top,'$',520,12,250,25,22,colors.cyan)
local income=text(top,'',520,42,300,22,14,colors.muted)
local protect=text(top,'',825,12,200,50,16)
local notice=frame(screen,235,100,610,50); notice.Visible=false
local noticeText=text(notice,'',15,3,580,44,17)
local noticeId=0
local function message(msg)
 noticeId=noticeId+1; local n=noticeId; noticeText.Text=msg; notice.Visible=true
 task.delay(4,function() if noticeId==n then notice.Visible=false end end)
end
local panel=frame(screen,175,164,730,446); panel.Visible=false
local title=text(panel,'',20,12,630,32,24,colors.gold)
button(panel,'X',675,10,38,34,function() panel.Visible=false end)
local content=frame(panel,15,56,700,376); content.BackgroundTransparency=1
local state=nil; local mode='Inventory'; local selected=nil; local confirmSale=nil; local reduced=false; local inventoryKey=''
local function clear() for _,c in ipairs(content:GetChildren()) do c:Destroy() end end
local function viewport(d,parent,x,y,w,h)
 local vp=Instance.new('ViewportFrame'); vp.Position=UDim2.fromOffset(x,y); vp.Size=UDim2.fromOffset(w,h); vp.BackgroundColor3=colors.bg; vp.BorderSizePixel=0; vp.Ambient=Color3.fromRGB(200,200,220); vp.LightColor=Color3.new(1,1,1); vp.Parent=parent; corner(vp)
 local camera=Instance.new('Camera'); camera.Parent=vp; vp.CurrentCamera=camera
 local template=templates:FindFirstChild(d.id)
 if template then local m=template:Clone(); m.Parent=vp; m:PivotTo(CFrame.Angles(0,.35,0)); camera.CFrame=CFrame.lookAt(Vector3.new(5,3.5,7),Vector3.new(0,1.4,0)); camera.FieldOfView=32 end
 return vp
end
local render
render=function()
 if not state then return end
 clear(); title.Text=mode
 if mode=='Help' then
  text(content,'1  BUY at the purple rift market.\n\n2  EARN cash in your vault, then COLLECT it at the green pad.\n\n3  RAID an OPEN vault. Interact with a relic and carry it to your own green pad. Its owner can recover it by getting close.\n\n4  EQUIP a relic in Inventory. Use Power or Q / controller R2. Powers are disabled while carrying.\n\n5  PROTECT stored items at the gold console. Upgrade slots at the cyan console.\n\nThis alpha resets when you leave. The field prevents new thefts, not movement through the gate.',12,4,665,320,17)
 elseif mode=='Settings' then
  text(content,'Comfort &amp; development',15,8,500,35,20)
  button(content,reduced and 'Reduced effects: ON' or 'Reduced effects: OFF',15,58,300,45,function() reduced=not reduced; render() end)
  text(content,'Reduces idle animation and ability flashes. No downloaded music or audio is included in this milestone.',15,118,650,65,17,colors.muted)
  if state.studio then button(content,'STUDIO ONLY: $2.5M test cash',15,215,330,44,function() action:FireServer('testCash') end) end
 elseif mode=='Inventory' or mode=='Index' then
  local list=Instance.new('ScrollingFrame'); list.Size=UDim2.fromOffset(340,370); list.BackgroundTransparency=1; list.BorderSizePixel=0; list.ScrollBarThickness=5; list.AutomaticCanvasSize=Enum.AutomaticSize.Y; list.CanvasSize=UDim2.new(); list.Parent=content
  local layout=Instance.new('UIListLayout'); layout.Padding=UDim.new(0,6); layout.Parent=list
  local entries={}
  if mode=='Index' then for _,d in ipairs(catalog.Items) do entries[#entries+1]={kind=d.id} end
  else entries=state.inventory end
  local chosen=nil
  for _,entry in ipairs(entries) do
   local d=catalog.ById[entry.kind]; local key=entry.uid or entry.kind
   if selected==key then chosen=entry end
   local b=button(list,(state.equipped==entry.uid and '★ ' or '')..d.name..'\n'..d.rarity..(entry.carried and ' / IN TRANSIT' or '')..(mode=='Index' and (state.seen[d.id] and ' / FOUND' or ' / UNDISCOVERED') or ''),0,0,324,55,function() selected=key; confirmSale=nil; render() end)
   b.TextXAlignment=Enum.TextXAlignment.Left; b.TextSize=14
   local tc=catalog.Colors[d.tier]; local stroke=Instance.new('UIStroke',b); stroke.Color=Color3.fromRGB(tc[1],tc[2],tc[3]); stroke.Thickness=selected==key and 2 or .6
  end
  chosen=chosen or entries[1]
  if chosen then
   local d=catalog.ById[chosen.kind]; selected=chosen.uid or chosen.kind
   viewport(d,content,360,0,330,190)
   text(content,d.name,360,195,330,28,21,colors.gold)
   text(content,d.rarity..'  •  '..d.category..'\n+$'..d.income..'/s  |  Value $'..d.price..'\nPower: '..string.upper(d.power),360,227,330,78,16)
   if mode=='Inventory' then
    button(content,'EQUIP',360,321,150,40,function() action:FireServer('equip',chosen.uid) end)
    button(content,confirmSale==chosen.uid and 'CONFIRM $'..math.floor(d.price*.5) or 'SELL 50%',520,321,170,40,function()
     if confirmSale==chosen.uid then action:FireServer('sell',chosen.uid); confirmSale=nil else confirmSale=chosen.uid; render() end
    end)
   elseif state.studio then button(content,'STUDIO: put on stand 8',360,321,330,40,function() action:FireServer('testMarket',d.id); message('Walk to the final market stand to purchase.'); end) end
  else text(content,'Your vault is empty. Buy a relic at the rift market.',12,12,600,80,20) end
 end
end
local function show(which) mode=which; selected=nil; confirmSale=nil; panel.Visible=true; render() end
local bottom=frame(screen,160,632,760,68)
button(bottom,'Inventory',10,12,140,44,function() show('Inventory') end)
button(bottom,'Index / 56',160,12,140,44,function() show('Index') end)
button(bottom,'How to play',310,12,140,44,function() show('Help') end)
button(bottom,'Settings',460,12,130,44,function() show('Settings') end)
local ability=button(bottom,'POWER [Q]',600,12,150,44,function() action:FireServer('power') end)
CAS:BindAction('OPItemPower',function(_,input)
 if input==Enum.UserInputState.Begin then action:FireServer('power') end
 return Enum.ContextActionResult.Sink
end,false,Enum.KeyCode.Q,Enum.KeyCode.ButtonR2)
CAS:BindAction('OPItemInventory',function(_,input)
 if input==Enum.UserInputState.Begin then show('Inventory') end
 return Enum.ContextActionResult.Sink
end,false,Enum.KeyCode.I,Enum.KeyCode.ButtonY)
local first=true
update.OnClientEvent:Connect(function(s)
 if s.message then message(s.message); return end
 state=s
 cash.Text='$'..s.cash..'   •   '..s.steals..' steals'
 income.Text='+$'..s.income..'/s  |  $'..s.bank..' waiting in vault'
 protect.Text=s.lock&gt;0 and 'PROTECTED '..s.lock..'s' or 'VAULT OPEN\nLock recharge: '..s.lockReady..'s'
 ability.Text=s.carry and 'CARRYING' or (s.cooldown&gt;0 and 'POWER '..s.cooldown..'s' or 'POWER [Q]')
 local keys={tostring(s.equipped),tostring(s.capacity)}
 for _,it in ipairs(s.inventory) do keys[#keys+1]=it.uid..tostring(it.carried) end
 local key=table.concat(keys,':')
 if panel.Visible and key~=inventoryKey then render() end
 inventoryKey=key
 if first then first=false; show('Help') end
end)
net.FX.OnClientEvent:Connect(function(kind,origin,size)
 if reduced then return end
 local f=Instance.new('Part'); f.Name='LocalPowerEffect'; f.Anchored=true; f.CanCollide=false; f.CanTouch=false; f.CanQuery=false; f.Shape=Enum.PartType.Ball
 f.Material=Enum.Material.Neon; f.Color=kind=='shadow' and Color3.fromRGB(170,65,240) or Color3.fromRGB(71,219,241)
 f.Transparency=.8; f.Size=Vector3.new(1,1,1); f.Position=origin; f.Parent=workspace
 local target=kind=='shield' and 7 or math.min(size*2,28)
 Tween:Create(f,TweenInfo.new(kind=='shadow' and 1.1 or .5),{Size=Vector3.new(target,target,target),Transparency=1}):Play(); Debris:AddItem(f,1.3)
end)
local world=workspace:WaitForChild('OPItemWorld'); local animated={}
local function add(m)
 if m:IsA('Model') and m:GetAttribute('Kind') then
  local arms={}
  for _,part in ipairs(m:GetChildren()) do
   if part:IsA('BasePart') and part:GetAttribute('IdleArm') then
    arms[#arms+1]={part=part,offset=m:GetPivot():ToObjectSpace(part.CFrame),side=part:GetAttribute('IdleArm')}
   end
  end
  animated[m]=arms
 end
end
for _,m in ipairs(world:GetChildren()) do add(m) end
world.ChildAdded:Connect(add); world.ChildRemoved:Connect(function(m) animated[m]=nil end)
local elapsed=0
Run.RenderStepped:Connect(function(dt)
 elapsed=elapsed+dt; if elapsed&lt;1/30 then return end; elapsed=0
 if reduced then return end
 local now=os.clock(); local camera=workspace.CurrentCamera
 for m,arms in pairs(animated) do
  local cf=m:GetAttribute('DisplayCF')
  if cf and not m:GetAttribute('Carried') and (camera.CFrame.Position-cf.Position).Magnitude&lt;110 then
   local isCharacter=m:GetAttribute('AnimatedCharacter')
   local pivot=cf*CFrame.new(0,math.sin(now*1.5)*.1,0)*CFrame.Angles(0,isCharacter and math.sin(now)*.08 or now*.3,0)
   m:PivotTo(pivot)
   for _,arm in ipairs(arms) do
    arm.part.CFrame=pivot*arm.offset*CFrame.Angles(math.sin(now*1.6)*.09*arm.side,0,0)
   end
  end
 end
end)
action:FireServer('ready')
