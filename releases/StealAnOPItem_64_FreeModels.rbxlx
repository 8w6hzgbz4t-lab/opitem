			<Item class="StringValue" referent="RBX697d0416d12d45798a00e0fe5b3735f2">
				<Properties>
					<string name="Value">-- All geometry is generated here. No downloaded meshes, textures, or asset scripts.
local F={}
local function rgb(r,g,b) return Color3.fromRGB(r,g,b) end
local gold=rgb(238,184,60); local steel=rgb(174,193,208); local dark=rgb(30,36,51)
function F.part(parent,name,size,cf,color,material,shape)
 local p=Instance.new('Part'); p.Name=name; p.Size=size; p.CFrame=cf
 p.Anchored=true; p.CanCollide=false; p.CanTouch=false; p.CanQuery=false; p.Color=color or steel
 p.Material=material or Enum.Material.SmoothPlastic
 p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth
 if shape then p.Shape=shape end
 p.Parent=parent; return p
end
function F.create(d,parent)
 local m=Instance.new('Model'); m.Name=d.name
 local root=F.part(m,'Root',Vector3.new(.1,.1,.1),CFrame.new(),dark); root.Transparency=1
 m.PrimaryPart=root
 local tint=Color3.fromHSV((d.tier-1)/7,.65,1)
 local function p(n,x,y,z,sx,sy,sz,c,mat,shape,rot)
  return F.part(m,n,Vector3.new(sx,sy,sz),CFrame.new(x,y,z)*(rot or CFrame.new()),c,mat,shape)
 end
 local function ball(n,x,y,z,s,c) return p(n,x,y,z,s,s,s,c,Enum.Material.SmoothPlastic,Enum.PartType.Ball) end
 local function ring(n,x,y,z,r,c)
  for i=1,16 do local a=i*math.pi/8
   p(n, x+math.cos(a)*r,y+math.sin(a)*r,z,.25,.5,.22,c,Enum.Material.Metal,nil,CFrame.Angles(0,0,a-math.pi/2))
  end
 end
 local k=d.model
 if d.category=='Character' and k~='bird' and k~='dragon' and k~='metaknight' and k~='mech' then
  local body=dark; local hair=dark; local skin=rgb(230,182,143); local wide=1
  if k=='knight' then body=rgb(39,46,61); skin=steel; wide=1.55
  elseif k=='saitama' then body=rgb(245,191,42)
  elseif k=='goku' then body=rgb(244,110,31); hair=gold
  elseif k=='luffy' then body=rgb(210,48,43)
  elseif k=='gojo' then hair=Color3.new(1,1,1)
  elseif k=='sukuna' then hair=rgb(230,146,159)
  elseif k=='rimuru' then hair=rgb(106,204,238)
  elseif k=='giorno' then body=rgb(201,64,137); hair=gold
  elseif k=='dio' then body=gold; hair=gold
  elseif k=='anos' or k=='yhwach' then body=rgb(223,229,237)
  elseif k=='exodia' then body=gold; skin=gold; wide=1.5
  elseif k=='titan' then body=rgb(64,120,215); skin=body; wide=1.6
  elseif k=='beerus' then skin=rgb(151,87,190); body=rgb(56,147,200)
  elseif k=='zeno' then skin=rgb(87,192,227); body=rgb(208,81,182)
  elseif k=='blockman' then body=rgb(45,179,183); hair=rgb(67,43,31) end
  p('Torso',0,1.45,0,1.35*wide,1.5,.7,body)
  p('Belt',0,.97,0,1.4*wide,.18,.76,gold,Enum.Material.Metal)
  p('LegL',-.38*wide,.25,0,.52*wide,1,.6,dark)
  p('LegR',.38*wide,.25,0,.52*wide,1,.6,dark)
  p('BootL',-.38*wide,-.17,-.12,.58*wide,.28,.9,dark)
  p('BootR',.38*wide,-.17,-.12,.58*wide,.28,.9,dark)
  local left=p('LeftArm',-.96*wide,1.5,0,.5*wide,1.35,.6,body)
  local right=p('RightArm',.96*wide,1.5,0,.5*wide,1.35,.6,body)
  left:SetAttribute('IdleArm',-1); right:SetAttribute('IdleArm',1)
  p('Head',0,2.67,0,1.05,1,.85,skin,nil,k=='blockman' and Enum.PartType.Block or Enum.PartType.Ball)
  for _,x in ipairs({-.22,.22}) do p('Eye',x,2.76,-.44,.09,.1,.06,dark) end
  if k~='saitama' and k~='knight' and k~='exodia' and k~='titan' and k~='zeno' then
   for i=-2,2 do
    local h=p('Hair',i*.22,3.23+(.18-math.abs(i)*.05),0,.3,.6,.8,hair,nil,nil,CFrame.Angles(0,0,-i*.18))
   end
  end
  if k=='gojo' then p('Blindfold',0,2.8,-.47,1.08,.27,.12,dark)
  elseif k=='luffy' then p('StrawBrim',0,3.22,0,.12,1.9,1.9,gold,nil,Enum.PartType.Cylinder,CFrame.Angles(0,0,math.pi/2)); ball('HatCrown',0,3.3,0,1.2,gold)
  elseif k=='saitama' then
   p('Cape',0,1.4,.55,1.7,2.4,.12,Color3.new(1,1,1)); ball('GloveL',-.96,1,0,.65,rgb(220,40,40)); ball('GloveR',.96,1,0,.65,rgb(220,40,40))
  elseif k=='knight' then
   p('Helmet',0,2.8,0,1.45,1.1,1.2,dark,Enum.Material.Metal)
   p('Visor',0,2.75,-.63,1.1,.19,.09,gold,Enum.Material.Neon)
   for _,x in ipairs({-1.6,1.6}) do
    ball('Shoulder',x,2.1,0,1,steel); p('Gauntlet',x,.92,-.1,.9,.9,.9,steel,Enum.Material.Metal)
    for j=1,3 do ball('GoldStud',x+(j-2)*.21,1.14,-.57,.15,gold) end
   end
   p('Plume',0,3.55,.1,.3,.55,.4,rgb(53,77,166))
  elseif k=='duelist' then
   for i=-2,2 do p('GoldFringe',i*.22,2.95,-.5,.16,.7,.12,gold,nil,nil,CFrame.Angles(0,0,i*.3)) end
   p('Coat',0,1.12,.49,1.5,2,.12,rgb(103,42,140)); ball('Pendant',0,1.65,-.48,.28,gold)
  elseif k=='beerus' then
   for _,x in ipairs({-.36,.36}) do p('LongEar',x,3.5,0,.3,1.1,.4,skin) end
   p('Collar',0,2.08,-.05,1.5,.3,.85,gold)
  elseif k=='titan' or k=='exodia' then
   for _,x in ipairs({-1.6,1.6}) do ball('Shoulder',x,2.1,0,1.2,body); ring('WristBand',x,.85,-.35,.36,gold) end
   p('Crest',0,3.4,0,.4,.9,.35,gold)
  elseif k=='sukuna' then for _,x in ipairs({-.32,.32}) do p('FaceMark',x,2.52,-.43,.05,.32,.05,dark) end
  elseif k=='rimuru' then ball('SlimeCompanion',1.3,.2,-.6,.65,rgb(72,196,242))
  elseif k=='yhwach' then p('Moustache',0,2.5,-.48,.65,.12,.1,dark); p('Cloak',0,1.3,.55,2,2.5,.15,steel)
  elseif k=='jinwoo' then p('ShadowBlade',1.1,1.5,-.5,.18,1.8,.2,rgb(166,62,251),Enum.Material.Neon)
  elseif k=='zeno' then p('RobeBand',0,1.5,-.41,.4,1.5,.08,gold); ball('EarL',-.57,2.7,0,.35,rgb(150,72,210)); ball('EarR',.57,2.7,0,.35,rgb(150,72,210)) end
 elseif k=='puzzle' then
  -- 24 square layers approximate an inverted square pyramid without a mesh dependency.
  for i=1,24 do local w=i/24*2.6; p('GoldPuzzleLayer',0,(i-1)*.095,0,w,.095,w,gold,Enum.Material.Metal) end
  ring('PendantLoop',0,2.75,0,.42,gold)
  for i=1,5 do p('FrontSeam',0,.45+i*.31,-(.45+i*.31)/2.28*1.3-.03,.4+i*.36,.025,.03,dark) end
  p('EyeBrow',0,1.76,-1.04,1.15,.07,.06,dark,nil,nil,CFrame.Angles(0,0,.1))
  for _,x in ipairs({-.3,.3}) do p('EyeWing',x,1.54,-.94,.64,.07,.08,dark,nil,nil,CFrame.Angles(0,0,x&gt;0 and .35 or -.35)) end
  ball('Eye',0,1.55,-1.01,.22,dark); p('EyeStem',0,1.23,-.77,.055,.5,.07,dark)
 elseif k=='sword' or k=='buster' or k=='pixel' or k=='energy' or k=='scythe' then
  p('Grip',0,.15,0,.28,1,.28,dark); p('Pommel',0,-.42,0,.44,.2,.4,gold,Enum.Material.Metal)
  p('Guard',0,.72,0,k=='buster' and 1.3 or 1.7,.2,.35,k=='sword' and tint or steel,Enum.Material.Metal)
  if k=='pixel' then for i=1,7 do p('BladePixel',math.sin(i)*.08,.8+i*.35,0,.45+((i%2)*.3),.38,.19,rgb(44,235,230),Enum.Material.Metal) end
  elseif k=='energy' then for _,x in ipairs({-.4,.4}) do p('PlasmaProng',x,1.95,0,.28,2.5,.19,rgb(57,230,255),Enum.Material.Neon,nil,CFrame.Angles(0,0,-x*.3)) end
  elseif k=='scythe' then p('Shaft',0,1.2,0,.18,3,.2,dark); p('Hook',.9,2.65,0,2,.25,.18,tint,Enum.Material.Metal,nil,CFrame.Angles(0,0,-.3))
  else
   local blade=p('Blade',0,2.1,0,k=='buster' and 1.25 or .55,2.6,.18,k=='sword' and (d.name=='Moonlight Blade' and rgb(74,238,243) or steel) or steel,Enum.Material.Metal)
   p('BladeEdge',.28,2.1,-.01,.06,2.5,.22,Color3.new(.9,.96,1),Enum.Material.Neon)
   if k=='buster' then for _,y in ipairs({1.05,1.45}) do ball('BladeRivet',-.32,y,-.12,.19,dark) end end
  end
 elseif k=='shield' then
  p('SilverRim',0,1.4,0,2.1,2.6,.3,steel,Enum.Material.Metal)
  p('BlueFace',0,1.45,-.2,1.8,2.2,.15,rgb(38,65,172))
  p('LowerPoint',0,.02,0,1.3,.8,.3,steel,Enum.Material.Metal,nil,CFrame.Angles(0,0,math.pi/4))
  for i=-1,1 do p('GoldCrest',i*.3,1.5+math.abs(i)*.2,-.32,.28,.65,.08,gold,Enum.Material.Metal,nil,CFrame.Angles(0,0,i*.4)) end
 elseif k=='hammer' then
  p('Handle',0,.5,0,.28,2,.28,rgb(104,65,40)); p('Head',0,2,0,2.5,1.25,1,d.name=='Thunder Hammer' and steel or rgb(114,71,40),Enum.Material.Metal)
  for _,x in ipairs({-.9,.9}) do p('Band',x,2,0,.15,1.3,1.06,gold,Enum.Material.Metal) end
 elseif k=='chains' then
  for _,side in ipairs({-1,1}) do for i=1,6 do ring('Chain',side*.8,2.9-i*.3,0,.15,steel) end
   p('Blade',side*.8,.5,0,.5,1.3,.2,gold,Enum.Material.Metal,nil,CFrame.Angles(0,0,side*.4)) end
 elseif k=='hat' then
  p('Brim',0,.8,0,.15,3,3,steel,Enum.Material.Metal,Enum.PartType.Cylinder,CFrame.Angles(0,0,math.pi/2))
  ball('Crown',0,1,0,1.4,rgb(41,97,122))
 elseif k=='banana' then
  for i=1,3 do local a=i*math.pi*2/3; p('Peel',math.cos(a)*.5,.4,math.sin(a)*.5,.28,1.4,.3,gold,nil,nil,CFrame.Angles(math.sin(a)*.8,0,math.cos(a)*.8)) end
 elseif k=='cup' then
  p('Stem',0,.6,0,.2,1,.2,gold,Enum.Material.Metal); p('Base',0,0,0,.14,1.3,1.3,gold,Enum.Material.Metal,Enum.PartType.Cylinder,CFrame.Angles(0,0,math.pi/2))
  ball('Bowl',0,1.4,0,1.6,gold); p('Wine',0,1.96,0,.06,1.05,1.05,rgb(98,19,55),nil,Enum.PartType.Cylinder,CFrame.Angles(0,0,math.pi/2))
 elseif k=='gauntlet' then
  p('Palm',0,1,0,1.5,1.6,.8,gold,Enum.Material.Metal)
  for i=1,4 do p('Finger',-.72+i*.3,2.15,0,.24,.95,.6,gold,Enum.Material.Metal); ball('Gem',-.72+i*.3,1.85,-.46,.2,Color3.fromHSV(i/6,1,1)) end
  p('Thumb',-.94,1.13,0,.45,.95,.6,gold,Enum.Material.Metal,nil,CFrame.Angles(0,0,-.4)); ball('MindGem',0,1,-.47,.37,tint)
 elseif k=='ring' then ring('Ringworld',0,1.6,0,1.7,steel); ring('Habitat',0,1.6,-.15,1.45,rgb(70,222,180))
 elseif k=='cube' then
  local c=p('Matrix',0,1.2,0,1.8,1.8,1.8,rgb(67,178,255),Enum.Material.Glass); c.Transparency=.45
  ball('Star',0,1.2,0,.55,Color3.new(1,1,1)); ring('Frame',0,1.2,0,1.6,gold)
 elseif k=='metaknight' then
  ball('Body',0,1.1,0,2,rgb(48,63,151)); ball('Mask',0,1.3,-.7,1.4,steel)
  for _,x in ipairs({-.28,.28}) do p('Eye',x,1.4,-1.36,.25,.12,.05,gold,Enum.Material.Neon) end
  p('Cape',0,1,.7,2.5,1.5,.12,rgb(96,40,153)); p('Sword',1.4,1.1,0,.2,2.8,.2,gold)
 elseif k=='bird' or k=='dragon' then
  local c=k=='bird' and rgb(125,88,59) or (d.name=='Solar Divinity' and gold or rgb(200,50,49))
  ball('Body',0,1,0,1.4,c); ball('Head',0,2,-.3,.8,c)
  for _,side in ipairs({-1,1}) do
   for i=1,4 do p('WingFeather',side*(.6+i*.3),1.3-i*.1,0,.38,1.6-i*.15,.2,c,nil,nil,CFrame.Angles(0,0,side*.55)) end
   ball('Eye',side*.2,2.1,-.65,.12,gold)
  end
  p('Beak',0,1.95,-.85,.23,.22,.6,gold)
  if k=='dragon' then for i=1,5 do ball('Tail',math.sin(i)*.4,.9-i*.15,.4+i*.3,.8-i*.1,c) end end
 elseif k=='mech' then
  for _,x in ipairs({-.7,.7}) do p('Leg',x,.4,0,.6,1.8,.7,steel); p('Foot',x,-.35,-.5,.9,.4,1.5,dark) end
  p('Head',0,1.9,0,2.7,1.5,1.8,steel); p('Visor',0,2,-.94,1.7,.2,.1,rgb(255,73,73),Enum.Material.Neon)
  p('RailCannon',1.65,2.4,-.8,.3,.3,3,dark,Enum.Material.Metal)
 elseif k=='shell' then
  ball('Shell',0,.8,0,1.8,rgb(45,90,218)); ring('Rim',0,.65,-.7,.8,steel)
  for i=-1,1 do p('Spike',i*.55,1.6,0,.22,.7,.22,steel,nil,nil,CFrame.Angles(0,0,-i*.3)) end
 elseif k=='pellet' or k=='disco' then
  ball('Core',0,1,0,1.5,k=='pellet' and rgb(255,244,190) or steel)
  if k=='pellet' then p('DisplayCradle',0,.1,0,1.8,.15,.8,gold,Enum.Material.Metal); for _,x in ipairs({-.6,.6}) do p('CradleArm',x,.35,0,.1,.5,.5,gold) end end
  if k=='disco' then for i=1,12 do local a=i*math.pi/6; ball('DiscoPanel',math.cos(a)*.72,1+math.sin(a)*.72,-.24,.28,Color3.fromHSV(i/12,1,1)) end end
 elseif k=='bullet' then
  p('Capsule',0,1,0,2.5,1.2,1.2,dark,nil,Enum.PartType.Cylinder)
  ball('Nose',-1,1,0,1.2,dark); ball('Eye',-.65,1.2,-.55,.3,Color3.new(1,1,1))
 else
  -- Gun/device family: distinct receiver dimensions, barrel arrangements, prongs, cores.
  local c=(k=='gun' and gold) or (k=='raygun' and rgb(194,53,47)) or steel
  local length=(k=='rifle' and 3.8) or (k=='bfg' and 2.6) or 2
  p('Receiver',0,1,0,1.1,.85,length,c,Enum.Material.Metal)
  p('Grip',0,.25,.4,.4,.9,.55,dark,nil,nil,CFrame.Angles(-.2,0,0))
  if k=='minigun' then for i=1,6 do local a=i*math.pi/3; p('Barrel',math.cos(a)*.4,1+math.sin(a)*.4,-1.5,.2,.2,2,dark,Enum.Material.Metal) end
  elseif k=='shotgun' then for _,x in ipairs({-.25,.25}) do p('Barrel',x,1,-1.6,.35,.35,2,steel,Enum.Material.Metal) end
  else p('Barrel',0,1,-length/2-.4,.45,.45,1.3,dark,Enum.Material.Metal) end
  if k=='gravitygun' or k=='portalgun' or k=='device' then
   for _,x in ipairs({-.7,.7}) do p('Prong',x,1,-1.3,.18,.2,1.5,steel,Enum.Material.Metal,nil,CFrame.Angles(0,-x*.3,0)) end
  end
  if k~='rifle' and k~='shotgun' and k~='gun' then ball('EnergyCell',0,1.4,-.1,.75,k=='bfg' and rgb(100,255,74) or tint) end
 end
 m:SetAttribute('Kind',d.id); m:SetAttribute('AnimatedCharacter',d.category=='Character')
 m.Parent=parent; return m
end
return F
</string>
					<BinaryString name="AttributesSerialize">AQAAAAkAAABDbGFzc05hbWUCDAAAAE1vZHVsZVNjcmlwdA==</BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">ModelFactory</string>
					<BinaryString name="SerializedOverrides" />
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">73dc296d0ee214c70ae114fb00001ee4</UniqueId>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBXd32886c1289c45af9553d1b1b377bc7d">
				<Properties>
					<string name="Value">-- Place the OPItemV2 folder in ServerScriptService. Disable the old prototype.
local Players=game:GetService('Players')
local RS=game:GetService('ReplicatedStorage')
local Run=game:GetService('RunService')
local Lighting=game:GetService('Lighting')
local Config=require(script.Parent.Config)
assert(not workspace:FindFirstChild('OPPrototype'),'Disable your old StealAnOPItem script, stop, then press Play again.')
assert(not RS:FindFirstChild('OPItemNet'),'Only one OPItemV2 package may run.')
local Catalog=require(script.Parent.Catalog)
local Factory=require(script.Parent.ModelFactory)
local Core=require(script.Parent.Core)
local core=Core.new(Catalog)
local net=Instance.new('Folder'); net.Name='OPItemNet'; net.Parent=RS
local action=Instance.new('RemoteEvent'); action.Name='Action'; action.Parent=net
local update=Instance.new('RemoteEvent'); update.Name='Update'; update.Parent=net
local fx=Instance.new('RemoteEvent'); fx.Name='FX'; fx.Parent=net
script.Parent.Catalog:Clone().Parent=net
local templates=Instance.new('Folder'); templates.Name='Models'; templates.Parent=net
for _,d in ipairs(Catalog.Items) do local m=Factory.create(d,templates); m.Name=d.id end
local world=require(script.Parent.World).build(Factory)
Lighting.ClockTime=16; Lighting.Brightness=2
Lighting.Ambient=Color3.fromRGB(105,117,149); Lighting.OutdoorAmbient=Color3.fromRGB(130,140,167)
local runtime,visuals,offers={}, {}, {}
local rng=Random.new()
local function body(p)
 local c=p.Character; local h=c and c:FindFirstChildOfClass('Humanoid'); local r=c and c:FindFirstChild('HumanoidRootPart')
 if h and h.Health&gt;0 and r then return r,h end
end
local function near(p,pos,dist) local r=body(p); return r and (r.Position-pos).Magnitude&lt;=dist end
local function say(p,msg) if p and p.Parent then update:FireClient(p,{message=msg}) end end
local function los(a,b,ignore)
 local params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude
 local exclude={}
 for _,p in ipairs(Players:GetPlayers()) do if p.Character then exclude[#exclude+1]=p.Character end end
 if ignore then exclude[#exclude+1]=ignore end
 params.FilterDescendantsInstances=exclude
 return workspace:Raycast(a,b-a,params)==nil
end
local function allowed(p,pos,anchor)
 local rt=runtime[p.UserId]
 if not rt or not near(p,pos,11) or os.clock()&lt;rt.nextAction then return false end
 local r=body(p); if not r or not los(r.Position,pos,anchor) then return false end
 rt.nextAction=os.clock()+.22; return true
end
local function prompt(anchor,title,cb)
 local q=Instance.new('ProximityPrompt'); q.ActionText=title; q.ObjectText=anchor.Name
 q.MaxActivationDistance=9; q.RequiresLineOfSight=true; q.Parent=anchor
 q.Triggered:Connect(function(p) if q.Enabled and anchor.Parent and allowed(p,anchor.Position,anchor) then cb(p) end end)
 return q
end
local function send(p)
 local snap=core:snapshot(p.UserId,os.clock())
 if snap then snap.studio=Run:IsStudio(); snap.mode='SESSION ALPHA - progress resets on leave'; update:FireClient(p,snap) end
end
local function clone(kind)
 local m=templates[kind]:Clone(); m.Parent=world.folder; return m
end
local function setDisplay(m,cf)
 m:SetAttribute('DisplayCF',cf); m:PivotTo(cf)
end
local function refresh()
 for uid,v in pairs(visuals) do if not core.items[uid] then v.model:Destroy(); visuals[uid]=nil end end
 for uid,it in pairs(core.items) do
  local d=Catalog.ById[it.kind]; local rt=runtime[it.owner]
  if rt then
   local v=visuals[uid]
   if not v then
    local model=clone(it.kind); local root=model.PrimaryPart
    local text=world.label(root,'')
    v={model=model,text=text}; visuals[uid]=v
    v.prompt=prompt(root,'Steal relic',function(p)
     local current=core.items[uid]; if not current then return end
     local ownerRT=runtime[current.owner]; if not ownerRT then return end
     -- Do not trust a client-animated display's position for spatial authority.
     local pos=ownerRT.base.slots[current.slot].Position
     if not near(p,pos,11) then return end
     local ok,msg=core:beginSteal(p.UserId,uid,os.clock()); say(p,msg)
     if ok then
      local thiefRT=runtime[p.UserId]; local root2,h=body(p)
      thiefRT.shield=0; thiefRT.lastPosition=root2.Position; thiefRT.lastMove=os.clock()
      h.WalkSpeed=12
      say(Players:GetPlayerByUserId(current.owner),'RAID: '..p.DisplayName..' took '..d.name..'. Catch them!')
      refresh()
     end
    end)
   end
   v.prompt.Enabled=not it.carrier
   v.model:SetAttribute('Carried',it.carrier~=nil)
   if not it.carrier then setDisplay(v.model,rt.base.slots[it.slot]) end
   v.text.Text=d.name..' ['..d.rarity..']\n+$'..d.income..'/s'..(it.carrier and '  IN TRANSIT' or '')
  end
 end
 for id,rt in pairs(runtime) do
  local p=core.players[id]; if p then
   rt.cash.Value=p.cash; rt.steals.Value=p.steals
   send(rt.player)
  end
 end
end
local function finish(p,success,reason)
 if core:finish(p.UserId,success) then
  local _,h=body(p); if h then h.WalkSpeed=16 end
  say(p,reason or (success and 'HEIST COMPLETE!' or 'Loot returned to its owner.'))
  refresh()
 end
end
local function roll()
 local n,sum=rng:NextNumber()*100,0
 for tier,w in ipairs(Catalog.Weights) do
  sum=sum+w; if n&lt;sum then return Catalog.Items[(tier-1)*8+rng:NextInteger(1,8)].id end
 end
 return 'item56'
end
local function setOffer(index,kind)
 if offers[index] then offers[index].model:Destroy() end
 core:setOffer(index,kind or roll()); local o=core.offers[index]; local d=Catalog.ById[o.kind]
 local model=clone(o.kind); setDisplay(model,world.stalls[index].cf)
 offers[index]={model=model,token=o.token}
 world.stalls[index].label.Text=d.name..' ['..d.rarity..']\n$'..d.price..' / +$'..d.income..'/s'
end
for i,stall in ipairs(world.stalls) do
 prompt(stall.anchor,'Buy current offer',function(p)
  local o=core.offers[i]; if not o then return end
  local ok,msg=core:buy(p.UserId,i,o.token); say(p,msg)
  if ok then
   if offers[i] then offers[i].model:Destroy(); offers[i]=nil end
   stall.label.Text='RESTOCKING'; refresh()
   task.delay(2,function() if not core.offers[i] then setOffer(i) end end)
  end
 end)
 setOffer(i,i&lt;=3 and ('item0'..i) or nil)
end
for _,b in ipairs(world.bases) do
 prompt(b.home,'Collect earnings',function(p) if b.owner==p.UserId then local _,msg=core:collect(p.UserId); say(p,msg); refresh() end end)
 prompt(b.lock,'Protect 20s / recharge 60s',function(p) if b.owner==p.UserId then local _,msg=core:protect(p.UserId,os.clock()); say(p,msg); refresh() end end)
 prompt(b.upgrade,'Expand vault',function(p) if b.owner==p.UserId then local _,msg=core:upgrade(p.UserId); say(p,msg); refresh() end end)
end
local function power(p)
 local rt=runtime[p.UserId]; local r=body(p); if not rt or not r then return end
 if not Config.EnablePowers then say(p,'Powers disabled in Config.'); return end
 local ok,kind=core:power(p.UserId,os.clock()); if not ok then say(p,kind); return end
 local origin=r.Position
 if kind=='shield' then rt.shield=os.clock()+3; fx:FireAllClients('shield',origin,3)
 elseif kind=='dash' then
  r.AssemblyLinearVelocity=r.CFrame.LookVector*44+Vector3.new(0,6,0); fx:FireAllClients('dash',origin,1)
 else
  local radius=kind=='slam' and 14 or (kind=='shadow' and 12 or 10)
  local windup=kind=='shadow' and 1.1 or .45
  fx:FireAllClients(kind,origin,radius)
  task.delay(windup,function()
   local caster=core.players[p.UserId]; local casterRoot=body(p)
   if not caster or not casterRoot or caster.carry or (casterRoot.Position-origin).Magnitude&gt;14 then return end
   for id,target in pairs(runtime) do
    local tr,th=body(target.player)
    if id~=p.UserId and tr and (tr.Position-origin).Magnitude&lt;=radius and os.clock()&gt;target.shield and os.clock()&gt;target.immune and los(origin,tr.Position) then
     if kind=='slow' or kind=='shadow' then target.slow=os.clock()+1.5; target.immune=os.clock()+4
     else
      local delta=tr.Position-origin; local dir=delta.Magnitude&gt;.01 and delta.Unit or Vector3.new(1,0,0)
      tr.AssemblyLinearVelocity=(kind=='pull' and -dir or dir)*28+Vector3.new(0,9,0)
      target.immune=os.clock()+2
     end
    end
   end
  end)
 end
 refresh()
end
local function join(p)
 local id=p.UserId; if runtime[id] then return end
 local b
 for _,candidate in ipairs(world.bases) do if not candidate.owner then b=candidate; break end end
 if not b then p:Kick('Eight vaults are occupied. Join another server.'); return end
 b.owner=id
 local stats=Instance.new('Folder'); stats.Name='leaderstats'; stats.Parent=p
 local cash=Instance.new('IntValue'); cash.Name='Cash'; cash.Parent=stats
 local steals=Instance.new('IntValue'); steals.Name='Steals'; steals.Parent=stats
 local rt={player=p,base=b,cash=cash,steals=steals,nextAction=0,nextRemote=0,shield=0,slow=0,immune=0}
 runtime[id]=rt; core:addPlayer(id,os.clock())
 local function char(c)
  local r=c:WaitForChild('HumanoidRootPart',10); local h=c:WaitForChild('Humanoid',10)
  if not r or not h or not runtime[id] then return end
  finish(p,false); rt.slow=0; rt.shield=0; c:PivotTo(b.spawn)
  h.Died:Connect(function() finish(p,false,'Heist ended on respawn.') end)
 end
 p.CharacterAdded:Connect(char); if p.Character then task.spawn(char,p.Character) end
 task.spawn(function()
  local pg=p:WaitForChild('PlayerGui',10); if not pg or not runtime[id] then return end
  local client=script.Parent.Client:Clone(); client.Parent=pg; client.Enabled=true
 end)
 refresh()
end
Players.PlayerAdded:Connect(join)
for _,p in ipairs(Players:GetPlayers()) do join(p) end
Players.PlayerRemoving:Connect(function(p)
 local rt=runtime[p.UserId]; if not rt then return end
 core:removePlayer(p.UserId); rt.base.owner=nil; runtime[p.UserId]=nil; refresh()
end)
action.OnServerEvent:Connect(function(p,verb,arg)
 local rt=runtime[p.UserId]; if not rt or type(verb)~='string' or #verb&gt;20 then return end
 if os.clock()&lt;rt.nextRemote then return end; rt.nextRemote=os.clock()+.15
 if verb=='ready' then send(p); return end
 if not body(p) then return end
 if verb=='power' then power(p); return end
 local ok,msg
 if verb=='equip' and type(arg)=='string' and #arg&lt;30 then ok,msg=core:equip(p.UserId,arg)
 elseif verb=='sell' and type(arg)=='string' and #arg&lt;30 then
  if not near(p,rt.base.home.Position,40) then say(p,'Return to your vault to sell.'); return end
  ok,msg=core:sell(p.UserId,arg)
 elseif verb=='upgrade' then
  if not near(p,rt.base.upgrade.Position,12) then say(p,'Use your vault upgrade console.'); return end
  ok,msg=core:upgrade(p.UserId)
 elseif verb=='testCash' and Run:IsStudio() then
  core.players[p.UserId].cash=Config.StudioTestGrant; core:changed(); ok=true; msg='STUDIO TEST CASH - session only.'
 elseif verb=='testMarket' and Run:IsStudio() and type(arg)=='string' and Catalog.ById[arg] then
  setOffer(8,arg); ok=true; msg='Selected collectible is on market stand 8.'
 else return end
 if msg then say(p,msg) end; refresh()
end)
local tickAcc,moveAcc=0,0
Run.Heartbeat:Connect(function(dt)
 tickAcc=tickAcc+dt; moveAcc=moveAcc+dt
 if moveAcc&gt;=.1 then
  moveAcc=0
  for id,rt in pairs(runtime) do
   local state=core.players[id]; local r,h=body(rt.player)
   if h then h.WalkSpeed=os.clock()&lt;rt.slow and 8 or (state.carry and 12 or 16) end
   local it=core.items[state.carry]
   if it then
    local now=os.clock(); local invalid=not r or now-it.started&gt;Config.CarryTimeout
    if r and rt.lastPosition and now-rt.lastMove&gt;=.25 then
     if (r.Position-rt.lastPosition).Magnitude&gt;28*(now-rt.lastMove)+7 or r.Position.Y&lt; -5 then invalid=true end
     rt.lastPosition=r.Position; rt.lastMove=now
    end
    if invalid then finish(rt.player,false,'Heist expired or movement was invalid.') else
     local v=visuals[it.uid]; if v then v.model:PivotTo(CFrame.new(r.Position+Vector3.new(0,3.5,0))) end
     local owner=runtime[it.owner]; local ownerRoot=owner and body(owner.player)
     if ownerRoot and (r.Position-ownerRoot.Position).Magnitude&lt;5.5 and los(ownerRoot.Position,r.Position) then finish(rt.player,false,'The defender recovered their relic.')
     elseif (r.Position-(rt.base.home.Position+Vector3.new(0,2,0))).Magnitude&lt;7 then finish(rt.player,true) end
    end
   end
  end
 end
 if tickAcc&gt;=1 then
  local seconds=math.floor(tickAcc); tickAcc=tickAcc-seconds; core:tick(seconds)
  for _,b in ipairs(world.bases) do
   local state=b.owner and core.players[b.owner]; local rt=b.owner and runtime[b.owner]
   if state and rt then
    local locked=state.lockUntil&gt;os.clock()
    b.gate.Transparency=locked and .55 or 1
    b.sign.Text=rt.player.DisplayName..'\n'..(locked and 'THEFT PROTECTED '..math.ceil(state.lockUntil-os.clock())..'s' or 'OPEN TO RAID')
    b.bank.Text='$'..state.bank..' READY\nCOLLECT / DELIVER'
    send(rt.player)
   else b.sign.Text='UNCLAIMED VAULT'; b.bank.Text='COLLECT / DELIVER'; b.gate.Transparency=1 end
  end
 end
end)
task.spawn(function() while task.wait(Config.MarketRefresh) do for i=1,8 do setOffer(i) end end end)
print('OPItemV2: 56 models ready. SESSION ALPHA: no persistent saves. Disable old prototype before testing.')
</string>
					<BinaryString name="AttributesSerialize">AQAAAAkAAABDbGFzc05hbWUCBgAAAFNjcmlwdA==</BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Server</string>
					<BinaryString name="SerializedOverrides" />
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">73dc296d0ee214c70ae114fb00001ee5</UniqueId>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX18b8d911787c4930acd504a9d46080a4">
				<Properties>
					<string name="Value">local W={}
function W.build(F)
 local folder=Instance.new('Folder'); folder.Name='OPItemWorld'; folder.Parent=workspace
 local function p(n,s,cf,c,solid,mat)
  local a=F.part(folder,n,s,cf,c,mat); a.CanCollide=solid or false; a.CanQuery=solid or false; return a
 end
 local function label(a,t)
  local b=Instance.new('BillboardGui'); b.Size=UDim2.fromOffset(230,64); b.StudsOffset=Vector3.new(0,3.5,0); b.MaxDistance=65; b.AlwaysOnTop=false; b.Parent=a
  local l=Instance.new('TextLabel'); l.Size=UDim2.fromScale(1,1); l.BackgroundTransparency=.2; l.BackgroundColor3=Color3.fromRGB(14,19,35); l.TextColor3=Color3.new(1,1,1); l.Font=Enum.Font.GothamBold; l.TextSize=14; l.TextWrapped=true; l.Text=t; l.Parent=b
  Instance.new('UICorner',l).CornerRadius=UDim.new(0,10); return l
 end
 local navy=Color3.fromRGB(26,34,52); local cyan=Color3.fromRGB(70,221,237); local gold=Color3.fromRGB(240,188,68)
 p('FloatingFoundation',Vector3.new(254,8,190),CFrame.new(0,-5,0),navy,true,Enum.Material.Slate)
 p('Plaza',Vector3.new(252,1,188),CFrame.new(0,-.5,0),Color3.fromRGB(59,72,91),true,Enum.Material.SmoothPlastic)
 p('RiftCarpet',Vector3.new(222,.12,18),CFrame.new(0,.08,0),Color3.fromRGB(71,46,110))
 for i=-10,10 do p('LaneDivider',Vector3.new(.12,.15,16),CFrame.new(i*10,.16,0),cyan) end
 for _,z in ipairs({-93,93}) do p('OuterRail',Vector3.new(250,3,1),CFrame.new(0,1.5,z),navy,true); p('EdgeLight',Vector3.new(250,.12,1.1),CFrame.new(0,3.1,z),cyan,false,Enum.Material.Neon) end
 for _,x in ipairs({-125,125}) do p('EndRail',Vector3.new(1,3,186),CFrame.new(x,1.5,0),navy,true) end
 local bases={}
 for i=1,8 do
  local x=-84+((i-1)%4)*56; local z=i&lt;=4 and -57 or 57
  local cf=CFrame.new(x,0,z)*CFrame.Angles(0,z&lt;0 and math.pi or 0,0)
  local accent=Color3.fromHSV((i-1)/8,.56,.92)
  local b={cf=cf,slots={}}; bases[i]=b
  local function localPart(n,size,pos,c,solid,mat) return p(n,size,cf*CFrame.new(pos),c,solid,mat) end
  localPart('VaultFloor',Vector3.new(48,1,48),Vector3.new(0,.5,0),navy,true)
  localPart('BackWall',Vector3.new(48,11,1),Vector3.new(0,6,24),navy,true)
  for _,sx in ipairs({-24,24}) do localPart('SideWall',Vector3.new(1,9,48),Vector3.new(sx,5,0),navy,true) end
  for _,sx in ipairs({-20,20}) do localPart('GatePillar',Vector3.new(4,12,4),Vector3.new(sx,6,-23),navy,true); localPart('PillarLight',Vector3.new(.3,10,.3),Vector3.new(sx,6,-25.1),accent,false,Enum.Material.Neon) end
  localPart('GateLintel',Vector3.new(44,2,4),Vector3.new(0,12,-23),navy,true)
  b.gate=localPart('ProtectionField',Vector3.new(35,10,.2),Vector3.new(0,6,-23),accent,false,Enum.Material.ForceField); b.gate.Transparency=.7
  b.sign=label(localPart('VaultSign',Vector3.new(1,1,1),Vector3.new(0,11,-23),accent),'UNCLAIMED VAULT')
  b.home=localPart('Deliver / Collect',Vector3.new(12,.2,8),Vector3.new(0,1.15,-16),Color3.fromRGB(63,221,154))
  b.bank=label(b.home,'DELIVER LOOT / COLLECT')
  b.lock=localPart('Protection Console',Vector3.new(3,2.5,3),Vector3.new(-16,2.2,-17),gold,true)
  label(b.lock,'PROTECT VAULT')
  b.upgrade=localPart('Upgrade Console',Vector3.new(3,2.5,3),Vector3.new(16,2.2,-17),cyan,true)
  label(b.upgrade,'UPGRADE SLOTS')
  b.spawn=cf*CFrame.new(0,5,-11)
  for slot=1,12 do
   local sx=-16.5+((slot-1)%4)*11; local sz=-3+math.floor((slot-1)/4)*10
   localPart('DisplayPedestal',Vector3.new(7,1.2,7),Vector3.new(sx,1.6,sz),Color3.fromRGB(46,56,78),true)
   localPart('PedestalTrim',Vector3.new(7.1,.12,7.1),Vector3.new(sx,2.25,sz),accent,false,Enum.Material.Neon)
   b.slots[slot]=cf*CFrame.new(sx,2.9,sz)
  end
 end
 local stalls={}
 for i=1,8 do
  local cf=CFrame.new(-98+(i-1)*28,2.5,0)
  p('MarketPodium',Vector3.new(8,1,8),cf*CFrame.new(0,-1.75,0),navy,true)
  local a=p('MarketInteraction',Vector3.new(.3,.3,.3),cf,cyan); a.Transparency=1
  stalls[i]={cf=cf,anchor=a,label=label(a,'RIFT MARKET')}
 end
 -- Decorative portal at the end of the lane, clear of every base entrance.
 for i=1,24 do
  local a=i*math.pi/12
  p('RiftArch',Vector3.new(1.3,2.1,1.2),CFrame.new(119,10+math.sin(a)*8,math.cos(a)*8)*CFrame.Angles(a,0,0),gold,false,Enum.Material.Metal)
 end
 local portal=p('Rift',Vector3.new(.2,14,14),CFrame.new(119,10,0),Color3.fromRGB(153,64,244),false,Enum.Material.Neon); portal.Transparency=.3
 for _,z in ipairs({-29,29}) do for x=-112,112,28 do
  p('LampPost',Vector3.new(.5,6,.5),CFrame.new(x,3,z),navy,true)
  local lamp=p('Lamp',Vector3.new(1.3,1.3,1.3),CFrame.new(x,6.5,z),gold,false,Enum.Material.Neon)
 end end
 return {folder=folder,bases=bases,stalls=stalls,label=label,part=p}
end
return W
