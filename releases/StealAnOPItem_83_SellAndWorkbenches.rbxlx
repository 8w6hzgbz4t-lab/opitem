function S:battles(p)
 local r=self.ctx.body(p);if not r then return {} end;local out={}
 for id,o in pairs(self.core.offers) do if o.state=='Auction' and (r.Position-Vector3.new(o.x,2.5,0)).Magnitude&lt;22 then
