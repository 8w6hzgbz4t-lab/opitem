 if aimedField then center=aimedField end
 if lockId then center=self.ctx.body(self.ctx.runtime[lockId].player).Position end
 self.ctx.fx:FireAllClients(key,center,math.max(2,d.radius&gt;0 and d.radius or d.range),d.name,d.windup,color,p.UserId,d.duration,direction,visualOrigin,lockId)
