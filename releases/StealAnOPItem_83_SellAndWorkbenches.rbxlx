				<Properties>
					<Content name="LinkedSource"><null /></Content>
					<ProtectedString name="Source">-- Session-only alpha; persistence is intentionally not implemented.
return {
 MaxPlayers=8, BaseSlots=8, EnablePowers=true,
 ConveyorInterval=3, ConveyorSpeed=8, ConveyorMaxOffers=12, ConveyorStartX=119, ConveyorEndX=-112, ConveyorY=2.5, ConveyorLifetime=32, CarryTimeout=50, StudioTestGrant=2500000,
 StartingCash=650, StarterItem="item01",
 SpawnProtection=30, ProtectionDuration=20, ProtectionRecharge=60,
 WalkSpeed=16, CarrySpeed=12, SlowSpeed=8,
}
</ProtectedString>
					<string name="ScriptGuid">{c001a81c-aa53-45eb-90f7-6a3e6fc31362}</string>
					<BinaryString name="AttributesSerialize" />
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">73dc296d0ee214c70ae114fb000003dc</UniqueId>
					<string name="Name">Config</string>
					<BinaryString name="SerializedOverrides" />
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
