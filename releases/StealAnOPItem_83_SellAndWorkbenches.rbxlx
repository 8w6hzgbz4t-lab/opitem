end
function S:hasDeveloperShield(p)
 local rt=self.ctx.runtime[p.UserId]
 return self.developerShields[p.UserId]~=nil and rt~=nil and self.clock()&lt;(rt.shield or 0) and (rt.shieldHits or 0)&gt;0
end
function S:clearDeveloperShield(p)
 if not self.developerShields[p.UserId] then return end
 local rt=self.ctx.runtime[p.UserId]
 if rt then rt.shield=0;rt.shieldHits=0 end
 self.developerShields[p.UserId]=nil
