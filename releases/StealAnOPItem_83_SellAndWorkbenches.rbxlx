 if not rt or not r or not self.ctx.movementSafe(p) or os.clock()&lt;(rt.shockUntil or 0) or not self.ctx.config.EnablePowers then return end
 local kind=type(arg)=='string' and arg or (type(arg)=='table' and arg.id or nil)
 if kind~=nil and (type(kind)~='string' or #kind&gt;24) then return end
