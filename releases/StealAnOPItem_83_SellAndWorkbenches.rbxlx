 assert(c.players[1].loadout[1]=='tag' and not c:loadPower(1,'push',1))
 assert(c:shopPower(1,'lightning'));assert(c:loadPower(1,'lightning',2));assert(c:power(1,100,'lightning'));assert(not c:power(1,101,'lightning'));assert(c:power(1,125,'lightning'))
 assert(c:unlockPowerSlot(1) and c.players[1].capacity==8);assert(not c:loadPower(1,'tag',3))
 local ranks={};for _,d in ipairs(Powers.Items) do ranks[d.rank]=true end;for i=1,5 do assert(ranks[i]) end
