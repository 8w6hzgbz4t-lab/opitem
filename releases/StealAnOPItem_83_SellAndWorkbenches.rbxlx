		<Item class="ModuleScript" referent="RBX_V75_DeveloperArtifacts"><Properties><string name="Name">DeveloperArtifacts</string><ProtectedString name="Source">-- Server-created cosmetic replicas. They never enter the collectible ledger.
-- All parts are massless and welded to a live character before parenting.
local A={};A.__index=A
local V,C=Vector3.new,CFrame.new
local gold=Color3.fromRGB(229,181,65)

local function clear(model)
 if model then model:Destroy() end
end
local function host(player,rod)
 local character=player.Character
 if not character or not character.Parent then return nil end
 if rod then return character:FindFirstChild('RightHand') or character:FindFirstChild('Right Arm') or character:FindFirstChild('HumanoidRootPart') end
 return character:FindFirstChild('UpperTorso') or character:FindFirstChild('Torso') or character:FindFirstChild('HumanoidRootPart')
end
local function weld(model,body)
 for _,part in ipairs(model:GetDescendants()) do
  if part:IsA('BasePart') then
   part.Anchored=false;part.Massless=true
   part.CanCollide=false;part.CanTouch=false;part.CanQuery=false
   local joint=Instance.new('WeldConstraint');joint.Name='DeveloperCosmeticWeld'
   joint.Part0=body;joint.Part1=part;joint.Parent=part
  end
 end
 model:SetAttribute('Kind',nil);model:SetAttribute('ItemId',nil)
 model:SetAttribute('DecorativeOnly',true);model:SetAttribute('DeveloperCosmetic',true)
 model.Parent=body.Parent
end
local function chain(model,torso,from,to,name)
 local direction=to-from
 local up=direction.Unit
 local reference=math.abs(up.Z)&gt;.95 and V(1,0,0) or V(0,0,1)
 local right=up:Cross(reference).Unit;local back=right:Cross(up).Unit
 local part=Instance.new('Part');part.Name=name;part.Size=V(.042,direction.Magnitude+.018,.048)
 part.CFrame=torso.CFrame*CFrame.fromMatrix((from+to)*.5,right,up,back)
 part.Color=gold;part.Material=Enum.Material.Metal;part.Anchored=false
 part.TopSurface=Enum.SurfaceType.Smooth;part.BottomSurface=Enum.SurfaceType.Smooth;part.Parent=model
 return part
end
function A.new(templates,clock)
 return setmetatable({templates=templates,clock=clock or os.clock,records={}},A)
end
function A:record(player)
 local record=self.records[player.UserId]
 if record and record.character~=player.Character then self:clear(player);record=nil end
 if not record then record={character=player.Character};self.records[player.UserId]=record end
 return record
end
function A:setProtected(player,enabled)
 local record=self:record(player)
 if not enabled then clear(record.puzzle);record.puzzle=nil;return end
 local torso=host(player,false)
 if not torso or record.puzzle and record.puzzle.Parent==player.Character then return end
 local template=self.templates and self.templates:FindFirstChild('item08')
 if not template then return end
 clear(record.puzzle)
 local model=template:Clone();model.Name='DeveloperMillenniumPuzzle'
 model:ScaleTo(template:GetScale()*.25)
 model:PivotTo(torso.CFrame*C(0,-.58,-.72))
 -- Two shallow chains connect the detailed pendant loop to the collar.
 for _,side in ipairs({-1,1}) do
  local previous=V(side*.40,.65,-.55)
  for index=1,8 do
   local t=index/8
   local nextPoint=V(side*.40*(1-t),.65-t*.08-math.sin(t*math.pi)*.035,-.55-t*.20)
   chain(model,torso,previous,nextPoint,'PendantChain_'..side..'_'..index)
   previous=nextPoint
  end
 end
 model:SetAttribute('ProtectionEmblem',true);model:SetAttribute('DeveloperUserId',player.UserId)
 model:SetAttribute('PartCount',(template:GetAttribute('PartCount') or 137)+16)
 weld(model,torso);record.puzzle=model
end
function A:pulseRod(player)
 local record=self:record(player);local hand=host(player,true)
 if not hand then return nil end
 if not record.rod or not record.rod.Parent then
  local template=self.templates and self.templates:FindFirstChild('item23')
  if not template then return hand.Position end
  local model=template:Clone();model.Name='DeveloperMillenniumRod'
  model:ScaleTo(template:GetScale()*.46)
  model:PivotTo(hand.CFrame*C(0,-.54,-.32)*CFrame.Angles(math.rad(-12),0,0))
  model:SetAttribute('CastingArtifact',true);model:SetAttribute('DeveloperUserId',player.UserId)
  weld(model,hand);record.rod=model
 end
 record.rodUntil=self.clock()+1.25
 local tip=record.rod:FindFirstChild('RodEyePupil',true) or record.rod:FindFirstChild('RodEyeHead',true) or record.rod.PrimaryPart
 return tip and tip.Position or hand.Position
end
function A:clearRod(player)
 local record=self.records[player.UserId]
 if record then clear(record.rod);record.rod=nil;record.rodUntil=nil end
end
function A:tick()
 for id,record in pairs(self.records) do
  if not record.character or not record.character.Parent then
   clear(record.puzzle);clear(record.rod);self.records[id]=nil
  elseif record.rod and self.clock()&gt;=(record.rodUntil or 0) then
   clear(record.rod);record.rod=nil;record.rodUntil=nil
  end
 end
end
function A:clear(player)
 local record=self.records[player.UserId]
 if record then clear(record.puzzle);clear(record.rod);self.records[player.UserId]=nil end
end
return A
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_V75_DeveloperEffects"><Properties><string name="Name">DeveloperEffects</string><ProtectedString name="Source">-- Small, local Millennium Rod effects. Server events decide all gameplay outcomes.
local Tween=game:GetService('TweenService')
local Debris=game:GetService('Debris')
local M={}
local V,C=Vector3.new,CFrame.new
local GOLD=Color3.fromRGB(255,210,98)
local function vector(v)
 return typeof(v)=='Vector3' and v.X==v.X and v.Y==v.Y and v.Z==v.Z
  and math.abs(v.X)&lt;100000 and math.abs(v.Y)&lt;100000 and math.abs(v.Z)&lt;100000
end
function M.start(net,player)
 local folder=Instance.new('Folder');folder.Name='DeveloperSpellEffects';folder.Parent=workspace
 local function part(name,size,cf,color,life)
  local p=Instance.new('Part');p.Name=name;p.Size=size;p.CFrame=cf;p.Color=color or GOLD
  p.Material=Enum.Material.Neon;p.Anchored=true;p.CanCollide=false;p.CanQuery=false;p.CanTouch=false
  p.CastShadow=false;p.Transparency=.22;p.Parent=folder
  Tween:Create(p,TweenInfo.new(life or .7),{Transparency=1}):Play();Debris:AddItem(p,(life or .7)+.05)
  return p
 end
 local function line(a,b,width,color,life)
  local delta=b-a;if delta.Magnitude&lt;.001 then return end
  return part('MillenniumRodLight',V(width,width,delta.Magnitude),CFrame.lookAt((a+b)*.5,b),color,life)
 end
 local function ring(center,radius,count,life)
  for i=0,count-1 do
   local a,b=i*math.pi*2/count,(i+1)*math.pi*2/count
   line(center+V(math.cos(a)*radius,0,math.sin(a)*radius),center+V(math.cos(b)*radius,0,math.sin(b)*radius),.12,GOLD,life)
  end
 end
 local connection=net.FX.OnClientEvent:Connect(function(kind,origin,radius,name,windup,color,userId,duration,direction,rodOrigin)
  if not vector(origin) then return end
  local camera=workspace.CurrentCamera
  if camera and (camera.CFrame.Position-origin).Magnitude&gt;240 then return end
  local playerGui=player:FindFirstChild('PlayerGui')
  local reduced=playerGui and playerGui:GetAttribute('OPReducedEffects')==true or false
  if vector(rodOrigin) then
   line(rodOrigin,origin,.16,reduced and GOLD or color or GOLD,.4)
   if not reduced then ring(rodOrigin,.4,8,.35) end
  end
  if kind~='developerRoyalSeal' then return end
  radius=type(radius)=='number' and math.clamp(radius,1,18) or 18
  local center=origin-V(0,2.6,0)
  ring(center,radius,reduced and 16 or 28,windup or .75)
  if windup then return end
  ring(center+V(0,.08,0),radius*.68,reduced and 12 or 20,.8)
  -- Eye of the Millennium: almond outline and central diamond on the seal floor.
  local left,right=center+V(-5,.2,0),center+V(5,.2,0)
  for _,side in ipairs({-1,1}) do
   local tip=center+V(0,.2,side*2.4)
   line(left,tip,.23,GOLD,.8);line(tip,right,.23,GOLD,.8)
  end
  local diamond={V(0,.2,-1.2),V(1.2,.2,0),V(0,.2,1.2),V(-1.2,.2,0)}
  for i=1,4 do line(center+diamond[i],center+diamond[i%4+1],.24,GOLD,.8) end
  if not reduced then
   for i=0,7 do
    local a=i*math.pi/4;local p=center+V(math.cos(a)*radius,.15,math.sin(a)*radius)
    line(p,p+V(0,2.2,0),.16,GOLD,.6)
   end
  end
 end)
 return {destroy=function()connection:Disconnect();folder:Destroy()end}
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_V75_DeveloperPowers"><Properties><string name="Name">DeveloperPowers</string><ProtectedString name="Source">-- Server-only Royal Seal. All hits use the existing shield, immunity and loot ledger.
local M={}
local WINDUP,RADIUS,MAX_DISTANCE=.65,18,24
local GOLD=Color3.fromRGB(255,210,98)
local function finiteVector(v)
 return typeof(v)=='Vector3' and v.X==v.X and v.Y==v.Y and v.Z==v.Z
  and math.abs(v.X)&lt;100000 and math.abs(v.Y)&lt;100000 and math.abs(v.Z)&lt;100000
end
function M.cast(phase,admin,player,rodOrigin)
 if not admin or not admin:authorized(player) then return false,'Access denied.' end
 local ready,root=admin:readyForMods(player)
 if not ready then return false,root end
 local ctx=phase.ctx
 if not ctx.config.EnablePowers then return false,'Powers are disabled.' end
 local runtime=ctx.runtime[player.UserId]
 if not runtime or not ctx.movementSafe(player) then return false,'Character movement unavailable.' end
 local origin=root.Position
 if not finiteVector(rodOrigin) or (rodOrigin-origin).Magnitude&gt;12 then rodOrigin=origin+Vector3.new(0,1,-1) end
 local direction=root.CFrame.LookVector
 runtime.castSerial=(runtime.castSerial or 0)+1
 local serial=runtime.castSerial
 ctx.fx:FireAllClients('developerRoyalSeal',origin,RADIUS,'Royal Seal',WINDUP,GOLD,player.UserId,.85,direction,rodOrigin)
 task.delay(WINDUP,function()
  local state=phase.core.players[player.UserId]
  local current=ctx.body(player)
  if not admin:authorized(player) or ctx.runtime[player.UserId]~=runtime or runtime.castSerial~=serial
   or not state or state.carry or state.pending or not current or current~=root
   or (current.Position-origin).Magnitude&gt;7 or not ctx.movementSafe(player)
   or os.clock()&lt;(runtime.shockUntil or 0) or os.clock()&lt;(runtime.interruptedUntil or 0) then return end
  local now=os.clock()
  for id,target in pairs(ctx.runtime) do
   if id~=player.UserId then
    local targetRoot=ctx.body(target.player)
    if targetRoot and (targetRoot.Position-origin).Magnitude&lt;=math.min(RADIUS,MAX_DISTANCE)
     and ctx.los(origin,targetRoot.Position) then
     local previous=target.shockUntil
     phase:hitPower(player.UserId,target,'lightning',origin,now)
     -- A blocked hit never drops an item. Only a newly applied stun can release it.
     if target.shockRoot==targetRoot and target.shockUntil~=previous and (target.shockUntil or 0)&gt;now then
      phase:finish(target.player,false,'Royal Seal knocked the item loose. Lost purchases are not refunded.')
     end
    end
   end
  end
  ctx.fx:FireAllClients('developerRoyalSeal',origin,RADIUS,'Royal Seal',nil,GOLD,player.UserId,.85,direction,rodOrigin)
  ctx.refresh()
 end)
 return true,'Royal Seal cast. Nearby unshielded carriers are briefly stopped and release their loot.'
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_V76_AudioClient"><Properties><string name="Name">AudioClient</string><ProtectedString name="Source">-- Local playback only. Server gameplay events carry a cue name, never an arbitrary asset ID.
local SoundService=game:GetService('SoundService')
local Debris=game:GetService('Debris')
local Config=require(script.Parent:WaitForChild('AudioConfig'))
local M={}
local sessions=setmetatable({},{__mode='k'})
local function finite(n)return type(n)=='number' and n==n and math.abs(n)&lt;math.huge end
local function volume(gui,key,fallback)
 local n=gui:GetAttribute(key)
 return finite(n) and math.clamp(n,0,1) or fallback
end
local function asset(id)
 return finite(id) and id&gt;0 and id%1==0 and 'rbxassetid://'..tostring(id) or nil
end
local function vector(v)
 return typeof(v)=='Vector3' and finite(v.X) and finite(v.Y) and finite(v.Z)
end
function M.start(net,gui)
 if sessions[gui] then return sessions[gui] end
 local folder=Instance.new('Folder');folder.Name='OPGameAudio';folder.Parent=SoundService
 local music=Instance.new('Sound');music.Name='OriginalBattleMusic';music.Looped=true
 music.SoundId=asset(Config.Music.AssetId) or '';music.PlaybackSpeed=Config.Music.PlaybackSpeed or 1
 music.Parent=folder
 local connections,active,last={},{},{}
 local buttons=setmetatable({},{__mode='k'})
 local tokens,updated=12,os.clock()
 local dead=false
 local function settings()
  music.Volume=gui:GetAttribute('OPMusicMuted')==true and 0 or volume(gui,'OPMusicVolume',Config.Music.Volume)
  if music.SoundId~='' and music.Volume&gt;0 then
   if not music.IsPlaying then music:Play() end
  elseif music.IsPlaying then music:Pause() end
  for sound,base in pairs(active)do
   if sound.Parent then sound.Volume=gui:GetAttribute('OPSfxMuted')==true and 0 or base*volume(gui,'OPSfxVolume',Config.EffectsVolume)
   else active[sound]=nil end
  end
 end
 local function play(payload)
  if dead or type(payload)~='table' or type(payload.kind)~='string' then return false end
  local cue=Config.Cues[payload.kind]
  if not cue or gui:GetAttribute('OPSfxMuted')==true then return false end
  local now=os.clock();tokens=math.min(12,tokens+math.max(0,now-updated)*8);updated=now
  if tokens&lt;1 or now-(last[payload.kind] or -math.huge)&lt;(cue.Gap or .1) then return false end
  local count=0
  for sound in pairs(active)do if sound.Parent then count=count+1 else active[sound]=nil end end
  if count&gt;=(Config.MaxSimultaneous or 12) then return false end
  local attenuation=1
  if payload.position~=nil then
   if not vector(payload.position) then return false end
   local camera=workspace.CurrentCamera
   if camera then
    local distance=(camera.CFrame.Position-payload.position).Magnitude
    if distance&gt;(Config.MaxDistance or 160) then return false end
    attenuation=math.clamp(1-distance/(Config.MaxDistance or 160),.08,1)
   end
  end
  local effectVolume=volume(gui,'OPSfxVolume',Config.EffectsVolume)
  if effectVolume&lt;=0 then return false end
  tokens=tokens-1;last[payload.kind]=now
  local sound=Instance.new('Sound');sound.Name='OPCue_'..payload.kind
  sound.SoundId=asset(cue.AssetId) or cue.Fallback
  sound.PlaybackSpeed=asset(cue.AssetId) and 1 or cue.Speed or 1
  if payload.kind=='powerCast' or payload.kind=='powerHit' or payload.kind=='shield' then
   sound.PlaybackSpeed=sound.PlaybackSpeed*(Config.PowerPitch[payload.power] or 1)
  end
  local base=(cue.Volume or .5)*attenuation
  sound.Volume=base*effectVolume;sound.Parent=folder;active[sound]=base
  sound.Ended:Once(function()active[sound]=nil;sound:Destroy()end)
  sound:Play();Debris:AddItem(sound,5)
  return true
 end
 local allowedRoots={OPItemHUD=true,OPPhaseHUD=true,OPDeveloperConsole=true,OPItemCashShop=true}
 local function bindButton(button)
  if not button:IsA('GuiButton') or buttons[button] then return end
  local ancestor=button.Parent;local allowed=false
  while ancestor and ancestor~=gui do
   if allowedRoots[ancestor.Name] then allowed=true;break end
   ancestor=ancestor.Parent
  end
  if allowed then buttons[button]=button.Activated:Connect(function()play({kind='ui'})end) end
 end
 for _,descendant in ipairs(gui:GetDescendants())do bindButton(descendant) end
 connections[#connections+1]=gui.DescendantAdded:Connect(bindButton)
 connections[#connections+1]=net:WaitForChild('Audio').OnClientEvent:Connect(play)
 for _,key in ipairs({'OPMusicMuted','OPSfxMuted','OPMusicVolume','OPSfxVolume'})do
  connections[#connections+1]=gui:GetAttributeChangedSignal(key):Connect(settings)
 end
 settings()
 local session={play=play}
 function session.destroy()
  if dead then return end;dead=true
  for _,connection in ipairs(connections)do connection:Disconnect() end
  for _,connection in pairs(buttons)do connection:Disconnect() end
  music:Stop();folder:Destroy();sessions[gui]=nil;table.clear(active)
 end
 sessions[gui]=session;return session
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_V76_AudioConfig"><Properties><string name="Name">AudioConfig</string><ProtectedString name="Source">-- Owner-uploaded audio goes here. Zero IDs use built-in SFX, and leave music off.
-- These files contain an original score; upload the supplied assets to this experience owner.
return {
 Music={AssetId=111355988554529,Volume=.18,PlaybackSpeed=1,Title='Relic Rivalry'},
 EffectsVolume=.55,
 MaxSimultaneous=12,
 MaxDistance=160,
 PowerPitch={tag=1.25,dash=1.3,gravity=.8,slow=.9,slam=.72,repulse=.86,shield=1.12,lightning=1.18,kiblast=1.08,spinjitzu=.84,royalseal=.75},
 Cues={
  powerCast={AssetId=0,File='power-cast.wav',Fallback='rbxasset://sounds/electronicpingshort.wav',Volume=.42,Speed=.8,Gap=.12},
  powerHit={AssetId=0,File='power-hit.wav',Fallback='rbxasset://sounds/action_footsteps_plastic.mp3',Volume=.5,Speed=1.05,Gap=.1},
  shield={AssetId=0,File='shield.wav',Fallback='rbxasset://sounds/electronicpingshort.wav',Volume=.42,Speed=1.45,Gap=.15},
  purchase={AssetId=0,File='purchase.wav',Fallback='rbxasset://sounds/electronicpingshort.wav',Volume=.48,Speed=1.3,Gap=.18},
  lost={AssetId=0,File='item-lost.wav',Fallback='rbxasset://sounds/action_jump.mp3',Volume=.5,Speed=.72,Gap=.2},
  deliver={AssetId=0,File='delivered.wav',Fallback='rbxasset://sounds/electronicpingshort.wav',Volume=.52,Speed=1.7,Gap=.2},
  lock={AssetId=0,File='base-lock.wav',Fallback='rbxasset://sounds/electronicpingshort.wav',Volume=.48,Speed=.65,Gap=.35},
  unlock={AssetId=0,File='base-unlock.wav',Fallback='rbxasset://sounds/electronicpingshort.wav',Volume=.36,Speed=.9,Gap=.35},
  levelup={AssetId=0,File='level-up.wav',Fallback='rbxasset://sounds/electronicpingshort.wav',Volume=.58,Speed=1.8,Gap=.4},
  ui={AssetId=0,File='ui-tick.wav',Fallback='rbxasset://sounds/button.wav',Volume=.2,Speed=1.25,Gap=.08},
 },
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_V76_CashShopBench"><Properties><string name="Name">CashShopBench</string><ProtectedString name="Source">local M={}
function M.create(world)
 local old=world.folder:FindFirstChild('CashShopBench');if old then old:Destroy() end
 local model=Instance.new('Model');model.Name='CashShopBench';model.Parent=world.folder
 model:SetAttribute('PreviewOnly',true)
 local V,C=Vector3.new,CFrame.new
 local gold=Color3.fromRGB(235,186,76);local navy=Color3.fromRGB(21,31,47)
 local green=Color3.fromRGB(81,219,159);local steel=Color3.fromRGB(116,139,156)
 local function part(name,size,cf,color,material,solid)
  local p=Instance.new('Part');p.Name=name;p.Size=size;p.CFrame=C(9,0,19)*cf
  p.Anchored=true;p.CanCollide=solid==true;p.CanTouch=false;p.CanQuery=solid==true
  p.Color=color;p.Material=material or Enum.Material.Metal;p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth;p.Parent=model;return p
 end
 part('Worktop',V(5,.3,3),C(0,2.35,0),steel,nil,true)
 part('GoldWorktopRim',V(5.15,.1,3.15),C(0,2.17,0),gold,nil,true)
 for _,x in ipairs({-1.8,1.8}) do
  part('DeskLeg'..x,V(.35,2,.4),C(x,1.1,.55),navy,nil,true)
  part('DeskFoot'..x,V(.8,.2,2.4),C(x,.2,0),navy,nil,true)
  part('DeskCornerLight'..x,V(.12,1.55,.12),C(x,1.2,.28),green,Enum.Material.Neon,false)
 end
 part('DisplayStand',V(.5,.8,.4),C(0,2.8,.7),gold)
 part('SignBezel',V(4.8,2.6,.32),C(0,4.35,.7),navy,nil,true)
 local sign=part('CashShopSign',V(4.4,2.2,.08),C(0,4.35,.49),Color3.fromRGB(16,64,55),Enum.Material.SmoothPlastic,false)
 local surface=Instance.new('SurfaceGui');surface.Name='CashShopDisplay';surface.Face=Enum.NormalId.Front;surface.CanvasSize=Vector2.new(640,300);surface.LightInfluence=0;surface.Parent=sign
 local title=Instance.new('TextLabel');title.Size=UDim2.fromScale(.94,.94);title.Position=UDim2.fromScale(.03,.03);title.BackgroundTransparency=1;title.Text='SHOP\nCASH • LEVELS • POWERS\nCOMING SOON';title.TextColor3=gold;title.TextSize=47;title.Font=Enum.Font.GothamBold;title.TextWrapped=true;title.Parent=surface
 for _,x in ipairs({-2.3,2.3}) do part('GoldSignEdge'..x,V(.09,2.5,.12),C(x,4.35,.47),gold,Enum.Material.Neon,false) end
 for row=0,2 do for col=0,5 do part('Key'..row..col,V(.22,.06,.17),C(-.8+col*.3,2.55,-.7+row*.23),row==0 and green or steel) end end
 for stack=0,2 do for level=0,2 do
  local p=part('CashBundle'..stack..level,V(.65,.18,.4),C(1.25+stack*.13,2.62+level*.2,.2+stack*.25),green,Enum.Material.SmoothPlastic,false)
  part('CashBand'..stack..level,V(.1,.185,.405),C(p.Position-V(9,0,19)),gold,Enum.Material.SmoothPlastic,false)
 end end
 local anchor=part('Browse Cash Packs',V(1,1,1),C(0,3,-1.5),green,nil,false);anchor.Transparency=1
 return anchor,model
end
return M
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX_V76_CashShopClient"><Properties><string name="Name">CashShopClient</string><ProtectedString name="Source">-- The server owns product mappings, price checks, prompts and receipt grants.
local Players=game:GetService('Players')
local RS=game:GetService('ReplicatedStorage')
local UIS=game:GetService('UserInputService')
local GS=game:GetService('GuiService')
local Tween=game:GetService('TweenService')
local playerGui=Players.LocalPlayer:WaitForChild('PlayerGui')
local remote=RS:WaitForChild('OPItemNet'):WaitForChild('CashShop')
local gui=script.Parent;assert(gui:IsA('ScreenGui'),'Shop requires a ScreenGui')
gui.ResetOnSpawn=false;gui.ScreenInsets=Enum.ScreenInsets.CoreUISafeInsets;gui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
local dark=Color3.fromRGB(20,29,45);local gold=Color3.fromRGB(235,193,104);local ink=Color3.fromRGB(238,244,248)
local muted=Color3.fromRGB(158,181,197);local green=Color3.fromRGB(115,218,170)
local function rounded(object,radius)local c=Instance.new('UICorner');c.CornerRadius=UDim.new(0,radius or 9);c.Parent=object end
local function label(parent,value,pos,size,fontSize,color)
 local t=Instance.new('TextLabel');t.Position=pos;t.Size=size;t.BackgroundTransparency=1;t.Text=value;t.Font=Enum.Font.GothamMedium;t.TextSize=fontSize;t.TextColor3=color or ink;t.TextWrapped=true;t.Parent=parent;return t
end
local safe=Instance.new('Frame');safe.Name='CashShopSafeBounds';safe.Size=UDim2.fromScale(1,1);safe.BackgroundTransparency=1;safe.Parent=gui
local panel=Instance.new('Frame');panel.Name='CashShopPanel';panel.Size=UDim2.fromOffset(480,500);panel.AnchorPoint=Vector2.new(.5,.5);panel.Position=UDim2.fromScale(.5,.5);panel.BackgroundColor3=dark;panel.BorderSizePixel=0;panel.Visible=false;panel.Parent=safe;rounded(panel)
local stroke=Instance.new('UIStroke');stroke.Color=gold;stroke.Transparency=.25;stroke.Parent=panel
label(panel,'ROBUX SHOP',UDim2.fromOffset(14,8),UDim2.new(1,-72,0,32),20,gold)
local close=Instance.new('TextButton');close.Name='CloseCashShop';close.Position=UDim2.new(1,-46,0,8);close.Size=UDim2.fromOffset(34,34);close.Text='×';close.TextSize=24;close.Font=Enum.Font.GothamBold;close.TextColor3=ink;close.BackgroundColor3=Color3.fromRGB(46,56,74);close.BorderSizePixel=0;close.Parent=panel;rounded(close)
local status=label(panel,'Loading offers…',UDim2.fromOffset(14,46),UDim2.new(1,-28,0,30),12,muted);status.Name='ShopStatus'
local list=Instance.new('ScrollingFrame');list.Name='ShopOffers';list.Position=UDim2.fromOffset(12,122);list.Size=UDim2.new(1,-24,1,-236);list.BackgroundTransparency=1;list.BorderSizePixel=0;list.ScrollBarThickness=4;list.CanvasSize=UDim2.fromOffset(0,0);list.Parent=panel
local summary=label(panel,'Choose an offer.',UDim2.new(0,14,1,-106),UDim2.new(1,-28,0,42),12,muted);summary.Name='ShopSummary'
local buy=Instance.new('TextButton');buy.Name='ShopBuyButton';buy.Position=UDim2.new(0,14,1,-61);buy.Size=UDim2.new(1,-28,0,38);buy.Text='COMING SOON';buy.Font=Enum.Font.GothamBold;buy.TextSize=14;buy.TextColor3=muted;buy.BackgroundColor3=Color3.fromRGB(39,49,63);buy.BorderSizePixel=0;buy.Active=false;buy.AutoButtonColor=false;buy.Selectable=false;buy.Parent=panel;rounded(buy)
label(panel,'Roblox confirms the final price.',UDim2.new(0,14,1,-22),UDim2.new(1,-28,0,16),10,muted)
local offers,cards,tweens={},{},{}
local selectedCategory,selectedId='cash',nil
local available,configured,submitting=false,false,false
local categoryButtons={}
local categoryNames={cash='Cash',levels='Levels',powers='Powers'}
local regularPowers={dash=true,gravity=true,slow=true,slam=true,repulse=true,shield=true,lightning=true,kiblast=true,spinjitzu=true}
local renderOffers
local function cancelPreviews()for _,tween in ipairs(tweens)do tween:Cancel()end;table.clear(tweens)end
local function hide()
 panel.Visible=false;GS.SelectedObject=nil;cancelPreviews()
 if playerGui:GetAttribute('OPActiveMenu')=='cashshop'then playerGui:SetAttribute('OPActiveMenu',nil)end
end
close.Activated:Connect(hide)
local function layout()
 local size=safe.AbsoluteSize;if size.X&lt;=0 or size.Y&lt;=0 then return end
 panel.Size=UDim2.fromOffset(math.min(520,size.X-16),math.min(560,size.Y-24))
end
safe:GetPropertyChangedSignal('AbsoluteSize'):Connect(layout)
playerGui:GetAttributeChangedSignal('OPActiveMenu'):Connect(function()
 if playerGui:GetAttribute('OPActiveMenu')~='cashshop'and panel.Visible then panel.Visible=false;GS.SelectedObject=nil;cancelPreviews()end
end)
UIS.InputBegan:Connect(function(input,processed)
 if panel.Visible and not processed and(input.KeyCode==Enum.KeyCode.Escape or input.KeyCode==Enum.KeyCode.ButtonB)then hide()end
end)
local function selectedOffer()
 for _,offer in ipairs(offers)do if offer.id==selectedId and offer.category==selectedCategory then return offer end end
end
local function updateAction()
 local offer=selectedOffer()
 local canBuy=offer~=nil and available and configured and offer.available==true and not offer.owned and not submitting
 buy.Active=canBuy;buy.Selectable=canBuy;buy.AutoButtonColor=canBuy
 buy.BackgroundColor3=canBuy and Color3.fromRGB(43,98,77)or Color3.fromRGB(39,49,63)
 buy.TextColor3=canBuy and ink or muted
 if submitting then buy.Text='CHECKING PURCHASE…'
 elseif not configured then buy.Text='COMING SOON'
 elseif not offer then buy.Text='CHOOSE AN OFFER'
 elseif offer.owned then buy.Text='ALREADY OWNED'
 elseif canBuy then buy.Text='BUY · '..offer.robux..' ROBUX'
 else buy.Text=offer.reason or'UNAVAILABLE'end
 if offer then summary.Text=offer.name..' · '..offer.robux..' Robux\n'..(offer.owned and'Already unlocked for your loadout.'or(offer.reason or'Roblox will ask you to confirm.'))
 else summary.Text='Choose an offer. Conveyor items and developer perks are never sold here.'end
end
local function preview(parent,offer)
 local area=Instance.new('Frame');area.Name='PowerPreview';area.Position=UDim2.fromOffset(10,126);area.Size=UDim2.new(1,-20,0,44);area.BackgroundColor3=Color3.fromRGB(15,27,44);area.BorderSizePixel=0;area.ClipsDescendants=true;area.Parent=parent;rounded(area)
 local function shape(name,pos,size,color)
  local p=Instance.new('Frame');p.Name=name;p.Position=pos;p.Size=size;p.AnchorPoint=Vector2.new(.5,.5);p.BorderSizePixel=0;p.BackgroundColor3=color;p.Parent=area;rounded(p,20);return p
 end
 local function animate(object,seconds,properties)
  if playerGui:GetAttribute('OPReducedEffects')==true then return end
  local tween=Tween:Create(object,TweenInfo.new(seconds,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),properties)
  tweens[#tweens+1]=tween;tween:Play()
 end
 if offer.power=='kiblast'then
  local trail=shape('KiPreviewTrail',UDim2.fromScale(.38,.5),UDim2.fromScale(.55,.08),Color3.fromRGB(102,218,255));trail.BackgroundTransparency=.5
  local orb=shape('KiPreviewOrb',UDim2.fromScale(.14,.5),UDim2.fromOffset(26,26),Color3.fromRGB(170,241,255))
  animate(orb,.7,{Position=UDim2.fromScale(.87,.5),BackgroundTransparency=.2})
 elseif offer.power=='spinjitzu'then
  for index=1,4 do
   local ring=shape('TornadoPreviewRing'..index,UDim2.fromScale(.5,.18+index*.14),UDim2.fromScale(.12+index*.075,.1),Color3.fromRGB(115,239,210));ring.Rotation=index*17
   animate(ring,1.1,{Rotation=ring.Rotation+300,BackgroundTransparency=.35})
  end
 else
  local icon=label(area,offer.icon or'POWER',UDim2.fromScale(.1,.15),UDim2.fromScale(.8,.7),18,gold);icon.TextXAlignment=Enum.TextXAlignment.Center
  animate(icon,.7,{TextTransparency=.25})
 end
end
local function details(offer)
 if offer.category=='cash'then return string.format('$%d game cash',offer.cash)end
 if offer.category=='levels'then return string.format('+%d base level%s',offer.levels,offer.levels==1 and''or's')end
 return 'RANK '..tostring(offer.rank or'?')..' · '..tostring(offer.cooldown or'?')..'s COOLDOWN'
end
renderOffers=function()
 cancelPreviews();for _,card in ipairs(cards)do card:Destroy()end;cards={}
 for key,button in pairs(categoryButtons)do button.BackgroundColor3=key==selectedCategory and Color3.fromRGB(42,76,72)or Color3.fromRGB(39,49,63)end
 local offset=0;local selectedCard
 for _,offer in ipairs(offers)do if offer.category==selectedCategory then
  local selected=offer.id==selectedId
  local height=selected and offer.category=='powers'and 180 or(selected and 134 or 84)
  local card=Instance.new('TextButton');card.Name='ShopOffer_'..offer.id;card.Position=UDim2.fromOffset(0,offset);card.Size=UDim2.new(1,-8,0,height);card.Text='';card.BorderSizePixel=0;card.BackgroundColor3=selected and Color3.fromRGB(37,66,76)or Color3.fromRGB(31,45,64);card.Selectable=true;card.Parent=list;rounded(card)
  if selected then selectedCard=card end
  local badge=label(card,offer.icon or(offer.category=='cash'and'$'or offer.category=='levels'and'LV'or'P'),UDim2.fromOffset(8,12),UDim2.fromOffset(40,44),15,green);badge.TextXAlignment=Enum.TextXAlignment.Center;badge.Name='OfferIcon'
  label(card,offer.name,UDim2.fromOffset(55,7),UDim2.new(.67,-55,0,30),13,gold)
  label(card,details(offer),UDim2.fromOffset(55,38),UDim2.new(.67,-55,0,32),10,muted)
  local cost=label(card,offer.robux..' Robux\n'..(offer.priceVerified==true and'PRICE'or'PROPOSED'),UDim2.new(.67,0,0,13),UDim2.new(.33,-10,0,48),12,green);cost.Name='OfferPrice';cost.TextXAlignment=Enum.TextXAlignment.Right
  if selected then
   local description=offer.description or'Adds this reward to your saved progress after a confirmed purchase.'
   label(card,description,UDim2.fromOffset(12,81),UDim2.new(1,-24,0,42),11,ink).Name='OfferDescription'
   if offer.category=='powers'then preview(card,offer)end
  end
  card.Activated:Connect(function()selectedId=offer.id;renderOffers()end)
  cards[#cards+1]=card;offset+=height+8
 end end
 list.CanvasSize=UDim2.fromOffset(0,offset);updateAction()
 if UIS.GamepadEnabled and panel.Visible then GS.SelectedObject=selectedCard or categoryButtons[selectedCategory]end
end
for index,key in ipairs({'cash','levels','powers'})do
 local category=key
 local button=Instance.new('TextButton');button.Name='ShopCategory_'..key;button.Position=UDim2.new((index-1)/3,14-(index-1)*4,0,80);button.Size=UDim2.new(1/3,-16,0,34);button.Text=categoryNames[key];button.TextSize=13;button.Font=Enum.Font.GothamBold;button.TextColor3=ink;button.BorderSizePixel=0;button.Parent=panel;rounded(button);categoryButtons[key]=button
 button.Activated:Connect(function()selectedCategory=category;selectedId=nil;list.CanvasPosition=Vector2.new(0,0);renderOffers()end)
end
buy.Activated:Connect(function()
 local offer=selectedOffer()
 if submitting or not available or not configured or not offer or offer.available~=true or offer.owned then return end
 submitting=true;updateAction();remote:FireServer({kind='buy',id=offer.id})
end)
local function positive(n)return type(n)=='number'and n==n and n&gt;0 and n&lt;math.huge and n%1==0 end
remote.OnClientEvent:Connect(function(data)
 if type(data)~='table'then return end
 if data.kind=='result'then
  submitting=false;updateAction();if type(data.message)=='string'then status.Text=data.message end;return
 end
 if data.kind~='catalog'or type(data.available)~='boolean'or type(data.configured)~='boolean'or type(data.offers)~='table'then return end
 offers={};available=data.available;configured=data.configured;submitting=false
 for index,offer in ipairs(data.offers)do
  if index&gt;15 then break end
  if type(offer)=='table'and type(offer.id)=='string'and type(offer.name)=='string'and positive(offer.robux)and categoryNames[offer.category]
   and((offer.category=='cash'and positive(offer.cash))or(offer.category=='levels'and positive(offer.levels))or(offer.category=='powers'and regularPowers[offer.power]))then offers[#offers+1]=offer end
 end
 status.Text=type(data.message)=='string'and data.message or(configured and'Choose an offer. Purchases need Roblox confirmation.'or'Preview offers · Purchases are not available yet.')
 renderOffers();layout()
 if data.open~=false then
  playerGui:SetAttribute('OPActiveMenu','cashshop');panel.Visible=true
  if UIS.GamepadEnabled then GS.SelectedObject=close end
 end
end)
layout()
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_V76_CashShopConfig"><Properties><string name="Name">CashShopConfig</string><ProtectedString name="Source">-- Configure real product IDs, verify Roblox prices, then enable checkout.
-- Disabled by default: missing IDs never produce a purchase prompt.
-- Only cash, base levels and the nine ordinary unlockable powers belong here.
-- Conveyor collectibles and every developer privilege are excluded.
return {
 Enabled=false,
 PreviewOnly=true,
 CashPerRobux=200,
 ProductInfoTTL=120,
 PromptCooldown=3,
 OpenCooldown=.5,
 Offers={
  {id='pocket',name='Pocket Cash',category='cash',robux=25,cash=5000,productId=3720840251},
  {id='stack',name='Vault Stack',category='cash',robux=100,cash=20000,productId=3720846297},
  {id='chest',name='Treasure Chest',category='cash',robux=250,cash=50000,productId=3720846778},
  {id='fortune',name='Grand Fortune',category='cash',robux=500,cash=100000,productId=3720847183},
  {id='level_one',name='One Base Level',category='levels',robux=25,levels=1,productId=3720847536},
  {id='level_five',name='Five Base Levels',category='levels',robux=100,levels=5,productId=3720847942},
  {id='unlock_dash',name='Dash Unlock',category='powers',robux=2,power='dash',productId=3720848352},
  {id='unlock_gravity',name='Pull Unlock',category='powers',robux=6,power='gravity',productId=3720848733},
  {id='unlock_slow',name='Slow Field Unlock',category='powers',robux=8,power='slow',productId=3720849165},
  {id='unlock_slam',name='Ground Slam Unlock',category='powers',robux=25,power='slam',productId=3720849458},
  {id='unlock_repulse',name='Knockback Pulse Unlock',category='powers',robux=70,power='repulse',productId=3720851934},
  {id='unlock_shield',name='Force Field Shield Unlock',category='powers',robux=90,power='shield',productId=3720852231},
  {id='unlock_lightning',name='Lightning Strike Unlock',category='powers',robux=325,power='lightning',productId=3720852595},
  {id='unlock_kiblast',name='Ki Blast Unlock',category='powers',robux=325,power='kiblast',productId=3720852857},
  {id='unlock_spinjitzu',name='Spinjitzu Unlock',category='powers',robux=80,power='spinjitzu',productId=3720853158},
 },
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_V76_CashShopService"><Properties><string name="Name">CashShopService</string><ProtectedString name="Source">-- Only ProcessReceipt can request a durable reward. Prompts never grant anything.
local Powers=require(script.Parent.PowerCatalog)
local S={};S.__index=S
local owners=setmetatable({},{__mode='k'})
local cashIds={pocket=true,stack=true,chest=true,fortune=true}
local levelIds={level_one=1,level_five=5}
local normal={dash=true,gravity=true,slow=true,slam=true,repulse=true,shield=true,lightning=true,kiblast=true,spinjitzu=true}
local configKeys={Enabled=true,PreviewOnly=true,CashPerRobux=true,Offers=true,ProductInfoTTL=true,PromptCooldown=true,OpenCooldown=true}
local common={id=true,name=true,category=true,robux=true,productId=true}
local glyphs={dash='&gt;&gt;',gravity='PULL',slow='SLOW',slam='SLAM',repulse='PULSE',shield='SHIELD',lightning='BOLT',kiblast='KI',spinjitzu='WIND'}
local function integer(n)return type(n)=='number'and n==n and n&gt;0 and n&lt;=9007199254740991 and n%1==0 end
local function copy(v)if type(v)~='table'then return v end;local t={};for k,x in pairs(v)do t[k]=copy(x)end;return t end
function S.validate(c)
 if type(c)~='table'or type(c.Enabled)~='boolean'or type(c.PreviewOnly)~='boolean'or c.Enabled==c.PreviewOnly then return false,'Choose either live checkout or preview mode.'end
 for k in pairs(c)do if not configKeys[k]then return false,'Unsupported shop configuration field.'end end
 if not integer(c.CashPerRobux)or type(c.Offers)~='table'or #c.Offers~=15 then return false,'Expected four cash, two level and nine ordinary-power offers.'end
 for k in pairs(c.Offers)do if type(k)~='number'or k%1~=0 or k&lt;1 or k&gt;15 then return false,'Offer list must be a dense array.'end end
 for k,b in pairs({ProductInfoTTL={10,600},PromptCooldown={1,30},OpenCooldown={.25,5}})do
  local n=c[k];if n~=nil and(type(n)~='number'or n~=n or n&lt;b[1]or n&gt;b[2])then return false,'Invalid shop throttle.'end
 end
 local ids,products={},{};local counts={cash=0,levels=0,powers=0}
 for _,o in ipairs(c.Offers)do
  if type(o)~='table'or type(o.id)~='string'or #o.id&lt;1 or #o.id&gt;32 or ids[o.id]or type(o.name)~='string'or #o.name&lt;1 or #o.name&gt;40
   or not integer(o.robux)or not counts[o.category]or not(o.productId==0 or integer(o.productId))then return false,'Invalid or duplicated offer.'end
  if c.Enabled and o.productId==0 then return false,'Every live offer needs a real Developer Product ID.'end
  if o.productId~=0 then if products[o.productId]then return false,'Product IDs must be unique.'end;products[o.productId]=true end
  local effect=o.category=='powers'and'power'or o.category
  for k in pairs(o)do if not common[k]and k~=effect then return false,'Unsupported reward or developer privilege.'end end
  if o.category=='cash'then
   if not cashIds[o.id]or not integer(o.cash)or o.cash~=o.robux*c.CashPerRobux then return false,'Cash prices must stay proportional.'end
  elseif o.category=='levels'then
   if levelIds[o.id]~=o.levels or not integer(o.levels)then return false,'Invalid base-level offer.'end
  else
   local p=normal[o.power]and Powers.ById[o.power]
   if not p or o.id~='unlock_'..o.power or o.robux~=math.ceil(p.price/c.CashPerRobux)then return false,'Only ordinary power unlocks belong here.'end
  end
  counts[o.category]+=1;ids[o.id]=true
 end
 return counts.cash==4 and counts.levels==2 and counts.powers==9,'Missing supported offers.'
end
function S.new(config,ctx)
 local valid,why=S.validate(config);assert(valid,why)
 assert(type(ctx)=='table'and ctx.core,'Shop requires server context.')
 if config.Enabled then
  assert(ctx.persistence and type(ctx.persistence.isReady)=='function'and type(ctx.purchaseGrant)=='function','Live checkout requires durable receipt fulfillment.')
  assert(ctx.marketplace and type(ctx.marketplace.PromptProductPurchase)=='function'and type(ctx.marketplace.GetProductInfo)=='function','Live checkout requires MarketplaceService.')
 end
 local self=setmetatable({config=copy(config),ctx=ctx,offers={},byId={},byProduct={},info={},nextOpen={},nextRequest={},prompting={},receiptBusy={},clock=ctx.clock or os.clock},S)
 for _,o in ipairs(config.Offers)do local row=copy(o);self.offers[#self.offers+1]=row;self.byId[row.id]=row;if row.productId&gt;0 then self.byProduct[row.productId]=row end end
 return self
end
function S:ready(p)
 if not p or not p.Parent or not self.ctx.core.players[p.UserId]then return false,'Player unavailable.'end
 if self.ctx.core.persistenceBusy then return false,'Saving progress. Please wait.'end
 local store=self.ctx.persistence
 if not store or type(store.isReady)~='function'or type(self.ctx.purchaseGrant)~='function'then return false,'Saved purchase delivery is not configured.'end
 local ok,ready=pcall(store.isReady,store,p.UserId)
 return ok and ready==true,'Your saved profile is not ready.'
end
function S:atBench(p)
 if not p or not p.Parent or not self.ctx.core.players[p.UserId]then return false,'Player unavailable.'end
 local root,h=self.ctx.body(p);local a=self.ctx.anchor
 if not root or not h or h.Health&lt;=0 or not a or not a.Parent or(root.Position-a.Position).Magnitude&gt;12 then return false,'Visit the Robux shop bench.'end
 return true
end
function S:productInfo(o)
 if o.productId==0 or not self.ctx.marketplace then return nil,'Developer Product is not configured.'end
 local now=self.clock();local old=self.info[o.productId];if old and now&lt;old.untilAt then return old.value,old.reason end
 local ok,d=pcall(function()return self.ctx.marketplace:GetProductInfo(o.productId,self.ctx.infoType or Enum.InfoType.Product)end)
 local value,reason
 if ok and type(d)=='table'and integer(d.PriceInRobux)and d.IsForSale~=false and(d.ProductId==nil or d.ProductId==o.productId)then
  value={price=d.PriceInRobux,imageId=integer(d.IconImageAssetId)and d.IconImageAssetId or nil}
  if value.price~=o.robux then reason='The Roblox price changed. This offer is temporarily unavailable.'end
 else reason='Roblox could not confirm this product. Please try again.'end
 self.info[o.productId]={value=value,reason=reason,untilAt=now+(value and(self.config.ProductInfoTTL or 120)or 5)}
 return value,reason
end
function S:eligibility(p,o)
 if not self.config.Enabled or self.config.PreviewOnly then return false,'Coming soon. Purchases are not available yet.'end
 local ready,why=self:ready(p);if not ready then return false,why end
 if self.ctx.persistence.canPurchase then
  local safe,reason=self.ctx.persistence:canPurchase(p.UserId);if not safe then return false,reason end
 end
 local state=self.ctx.core.players[p.UserId]
 if state.carry or state.pending then return false,'Deliver your item or leave the bid battle first.'end
 if o.power and Powers.ById[o.power].starter and not state.starterChosen then return false,'Choose your free starter in Powers before buying this unlock.'end
 if o.power and state.powerOwned and state.powerOwned[o.power]then return false,'Already owned.'end
 if o.levels and(state.progression or 0)+o.levels&gt;1000 then return false,'This pack exceeds the maximum base level.'end
 if o.cash and((state.cash or 0)+(state.held or 0)+o.cash&gt;2000000000 or(state.paidCashCredit or 0)&gt;0)then return false,'Spend or collect your existing cash credit before buying more.'end
 local info,reason=self:productInfo(o);if not info or reason then return false,reason end
 return true,nil,info
end
function S:catalog(p)
 local out={};local any=false;local state=p and self.ctx.core.players[p.UserId]
 for _,o in ipairs(self.offers)do
  local info=self:productInfo(o);local available,reason=self:eligibility(p,o);local power=o.power and Powers.ById[o.power]
  out[#out+1]={id=o.id,name=o.name,category=o.category,robux=info and info.price or o.robux,proposedRobux=o.robux,
   cash=o.cash,levels=o.levels,power=o.power,rank=power and power.rank,cooldown=power and power.cooldown,
   description=power and power.description or(o.cash and'Add game cash to your saved balance.'or'Raise your base level, income and protection.'),
   icon=o.cash and'$'or(o.levels and'LV'or glyphs[o.power]),imageId=info and info.imageId,
   available=available,owned=o.power~=nil and state~=nil and state.powerOwned~=nil and state.powerOwned[o.power]==true or false,
   reason=reason,preview=o.power,priceSource=info and'roblox'or'proposed',priceVerified=info~=nil}
  any=any or available
 end
 return{kind='catalog',available=any,configured=self.config.Enabled and not self.config.PreviewOnly,title='Robux Shop',
  message=self.config.Enabled and'Roblox confirms the final price before you buy.'or'Coming soon. Purchases are not available yet.',offers=out}
end
function S:notify(p,data)if p and p.Parent and self.ctx.remote then pcall(function()self.ctx.remote:FireClient(p,data)end)end end
function S:open(p)
 local near,why=self:atBench(p);if not near then return false,why end
 local now=self.clock();if now&lt;(self.nextOpen[p.UserId]or 0)then return false,'Please wait.'end
 self.nextOpen[p.UserId]=now+(self.config.OpenCooldown or .5);self:notify(p,self:catalog(p));return true
end
function S:request(p,payload)
 if not p or not p.Parent or not self.ctx.core.players[p.UserId]then return false,'Player unavailable.'end
 local function deny(why)self:notify(p,{kind='result',ok=false,message=why});return false,why end
 local now=self.clock();if now&lt;(self.nextRequest[p.UserId]or 0)then return deny('Please wait.')end
 self.nextRequest[p.UserId]=now+(self.config.PromptCooldown or 3)
 if type(payload)~='table'or payload.kind~='buy'or type(payload.id)~='string'or #payload.id&gt;32 then return deny('Invalid shop request.')end
 for k in pairs(payload)do if k~='kind'and k~='id'then return deny('Only an offer ID can be requested.')end end
 local o=self.byId[payload.id];if not o then return deny('Offer unavailable.')end
 local near,why=self:atBench(p);if not near then return deny(why)end
 local pending=self.prompting[p.UserId];if pending and now-pending.started&lt;90 then return deny('Finish your current Roblox checkout first.')end
 local allowed,reason=self:eligibility(p,o);if not allowed then return deny(reason)end
 if not self.attached then return deny('Purchase delivery is not connected.')end
 self.prompting[p.UserId]={offerId=o.id,productId=o.productId,started=now}
 local ok=pcall(function()self.ctx.marketplace:PromptProductPurchase(p,o.productId)end)
 if not ok then self.prompting[p.UserId]=nil;return deny('Roblox checkout could not open. No reward was granted.')end
 self:notify(p,{kind='result',ok=true,id=o.id,message='Complete or cancel the Roblox purchase window.'});return true
end
function S:processReceipt(r)
 local decisions=self.ctx.purchaseDecision or Enum.ProductPurchaseDecision
 local pending,granted=decisions.NotProcessedYet,decisions.PurchaseGranted
 if type(r)~='table'or not integer(r.PlayerId)or not integer(r.ProductId)or type(r.PurchaseId)~='string'or #r.PurchaseId&lt;1 or #r.PurchaseId&gt;128 or not string.match(r.PurchaseId,'^[%w_%-:]+$')then return pending end
 local o=self.byProduct[r.ProductId];if not o or self.receiptBusy[r.PurchaseId]then return pending end
 local p
 if self.ctx.getPlayerByUserId then p=self.ctx.getPlayerByUserId(r.PlayerId)elseif self.ctx.players then p=self.ctx.players:GetPlayerByUserId(r.PlayerId)end
 if not p or p.UserId~=r.PlayerId or not self:ready(p)then return pending end
 self.receiptBusy[r.PurchaseId]=true
 local ok,done,reason=pcall(self.ctx.purchaseGrant,p,r,copy(o));self.receiptBusy[r.PurchaseId]=nil
 if not ok or done~=true then return pending end
 self.prompting[p.UserId]=nil
 self:notify(p,{kind='result',ok=true,id=o.id,message=type(reason)=='string'and reason or'Purchase saved and delivered.'})
 local built,catalog=pcall(self.catalog,self,p);if built then self:notify(p,catalog)end
 return granted
end
function S:attach()
 if self.attached then return true end
 local m=self.ctx.marketplace;if not m then return false,'MarketplaceService is unavailable.'end
 if owners[m]and owners[m]~=self then return false,'A receipt handler is already attached.'end
 self.receiptHandler=function(r)return self:processReceipt(r)end
 local ok=pcall(function()m.ProcessReceipt=self.receiptHandler end)
 if not ok then self.receiptHandler=nil;return false,'Receipt handler could not be installed.'end
 owners[m]=self;self.attached=true
 if m.PromptProductPurchaseFinished then self.finished=m.PromptProductPurchaseFinished:Connect(function(userId,productId,purchased)
  local current=self.prompting[userId];if not current or current.productId~=productId then return end;self.prompting[userId]=nil
  local p=self.ctx.getPlayerByUserId and self.ctx.getPlayerByUserId(userId)or(self.ctx.players and self.ctx.players:GetPlayerByUserId(userId))
  self:notify(p,{kind='result',ok=purchased==true,id=current.offerId,message=purchased and'Purchase processing. Delivery follows the confirmed Roblox receipt.'or'Purchase cancelled. No reward was granted.'})
 end)end
 return true
end
function S:removePlayer(p)self.nextOpen[p.UserId]=nil;self.nextRequest[p.UserId]=nil;self.prompting[p.UserId]=nil end
return S
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_V78_FlightPose"><Properties><string name="Name">FlightPose</string><ProtectedString name="Source">-- Server-owned Superman pose without rotating forces or gyroscopes.
local M={}
function M.apply(player,m,root,direction)
 if not root or not m.flight then return end
 if direction and direction.Magnitude&gt;.1 then m.flightFacing=direction.Unit end
 local heading=m.flightFacing or Vector3.new(0,0,-1)
 local up=math.abs(heading:Dot(Vector3.yAxis))&gt;.95 and Vector3.zAxis or Vector3.yAxis
 local right=heading:Cross(up).Unit
 -- The character's head points along travel and the torso faces downward.
 root.AssemblyAngularVelocity=Vector3.zero
 root.CFrame=CFrame.fromMatrix(root.Position,right,heading,right:Cross(heading))
 m.flightJoints=m.flightJoints or{}
 local character=player.Character
 if character then for _,joint in ipairs(character:GetDescendants())do
  if joint:IsA('Motor6D')and(joint.Name=='RightShoulder'or joint.Name=='LeftShoulder'or joint.Name=='Right Shoulder'or joint.Name=='Left Shoulder'or joint.Name=='Neck')then
   local original=m.flightJoints[joint]
   if not original then original=joint.C0;m.flightJoints[joint]=original end
   local angle=joint.Name=='Neck'and math.pi/2 or math.pi
   joint.C0=CFrame.new(original.Position)*CFrame.Angles(angle,0,0)*original.Rotation
  end
 end end
 player:SetAttribute('OPDeveloperFlying',true)
end
function M.stop(player,m,root)
 if not m.flightFacing and not m.flightJoints then player:SetAttribute('OPDeveloperFlying',nil);return end
 for joint,original in pairs(m.flightJoints or{})do if joint.Parent then joint.C0=original end end
 m.flightJoints=nil
 if root and root.Parent then
  local direction=m.flightFacing or Vector3.new(0,0,-1)
  local flat=Vector3.new(direction.X,0,direction.Z)
  if flat.Magnitude&lt;.01 then flat=Vector3.new(0,0,-1)end
  root.CFrame=CFrame.lookAt(root.Position,root.Position+flat.Unit)
  root.AssemblyAngularVelocity=Vector3.zero
 end
 player:SetAttribute('OPDeveloperFlying',nil)
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_V78_FlightPoseClient"><Properties><string name="Name">FlightPoseClient</string><ProtectedString name="Source">-- Cosmetic animation suppression while the authorized server flight pose is active.
-- No movement, permission or orientation authority is granted by this module.
local Players=game:GetService('Players')
local Run=game:GetService('RunService')
local M={};local started=false
function M.start()
 if started then return end;started=true
 local cache={}
 Run.PreSimulation:Connect(function()
  for _,player in ipairs(Players:GetPlayers())do
   local character=player.Character
   if player:GetAttribute('OPDeveloperFlying')==true and character then
    local entry=cache[player]
    if not entry or entry.character~=character then
     entry={character=character,joints={}};cache[player]=entry
     for _,joint in ipairs(character:GetDescendants())do if joint:IsA('Motor6D')then entry.joints[#entry.joints+1]=joint end end
    end
    for _,joint in ipairs(entry.joints)do if joint.Parent then joint.Transform=CFrame.identity end end
   else cache[player]=nil end
  end
 end)
 Players.PlayerRemoving:Connect(function(player)cache[player]=nil end)
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_V78_PersistenceConfig"><Properties><string name="Name">PersistenceConfig</string><ProtectedString name="Source">-- Live storage is required. Failed/locked/corrupt loads never get a writable fallback profile.
return {
 Enabled=true,
 ProfileStoreName='StealAnOPItemProfiles_v1',
 JournalStoreName='StealAnOPItemTransfers_v1',
 StudioProfileStoreName='StealAnOPItem_TESTProfiles_v1',
 StudioJournalStoreName='StealAnOPItem_TESTTransfers_v1',
 LockSeconds=120,
 AutosaveSeconds=30,
 JournalSeconds=60,
 Retries=3,
 RetryDelay=.35,
 MaxRetryDelay=2,
 MaxProfilesPerTransaction=8,
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_V78_PersistentSession"><Properties><string name="Name">PersistentSession</string><ProtectedString name="Source">-- Serialize durable economy changes before the server acknowledges them.
-- A storage failure stops play; unconfirmed memory is never saved over good data.
local Codec=require(script.Parent.ProfileCodec)
local S={};S.__index=S
local MAX_CASH=2000000000
local function clone(v)
 if type(v)~='table'then return v end
 local out={};for k,x in pairs(v)do out[k]=clone(x)end;return out
end
local function equal(a,b)
 if type(a)~=type(b)then return false end
 if type(a)~='table'then return a==b end
 for k,v in pairs(a)do if not equal(v,b[k])then return false end end
 for k in pairs(b)do if a[k]==nil then return false end end
 return true
end
local fields={'players','items','offers','transactions','exodiaUsed','infinityAwarded','seq','revision','now'}
local function backup(core)
 local references={}
 local function snapshot(value)
  if type(value)~='table'then return value end
  local out={};references[out]=value
  for k,v in pairs(value)do out[k]=snapshot(v)end;return out
 end
 local out={};for _,key in ipairs(fields)do out[key]=snapshot(core[key])end
 return{values=out,references=references}
end
local function rollback(core,saved)
 local function restore(value)
  if type(value)~='table'then return value end
  local target=saved.references[value]or{};table.clear(target)
  for k,v in pairs(value)do target[k]=restore(v)end;return target
 end
 for _,key in ipairs(fields)do core[key]=restore(saved.values[key])end
end
local methods={'purchaseAttempt','bid','withdraw','pickup','expireOffer','finish','beginSteal','sell','collect',
 'upgrade','gainLevel','shopPower','chooseStarter','loadPower','unlockPowerSlot','grant','claimExodia',
 'checkExodia','checkInfinity','protect','equip','characterReset','cancelAll',
 'beginItemMove','cancelItemMove','moveItem'}
function S.new(core,store,ctx)
 local self=setmetatable({core=core,store=store,ctx=ctx or{},loaded={},loading={},rate={},pendingSettings={},depth=0,original={},failed=false},S)
 self.clock=self.ctx.clock or os.clock;self.wall=self.ctx.wall or os.time
 self.wait=self.ctx.wait or task.wait
 self.guid=assert(self.ctx.guid,'Unique item IDs require a server GUID factory')
 self.namespace=self.guid();core.persistenceBusy=false
 -- Prefix every persistent item/reward ID across servers. Models/stats are unchanged.
 core.nextId=function(c,prefix)c.seq+=1;return self.namespace..':'..prefix..c.seq end
 for _,name in ipairs(methods)do
  local original=core[name];self.original[name]=original
  core[name]=function(c,...)
   local args=table.pack(...)
   if self.depth&gt;0 and self.ownerThread==coroutine.running()then return self:_invoke(name,original,args)end
   if name=='grant'and self.loading[args[1]]then return self:_invoke(name,original,args)end
   return self:_change(name,args,function()return self:_invoke(name,original,args)end)
  end
 end
 return self
end
function S:_invoke(name,original,args)
 local result=table.pack(original(self.core,table.unpack(args,1,args.n)))
 if name=='grant'and type(result[1])=='string'then
  local uid=result[1];local item=self.core.items[uid]
  if item then
   local fresh=self.core:nextId('relic');self.core.items[uid]=nil;item.uid=fresh;self.core.items[fresh]=item
   local p=self.core.players[item.owner];p.slots[item.slot]=fresh;if p.equipped==uid then p.equipped=fresh end
   result[1]=fresh
  end
 end
 return table.unpack(result,1,result.n)
end
function S:isReady(id)
 return not self.failed and self.loaded[id]==true and self.store:isReady(id)
end
function S:canPurchase(id)
 if not self:isReady(id)or self.core.persistenceBusy then return false,'Saved profile is not ready.'end
 local count=0;for _ in pairs(self.core.players[id].receipts)do count+=1 end
 if count&gt;=Codec.MaxReceipts then return false,'Purchases are unavailable while your receipt history needs maintenance.'end
 if self.ctx.canStore then
  local data=Codec.capture(self.core,id,self.clock(),self.wall())
  if not data or not self.ctx.canStore(data,10000)then return false,'Purchases are unavailable while your saved profile needs maintenance.'end
 end
 return true
end
function S:_fatal(why)
 self.failed=true;self.core.persistenceBusy=true
 if self.ctx.onFailure then self.ctx.onFailure(tostring(why))end
 return false,'Saved progress is unavailable. Rejoin when storage recovers.'
end
function S:_ids(name,args)
 local ids={};local used={}
 local function add(id)if id and self.loaded[id]and not used[id]then used[id]=true;ids[#ids+1]=id end end
 if name=='cancelAll'or name=='claimExodia'or name=='admin'then for id in pairs(self.loaded)do add(id)end
 elseif name=='pickup'or name=='expireOffer'then
  local o=name=='pickup'and args[1]or self.core.offers[args[1]]
  if o then for id in pairs(o.bids)do add(id)end end
  if name=='pickup'and args[2]then add(args[2].player)end
 else
  add(args[1]);local p=self.core.players[args[1]]
  if name=='finish'or name=='characterReset'then local it=p and self.core.items[p.carry];if it then add(it.owner)end end
  if name=='beginSteal'then local it=self.core.items[args[2]];if it then add(it.owner)end end
 end
 table.sort(ids);return ids
end
function S:_capture(ids,now,wall)
 local data={}
 for _,id in ipairs(ids)do
  local value,why=Codec.capture(self.core,id,now,wall)
  if not value then return nil,why end
  data[id]=value
 end
 return data
end
function S:_budget(ids,cost)
 local now=self.clock()
 for _,id in ipairs(ids)do
  local r=self.rate[id]or{tokens=6,time=now};self.rate[id]=r
  r.tokens=math.min(6,r.tokens+math.max(0,now-r.time)*.25);r.time=now
  if r.tokens&lt;cost then return false end
 end
 for _,id in ipairs(ids)do self.rate[id].tokens-=cost end
 return true
end
function S:_redeem(ids)
 for _,id in ipairs(ids)do local p=self.core.players[id]
  local amount=math.min(p.paidCashCredit or 0,math.max(0,MAX_CASH-p.cash-p.held))
  if amount&gt;0 then p.cash+=amount;p.paidCashCredit-=amount end
 end
end
local function unownedExpiry(core,args)
 local id,now=args[1],args[2];local offer=core.offers[id]
 if type(now)~='number'or now~=now or math.abs(now)==math.huge or not offer or offer.state~='Conveyor'
  or type(offer.bids)~='table'or next(offer.bids)or offer.tx then return false end
 local item=core.items[offer.uid]
 if not item or item.state~='Conveyor'or item.offer~=id or item.owner or item.carrier or item.tx then return false end
 if offer.x&gt;core.config.ConveyorEndX and now&lt;offer.expires then return false end
 for _,tx in pairs(core.transactions)do
  if not tx.resolved and(tx.offer==id or tx.uid==offer.uid)then return false end
 end
 return true
end
function S:_change(name,args,callback,urgent)
 if self.failed or self.core.persistenceBusy then return false,'Progress is saving. Please try again.'end
 local ids=self:_ids(name,args)
 -- Unsold belt items have no saved owner. Dispose only this verified world-only
 -- state through the same mutex/rollback path; never exempt bids or ownership.
 if #ids==0 and not(name=='expireOffer'and unownedExpiry(self.core,args))then return false,'Saved profile is not ready.'end
 for _,id in ipairs(ids)do if not self:isReady(id)then return self:_fatal('Profile lease is not ready: '..id)end end
 local now,wall=self.clock(),self.wall()
 local before,why=self:_capture(ids,now,wall);if not before then return self:_fatal(why)end
 local saved=backup(self.core)
 self.core.persistenceBusy=true;self.depth=1;self.ownerThread=coroutine.running()
 local result=table.pack(pcall(callback));self.depth=0;self.ownerThread=nil
 if not result[1]then rollback(self.core,saved);return self:_fatal(result[2])end
 self:_redeem(ids)
 local after;after,why=self:_capture(ids,now,wall)
 if not after then rollback(self.core,saved);return self:_fatal(why)end
 local changed={};for _,id in ipairs(ids)do if not equal(before[id],after[id])then changed[#changed+1]=id end end
 if #changed&gt;0 then
  local cost=#changed&gt;1 and 3 or 1
  local automatic=name=='finish'or name=='characterReset'or name=='pickup'or name=='expireOffer'or name=='withdraw'or urgent
  if not automatic and not self:_budget(changed,cost)then
   rollback(self.core,saved);self.core.persistenceBusy=false
   return false,'Progress is saving. Please wait a moment before changing your vault.'
  end
  local ok,reason
  if #changed==1 then ok,reason=self.store:save(changed[1],after[changed[1]])else ok,reason=self.store:atomic(changed,after)end
  if not ok then rollback(self.core,saved);return self:_fatal(reason)end
  -- A committed journal remains authoritative even if final cleanup needs retry.
  for _,id in ipairs(changed)do
   if not self.store:isReady(id)then
    local recovered=self.store:recover(id)
    if not recovered then return self:_fatal('Committed transfer cleanup needs recovery')end
   end
  end
 end
 self.core.persistenceBusy=false
 return table.unpack(result,2,result.n)
end
function S:_waitForTurn()
 local limit=self.clock()+12
 while self.core.persistenceBusy and not self.failed and self.clock()&lt;limit do self.wait(.05)end
 return not self.failed and not self.core.persistenceBusy
end
function S:load(id)
 if self.loaded[id]or self.loading[id]then return false,'Profile is already loading.'end
 self.loading[id]=true
 -- Defaults are built away from the active world. Only a successful missing-key
 -- UpdateAsync may install them; a failed load never creates a writable fallback.
 local class=getmetatable(self.core);local fresh=class.new(self.core.catalog,self.core.config)
 fresh:addPlayer(id,self.clock())
 local p=fresh.players[id];local old=p.slots[1];local uid=self.guid()..':starter'
 if old then local item=fresh.items[old];fresh.items[old]=nil;item.uid=uid;fresh.items[uid]=item;p.slots[1]=uid;p.equipped=uid end
 local defaults,why=Codec.capture(fresh,id,self.clock(),self.wall())
 if not defaults then self.loading[id]=nil;return false,why end
 local ok,data=self.store:load(id,defaults)
 if not ok then self.loading[id]=nil;return false,data end
 if not self:_waitForTurn()then self.loading[id]=nil;self.store:release(id);return false,'Server progress is unavailable.'end
 self.core.persistenceBusy=true;self.depth=1;self.ownerThread=coroutine.running();self.core:addPlayer(id,self.clock());self.depth=0;self.ownerThread=nil
 ok,why=Codec.restore(self.core,id,data,self.clock(),self.wall())
 if not ok then
  self.loading[id]=nil;self.core.players[id]=nil;self.core.persistenceBusy=false;self.store:release(id)
  return false,why
 end
 self.loaded[id]=true;self.loading[id]=nil
 local recovery=self.core.players[id].carryReturnRecovery
 if recovery then
  self.recoverySeq=(self.recoverySeq or 0)+1
  local index='recovered'..self.recoverySeq
  local x=math.clamp(recovery.pickupX,self.core.config.ConveyorEndX+.1,self.core.config.ConveyorStartX)
  local offer=self.core:setOffer(index,recovery.kind,self.clock(),x)
  self.core.items[offer.uid]=nil;offer.uid=recovery.uid
  self.core.items[recovery.uid]={uid=recovery.uid,kind=recovery.kind,state='Conveyor',offer=index}
  self.core.players[id].carryReturnRecovery=nil
 end
 local normalized;normalized,why=Codec.capture(self.core,id,self.clock(),self.wall())
 if not normalized then return self:_fatal(why)end
 ok,why=self.store:save(id,normalized)
 if not ok then return self:_fatal(why)end
 self.core.persistenceBusy=false
 return true
end
function S:flushAll()
 if not self:_waitForTurn()then return false,'Progress unavailable.'end
 self.core.persistenceBusy=true
 for id in pairs(self.loaded)do
  local pending=clone(self.pendingSettings[id]);if pending then self:_applySettings(id,pending)end
  local data,why=Codec.capture(self.core,id,self.clock(),self.wall())
  if not data then return self:_fatal(why)end
  local ok;ok,why=self.store:save(id,data);if not ok then return self:_fatal(why)end
  if pending then self:_clearSettings(id,pending)end
 end
 self.core.persistenceBusy=false;return true
end
function S.validateSettings(patch)
 if type(patch)~='table'then return false,'Invalid settings.'end
 local allowed={musicMuted='boolean',sfxMuted='boolean',reducedEffects='boolean',musicVolume='number',sfxVolume='number',tutorialCompleted='boolean'}
 local count=0
 for k,v in pairs(patch)do
  count+=1;if count&gt;6 or not allowed[k]or type(v)~=allowed[k]then return false,'Invalid settings.'end
  if type(v)=='number'and(v~=v or v&lt;0 or v&gt;1)then return false,'Invalid volume.'end
 end
 return true
end
function S:_applySettings(id,patch)
 local p=self.core.players[id]
 for k,v in pairs(patch)do if k=='tutorialCompleted'then p.tutorialCompleted=v else p.settings[k]=v end end
end
function S:_clearSettings(id,patch)
 local pending=self.pendingSettings[id]
 if not pending then return end
 for k,v in pairs(patch)do if pending[k]==v then pending[k]=nil end end
 if not next(pending)then self.pendingSettings[id]=nil end
end
function S:settings(id,patch)
 local valid,why=S.validateSettings(patch);if not valid then return false,why end
 return self:_change('settings',{id},function()
  self:_applySettings(id,patch)
  return true,'Settings saved.'
 end)
end
function S:queueSettings(id,patch)
 local valid,why=S.validateSettings(patch);if not valid then return false,why end
 if not self:isReady(id)then return false,'Saved profile is not ready.'end
 local pending=self.pendingSettings[id]or{};self.pendingSettings[id]=pending
 for k,v in pairs(patch)do pending[k]=v end
 return true
end
function S:flushSettings(onlyId)
 if self.core.persistenceBusy or self.failed then return false end
 local flushed=false
 for id,queued in pairs(self.pendingSettings)do if(not onlyId or onlyId==id)and self.loaded[id]then
  local patch=clone(queued)
  if self:settings(id,patch)then self:_clearSettings(id,patch);flushed=true end
 end end
 return flushed
end
function S:adminCommand(callback)
 return self:_change('admin',{},callback)
end
function S:runFor(id,callback)
 return self:_change('direct',{id},callback)
end
local function addCash(p,amount)
 local available=math.max(0,MAX_CASH-p.cash-p.held);local direct=math.min(amount,available)
 p.cash+=direct;p.paidCashCredit=(p.paidCashCredit or 0)+(amount-direct)
end
function S:grantReceipt(player,receipt,offer,cashPerRobux)
 local id=player.UserId
 if self.core.persistenceBusy or not self:isReady(id)then return false,'Profile is not ready.'end
 local old=self.core.players[id].receipts[receipt.PurchaseId]
 if old then return old.productId==receipt.ProductId,'Receipt already saved.'end
 return self:_change('receipt',{id},function()
  local p=self.core.players[id];local count=0;for _ in pairs(p.receipts)do count+=1 end
  if count&gt;=Codec.MaxReceipts then return false,'Receipt ledger capacity reached.'end
  local result='Granted'
  if offer.cash then addCash(p,offer.cash)
  elseif offer.levels then
   local gain=math.min(offer.levels,1000-p.progression)
   if gain&gt;0 then self.core:gainLevel(id,gain)end
   if gain&lt;offer.levels then addCash(p,math.floor(offer.robux*cashPerRobux*(offer.levels-gain)/offer.levels));result='CashFallback'end
  elseif offer.power then
   if p.powerOwned[offer.power]then
    addCash(p,require(script.Parent.PowerCatalog).ById[offer.power].price);result='CashFallback'
   else p.powerOwned[offer.power]=true end
  else return false,'Unsupported receipt reward.'end
  p.receipts[receipt.PurchaseId]={productId=receipt.ProductId,grantedAt=self.wall(),offerId=offer.id,result=result}
  return true,result=='CashFallback'and'Purchase delivered as game cash because the original reward was already owned or capped.'or'Purchase saved.'
 end,true)
end
function S:leave(id)
 if not self.loaded[id]then return false,'Profile is not loaded.'end
 if self.failed then
  if not self.store:isReady(id)then self.store:recover(id)end
  self.store:release(id);self.loaded[id]=nil;return false,'Server stopped after a storage failure.'
 end
 -- PlayerRemoving must not orphan a loaded profile while another write is
 -- yielding. Keep this callback alive until that write completes or the
 -- server enters its fail-closed release path.
 while not self:_waitForTurn()do
  if self.failed then return self:leave(id)end
 end
 -- BindToClose and PlayerRemoving may both wait for the same departure.
 if not self.loaded[id]then return true end
 -- Resolve carries/bids durably before removing owned world models.
 self.core:characterReset(id,self.clock())
 for other,p in pairs(self.core.players)do
  local it=p.carry and self.core.items[p.carry]
  if it and it.owner==id then self.core:finish(other,false,self.clock())end
 end
 if self.failed then return self:leave(id)end
 self.core.persistenceBusy=true
 local pending=self.pendingSettings[id];if pending then self:_applySettings(id,pending)end
 local data,why=Codec.capture(self.core,id,self.clock(),self.wall())
 if not data then return self:_fatal(why)end
 local ok;ok,why=self.store:release(id,data)
 if not ok then return self:_fatal(why)end
 self.loaded[id]=nil;self.rate[id]=nil;self.pendingSettings[id]=nil
 self.depth=1;self.ownerThread=coroutine.running();self.core:removePlayer(id);self.depth=0;self.ownerThread=nil;self.core.persistenceBusy=false
 return true
end
return S
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_V78_PowerEffects"><Properties><string name="Name">PowerEffects</string><ProtectedString name="Source">-- Cosmetic-only Ki Blast / Spinjitzu effects. Server spherecasts own every hit.
local Players=game:GetService('Players')
local Run=game:GetService('RunService')
local M={}
local sessions=setmetatable({},{__mode='k'})
local SUPPORTED={lightning=true,slam=true,kiblast=true,spinjitzu=true,kiProjectile=true,kiImpact=true,spinjitzuActive=true,spinjitzuEnd=true}
local MAX_PARTS,MAX_DISTANCE=120,180
local function vector(v)return typeof(v)=='Vector3'and v.X==v.X and v.Y==v.Y and v.Z==v.Z and math.abs(v.X)&lt;10000 and math.abs(v.Y)&lt;10000 and math.abs(v.Z)&lt;10000 end
local function bounded(value,fallback,lo,hi)
 local n=tonumber(value);if not n or n~=n or math.abs(n)==math.huge then n=fallback end
 return math.clamp(n,lo,hi)
end
function M.start(net,gui)
 if sessions[gui]then return sessions[gui]end
 local entries={};local count=0;local dead=false
 local function reduced()return gui:GetAttribute('OPReducedEffects')==true end
 local function drop(entry)
  if not entry or entry.dead then return end;entry.dead=true
  for _,part in ipairs(entry.parts)do part:Destroy();count=count-1 end
 end
 local function clear(kind,userId)
  for _,entry in ipairs(entries)do if entry.kind==kind and entry.userId==userId then drop(entry)end end
 end
 local function part(entry,name,color,ball)
  local p=Instance.new('Part');p.Name=name;p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=false
  p.Material=Enum.Material.Neon;p.Color=color;p.Transparency=.15
  if ball then p.Shape=Enum.PartType.Ball end
  p.Size=Vector3.new(.2,.2,.2);p.Parent=workspace;entry.parts[#entry.parts+1]=p;count=count+1;return p
 end
 local function line(p,a,b,width)
  local length=(b-a).Magnitude
  if length&lt;.001 then p.Transparency=1;return end
  p.Size=Vector3.new(width,width,length);p.CFrame=CFrame.lookAt((a+b)*.5,b)
 end
 local function near(origin)
  local camera=workspace.CurrentCamera
  return camera and(camera.CFrame.Position-origin).Magnitude&lt;=MAX_DISTANCE
 end
 local function receive(kind,origin,radius,name,windup,color,userId,duration,direction,visualOrigin,targetId)
  if not SUPPORTED[kind]or not vector(origin)or type(userId)~='number'then return end
  if kind=='spinjitzuEnd'then clear('spinjitzuActive',userId);return end
  if kind=='kiImpact'then clear('kiProjectile',userId)end
  if kind=='lightning'then
   if type(windup)~='number'or type(targetId)~='number'then return end
   kind='lightningLock'
  end
  if kind=='slam'then
   if type(windup)=='number'then kind='slamWarning'
   else clear('slamWarning',userId);kind='slamRubble'end
  end
  if dead or not near(origin)then return end
  if kind=='kiProjectile'or kind=='spinjitzuActive'then clear(kind,userId)end
  local small=reduced();local n=kind=='kiProjectile'and 3 or(kind=='kiImpact'and(small and 4 or 8)or(kind=='spinjitzuActive'and(small and 6 or 12)or(small and 8 or 16)))
  local warning=kind=='kiblast'or kind=='spinjitzu'or kind=='slamWarning'or kind=='lightningLock'
  if warning and count+n&gt;MAX_PARTS then
   -- Preserve readable warnings by retiring decorative effects first.
   for _,entry in ipairs(entries)do
    if entry.kind~='kiblast'and entry.kind~='spinjitzu'and entry.kind~='slamWarning'and entry.kind~='lightningLock'then drop(entry)end
    if count+n&lt;=MAX_PARTS then break end
   end
   n=math.min(n,MAX_PARTS-count)
   if n&lt;4 then return end
  end
  if count+n&gt;MAX_PARTS then return end
  local life=kind=='slamRubble'and 1.5 or kind=='kiImpact'and .26 or warning and bounded(windup,.6,.1,1.5)or bounded(duration,1,.1,2)
  local entry={kind=kind,userId=userId,targetId=targetId,origin=origin,started=os.clock(),life=life,parts={},direction=vector(direction)and direction.Magnitude&gt;.1 and direction.Magnitude&lt;1.01 and direction.Unit or Vector3.new(0,0,-1),radius=bounded(radius,3,1,40)}
  local tint=typeof(color)=='Color3'and color or Color3.fromRGB(103,234,236)
  for i=1,n do
   local p=part(entry,'OPPower_'..kind..'_'..i,tint,kind=='kiProjectile'and i&lt;3)
   if kind=='slamRubble'and i%2==0 then p.Material=Enum.Material.Slate;p.Color=Color3.fromRGB(97,84,68)end
  end
  entries[#entries+1]=entry
 end
 local fxConnection=net:WaitForChild('FX').OnClientEvent:Connect(receive)
 local renderConnection=Run.RenderStepped:Connect(function()
  local now=os.clock()
  for i=#entries,1,-1 do
   local e=entries[i];local age=now-e.started
   if e.dead or age&gt;=e.life or not near(e.origin)then drop(e);table.remove(entries,i)
   elseif e.kind=='slamRubble'then
    local fade=math.clamp((age-.65)/.85,0,1);local rise=math.min(1,age/.16)
    for j,p in ipairs(e.parts)do
     local angle=j/#e.parts*math.pi*2;local radius=2+(j%4)*1.45
     local floor=e.origin-Vector3.new(0,2.65,0)
     if j%2==0 then
      local size=.65+(j%3)*.28;p.Size=Vector3.new(size,size*(.7+(j%2)*.3),size)
      p.CFrame=CFrame.new(floor+Vector3.new(math.cos(angle)*radius,(.3+(j%3)*.35)*rise-fade*.55,math.sin(angle)*radius))*CFrame.Angles(j*.31,angle,j*.17)
     else
      local a=floor+Vector3.new(math.cos(angle)*.7,.08,math.sin(angle)*.7)
      local b=floor+Vector3.new(math.cos(angle+.12)*radius,.08,math.sin(angle+.12)*radius)
      line(p,a,b,.12*(1-fade)+.02)
     end
     p.Transparency=fade
    end
   elseif e.kind=='kiProjectile'then
    local center=e.origin+e.direction*math.min(e.radius,70*age)
    for j,p in ipairs(e.parts)do
     if j==3 then line(p,center-e.direction*.5,center-e.direction*5,.35);p.Transparency=.4
     else local r=j==1 and 1.5 or 2.1;p.Size=Vector3.new(r,r,r);p.CFrame=CFrame.new(center);p.Transparency=j==2 and .65 or .12 end
    end
   elseif e.kind=='spinjitzuActive'then
    local player=Players:GetPlayerByUserId(e.userId)
    local root=player and player.Character and player.Character:FindFirstChild('HumanoidRootPart')
    if not root then drop(e)
    else
     local origin=root.Position-Vector3.new(0,2.7,0);local n=#e.parts
     for j,p in ipairs(e.parts)do
      local t=(j-1)/n;local angle=t*math.pi*4+age*12
      local nextT=t+1/n;local radiusA=1.5+t*3.8;local radiusB=1.5+nextT*3.8
      local a=origin+Vector3.new(math.cos(angle)*radiusA,t*6,math.sin(angle)*radiusA)
      local b=origin+Vector3.new(math.cos(angle+math.pi*4/n)*radiusB,nextT*6,math.sin(angle+math.pi*4/n)*radiusB)
      line(p,a,b,.18);p.Transparency=.18+math.min(.5,age/e.life*.35)
     end
    end
   elseif e.kind=='kiImpact'then
    local t=age/e.life
    for j,p in ipairs(e.parts)do
     local angle=j/#e.parts*math.pi*2;local direction=Vector3.new(math.cos(angle),.2+((j%3)/3),math.sin(angle))
     line(p,e.origin+direction*(.5+t*e.radius*.35),e.origin+direction*(1+t*e.radius*.85),.15*(1-t)+.03);p.Transparency=t
    end
   else
    local radius=e.kind=='kiblast'and(1.1+age*.4)or e.radius
    local center=e.origin
    if e.kind=='lightningLock'then
     local target=Players:GetPlayerByUserId(e.targetId)
     local targetRoot=target and target.Character and target.Character:FindFirstChild('HumanoidRootPart')
     if not targetRoot then drop(e);center=nil
     else center=targetRoot.Position end
    end
    if center then
     local origin=center-Vector3.new(0,2.7,0);local n=#e.parts
     for j,p in ipairs(e.parts)do
      local a=(j-1)/n*math.pi*2;local b=j/n*math.pi*2
      line(p,origin+Vector3.new(math.cos(a)*radius,.12,math.sin(a)*radius),origin+Vector3.new(math.cos(b)*radius,.12,math.sin(b)*radius),.13)
      p.Transparency=.2
     end
    end
   end
  end
 end)
 local session={}
 function session.destroy()
  if dead then return end;dead=true;fxConnection:Disconnect();renderConnection:Disconnect()
  for _,entry in ipairs(entries)do drop(entry)end;table.clear(entries);sessions[gui]=nil
 end
 sessions[gui]=session;return session
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_V78_ProfileCodec"><Properties><string name="Name">ProfileCodec</string><ProtectedString name="Source">-- Pure, versioned profile snapshots. Roblox storage and session locks live elsewhere.
local Powers=require(script.Parent.PowerCatalog)
local M={SchemaVersion=1,MaxReceipts=10000,MaxCatchupSeconds=60}
local MAX_CASH,MAX_CREDIT=2000000000,1000000000000
local settingsDefaults={musicMuted=false,sfxMuted=false,reducedEffects=false,musicVolume=.18,sfxVolume=.55}
local topKeys={schemaVersion=true,userId=true,cash=true,bank=true,level=true,steals=true,items=true,
 equipped=true,powerOwned=true,loadout=true,powerSlots=true,starterChosen=true,seen=true,
 infinityAwarded=true,pendingReward=true,rewardReadyAt=true,settings=true,tutorialCompleted=true,
 receipts=true,paidCashCredit=true,checkpointAt=true,checkpointIncome=true,powerReadyAt=true,
 castReadyAt=true,protectionUntilAt=true,protectionReadyAt=true,carryReturnRecovery=true}
local function finite(value)return type(value)=='number'and value==value and math.abs(value)&lt;math.huge end
local function number(value,minimum,maximum,integer)
 return finite(value)and value&gt;=minimum and value&lt;=maximum and(not integer or value%1==0)
end
local function identifier(value,maximum)
