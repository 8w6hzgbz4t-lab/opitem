  p('Thumb',-.94,1.13,0,.45,.95,.6,gold,Enum.Material.Metal,nil,CFrame.Angles(0,0,-.4)); ball('MindGem',0,1,-.47,.37,tint)
 elseif k=='ring' then ring('Ringworld',0,1.6,0,1.7,steel); ring('Habitat',0,1.6,-.15,1.45,rgb(70,222,180))
 elseif k=='cube' then
