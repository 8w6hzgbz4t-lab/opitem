   local it=self.core.items[p.carry];local tx=it and self.core.transactions[it.tx]
   -- A disappearing belt hologram never expires the real carried item. Keep
   -- its reservation until delivery or a valid interruption/death/disconnect.
   if not r or not tx or not self.ctx.movementSafe(rt.player) then self:finish(rt.player,false,'Delivery interrupted.')
   else
