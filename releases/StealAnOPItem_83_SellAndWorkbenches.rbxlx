 if type(arg)=='table' and arg.aim~=nil then
  local a=arg.aim;if typeof(a)~='Vector3' or not finite(a.X) or not finite(a.Y) or not finite(a.Z) or a.Magnitude&lt;.1 or a.Magnitude&gt;1.01 then return end;direction=a.Unit
 end
