					<ProtectedString name="Source">-- SERVER ONLY. Set both fields explicitly; no name, creator, Studio, or client bypass.
return {
 Enabled=false,
 DeveloperUserId=0, -- Replace with your positive numeric Roblox UserId.
 CommandBurst=5, CommandsPerSecond=2, ConfirmationSeconds=20,
 MaxLogs=200, FlightSpeed=42, InputInterval=.08,
 MaxCurrency=2000000000, MaxProtectionSeconds=3600,
}
