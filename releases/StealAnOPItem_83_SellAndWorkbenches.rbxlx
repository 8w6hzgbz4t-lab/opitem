   next.Lock.ExpiresAt=self.clock()+self.config.LockSeconds;return next
  end,'profiles')
  if not saved or not record then prepared=false;break end
 end
 if prepared then
  ok,journal=self:_update(self.journal,key,function(current)
   if not self:_journal(current)or current.Owner~=self.owner then return nil end
   if current.Status~='Preparing'then return current end
   local next=clone(current);next.Status=self.clock()&lt;current.ExpiresAt and'Committed'or'Aborted';return next
  end,'journal')
  if ok and journal and journal.Status=='Committed'then return self:_finishAtomic(users,operationId,true)end
 end
 -- Abort is a CAS competing with a possibly acknowledged-late commit. If a
 -- commit won, it stays authoritative; network errors never imply rollback.
 ok,journal=self:_decision(operationId,true)
 if not ok then
  for _,id in ipairs(users)do self:_block(id,'TransactionInDoubt')end
  return false,'TransactionInDoubt'
 end
 return self:_finishAtomic(users,operationId,journal.Status=='Committed')
end
function Store:release(id,data)
 if not self:isReady(id)then return false,'ProfileNotReady'end
 if data~=nil and not self:_validData(data)then return false,'InvalidProfileData'end
 local staged=data~=nil and clone(data)or nil
 local writeId=self:_id();local why
 local ok,record=self:_update(self.profiles,'u:'..id,function(current)
  why=nil
  if not self:_record(current,id)then why='InvalidProfile';return nil end
  if current.LastWriteId==writeId and current.Lock==nil and not current.Pending then return current end
  if not self:_owned(current)then why='SessionLost';return nil end
  if current.Pending then why='TransactionPending';return nil end
  local next=clone(current);if staged~=nil then next.Data=clone(staged)end
  next.LastWriteId=writeId;next.Lock=nil;return next
 end,'profiles')
 if not ok then self:_block(id,'ReleaseInDoubt');return false,'ReleaseInDoubt'end
 if not record then self:_block(id,why);return false,why or'ReleaseRejected'end
 self.loaded[id]=nil;return true
end
return Store
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_V81_VaultService"><Properties><string name="Name">VaultService</string><ProtectedString name="Source">-- Owner-only base management. Durable Core methods own every item transition.
local V={};V.__index=V
local verbs={beginItemMove=true,cancelItemMove=true,moveItem=true}
local function uid(value)return type(value)=='string'and #value&gt;0 and #value&lt;=96 end
local function integer(value)return type(value)=='number'and value==value and math.abs(value)&lt;math.huge and value%1==0 end
function V.new(ctx)
 return setmetatable({ctx=ctx,rate={},cancelRate={},clock=ctx.clock or os.clock},V)
end
function V:inside(p)
 local rt=self.ctx.runtime[p.UserId];local state=self.ctx.core.players[p.UserId]
 local root=self.ctx.body(p)
 if not rt or not state or rt.pendingReset or rt.base.owner~=p.UserId or not root or not self.ctx.movementSafe(p)then return false end
 local position=rt.base.cf:PointToObjectSpace(root.Position)
 if math.abs(position.X)&gt;23 or math.abs(position.Z)&gt;24 then return false end
 return position.Y&gt;=.5 and position.Y&lt;=12 or state.capacity&gt;=16 and position.Y&gt;=20 and position.Y&lt;=31
end
function V:open(p)
 if self.ctx.core.closing or self.ctx.core.persistenceBusy or not self.ctx.persistence:isReady(p.UserId)or not self:inside(p)then return false end
 self.ctx.update:FireClient(p,{open='inventory'});return true
end
function V:handle(p,verb,arg)
 if not verbs[verb]then return false end
 local now=self.clock();local id=p.UserId
 local rate=verb=='cancelItemMove'and self.cancelRate or self.rate
 if now&lt;(rate[id]or 0)then return true end;rate[id]=now+.2
 local core=self.ctx.core
 if core.closing or core.persistenceBusy or not self.ctx.persistence:isReady(id)then return true end
 local ok,msg
 if verb=='cancelItemMove'then
  -- Cancellation is allowed after walking away; it cannot mutate ownership.
  ok,msg=core:cancelItemMove(id)
 elseif not self:inside(p)then
  msg='Return inside your own base to manage items.'
 elseif verb=='beginItemMove'and uid(arg)then
  ok,msg=core:beginItemMove(id,arg,now)
 elseif verb=='moveItem'and type(arg)=='table'and uid(arg.uid)and uid(arg.token)and integer(arg.slot)and arg.slot&gt;=1 and arg.slot&lt;=16 then
  ok,msg=core:moveItem(id,arg.uid,arg.slot,arg.token,now)
 else msg='Invalid item management request.'end
 if msg then self.ctx.say(p,msg)end
 self.ctx.refresh();return true
end
function V:removePlayer(p)self.rate[p.UserId]=nil;self.cancelRate[p.UserId]=nil end
return V
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_V83_BaseWorkbench"><Properties><string name="Name">BaseWorkbench</string><ProtectedString name="Source">-- Cosmetic base desk around the existing manager anchor. No economy or input code.
local B={}
function B.create(world,anchor,index,baseCF)
 local name='VaultWorkbench'..tostring(index)
 local old=world.folder:FindFirstChild(name)
 if old then old:Destroy()end
 local model=Instance.new('Model');model.Name=name
 model:SetAttribute('BaseIndex',index)
 model:SetAttribute('CosmeticWorkbench',true)
 model:SetAttribute('PartBudget',85)
 if baseCF then model:SetAttribute('BaseCF',baseCF)end
 local V,C,A=Vector3.new,CFrame.new,CFrame.Angles
 local navy=Color3.fromRGB(25,35,49)
 local steel=Color3.fromRGB(112,134,144)
 local wood=Color3.fromRGB(101,73,48)
 local gold=Color3.fromRGB(222,181,104)
 local green=Color3.fromRGB(105,220,167)
 local pale=Color3.fromRGB(230,234,217)
 local parts=0
 local function part(label,size,cf,color,material,solid)
  parts=parts+1;assert(parts&lt;=85,'Base workbench part budget exceeded')
  local p=Instance.new('Part');p.Name=label;p.Size=size;p.CFrame=anchor.CFrame*cf
  p.Anchored=true;p.CanTouch=false;p.CanCollide=solid==true;p.CanQuery=solid==true
  p.Material=material or Enum.Material.Metal;p.Color=color
  p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth
  p.Parent=model;return p
 end
 part('WorkbenchTop',V(4.8,.24,2.8),C(0,.28,0),steel,nil,true)
 part('BronzeDesktopEdge',V(4.88,.08,2.88),C(0,.14,0),gold)
 part('InsetWoodSurface',V(4.55,.06,2.55),C(0,.43,0),wood,Enum.Material.Wood)
 for _,x in ipairs({-1.85,1.85})do
  for _,z in ipairs({-.95,.95})do
   part('Leg'..x..'_'..z,V(.24,1.35,.28),C(x,-.4,z),navy,nil,true)
   part('LegFoot'..x..'_'..z,V(.46,.16,.53),C(x,-1.09,z),steel,nil,true)
   part('WorktopRivet'..x..'_'..z,V(.09,.035,.09),C(x,.48,z),gold)
  end
 end
 part('LowerShelf',V(3.8,.14,1.8),C(0,-.71,.15),wood,Enum.Material.Wood)
 for drawer=1,3 do
  local x=(drawer-2)*1.1
  part('SupplyDrawer'..drawer,V(1,.38,1.15),C(x,-.04,.3),navy)
  part('DrawerFace'..drawer,V(.96,.32,.08),C(x,-.04,-.315),steel)
  part('DrawerPull'..drawer,V(.35,.065,.10),C(x,-.04,-.405),gold)
 end
 part('ScreenStand',V(.45,.55,.35),C(0,.76,.75),steel)
 part('ScreenStandFoot',V(1.1,.07,.65),C(0,.5,.72),navy)
 local monitor=C(0,1.58,.75)*A(math.rad(-12),0,0)
 part('MonitorBezel',V(3.15,1.8,.25),monitor,navy)
 local screen=part('VaultDisplay',V(2.91,1.56,.045),monitor*C(0,0,-.15),Color3.fromRGB(15,53,43),Enum.Material.SmoothPlastic)
 local surface=Instance.new('SurfaceGui');surface.Name='VaultWorkbenchDisplay'
 surface.Face=Enum.NormalId.Front;surface.CanvasSize=Vector2.new(800,340)
 surface.LightInfluence=0;surface.AlwaysOnTop=false;surface.Parent=screen
 local title=Instance.new('TextLabel');title.Name='WorkbenchTitle'
 title.BackgroundTransparency=1;title.Position=UDim2.fromScale(.035,.04);title.Size=UDim2.fromScale(.93,.92)
 title.Font=Enum.Font.GothamBold;title.TextSize=51;title.TextColor3=green;title.TextWrapped=true
 title.Text='MY VAULT\nMOVE • SELL\nBASE LEVELS';title.Parent=surface
 for _,side in ipairs({-1,1})do
  part('MonitorGoldTrim'..side,V(.06,1.72,.05),monitor*C(side*1.52,0,-.15),gold)
 end
 part('MonitorStatusLight',V(.26,.045,.035),monitor*C(0,-.82,-.15),green,Enum.Material.Neon)
 part('KeyboardBase',V(2.25,.075,.72),C(-.25,.5,-.7),navy)
 for row=0,2 do
  for column=0,6 do
   part('Key'..row..'_'..column,V(.21,.045,.12),C(-1.11+column*.28,.56,-.94+row*.2),row==0 and green or pale)
  end
 end
 part('ControlPad',V(.62,.065,.66),C(1.48,.5,-.72),navy)
 part('ControlDial',V(.31,.06,.31),C(1.48,.56,-.72)*A(0,math.pi/4,0),gold)
 part('LedgerCover',V(.72,.09,.83),C(-1.55,.52,.04)*A(0,-.13,0),green,Enum.Material.SmoothPlastic)
 part('LedgerPages',V(.65,.075,.77),C(-1.55,.58,.04)*A(0,-.13,0),pale,Enum.Material.SmoothPlastic)
 part('LedgerBinding',V(.095,.15,.85),C(-1.9,.56,.09)*A(0,-.13,0),gold)
 part('LedgerBookmark',V(.06,.015,.48),C(-1.46,.625,.12)*A(0,-.13,0),navy)
 part('ItemTray',V(.78,.07,.65),C(1.58,.5,.22),steel)
 for _,side in ipairs({-1,1})do
  part('TrayEdge'..side,V(.05,.11,.66),C(1.58+side*.38,.56,.22),gold)
 end
 part('TrayRelic',V(.34,.34,.34),C(1.58,.72,.22)*A(.35,.6,.2),green,Enum.Material.Glass)
 model:SetAttribute('PartCount',parts)
 model.PrimaryPart=model:FindFirstChild('WorkbenchTop')
 -- Keep the interaction object, its CFrame and every connected prompt intact.
 anchor.Transparency=1;anchor.CanCollide=false;anchor.CanQuery=false
 model.Parent=world.folder
 return model
end
return B
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_V83_ItemPromptClient"><Properties><string name="Name">ItemPromptClient</string><ProtectedString name="Source">-- Per-player labels only. The server derives Buy/Sell/Steal from live ownership.
local Prompts=game:GetService('ProximityPromptService')
local Players=game:GetService('Players')
local M={}
local sessions=setmetatable({},{__mode='k'})
local function finite(n)return type(n)=='number'and n==n and math.abs(n)&lt;math.huge end
function M.start(net,player)
 player=player or Players.LocalPlayer
 if not player then return nil end
 if sessions[player]then return sessions[player]end
 local records=setmetatable({},{__mode='k'})
 local connections={};local dead=false
 local function forget(prompt)
  local record=records[prompt];if not record then return end
  records[prompt]=nil
  for _,connection in ipairs(record.connections)do connection:Disconnect()end
 end
 local function refresh(prompt)
  local record=records[prompt]
  if dead or not record or record.updating or prompt:GetAttribute('OPItemPrompt')~=true then return end
  local state=prompt:GetAttribute('ItemState');local owner=prompt:GetAttribute('ItemOwnerUserId')
  local uid=prompt:GetAttribute('ItemUID');local label='Interact'
  if type(uid)=='string'and #uid&gt;0 and #uid&lt;=96 then
   if state=='Stored'and finite(owner)and owner&gt;0 and owner%1==0 then
    if owner==player.UserId then
     local price=prompt:GetAttribute('SellPrice')
     label=finite(price)and price&gt;=0 and price%1==0 and('Sell · $'..string.format('%.0f',price)..' (50%)')or'Sell (50%)'
    else label='Steal'end
   elseif state=='Conveyor'or state=='Contesting'or state=='Auction'then label='Buy'
   elseif state=='PurchaseCarry'or state=='TheftCarry'then label='In transit'end
  end
  if prompt.ActionText~=label then
   record.updating=true;prompt.ActionText=label;record.updating=false
  end
 end
 local function observe(prompt)
  if dead or not prompt:IsA('ProximityPrompt')or not prompt:IsDescendantOf(workspace)then return end
  if records[prompt]then refresh(prompt);return end
  local record={connections={}};records[prompt]=record
  local function watch(signal,callback)record.connections[#record.connections+1]=signal:Connect(callback)end
  -- Retain one bounded observer set per live prompt, including hidden prompts,
  -- so ownership text is correct before Roblox displays its next interaction.
  for _,name in ipairs({'OPItemPrompt','ItemUID','ItemOwnerUserId','ItemState','SellPrice'})do
   watch(prompt:GetAttributeChangedSignal(name),function()refresh(prompt)end)
  end
  watch(prompt:GetPropertyChangedSignal('ActionText'),function()refresh(prompt)end)
  watch(prompt.AncestryChanged,function()
   if not prompt:IsDescendantOf(workspace)then forget(prompt)end
  end)
  watch(prompt.Destroying,function()forget(prompt)end)
  refresh(prompt)
 end
 connections[#connections+1]=workspace.DescendantAdded:Connect(observe)
 connections[#connections+1]=Prompts.PromptShown:Connect(function(prompt)
  observe(prompt);local record=records[prompt];if record then record.shown=true;refresh(prompt)end
 end)
 connections[#connections+1]=Prompts.PromptHidden:Connect(function(prompt)
  -- Showing/hiding never allocates listeners, so repeated approaches cannot leak.
  local record=records[prompt];if record then record.shown=false end
 end)
 for _,descendant in ipairs(workspace:GetDescendants())do observe(descendant)end
 local session={}
 function session.destroy()
  if dead then return end;dead=true
  for _,connection in ipairs(connections)do connection:Disconnect()end
  local prompts={};for prompt in pairs(records)do prompts[#prompts+1]=prompt end
  for _,prompt in ipairs(prompts)do forget(prompt)end
  sessions[player]=nil
 end
 sessions[player]=session;return session
end
return M
</ProtectedString></Properties></Item></Item>
