  root.AssemblyLinearVelocity=Vector3.zero
  rt.travelPosition=root.Position;rt.travelTime=self.clock();rt.travelCredit=5;rt.safeCF=root.CFrame;rt.blockedUntil=0;rt.impulseUntil=0
 end
end
