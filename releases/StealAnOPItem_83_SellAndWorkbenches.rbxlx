function S:menuData(p)
 local catalog={};for _,d in ipairs(self.ctx.catalog.Items) do
  table.insert(catalog,{id=d.id,name=d.name,tier=d.tier,rarity=d.rarity,power=d.power})
 end
 local powers={};for _,d in ipairs(Powers.Items) do
  table.insert(powers,{id=d.id,name=d.name,rank=d.rank,price=d.price,cooldown=d.cooldown,description=d.description})
 end
 return {catalog=catalog,powers=powers,mods=self:getState(p),players=self:menuPlayers(),uniquePower={id='royalseal',name='Royal Seal',cooldown=self.config.RoyalSealCooldown or 15,remaining=math.max(0,(self.royalReady[p.UserId] or 0)-self.clock()),description='A Millennium Rod seal interrupts nearby opponents after a visible warning. Normal protection, line of sight and carry restrictions apply.'}}
end
function S:reply(p,data)
 data.authorized=self:authorized(p)==true
 if data.authorized then
  data.mods=self:getState(p)
  data.flight=data.mods.flight;data.noclip=data.mods.noclip;data.players=self:menuPlayers()
 end
 return data
end
function S:resetTravel(p)
