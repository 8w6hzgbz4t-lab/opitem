tabBar.Size = UDim2.new(1, -24, 0, 36)
tabBar.Parent = panel
local tabLayout = Instance.new('UIGridLayout')
tabLayout.CellPadding = UDim2.fromOffset(6, 0)
tabLayout.CellSize = UDim2.new(.2, -5, 1, 0)
tabLayout.SortOrder = Enum.SortOrder.LayoutOrder
