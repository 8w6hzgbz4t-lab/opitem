  if name=='giftcash' then
   if p.cash+c.amount&gt;self.config.MaxCurrency-(p.held or 0) then return false,'Gift exceeds the recipient currency limit. Nothing was gifted.' end
   p.cash+=c.amount;core:changed();self.ctx.refresh()
   return true,'Gifted $'..c.amount..' to '..(rt.player.DisplayName or rt.player.Name or tostring(c.target))..'.'
  end
  local maximum=self.config.MaxDeveloperLevel or 1000
  if (p.progression or p.level or 0)+c.amount&gt;maximum then return false,'Gift exceeds the recipient level limit. Nothing was gifted.' end
  local ok,msg=core:gainLevel(c.target,c.amount)
  if not ok then return false,msg or 'Levels could not be gifted.' end
  self.ctx.refresh();return true,'Gifted '..c.amount..' levels to '..(rt.player.DisplayName or rt.player.Name or tostring(c.target))..'.'
 elseif name=='cash' then
  if not p then return false,'Player left.' end
  if c.operation=='add' then p.cash=math.min(self.config.MaxCurrency-(p.held or 0),p.cash+c.amount)
  elseif c.operation=='remove' then p.cash=math.max(0,p.cash-c.amount) else p.cash=math.min(self.config.MaxCurrency-(p.held or 0),c.amount) end
  core:changed();self.ctx.refresh();return true,'Cash is now '..p.cash
 elseif name=='grant' then
