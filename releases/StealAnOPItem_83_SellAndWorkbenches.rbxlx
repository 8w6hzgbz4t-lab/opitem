     -- Root-centred character volume with a small projectile radius.
     if along&gt;=-blast.radius and along&lt;=allowed and (offset-shot.direction*closest).Magnitude&lt;=blast.radius+2.1
      and self.ctx.los(shot.position,targetRoot.Position) and (not bestAlong or closest&lt;bestAlong or(closest==bestAlong and id&lt;best.player.UserId))then
      best,bestAlong=target,closest
     end
