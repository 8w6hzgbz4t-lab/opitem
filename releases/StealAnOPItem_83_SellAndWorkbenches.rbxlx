				</Item>
			<Item class="ModuleScript" referent="RBX_V71_FreeModels_SecretFormula"><Properties><string name="Name">SecretFormula</string><ProtectedString name="Source">-- The Krusty Krab's bottled recipe: entirely native Roblox display geometry.
-- No meshes, decals, external assets or runtime interaction are required.
local M={}
local V,C,A,RGB=Vector3.new,CFrame.new,CFrame.Angles,Color3.fromRGB
local GLASS,WOOD,PAPER,METAL=Enum.Material.Glass,Enum.Material.Wood,Enum.Material.SmoothPlastic,Enum.Material.Metal
local TAU=math.pi*2

function M.build(b,key)
 if key~="krabby_patty_formula" then return false end
 local green,darkGreen,paleGreen=RGB(83,172,127),RGB(28,103,78),RGB(190,238,205)
 local parchment,edge,ink=RGB(245,221,166),RGB(178,132,66),RGB(77,55,32)
 local cork,twine,red,gold=RGB(166,112,66),RGB(203,166,104),RGB(174,40,37),RGB(226,178,73)
 local vertical=A(0,0,math.pi/2)
 local function glass(part,transparency)
  part.Transparency=transparency;part.Reflectance=.04;return part
 end
 -- A translucent cylindrical body, rounded shoulders and a separate narrow neck.
 -- The recipe is real geometry inside the glass and remains visible above the label.
 glass(b:cylinder("GreenGlassBottleBody",V(2.44,2.22,2.22),C(0,1.61,0)*vertical,green,GLASS),.65)
 glass(b:ball("RoundedGlassShoulder",V(2.22,.91,2.22),C(0,2.77,0),green,GLASS),.67)
 glass(b:cylinder("HeavyGlassBottleBase",V(.19,2.28,2.28),C(0,.40,0)*vertical,darkGreen,GLASS),.28)
 glass(b:cylinder("LongNarrowBottleNeck",V(1.16,.77,.77),C(0,3.48,0)*vertical,green,GLASS),.55)
 glass(b:cylinder("BottleLip",V(.19,.91,.91),C(0,4.04,0)*vertical,paleGreen,GLASS),.34)
 -- Rings lie horizontally around the bottle, so none cross its front like a halo.
 b:ring("ThickBottomGlassRim",C(0,.39,0)*A(math.pi/2,0,0),1.095,.072,darkGreen,16,GLASS)
 b:ring("ShoulderGlassSeam",C(0,2.76,0)*A(math.pi/2,0,0),1.037,.037,paleGreen,16,GLASS)
 b:ring("MouthGlassEdge",C(0,4.11,0)*A(math.pi/2,0,0),.407,.044,paleGreen,12,GLASS)
 for _,s in ipairs({-1,1}) do
  local part=b:box("BottleReflection"..s,V(.045,1.62,.025),C(s*.77,1.78,-.79)*A(0,s*.22,s*.035),paleGreen,GLASS)
  part.Transparency=.3
  glass(b:box("NeckReflection"..s,V(.025,.68,.018),C(s*.20,3.52,-.34),paleGreen,GLASS),.25)
 end
 -- Warm cork, a bevelled crown and small embedded grain marks; no floating cap.
 b:cylinder("FittedCorkStopper",V(.45,.66,.66),C(0,4.24,0)*vertical,cork,WOOD)
 b:cylinder("CorkCrown",V(.08,.70,.70),C(0,4.48,0)*vertical,RGB(188,139,87),WOOD)
 b:ring("CorkEndGrain",C(0,4.526,0)*A(math.pi/2,0,0),.244,.024,RGB(139,91,51),12,WOOD)
 for i=0,7 do
  local a=i*TAU/8
  b:box("CorkPore"..i,V(.045,.055,.018),C(math.sin(a)*.333,4.20+(i%3)*.058,math.cos(a)*.333)*A(0,a,0),RGB(120,76,43),WOOD)
 end
 -- A cream scroll rolled around a dark hollow centre, with concentric paper ends.
 local scroll=C(.10,1.85,-.06)*A(0,0,-.12)
 b:cylinder("RolledSecretRecipe",V(2.30,.78,.78),scroll*vertical,parchment,PAPER)
 b:box("CurledParchmentEdge",V(.055,2.09,.12),scroll*C(.37,0,-.08)*A(0,0,.015),edge,PAPER)
 for _,s in ipairs({-1,1}) do
  b:cylinder("ScrollHollowEnd"..s,V(.025,.265,.265),scroll*C(0,s*1.163,0)*vertical,ink,PAPER)
  b:ring("RolledPaperEnd"..s,scroll*C(0,s*1.183,0)*A(math.pi/2,0,0),.315,.035,edge,12,PAPER)
  b:ring("InnerPaperRoll"..s,scroll*C(0,s*1.193,0)*A(math.pi/2,0,0),.205,.025,parchment,12,PAPER)
 end
 -- Handwritten recipe strokes are tucked inside; the formula itself stays secret.
 for row=0,5 do
  local y=.70-row*.15
  b:box("RecipeInkStroke"..row,V(.23+(row%3)*.026,.018,.012),scroll*C(-.02,y,-.391),ink,PAPER)
 end
 b:ring("ScrollBinding",scroll*C(0,-.16,0)*A(math.pi/2,0,0),.40,.033,RGB(185,49,40),12,PAPER)
 -- Two visible turns of twine around the neck, a small knot and trailing string.
 for i=0,1 do
  b:ring("NeckTwineTurn"..i,C(0,3.29+i*.095,0)*A(math.pi/2,0,0),.408,.045,twine,12,PAPER)
 end
 b:ball("TwineKnot",V(.16,.14,.10),C(.10,3.32,-.43),twine,PAPER)
 b:line("LeftStringTail",V(.07,3.3,-.46),V(-.14,2.99,-.65),.039,.039,twine,PAPER)
 b:line("LeftStringEnd",V(-.14,2.99,-.65),V(-.09,2.86,-.73),.039,.039,twine,PAPER)
 b:line("SealString",V(.15,3.29,-.45),V(.46,2.89,-.82),.043,.043,twine,PAPER)
 b:line("SealStringLower",V(.46,2.89,-.82),V(.45,2.65,-.92),.043,.043,twine,PAPER)
 -- Red sealing wax and an embossed anchor identify the guarded Krusty Krab recipe.
 b:ball("RedWaxSeal",V(.48,.51,.10),C(.45,2.65,-.97),red,PAPER)
 b:ring("WaxSealImprint",C(.45,2.65,-1.031),.16,.022,gold,12,METAL)
 b:line("SealAnchorStem",V(.45,2.56,-1.049),V(.45,2.75,-1.049),.027,.018,gold,METAL)
 b:line("SealAnchorCrossbar",V(.37,2.68,-1.049),V(.53,2.68,-1.049),.024,.018,gold,METAL)
 b:line("SealAnchorLeft",V(.45,2.56,-1.049),V(.36,2.62,-1.049),.024,.018,gold,METAL)
 b:line("SealAnchorRight",V(.45,2.56,-1.049),V(.54,2.62,-1.049),.024,.018,gold,METAL)
 -- A compact, fitted label uses real SurfaceGui text through Labels.lua.
 b:box("FormulaLabelBorder",V(1.89,1.14,.039),C(0,1.35,-1.095),RGB(133,52,38),PAPER)
 b:box("FormulaLabel",V(1.77,1.02,.035),C(0,1.35,-1.126),RGB(251,232,184),PAPER)
 b:box("FormulaBrand",V(1.62,.27,.023),C(0,2.01,-1.14),RGB(251,232,184),PAPER)
 for _,s in ipairs({-1,1}) do
  b:box("LabelCorner"..s,V(.13,.06,.014),C(s*.75,.91,-1.148),gold,METAL)
 end
 b.model:SetAttribute("ArtVersion",71)
 b.model:SetAttribute("SealedRecipeBottle",true)
 b.model:SetAttribute("RecipeContents","Krabby Patty Secret Formula")
 return true
end

return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_V72_FreeModels_AllSpark"><Properties><string name="Name">AllSpark</string><ProtectedString name="Source">-- Movie-style AllSpark: six engraved mechanical faces, all native Roblox parts.
-- The glyphs are fitted physical strokes, with no decals or external asset IDs.
local M={}
local V,C,A,RGB=Vector3.new,CFrame.new,CFrame.Angles,Color3.fromRGB
local METAL,NEON=Enum.Material.Metal,Enum.Material.Neon
local PI=math.pi

-- Angular Cybertronian-inspired reliefs. Six distinct glyphs contain four strokes
-- each; their face-specific orientation makes every side different and readable.
local glyphs={
 {{-.34,.10,-.04,.28},{-.04,.28,.31,.04},{-.04,.28,-.13,-.29},{-.13,-.29,.28,-.14}},
 {{-.32,.28,.26,.13},{.26,.13,-.18,-.12},{-.18,-.12,.18,-.30},{-.07,.20,-.07,-.19}},
 {{-.33,-.23,-.18,.27},{-.18,.27,.32,.08},{.32,.08,.12,-.29},{-.04,-.01,.31,-.15}},
 {{-.29,.28,-.10,-.25},{-.10,-.25,.30,-.09},{.30,-.09,.12,.26},{-.04,.05,.31,.11}},
 {{-.31,.04,.02,.29},{.02,.29,.30,-.23},{.30,-.23,-.24,-.11},{-.24,-.11,-.06,.06}},
 {{-.30,.25,.23,.13},{.23,.13,.06,-.30},{-.30,-.22,.06,-.30},{-.11,-.05,.29,.04}},
}

function M.build(b,key)
 if key~="transformers_allspark" then return false end
 local core=RGB(57,53,43)
 local bronze=RGB(153,139,111)
 local silver=RGB(174,170,148)
 local relief=RGB(199,186,153)
 local dark=RGB(74,69,54)
 local recess=RGB(116,108,86)
 local cyan=RGB(76,164,177)
 -- The body is closed; six slightly inset armour panels meet twelve diagonal
 -- edge rails. Diamond cross sections give the rails true chamfered corners.
 b:box("AllSparkClosedMetalCore",V(2.91,2.91,2.91),C(),core,METAL)
 local n=0
 for _,s in ipairs({-1,1}) do for _,t in ipairs({-1,1}) do
  n=n+1
  b:box("ChamferedXEdge"..n,V(2.94,.132,.132),C(0,s*1.474,t*1.474)*A(PI/4,0,0),silver,METAL)
  b:box("ChamferedYEdge"..n,V(.132,2.94,.132),C(s*1.474,0,t*1.474)*A(0,PI/4,0),silver,METAL)
  b:box("ChamferedZEdge"..n,V(.132,.132,2.94),C(s*1.474,t*1.474,0)*A(0,0,PI/4),silver,METAL)
 end end
 for _,x in ipairs({-1,1}) do for _,y in ipairs({-1,1}) do for _,z in ipairs({-1,1}) do
  local p=b:ball("WornMetalCorner"..x..y..z,.186,C(x*1.474,y*1.474,z*1.474),bronze,METAL)
  p.Reflectance=.07
 end end end
 local faces={
  {"Front",C(0,0,-1.475)},
  {"Back",C(0,0,1.475)*A(0,PI,0)},
  {"Right",C(1.475,0,0)*A(0,-PI/2,0)},
  {"Left",C(-1.475,0,0)*A(0,PI/2,0)},
  {"Top",C(0,1.475,0)*A(PI/2,0,0)},
  {"Bottom",C(0,-1.475,0)*A(-PI/2,0,0)},
 }
 for faceIndex,entry in ipairs(faces) do
  local label,frame=entry[1],entry[2]
  local prefix="AllSpark"..label
  local plate=b:box(prefix.."RecessedFacePanel",V(2.88,2.88,.102),frame,faceIndex%2==0 and recess or bronze,METAL)
  plate.Reflectance=.055
  -- Thin protective metal borders sit above the dark panel clearance seam.
  for _,s in ipairs({-1,1}) do
   b:box(prefix.."RaisedHorizontalBorder"..s,V(2.62,.043,.036),frame*C(0,s*1.315,-.071),silver,METAL)
   b:box(prefix.."RaisedVerticalBorder"..s,V(.043,2.62,.036),frame*C(s*1.315,0,-.071),silver,METAL)
  end
  -- Two inset strokes segment the ancient plate without turning it into a grid.
  for row=1,2 do
   b:box(prefix.."DarkRecessedDivision"..row,V(2.48,.035,.017),frame*C(0,.43-(row-1)*.86,-.059),dark,METAL)
  end
  for row=1,3 do for col=1,2 do
   local idx=(row-1)*2+col
   local glyph=glyphs[(idx+faceIndex-2)%#glyphs+1]
   local x=(col==1 and -.62 or .62)
   local y=.86-(row-1)*.86
   local rotation=((faceIndex+idx)%3-1)*.065
   local cf=frame*C(x,y,-.09)*A(0,0,rotation)
   for stroke,seg in ipairs(glyph) do
    b:line(prefix.."CybertronianGlyph"..idx.."Stroke"..stroke,
     cf*V(seg[1],seg[2],0),cf*V(seg[3],seg[4],0),.060,.045,
     (idx+faceIndex)%3==0 and silver or relief,METAL)
   end
  end end
  -- Small inset fasteners and one dim seam are part of the cube, never floating.
  for _,x in ipairs({-1,1}) do for _,y in ipairs({-1,1}) do
   b:box(prefix.."FlushCornerFastener"..x..y,V(.10,.10,.028),frame*C(x*1.17,y*1.17,-.071)*A(0,0,PI/4),dark,METAL)
  end end
  local seam=b:box(prefix.."SubtleCyanPowerSeam",V(.27,.024,.012),frame*C(faceIndex%2==0 and .98 or -.98,-.43,-.066),cyan,NEON)
  seam.Transparency=.30
 end
 b.model:SetAttribute("ArtVersion",72)
 b.model:SetAttribute("AllSparkFaceCount",6)
 b.model:SetAttribute("CybertronianGlyphCount",36)
 b.model:SetAttribute("GlyphStrokeCount",144)
 b.model:SetAttribute("ChamferedMetalEdges",12)
 b.model:SetAttribute("Franchise","Transformers")
 b.model:SetAttribute("ArtReference","Movie AllSpark cube")
 return true
end

return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_V72_FreeModels_EnergonAxe"><Properties><string name="Name">EnergonAxe</string><ProtectedString name="Source">-- Optimus Prime's orange Energon axe, built entirely from native Roblox parts.
-- The crescent has two tapered, sloping faces and a genuinely thin cutting edge.
local M={}
local V,C,A,RGB=Vector3.new,CFrame.new,CFrame.Angles,Color3.fromRGB
local METAL,NEON=Enum.Material.Metal,Enum.Material.Neon
local function point(theta,width,z)
 return V(-.55+width*math.cos(theta),4.95+1.75*math.sin(theta),z)
end

function M.build(b,key)
 if key~="optimus_energon_axe" then return false end
 local blue,blueLight,red=RGB(25,56,119),RGB(48,95,171),RGB(172,33,34)
 local dark,silver,steel=RGB(32,38,47),RGB(190,207,219),RGB(90,107,121)
 local orange,amber,edge=RGB(255,106,12),RGB(255,146,30),RGB(255,220,110)
 local vertical=A(0,0,math.pi/2)
 -- The handle is a compact red/blue mechanical forearm emitter, not a wooden axe.
 b:cylinder("SteelGripCore",V(3.25,.34,.34),C(-.85,1.99,0)*vertical,steel,METAL)
 b:cylinder("BlueGripSleeve",V(2.12,.48,.48),C(-.85,1.75,0)*vertical,blue,METAL)
 for i=0,7 do
  b:cylinder("RecessedGripBand"..i,V(.070,.505,.505),C(-.85,.83+i*.25,0)*vertical,dark,METAL)
 end
 b:cylinder("BevelledPommel",V(.23,.66,.66),C(-.85,.48,0)*vertical,silver,METAL)
 b:cylinder("PommelBlueInset",V(.075,.48,.48),C(-.85,.329,0)*vertical,blueLight,METAL)
 b:box("FrontGripEnergyStripe",V(.080,1.84,.035),C(-.85,1.78,-.264),amber,NEON)
 b:box("RearGripEnergyStripe",V(.080,1.84,.035),C(-.85,1.78,.264),amber,NEON)
 b:cylinder("LowerEmitterCollar",V(.25,.76,.76),C(-.85,3.00,0)*vertical,silver,METAL)
 b:box("RedForearmEmitter",V(.78,1.35,.70),C(-.85,3.70,0),red,METAL)
 for _,s in ipairs({-1,1}) do
  b:wedge("BlueEmitterShoulder"..s,V(.19,.97,.76),C(-.85+s*.48,3.83,0),blue,METAL)
  b:box("SilverArmourRail"..s,V(.10,1.02,.10),C(-.85+s*.32,3.70,-.40),silver,METAL)
  b:box("RearArmourRail"..s,V(.10,1.02,.10),C(-.85+s*.32,3.70,.40),silver,METAL)
  for j=0,3 do
   b:box("EmitterCoolingVent"..s.."_"..j,V(.28,.055,.025),C(-.85+s*.20,3.37+j*.18,-.365)*A(0,0,s*.20),dark,METAL)
  end
 end
 b:box("UpperBluePowerBlock",V(.89,.50,.82),C(-.85,4.46,0),blue,METAL)
 b:box("SilverBridgeCasing",V(1.34,.43,.67),C(-.34,4.91,0),silver,METAL)
 b:box("BridgeDarkRecess",V(1.18,.24,.71),C(-.25,4.91,0),dark,METAL)
 b:box("OrangeEmitterBeam",V(1.17,.14,.74),C(-.20,4.91,0),orange,NEON)
 -- Layered round energy hub and recessed bolts on both sides of the emitter.
 local hub=C(-.85,4.91,0)*A(0,math.pi/2,0)
 b:cylinder("CircularArmourHub",V(.85,1.10,1.10),hub,blue,METAL)
 for _,s in ipairs({-1,1}) do
  local z=s*.46
  b:cylinder("SilverHubRim"..s,V(.09,.90,.90),C(-.85,4.91,z)*A(0,math.pi/2,0),silver,METAL)
  b:cylinder("InsetRedHub"..s,V(.10,.70,.70),C(-.85,4.91,z+s*.06)*A(0,math.pi/2,0),red,METAL)
  b:cylinder("EnergonHubCore"..s,V(.12,.39,.39),C(-.85,4.91,z+s*.12)*A(0,math.pi/2,0),orange,NEON)
  b:cylinder("HotCentralPin"..s,V(.13,.15,.15),C(-.85,4.91,z+s*.17)*A(0,math.pi/2,0),edge,NEON)
  for j=0,3 do
   local a=j*math.pi/2+math.pi/4
   b:cylinder("HubBolt"..s.."_"..j,V(.06,.084,.084),C(-.85+math.cos(a)*.46,4.91+math.sin(a)*.46,z+s*.065)*A(0,math.pi/2,0),steel,METAL)
  end
 end
 -- Continuous half-moon silhouette. The outer edge is only .05 studs thick;
 -- the inner spine is .48 thick, so each broad face slopes toward a sharp edge.
 local segments=12
 for i=0,segments-1 do
  local a=-math.pi/2+i*math.pi/segments
  local c=-math.pi/2+(i+1)*math.pi/segments
  for _,s in ipairs({-1,1}) do
   local innerA,innerC=point(a,1.10,s*.24),point(c,1.10,s*.24)
   local outerA,outerC=point(a,2.45,s*.025),point(c,2.45,s*.025)
   b:triangle("SlopingCrescentFace"..s.."_"..i.."a",innerA,outerA,outerC,orange,.035,NEON)
   b:triangle("SlopingCrescentFace"..s.."_"..i.."b",innerA,outerC,innerC,i%3==0 and amber or orange,.035,NEON)
  end
  b:line("SharpLuminousEdge"..i,point(a,2.45,0),point(c,2.45,0),.048,.055,edge,NEON)
  b:line("CurvedOrangeBladeSpine"..i,point(a,1.10,0),point(c,1.10,0),.065,.48,amber,NEON)
  -- A fine inset line follows the broad face rather than floating around it.
  if i&gt;0 and i&lt;segments-1 then
   b:line("InsetEnergonContour"..i,point(a,1.94,-.145),point(c,1.94,-.145),.024,.024,edge,NEON)
  end
 end
 -- A tiny Optimus-coloured armour badge distinguishes the mechanical grip.
 b:box("OptimusBlueBadge",V(.31,.37,.037),C(-.85,3.78,-.379),blueLight,METAL)
 b:box("OptimusSilverFaceplate",V(.23,.16,.046),C(-.85,3.71,-.407),silver,METAL)
 b:box("OptimusEyeStrip",V(.22,.038,.044),C(-.85,3.85,-.408),RGB(110,231,255),NEON)
 for _,s in ipairs({-1,1}) do
  b:box("BlueBadgeAntenna"..s,V(.043,.27,.047),C(-.85+s*.17,3.88,-.405),blueLight,METAL)
 end
 b.model:SetAttribute("ArtVersion",72)
 b.model:SetAttribute("ArtSource","NativeRobloxParts")
 b.model:SetAttribute("BladeProfile","Double-bevel Energon crescent with thin cutting edge")
 b.model:SetAttribute("Franchise","Transformers")
 return true
end

return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_V72_FreeModels_MatrixLeadership"><Properties><string name="Name">MatrixLeadership</string><ProtectedString name="Source">-- Transformers' Matrix of Leadership, sculpted from native Roblox geometry.
-- The two silver finger handles are actual open loops; no dark inset fakes them.
local M={}
local V,C,A,RGB=Vector3.new,CFrame.new,CFrame.Angles,Color3.fromRGB
local METAL,NEON=Enum.Material.Metal,Enum.Material.Neon
local TAU=math.pi*2

function M.build(b,key)
 if key~="transformers_matrix" then return false end
 local silver,bright,steel=RGB(162,179,190),RGB(221,232,236),RGB(74,92,106)
 local gold,bronze,warm=RGB(222,151,50),RGB(123,77,35),RGB(248,190,80)
 local blue,cyan,darkBlue=RGB(31,124,222),RGB(99,226,255),RGB(20,73,145)
 local cy=1.82
 local frontCylinder=A(0,math.pi/2,0)
 -- Orange-bronze housing with separate silver rear casting and a raised lip.
 -- Discs occupy only the central chassis and never close either finger handle.
 b:cylinder("SilverRearHousing",V(.28,2.09,2.09),C(0,cy,.17)*frontCylinder,steel,METAL)
 b:cylinder("BronzeCircularChassis",V(.38,1.96,1.96),C(0,cy,-.08)*frontCylinder,bronze,METAL)
 b:ring("BackSilverCastingLip",C(0,cy,.34),1.0,.13,silver,16,METAL)
 b:ring("GoldenOuterEnergyRing",C(0,cy,-.32),.94,.17,gold,16,METAL)
 b:ring("InnerDarkSocket",C(0,cy,-.415),.778,.075,bronze,16,METAL)
 -- Two eight-sided, cast-metal hand grips. The empty middle stays see-through
 -- from both sides; thin bright edges articulate the bevel on their front face.
 local loop={{.94,2.14},{1.37,2.64},{2.08,2.56},{2.48,2.14},
             {2.39,1.35},{1.97,1.00},{1.35,1.10},{.94,1.48}}
 for _,s in ipairs({-1,1}) do
  local prefix=s&lt;0 and "Left" or "Right"
  for i,p in ipairs(loop) do
   local q=loop[i%#loop+1]
   b:line(prefix.."OpenHandleCast_"..i,V(s*p[1],p[2],.04),V(s*q[1],q[2],.04),.255,.39,silver,METAL)
   b:line(prefix.."HandleFrontBevel_"..i,V(s*p[1],p[2],-.166),V(s*q[1],q[2],-.166),.068,.046,bright,METAL)
  end
  -- Grip ribs sit on the outside edge rather than filling the finger void.
  for j=0,3 do
   local t=.22+j*.16
   local x=2.48+(2.39-2.48)*t
   local y=2.14+(1.35-2.14)*t
   b:box(prefix.."GripRidge_"..j,V(.30,.065,.46),C(s*x,y,.04)*A(0,0,s*.114),steel,METAL)
  end
  b:box(prefix.."UpperHandleShoulder",V(.45,.19,.49),C(s*1.26,2.39,.05)*A(0,0,s*.68),silver,METAL)
  b:box(prefix.."LowerHandleShoulder",V(.40,.18,.48),C(s*1.19,1.31,.05)*A(0,0,-s*.51),silver,METAL)
  for _,y in ipairs({2.40,1.27}) do
   b:cylinder(prefix.."HandleShoulderBolt_"..y,V(.055,.14,.14),C(s*1.24,y,-.227)*frontCylinder,bronze,METAL)
   b:box(prefix.."HandleBoltSlot_"..y,V(.068,.018,.012),C(s*1.24,y,-.260),steel,METAL)
  end
 end
 -- Chassis ribs, screw heads and fine radial gold highlights surround the orb.
 for i=0,11 do
  local angle=i*TAU/12
  local sin,cos=math.sin(angle),math.cos(angle)
  b:box("ChassisRadialRib_"..i,V(.19,.22,.35),C(sin*.97,cy+cos*.97,-.045)*A(0,0,-angle),gold,METAL)
  b:box("RadialBrightEdge_"..i,V(.055,.17,.035),C(sin*.99,cy+cos*.99,-.247)*A(0,0,-angle),warm,METAL)
 end
 for i=0,7 do
  local angle=(i+.5)*TAU/8
  local x,y=math.sin(angle)*.94,cy+math.cos(angle)*.94
  b:cylinder("SocketFastener_"..i,V(.055,.10,.10),C(x,y,-.436)*frontCylinder,silver,METAL)
  b:box("SocketFastenerSlot_"..i,V(.052,.012,.012),C(x,y,-.469)*A(0,0,-angle),steel,METAL)
 end
 -- A true, closed, faceted blue crystal lens. Eight crown facets lead into
 -- sixteen shoulder facets, so the blue core has a sculpted mineral silhouette.
 local facetColors={RGB(79,204,250),RGB(48,159,237),RGB(28,116,208),RGB(31,139,224),
                    RGB(55,188,241),RGB(101,224,251),RGB(57,169,239),RGB(39,145,223)}
 b:ball("BlueEnergyCore",V(1.37,1.37,.66),C(0,cy,-.385),blue,NEON)
 for i=0,7 do
  local a=i*TAU/8;local nextAngle=(i+1)*TAU/8
  local outerA=V(math.cos(a)*.72,cy+math.sin(a)*.72,-.493)
  local outerB=V(math.cos(nextAngle)*.72,cy+math.sin(nextAngle)*.72,-.493)
  local innerA=V(math.cos(a)*.35,cy+math.sin(a)*.35,-.785)
  local innerB=V(math.cos(nextAngle)*.35,cy+math.sin(nextAngle)*.35,-.785)
  b:triangle("CrystalShoulderA_"..i,outerA,outerB,innerB,facetColors[i+1],.018,METAL)
  b:triangle("CrystalShoulderB_"..i,outerA,innerB,innerA,facetColors[i+1],.018,METAL)
  b:triangle("CrystalCrown_"..i,innerA,innerB,V(0,cy,-.884),facetColors[(i+2)%8+1],.018,NEON)
 end
 -- A restrained luminous glint preserves the jewel silhouette instead of
 -- surrounding this compact relic in spikes or unrelated floating effects.
 b:line("CrystalLongGlint",V(-.27,cy+.43,-.738),V(-.12,cy+.17,-.846),.035,.018,cyan,NEON)
 b:line("CrystalShortGlint",V(-.22,cy+.33,-.791),V(-.08,cy+.34,-.825),.025,.018,RGB(200,250,255),NEON)
 -- The silver chevron crown, sternum and pointed crest are mechanical relief,
 -- with physical layered plates rather than an uploaded emblem decal.
 for _,s in ipairs({-1,1}) do
  b:line("CrownWing_"..s,V(s*.18,2.80,-.23),V(s*.70,3.10,-.08),.16,.30,silver,METAL)
  b:line("CrownWingBevel_"..s,V(s*.21,2.85,-.398),V(s*.67,3.105,-.235),.045,.035,bright,METAL)
  b:line("LowerSilverJaw_"..s,V(s*.18,.72,-.22),V(s*.59,.87,-.15),.15,.29,silver,METAL)
  b:triangle("CrestCheek_"..s,V(s*.12,2.88,-.455),V(s*.32,3.08,-.455),V(s*.28,2.82,-.455),silver,.06,METAL)
 end
 b:box("CrownCentralKeystone",V(.22,.32,.31),C(0,2.94,-.22),silver,METAL)
 b:triangle("CrownKeystoneTip",V(-.11,3.10,-.39),V(.11,3.10,-.39),V(0,3.26,-.39),bright,.08,METAL)
 b:box("LowerCastHeel",V(.37,.16,.40),C(0,.71,.02),steel,METAL)
 b:box("HeelGoldPlate",V(.21,.075,.04),C(0,.70,-.205),gold,METAL)
 b.model.Name="Transformers Matrix of Leadership"
 b.model:SetAttribute("ArtVersion",72)
 b.model:SetAttribute("Kind","transformers_matrix")
 b.model:SetAttribute("OpenFingerHandles",true)
 b.model:SetAttribute("NativeFacetedEnergyCrystal",true)
 return true
end

return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_V75_FreeModels_DragonCollectibles"><Properties><string name="Name">DragonCollectibles</string><ProtectedString name="Source">-- Native, display-sized Yu-Gi-Oh! dragons. No meshes, decals or runtime animation.
-- Both sculptures face -Z and keep their complete wings and tails over a plinth.
local M={}
local V,C,A=Vector3.new,CFrame.new,CFrame.Angles
local RGB=Color3.fromRGB
local METAL,SMOOTH,NEON=Enum.Material.Metal,Enum.Material.SmoothPlastic,Enum.Material.Neon
local PI=math.pi

local function box(b,n,p,size,color,rotation,material)
 return b:box(n,size,C(p)*(rotation or C()),color,material or METAL)
end
local function ball(b,n,p,size,color)
 return b:ball(n,size,C(p),color,METAL)
end
local function line(b,n,a,c,width,color,depth)
 return b:line(n,a,c,width,depth or width,color,METAL)
end
local function fin(b,n,a,c,d,color,thickness)
 return b:triangle(n,a,c,d,color,thickness or .06,METAL)
end
local function blade(b,n,a,tip,width,color)
 local delta=tip-a
 local side=delta:Cross(V(0,0,1))
 if side.Magnitude&lt;.01 then side=delta:Cross(V(0,1,0)) end
 side=side.Unit*width*.5
 fin(b,n,a-side,a+side,tip,color,.075)
end

local function torso(b,stardust,palette)
 local white,bright,shade,deep=palette.white,palette.bright,palette.shade,palette.deep
 ball(b,'ArmoredPelvis',V(0,1.53,.46),V(1.02,1.19,1.08),shade)
 ball(b,'TaperedDragonTorso',V(0,2.58,.23),V(1.20,1.91,1.07),white)
 ball(b,'HighShoulderMantle',V(0,3.27,.30),V(1.46,.83,1.00),shade)
 for _,s in ipairs({-1,1}) do
  box(b,'PectoralArmor'..s,V(s*.30,3.07,-.32),V(.63,.66,.25),white,A(-.11,0,-s*.17))
  box(b,'PectoralBevel'..s,V(s*.31,3.28,-.47),V(.63,.11,.085),bright,A(0,0,-s*.17))
  line(b,'CollarArc'..s,V(s*.12,3.50,-.17),V(s*.69,3.38,-.08),.13,bright,.15)
  for rib=0,2 do
   box(b,'FlankPlate'..s..'_'..rib,V(s*(.52-rib*.055),2.74-rib*.31,.31),V(.26,.36,.83),
    rib%2==0 and white or shade,A(.10,0,-s*.18))
  end
 end
 for row=0,5 do
  local y=2.91-row*.25
  local width=.78-row*.055
  local z=-.37+row*.035
  box(b,'BellyArmorCourse'..row,V(0,y,z),V(width,.23,.20),row%2==0 and bright or white,A(-.10,0,0))
  if not stardust or row%2==0 then box(b,'BellyScaleLowerLip'..row,V(0,y-.085,z-.105),V(width*.94,.032,.035),shade) end
 end
 if stardust then
  local center=V(0,3.12,-.50)
  fin(b,'StardustBreastCrystalUpper',center+V(-.14,0,0),center+V(.14,0,0),center+V(0,.27,-.06),palette.accent,.04)
  fin(b,'StardustBreastCrystalLower',center+V(-.14,0,0),center+V(0,-.26,-.06),center+V(.14,0,0),palette.lit,.04)
 else
  box(b,'BlueEyesBreastKeel',V(0,3.03,-.52),V(.13,.65,.12),bright,A(-.09,0,0))
 end
end

local function limbs(b,stardust,palette)
 for _,s in ipairs({-1,1}) do
  local white,shade,bright=palette.white,palette.shade,palette.bright
  -- Reverse-jointed haunches with broad three-taloned feet support the sculpture.
  ball(b,'HipJoint'..s,V(s*.57,1.62,.41),V(.61,.70,.67),shade)
  line(b,'PowerfulThigh'..s,V(s*.57,1.69,.40),V(s*.83,1.05,-.06),.46,white,.56)
  b:wedge('ArmoredKnee'..s,V(.48,.43,.48),C(s*.83,1.00,-.08)*A(-.22,0,0),bright,METAL)
  line(b,'SweptShin'..s,V(s*.82,1.04,-.02),V(s*.68,.43,.13),.30,shade,.34)
  box(b,'ShinFaceArmor'..s,V(s*.74,.70,-.07),V(.31,.52,.19),white,A(.24,0,-s*.20))
  ball(b,'LowAnkle'..s,V(s*.68,.37,.03),V(.36,.39,.42),shade)
  box(b,'DragonFoot'..s,V(s*.70,.22,-.24),V(.64,.27,.81),white,A(0,s*.08,0))
  for toe=-1,1 do
   local x=s*.70+toe*.19
   box(b,'SegmentedToe'..s..'_'..toe,V(x,.19,-.64),V(.16,.17,.35),shade,A(-.12,0,0))
   blade(b,'SharpFootTalon'..s..'_'..toe,V(x,.20,-.73),V(x,.12,-1.00),.17,bright)
  end
  blade(b,'HeelSpur'..s,V(s*.69,.43,.30),V(s*.73,.59,.69),.15,white)
  -- Forearms are separate from the wings and end in visible curled fingers.
  ball(b,'ShoulderJoint'..s,V(s*.69,3.28,.02),V(.44,.49,.49),shade)
  line(b,'UpperForelimb'..s,V(s*.72,3.21,.02),V(s*.94,2.76,-.22),.25,white,.29)
  ball(b,'ElbowJoint'..s,V(s*.95,2.72,-.24),V(.31,.32,.34),shade)
  line(b,'ForearmPlate'..s,V(s*.95,2.75,-.22),V(s*1.07,2.55,-.65),.23,white,.28)
  box(b,'ClawedPalm'..s,V(s*1.08,2.50,-.76),V(.34,.18,.30),shade,A(.16,0,-s*.20))
  for _,finger in ipairs(stardust and {-1,1} or {-1,0,1}) do
   local x=s*1.08+finger*.105
   line(b,'ClawFinger'..s..'_'..finger,V(x,2.52,-.84),V(x,2.36,-1.00),.075,white,.095)
   blade(b,'HandTalon'..s..'_'..finger,V(x,2.37,-.99),V(x,2.33,-1.15),.09,bright)
  end
  blade(b,'ForearmBackSpur'..s,V(s*.98,2.74,-.30),V(s*1.22,3.08,-.10),.20,stardust and palette.accent or bright)
 end
end

local function head(b,stardust,palette)
 local white,bright,shade,deep=palette.white,palette.bright,palette.shade,palette.deep
 local neck={V(0,3.29,.23),V(0,3.72,.02),V(0,4.12,-.25),V(0,4.45,-.62)}
 for i=1,#neck-1 do
  line(b,'SegmentedNeck'..i,neck[i],neck[i+1],.58-i*.045,shade,.61-i*.035)
  local p=(neck[i]+neck[i+1])*.5
  box(b,'NeckThroatScale'..i,p+V(0,0,-.27),V(.48-i*.035,.32,.17),bright,A(-.50,0,0))
 end
 -- A long cheek/upper-jaw assembly, dark recessed mouth and two separate eyes.
 ball(b,'SculptedDragonCranium',V(0,4.52,-.82),V(.88,.70,.94),shade)
 box(b,'BrowArmoredSkull',V(0,4.69,-.86),V(.70,.35,.88),white,A(.10,0,0))
 b:wedge('LongUpperMuzzle',V(.61,.34,.94),C(0,4.49,-1.35)*A(.13,0,0),white,METAL)
 if not stardust then box(b,'MuzzleTopRidge',V(0,4.61,-1.29),V(.25,.08,.65),bright,A(.32,0,0)) end
 box(b,'NoseTerminalPlate',V(0,4.42,-1.81),V(.45,.13,.13),bright,A(.13,0,0))
 box(b,'OpenMouthRecess',V(0,4.29,-1.35),V(.54,.12,.88),deep,A(.05,0,0),SMOOTH)
 b:wedge('SeparateLowerJaw',V(.52,.16,.84),C(0,4.17,-1.30)*A(-.12,0,0),shade,METAL)
 box(b,'LowerJawChinPlate',V(0,4.15,-1.68),V(.43,.14,.17),white,A(-.12,0,0))
 for _,s in ipairs({-1,1}) do
  -- Eye facets face forward and outward; bright iris remains readable overhead.
  local eye=C(s*.34,4.62,-1.14)*A(0,-s*.38,0)
  b:box('RecessedEyeSocket'..s,V(.25,.20,.10),eye,deep,SMOOTH)
  b:box('SignatureDragonEye'..s,V(.16,.095,.046),eye*C(0,0,-.068),palette.eye,NEON)
  b:box('DragonEyePupil'..s,V(.027,.087,.015),eye*C(0,0,-.097),deep,SMOOTH)
  b:box('RaisedEyeBrow'..s,V(.32,.075,.12),eye*C(0,.115,-.06)*A(0,0,-s*.16),bright,METAL)
  box(b,'MuzzleNostril'..s,V(s*.15,4.46,-1.876),V(.075,.045,.025),deep,A(0,0,-s*.10),SMOOTH)
  fin(b,'SculptedCheekPlate'..s,V(s*.30,4.74,-.97),V(s*.62,4.43,-.57),V(s*.28,4.26,-1.20),white,.09)
  for tooth=0,(stardust and 1 or 2) do
   blade(b,'UpperJawFang'..s..'_'..tooth,V(s*.25,4.36,-1.07-tooth*.27),V(s*.24,4.23,-1.10-tooth*.27),.075,bright)
  end
  blade(b,'LowerJawRearHorn'..s,V(s*.30,4.25,-.77),V(s*.50,4.10,-.41),.19,shade)
  if stardust then
   blade(b,'StardustLongCrownHorn'..s,V(s*.24,4.84,-.63),V(s*.57,5.77,.04),.32,bright)
   blade(b,'StardustEarBlade'..s,V(s*.42,4.65,-.59),V(s*.83,5.12,.38),.27,white)
   blade(b,'StardustEmeraldCrownInlay'..s,V(s*.26,4.95,-.55),V(s*.51,5.59,-.04),.085,palette.accent)
  else
   blade(b,'BlueEyesRearSweptHorn'..s,V(s*.32,4.82,-.59),V(s*.67,5.20,.48),.31,bright)
   blade(b,'BlueEyesTempleSpur'..s,V(s*.43,4.46,-.53),V(s*.72,4.64,.15),.27,white)
  end
 end
 if stardust then
  blade(b,'StardustForeheadSpear',V(0,4.87,-1.02),V(0,5.60,-1.32),.22,white)
  fin(b,'StardustForeheadCrystal',V(-.11,4.85,-1.23),V(.11,4.85,-1.23),V(0,5.14,-1.19),palette.accent,.035)
 else
  blade(b,'BlueEyesOccipitalBlade',V(0,4.84,-.49),V(0,5.28,.29),.25,white)
 end
end

local function wings(b,stardust,palette)
 for _,s in ipairs({-1,1}) do
  local prefix=s&lt;0 and 'LeftWing' or 'RightWing'
  local root=V(s*.51,3.39,.49)
  local elbow=V(s*.92,4.14,.72)
  local crest=V(s*1.52,stardust and 5.30 or 5.10,.70)
  local outer=V(s*2.43,stardust and 4.68 or 4.38,1.02)
  local low=V(s*2.10,2.78,1.27)
  local inner=V(s*.79,2.49,.58)
  local middle=V(s*1.65,3.63,.89)
  local membrane=stardust and palette.accent or palette.membrane
  -- Actual double-wedge triangles make broad membranes with sculpted valleys.
  fin(b,prefix..'UpperMembrane',elbow,crest,outer,membrane,.055)
  fin(b,prefix..'MiddleMembrane',elbow,outer,middle,stardust and palette.lit or palette.shade,.055)
  fin(b,prefix..'OuterMembrane',middle,outer,low,membrane,.055)
  fin(b,prefix..'LowerMembrane',middle,low,V(s*1.32,2.93,.83),stardust and palette.accent or palette.membrane,.055)
  fin(b,prefix..'RootMembrane',root,middle,inner,membrane,.055)
  line(b,prefix..'Humerus',root,elbow,.20,palette.white,.23)
  line(b,prefix..'LeadingEdge',elbow,crest,.15,palette.bright,.19)
  line(b,prefix..'CrestEdge',crest,outer,.11,palette.white,.14)
  line(b,prefix..'LongWingFinger',elbow,outer,.11,palette.bright,.15)
  line(b,prefix..'LowerWingFinger',elbow,low,.105,palette.white,.14)
  line(b,prefix..'InteriorWingFinger',elbow,V(s*1.32,2.93,.83),.09,palette.bright,.12)
  line(b,prefix..'RootStrut',root,inner,.12,palette.shade,.14)
  ball(b,prefix..'ElbowJoint',elbow,V(.26,.26,.28),palette.shade)
  blade(b,prefix..'ThumbTalon',crest,crest+V(s*.03,.35,-.13),.18,palette.bright)
  blade(b,prefix..'OuterTalon',outer,outer+V(s*.12,-.30,.04),.14,palette.bright)
  blade(b,prefix..'LowerTalon',low,low+V(-s*.05,-.28,.05),.15,palette.white)
  if stardust then
   -- Stardust's layered white ray feathers contrast with Blue-Eyes' bat wings.
   for ray=0,2 do
    local start=elbow:Lerp(crest,.35+ray*.20)
    local tip=V(s*(2.15+ray*.14),4.06+ray*.24,1.02)
    blade(b,prefix..'SilverRayFeather'..ray,start,tip,.16,palette.bright)
   end
  else
   line(b,prefix..'RecessedMembraneVein',V(s*1.29,3.87,.84),V(s*2.30,3.39,1.19),.043,palette.shade,.045)
  end
 end
end

local function tailAndSpines(b,stardust,palette)
 local points={V(0,1.58,.71),V(.17,1.40,1.16),V(.50,1.16,1.63),V(.94,.95,1.95),
  V(1.45,.77,2.06),V(1.86,.67,1.90),V(2.08,.65,1.53),V(2.06,.75,1.06),V(1.82,.96,.68)}
 for i=1,#points-1 do
  local width=.48-(i-1)*.047
  line(b,'ConnectedTailSegment'..i,points[i],points[i+1],width,i%2==0 and palette.shade or palette.white,width*.90)
  if i&lt;#points-1 then ball(b,'TailArmoredJoint'..i,points[i+1],V(width*.91,width*.91,width*.91),palette.white) end
 end
 blade(b,'SharpTailTip',points[#points],V(1.42,1.31,.41),.18,palette.bright)
 for i=1,4 do
  local p=points[i+1]
  blade(b,'TailSpine'..i,p+V(0,.13,0),p+V(-.03,.40-i*.025,.13),.15,stardust and palette.accent or palette.bright)
 end
 local back={V(0,3.38,.78),V(0,3.04,.84),V(0,2.65,.82),V(0,2.27,.84)}
 for i,p in ipairs(back) do
  blade(b,'DorsalArmorSpine'..i,p,p+V(0,.21,.40-i*.025),.21,stardust and palette.accent or palette.bright)
 end
end

function M.build(b,key)
 if key~='stardust_dragon' and key~='blue_eyes_white_dragon' then return false end
 local stardust=key=='stardust_dragon'
 local palette=stardust and {
  white=RGB(215,239,235),bright=RGB(250,255,250),shade=RGB(115,167,164),
  deep=RGB(18,53,62),accent=RGB(45,153,137),lit=RGB(111,219,188),eye=RGB(126,255,203),
 } or {
  white=RGB(214,228,242),bright=RGB(251,253,255),shade=RGB(131,156,185),
  deep=RGB(16,31,55),membrane=RGB(160,190,219),eye=RGB(60,181,255),
 }
 torso(b,stardust,palette)
 limbs(b,stardust,palette)
 head(b,stardust,palette)
 wings(b,stardust,palette)
 tailAndSpines(b,stardust,palette)
 b.model:SetAttribute('ArtVersion',75)
 b.model:SetAttribute('Franchise','Yu-Gi-Oh!')
 b.model:SetAttribute('CharacterName',stardust and 'Stardust Dragon' or 'Blue-Eyes White Dragon')
 b.model:SetAttribute('SculptedDragonHead',true)
 b.model:SetAttribute('RecessedSeparateEyes',2)
 b.model:SetAttribute('OpenDragonMouth',true)
 b.model:SetAttribute('NativePolygonWings',2)
 b.model:SetAttribute('ConnectedTaperedTail',true)
 b.model:SetAttribute('ArticulatedClawedLimbs',4)
 return true
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_V75_FreeModels_PopCultureItems"><Properties><string name="Name">PopCultureItems</string><ProtectedString name="Source">-- Hand-built collectible art. All surfaces, lettering and gems are native parts.
local M={}
local V,C,A,RGB=Vector3.new,CFrame.new,CFrame.Angles,Color3.fromRGB
local PI=math.pi
local METAL,WOOD,NEON,PLASTIC=Enum.Material.Metal,Enum.Material.Wood,Enum.Material.Neon,Enum.Material.SmoothPlastic
local silver,ivory,dark=RGB(211,225,237),RGB(246,248,244),RGB(20,28,43)
local gold,paleGold,bronze=RGB(229,170,37),RGB(255,225,118),RGB(133,83,27)
local blue,cyan,red=RGB(22,82,180),RGB(81,222,248),RGB(192,32,43)

local letters={
 M={{-.4,-.5,-.4,.5},{-.4,.5,0,-.05},{0,-.05,.4,.5},{.4,.5,.4,-.5}},
 O={{-.35,-.5,-.35,.5},{-.35,.5,.35,.5},{.35,.5,.35,-.5},{.35,-.5,-.35,-.5}},
 S={{.35,.5,-.35,.5},{-.35,.5,-.35,0},{-.35,0,.35,0},{.35,0,.35,-.5},{.35,-.5,-.35,-.5}},
 T={{-.4,.5,.4,.5},{0,.5,0,-.5}},
 U={{-.35,.5,-.35,-.5},{-.35,-.5,.35,-.5},{.35,-.5,.35,.5}},
 N={{-.35,-.5,-.35,.5},{-.35,.5,.35,-.5},{.35,-.5,.35,.5}},
 G={{.35,.5,-.35,.5},{-.35,.5,-.35,-.5},{-.35,-.5,.35,-.5},{.35,-.5,.35,0},{.35,0,.02,0}},
}
local function lettering(b,name,word,frame,size,color,width)
 local advance=size*.9
 for index=1,#word do
  local glyph=letters[word:sub(index,index)]
  if glyph then for stroke,line in ipairs(glyph) do
   local x=(index-(#word+1)/2)*advance
   b:line(name..index..'_'..stroke,frame*V(x+line[1]*size,line[2]*size,0),frame*V(x+line[3]*size,line[4]*size,0),width or .035,.026,color,METAL)
  end end
 end
end
local function disc(b,name,frame,diameter,depth,color,material)
 return b:cylinder(name,V(depth,diameter,diameter),frame*A(0,PI/2,0),color,material or METAL)
end
local function gem(b,name,position,size,color)
 local p=b:box(name,V(size,size,.055),C(position)*A(0,0,PI/4),color or ivory,METAL)
 p.Reflectance=.22
 return p
end

local function glove(b)
 local cool=RGB(169,188,211)
 b:ball('TailoredGlovePalm',V(1.85,2.12,.64),C(0,1.9,.02),ivory,Enum.Material.Fabric)
 b:ball('PaddedGloveBack',V(1.64,1.95,.31),C(0,1.94,-.25),silver,Enum.Material.Fabric)
 b:box('FittedWristCuff',V(1.42,.53,.68),C(0,.69,.04),cool,Enum.Material.Fabric)
 for _,side in ipairs({-1,1}) do
  b:line('CuffPiping'..side,V(-.68,.69+side*.22,-.32),V(.68,.69+side*.22,-.32),.052,.05,silver,METAL)
 end
 for i=1,3 do disc(b,'CuffPearlButton'..i,C(.54,.55+i*.095,-.343),.075,.035,ivory) end
 local fingers={
  {name='Index',x=-.65,start=2.67,length=1.51,lean=-.075,width=.34},
  {name='Middle',x=-.21,start=2.82,length=1.79,lean=-.01,width=.36},
  {name='Ring',x=.24,start=2.77,length=1.61,lean=.055,width=.35},
  {name='Pinky',x=.66,start=2.59,length=1.26,lean=.14,width=.31},
 }
 local gems=0
 for _,finger in ipairs(fingers) do
  local a=V(finger.x,finger.start,.015)
  for segment=1,3 do
   local t=segment/3
   local tip=V(finger.x+finger.lean*t,finger.start+finger.length*t,.015+(.06*t*t))
   b:line(finger.name..'FingerSegment'..segment,a,tip,finger.width,.40,ivory,Enum.Material.Fabric)
   b:ball(finger.name..'RoundedJoint'..segment,V(finger.width,.30,.40),C(tip),silver,Enum.Material.Fabric)
   if segment&lt;3 then b:line(finger.name..'TailoringJoint'..segment,tip+V(-finger.width*.38,0,-.205),tip+V(finger.width*.38,0,-.205),.018,.018,cool,Enum.Material.Fabric) end
   for j=0,2 do
    local center=a:Lerp(tip,.2+j*.3)
    gem(b,finger.name..'FingerRhinestone'..segment..'_'..j,center+V((j%2==0 and -.055 or .055),0,-.228),.105,j%2==0 and ivory or cool)
    gems=gems+1
   end
   a=tip
  end
  b:ball(finger.name..'TailoredFingertip',V(finger.width*.93,.27,.39),C(a+V(0,.04,0)),ivory,Enum.Material.Fabric)
 end
 local thumb={V(-.64,1.6,.03),V(-1.15,1.98,.02),V(-1.46,2.51,.025),V(-1.54,2.9,.03)}
 for i=1,3 do
  b:line('ThumbTailoredSegment'..i,thumb[i],thumb[i+1],.40,.44,ivory,Enum.Material.Fabric)
  b:ball('ThumbRoundedJoint'..i,V(.41,.36,.45),C(thumb[i+1]),silver,Enum.Material.Fabric)
  for j=0,2 do gem(b,'ThumbRhinestone'..i..'_'..j,thumb[i]:Lerp(thumb[i+1],.2+j*.3)+V(0,0,-.25),.11,ivory);gems=gems+1 end
 end
 b:line('ThumbSeam',V(-.77,1.55,-.27),V(-1.2,2.09,-.24),.027,.02,cool,Enum.Material.Fabric)
 for row=0,5 do for col=0,4 do
  local x=(col-2)*.255+(row%2)*.04
  local y=1.14+row*.255
  if math.abs(x)&lt;.77 then gem(b,'PalmRhinestone'..row..'_'..col,V(x,y,-.403),.118,(row+col)%3==0 and cool or ivory);gems=gems+1 end
 end end
 for _,side in ipairs({-1,1}) do
  b:line('PalmContourStitch'..side,V(side*.72,1.11,-.22),V(side*.82,2.47,-.20),.025,.025,cool,Enum.Material.Fabric)
 end
 for i=0,9 do gem(b,'CuffRhinestone'..i,V(-.59+i*.13,.7,-.36),.078,ivory);gems=gems+1 end
 for i,p in ipairs({V(-.35,2.2,-.455),V(.4,1.35,-.455),V(-.18,3.8,-.25)}) do
  b:line('StoneGlintVertical'..i,p-V(0,.115,0),p+V(0,.115,0),.024,.02,ivory,NEON)
  b:line('StoneGlintCross'..i,p-V(.09,0,0),p+V(.09,0,0),.024,.02,ivory,NEON)
 end
 b.model:SetAttribute('FingerCount',5)
 b.model:SetAttribute('RhinestoneCount',gems)
 b.model:SetAttribute('RecognizableFeature','Five-finger silver rhinestone performance glove')
 b.model:SetAttribute('Franchise','Michael Jackson')
end

local function frustumY(b,name,y0,y1,r0,r1,color,segments)
 segments=segments or 10
 for i=0,segments-1 do
  local a,c=i*2*PI/segments,(i+1)*2*PI/segments
  local p=V(math.cos(a)*r0,y0,math.sin(a)*r0)
  local q=V(math.cos(c)*r0,y0,math.sin(c)*r0)
  local r=V(math.cos(c)*r1,y1,math.sin(c)*r1)
  local s=V(math.cos(a)*r1,y1,math.sin(a)*r1)
  b:triangle(name..i..'A',p,q,r,color,.025,WOOD)
  b:triangle(name..i..'B',p,r,s,color,.025,WOOD)
 end
end
local function bat(b)
 local honey,grain,light=RGB(145,91,47),RGB(92,53,31),RGB(190,137,76)
 b:cylinder('TurnedAshBarrel',V(2.5,.98,.98),C(0,3.87,0)*A(0,0,PI/2),honey,WOOD)
 b:ball('RoundedWoodBarrelCap',V(.98,.52,.98),C(0,5.12,0),honey,WOOD)
 frustumY(b,'TaperedWoodShoulder',1.65,2.64,.19,.49,honey,10)
 b:cylinder('LongWoodHandle',V(1.40,.38,.38),C(0,1.03,0)*A(0,0,PI/2),light,WOOD)
 b:cylinder('TurnedBatKnob',V(.16,.62,.62),C(0,.28,0)*A(0,0,PI/2),honey,WOOD)
 b:ball('SmoothKnobEdge',V(.62,.13,.62),C(0,.21,0),honey,WOOD)
 for i=0,11 do
  local y=.49+i*.083
  b:cylinder('DarkLeatherGripBand'..i,V(.07,.405,.405),C(0,y,0)*A(0,0,PI/2),RGB(51,40,34),Enum.Material.Fabric)
  b:line('DiagonalGripSeam'..i,V(-.15,y-.02,-.15),V(.15,y+.065,-.15),.025,.023,RGB(114,84,57),Enum.Material.Fabric)
 end
 for i=0,15 do
  local angle=i*2*PI/16
  local x,z=math.sin(angle)*.493,math.cos(angle)*.493
  local offset=(i%3)*.10
  b:line('BarrelWoodGrain'..i,V(x,2.82+offset,z),V(x*.97,4.87-offset,z*.97),.017+(i%2)*.009,.017,i%2==0 and grain or light,WOOD)
 end
 b:ring('TopEndGrainOuter',C(0,5.365,0)*A(PI/2,0,0),.27,.018,grain,12,WOOD)
 b:ring('TopEndGrainInner',C(.025,5.372,0)*A(PI/2,0,0),.14,.014,light,10,WOOD)
 b:box('TungsBrandInset',V(.79,.47,.028),C(0,4.21,-.493),RGB(113,65,34),WOOD)
 lettering(b,'TungsBarrelBrand','TUNGS',C(0,4.21,-.519),.16,RGB(235,189,116),.020)
 for i=0,3 do
  local x=-.3+i*.2
  b:line('WornBarrelScuff'..i,V(x,3.01+i*.10,-.495),V(x+.08,3.20+i*.1,-.492),.015,.014,RGB(203,157,94),WOOD)
 end
 b.model:SetAttribute('RealTaperedShoulder',true)
 b.model:SetAttribute('WrappedGripBands',12)
 b.model:SetAttribute('NativeRaisedName','TUNGS')
 b.model:SetAttribute('RecognizableFeature','Rounded wooden bat with tapered shoulder and worn wrapped grip')
 b.model:SetAttribute('Franchise','Tung Tung Tung Sahur')
end

local function roundedCard(b,name,frame,width,height,depth,radius,color,material)
 b:box(name..'HorizontalCore',V(width,height-2*radius,depth),frame,color,material)
 b:box(name..'VerticalCore',V(width-2*radius,height,depth),frame,color,material)
 for _,x in ipairs({-1,1}) do for _,y in ipairs({-1,1}) do
  disc(b,name..'RoundCorner'..x..y,frame*C(x*(width/2-radius),y*(height/2-radius),0),radius*2,depth,color,material)
 end end
end
local function creditCard(b)
 local body=RGB(26,25,43)
 roundedCard(b,'PlatinumCardBody',C(0,1.65,0),4.6,2.88,.16,.19,silver,METAL)
 roundedCard(b,'BlackCeramicCardFace',C(0,1.65,-.096),4.42,2.70,.035,.16,body,METAL)
 roundedCard(b,'BlackCeramicCardBack',C(0,1.65,.096),4.42,2.70,.035,.16,RGB(37,36,49),METAL)
 for _,side in ipairs({-1,1}) do
  b:box('EngravedGoldTopBottom'..side,V(3.90,.025,.025),C(0,1.65+side*1.275,-.124),paleGold,METAL)
  b:box('EngravedGoldSide'..side,V(.025,2.14,.025),C(side*2.11,1.65,-.124),gold,METAL)
 end
 lettering(b,'MomsCardEmbossedTitle','MOMS',C(-.36,2.58,-.151),.36,paleGold,.041)
 -- A fictional icon replaces card numbers, expiry dates and payment-network marks.
 b:box('GoldMicrochipBody',V(.91,.67,.045),C(-1.34,1.78,-.14),gold,METAL)
 b:box('MicrochipCenter',V(.37,.45,.015),C(-1.34,1.78,-.173),RGB(208,150,47),METAL)
 for side=-1,1,2 do
  for row=-1,1 do
   b:box('ContactPad'..side..'_'..row,V(.20,.13,.024),C(-1.34+side*.31,1.78+row*.195,-.178),paleGold,METAL)
  end
  b:box('ContactSplit'..side,V(.018,.56,.012),C(-1.34+side*.20,1.78,-.197),bronze,METAL)
 end
 for row=-1,1,2 do b:box('MicrochipRowSplit'..row,V(.86,.018,.012),C(-1.34,1.78+row*.10,-.195),bronze,METAL) end
 for wave=1,3 do
  local radius=.18+wave*.105
  for i=0,5 do
   local a=-PI/3+i*PI/9;local z=-PI/3+(i+1)*PI/9
   b:line('ContactlessArc'..wave..'_'..i,V(-.45+math.cos(a)*radius,1.78+math.sin(a)*radius,-.158),V(-.45+math.cos(z)*radius,1.78+math.sin(z)*radius,-.158),.025,.02,silver,METAL)
  end
 end
 local center=V(1.22,1.72,-.156)
 for i=0,7 do
  local a=i*PI/4
  local c=RGB(112+(i%3)*46,128+(i%4)*28,209+(i%2)*28)
  b:triangle('EtherealHologramFacet'..i,center+V(0,.57,0),center+V(math.cos(a)*.48,-.35,math.sin(a)*.07),center+V(math.cos(a+PI/4)*.48,-.35,math.sin(a+PI/4)*.07),c,.025,METAL)
 end
 for i=0,7 do
  local a=i*PI/4
  b:line('HologramSecurityRay'..i,center+V(math.cos(a)*.65,math.sin(a)*.65,0),center+V(math.cos(a)*.83,math.sin(a)*.83,0),.022,.018,paleGold,METAL)
 end
 -- Four embossed decorative dashes are explicitly not a real account number.
 for group=0,3 do
  for mark=0,2 do
   local x=-1.75+group*.88+mark*.18
   b:box('FictionalSecurityDash'..group..'_'..mark,V(.115,.043,.025),C(x,.77,-.152),silver,METAL)
  end
 end
 b:box('RearMagneticStripe',V(4.2,.47,.023),C(0,2.19,.126),RGB(8,10,18),PLASTIC)
 b:box('RearSignaturePanel',V(2.6,.41,.02),C(-.5,1.47,.127),RGB(193,192,208),PLASTIC)
 for i=0,6 do b:line('SignatureDecorativeWave'..i,V(-1.5+i*.25,1.46+.08*math.sin(i),.145),V(-1.25+i*.25,1.46+.08*math.sin(i+1),.145),.022,.016,RGB(57,59,84),METAL) end
 for i=0,7 do
  b:box('RearMicroprint'..i,V(.23+(i%3)*.06,.025,.014),C(-1.6+i*.45,.88,.143),silver,METAL)
 end
 b.model:SetAttribute('FictionalCard',true)
 b.model:SetAttribute('NoPersonalPaymentData',true)
 b.model:SetAttribute('RoundedMetalCard',true)
 b.model:SetAttribute('RaisedMomsLettering',true)
 b.model:SetAttribute('ContactlessArcCount',3)
 b.model:SetAttribute('RecognizableFeature','Black platinum credit card with gold chip and ethereal hologram')
end

local function ring(b)
 local ringCenter=V(0,2.67,0)
 local radius=1.55
 for i=0,23 do
  local a,c=i*2*PI/24,(i+1)*2*PI/24
  local p,q=ringCenter+V(math.cos(a)*radius,math.sin(a)*radius,0),ringCenter+V(math.cos(c)*radius,math.sin(c)*radius,0)
  local tangent=(q-p).Unit;local radial=V(math.cos((a+c)*.5),math.sin((a+c)*.5),0)
  local cf=CFrame.fromMatrix((p+q)*.5,tangent,radial,tangent:Cross(radial))
  local part=b:cylinder('RoundedGoldenRingSegment'..i,V((q-p).Magnitude+.015,.45,.45),cf,i%4==0 and paleGold or gold,METAL)
  part.Reflectance=.12
  b:ball('RoundedRingJoint'..i,.44,C(p),gold,METAL)
 end
 for _,side in ipairs({-1,1}) do
  b:ring('PolishedRingBevel'..side,C(ringCenter+V(0,0,side*.177)),radius,.067,paleGold,24,METAL)
 end
 -- A compact blue-and-gold energy base supports the open ring without filling it.
 b:box('BlueSpeedPlinth',V(2.38,.20,1.44),C(0,.34,.12),blue,METAL)
 b:box('GoldPlinthInset',V(2.13,.045,1.20),C(0,.462,.12),gold,METAL)
 b:box('LowSonicBlueSupport',V(.31,.53,.30),C(0,.72,.10),blue,METAL)
 b:ball('RingCradle',V(.62,.28,.44),C(0,.99,.04),paleGold,METAL)
 for _,side in ipairs({-1,1}) do
  for i=0,2 do
   local y=.68+i*.16
   b:line('BlueSpeedTrail'..side..'_'..i,V(side*.75,y,.35),V(side*(1.25+i*.24),y+.23,.5),.065,.07,cyan,NEON)
  end
 end
 for i=0,7 do
  local a=i*PI/4
  local p=ringCenter+V(math.cos(a)*1.56,math.sin(a)*1.56,-.245)
  b:box('RingInsetHighlight'..i,V(.13,.038,.025),C(p)*A(0,0,a+PI/2),ivory,METAL)
 end
 for i,p in ipairs({V(-1.12,3.76,-.30),V(1.4,2.1,-.3)}) do
  b:line('RingSparkleLong'..i,p-V(0,.16,0),p+V(0,.16,0),.032,.02,paleGold,NEON)
  b:line('RingSparkleShort'..i,p-V(.12,0,0),p+V(.12,0,0),.032,.02,paleGold,NEON)
 end
 b.model:SetAttribute('TrueOpenRing',true)
 b.model:SetAttribute('RoundedRingSegments',24)
 b.model:SetAttribute('RecognizableFeature','Open golden ring with polished rounded tube and Sonic blue cradle')
 b.model:SetAttribute('Franchise','Sonic the Hedgehog')
end

local function star(b,name,center,radius,depth,color)
 local vertices={}
 for i=0,9 do
  local a=PI/2+i*PI/5;local r=i%2==0 and radius or radius*.43
  vertices[#vertices+1]=center+V(math.cos(a)*r,math.sin(a)*r,0)
 end
 for i=1,10 do
  b:triangle(name..i,center+V(0,0,-depth),vertices[i],vertices[i%10+1],color,.025,METAL)
 end
end
local function shield(b)
 local center=V(0,2.43,0)
 disc(b,'ConvexShieldBacking',C(center),4.62,.34,RGB(142,27,39))
 disc(b,'BrushedMetalOuterRim',C(center+V(0,0,-.17)),4.65,.11,silver)
 disc(b,'OuterRedShieldFace',C(center+V(0,0,-.24)),4.48,.10,red)
 disc(b,'SilverConcentricBand',C(center+V(0,0,-.31)),3.62,.10,silver)
 disc(b,'InnerRedConcentricBand',C(center+V(0,0,-.38)),2.87,.10,red)
 disc(b,'BlueStarMedallion',C(center+V(0,0,-.45)),2.09,.10,blue)
 star(b,'RaisedFivePointStar',center+V(0,0,-.69),.90,0,ivory)
 b:ring('MachinedOuterRimLine',C(center+V(0,0,-.238)),2.28,.036,RGB(235,241,247),32,METAL)
 b:ring('OuterBandFineSeam',C(center+V(0,0,-.30)),1.83,.026,RGB(126,35,47),24,METAL)
 for i=0,15 do
  local a=i*2*PI/16
  b:line('RadialBrushedMetalDetail'..i,center+V(math.cos(a)*1.64,math.sin(a)*1.64,-.366),center+V(math.cos(a+.016)*1.73,math.sin(a+.016)*1.73,-.367),.013,.012,RGB(173,191,210),METAL)
 end
 for i=0,5 do
  local a=.35+i*.93
  b:line('ShieldPaintWear'..i,center+V(math.cos(a)*2.02,math.sin(a)*2.02,-.302),center+V(math.cos(a+.04)*2.08,math.sin(a+.04)*2.08,-.303),.024,.016,RGB(221,211,204),METAL)
 end
 -- Two raised rear leather loops are hollow and visibly stand off the shell.
 disc(b,'RearArmorInset',C(center+V(0,0,.19)),3.95,.08,RGB(91,109,128))
 local leather=RGB(92,56,33)
 for _,side in ipairs({-1,1}) do
  local x=side*.79
  b:line('LeatherStrapUpper'..side,V(x,2.98,.28),V(x,2.89,.68),.24,.20,leather,Enum.Material.Fabric)
  b:line('LeatherStrapMiddle'..side,V(x,2.89,.68),V(x,1.98,.68),.24,.20,leather,Enum.Material.Fabric)
  b:line('LeatherStrapLower'..side,V(x,1.98,.68),V(x,1.89,.28),.24,.20,leather,Enum.Material.Fabric)
  for _,y in ipairs({1.89,2.98}) do
   b:box('StrapMount'..side..y,V(.45,.27,.09),C(x,y,.29),dark,METAL)
   for _,screw in ipairs({-.13,.13}) do disc(b,'RearStrapRivet'..side..y..screw,C(x+screw,y,.35),.075,.035,silver) end
  end
  b:box('StrapBuckle'..side,V(.35,.20,.07),C(x,2.5,.81),silver,METAL)
 end
 b.model:SetAttribute('ConcentricShieldBands',4)
 b.model:SetAttribute('StarPointCount',5)
 b.model:SetAttribute('RearOpenStrapCount',2)
 b.model:SetAttribute('RecognizableFeature','Convex red white blue concentric shield with raised five-point star')
 b.model:SetAttribute('Franchise','Captain America')
end

local builders={michael_jackson_glove=glove,tungs_bat=bat,moms_credit_card=creditCard,sonic_gold_ring=ring,captain_america_shield=shield}
function M.build(b,key)
 local builder=builders[key]
 if not builder then return false end
 builder(b)
 b.model:SetAttribute('ArtVersion',75)
 b.model:SetAttribute('ArtSource','NativeRobloxParts')
 return true
end
return M
</ProtectedString></Properties></Item></Item>
