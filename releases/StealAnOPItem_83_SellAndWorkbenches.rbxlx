 local d=Powers.ById[key];local origin=r.Position
 if d.dash then
  rt.impulseUntil=os.clock()+.8;r.AssemblyLinearVelocity=direction*40+Vector3.new(0,5,0)
  self.ctx.fx:FireAllClients('dash',origin,1,d.name);self.ctx.refresh();return
 end
 if d.target=='self' then rt.shield=os.clock()+d.duration;self.ctx.fx:FireAllClients('shield',origin,1,d.name);self.ctx.refresh();return end
 local center=d.target=='field' and origin+direction*d.range*.65 or origin
 local color=Color3.fromRGB(table.unpack(d.warningColor))
 self.ctx.fx:FireAllClients(key,center,math.max(2,d.radius&gt;0 and d.radius or d.range),d.name,d.windup,color)
