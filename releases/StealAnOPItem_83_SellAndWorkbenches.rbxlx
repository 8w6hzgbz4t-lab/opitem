 o=c:setOffer('pending','item17',200);assert(c:purchaseAttempt(2,'pending',o.token,200));c:advance(202)
 local piece=c.players[1].slots[2];assert(c:beginSteal(3,piece,203));assert(c:claimExodia(1,reward,'respawn',204))
