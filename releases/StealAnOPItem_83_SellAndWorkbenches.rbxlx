   if not r or not o or (r.Position-Vector3.new(o.x,2.5,0)).Magnitude&gt;Rules.AuctionRange or not self.ctx.los(r.Position,Vector3.new(o.x,2.5,0)) or not self.ctx.movementSafe(rt.player) or now&lt;(rt.interruptedUntil or 0) then self.core:withdraw(id,now) end
  end
