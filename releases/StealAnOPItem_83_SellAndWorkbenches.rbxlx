			<Item class="ModuleScript" referent="RBX8859bc0bd6e34e7d9017af3d601c7288">
				<Properties>
					<Content name="LinkedSource"><null /></Content>
					<ProtectedString name="Source">-- Reusable pure session tests. Does not touch live game state or Instances.
return function(package)
 local temp=package
 local results={}
 local C=require(temp.Catalog);local config=require(temp.Config);local Core=require(temp.Core);local Powers=require(temp.PowerCatalog)
 local function fresh(n)
  local c=Core.new(C,config);for id=1,n do c:addPlayer(id,0);c.players[id].cash=10000000 end;return c
 end
 local function invariants(c)
  for id,p in pairs(c.players) do
   assert(p.capacity==8 and p.cash&gt;=0 and p.held&gt;=0 and p.cash+p.held&lt;=2000000000)
   local count=0;for slot in pairs(p.slots) do assert(slot&gt;=1 and slot&lt;=8);count+=1 end;assert(count&lt;=8)
   local held=0;for _,tx in pairs(c.transactions) do if tx.player==id and not tx.resolved then held+=tx.amount;assert(p.slots[tx.slot]=='@'..tx.id) end end
   assert(held==p.held,'Escrow invariant')
   if p.carry then local it=c.items[p.carry];assert(it and it.carrier==id and c.transactions[it.tx].status=='Carrying') end
  end
  for uid,it in pairs(c.items) do if it.state=='Stored' then assert(c.players[it.owner].slots[it.slot]==uid) end end
 end
 local c=fresh(2);local o=c:setOffer('a','item01',100,55);local uid=o.uid;local token=o.token
 assert(c:purchaseAttempt(1,'a',token,100));assert(c.players[1].held==100 and c.players[1].cash==9999900)
 assert(c:income(1)==3 and c.items[uid].owner==nil);invariants(c)
 c:advance(101.6);assert(c.players[1].carry==uid and c.items[uid].state=='PurchaseCarry')
 assert(not c:power(1,102,'tag'));assert(c:finish(1,true,102));assert(c.items[uid].owner==1 and c:income(1)==6)
 assert(c.players[1].held==0 and not c:finish(1,true,103));invariants(c)
 results.delivery='Purchase escrow, delayed ownership/income, overhead carry state, successful commit, duplicate completion rejection passed'
 c=fresh(2);o=c:setOffer('a','item17',100,55);token=o.token;uid=o.uid
 assert(c:purchaseAttempt(1,'a',token,100));c:advance(101.6);assert(c:finish(1,false,103))
 assert(o.x==55 and o.expires&gt;103 and o.token~=token and c.items[uid].state=='Conveyor')
 assert(c.players[1].cash==10000000-C.ById.item17.price and c.players[1].held==0 and c:free(1)==2)
 assert(not c:finish(1,false,104));assert(not c:purchaseAttempt(1,'a',token,104));invariants(c)
 assert(c:purchaseAttempt(1,'a',o.token,104));c:advance(106);c.now=107;c:removePlayer(1)
 assert(c.offers.a and c.items[uid].state=='Conveyor');invariants(c)
 results.refunds='Paid carries lost to interruption or disconnect forfeit their purchase price once, retain item UID, restore recorded X, refresh expiry/token and reject stale/replayed actions'
 c=fresh(3);o=c:setOffer('a','item01',100)
 assert(c:purchaseAttempt(1,'a',o.token,100));assert(c:purchaseAttempt(2,'a',o.token,100.5));c:advance(101.6)
 assert(o.state=='Auction' and o.hardEnd==113.5)
 assert(not c:bid(1,'a',0/0,102));assert(not c:bid(1,'a',math.huge,102));assert(not c:bid(1,'a',-1,102))
 assert(c:bid(1,'a',125,102));assert(not c:bid(2,'a',149,102));assert(c:bid(2,'a',175,102.1))
 for i=1,7 do c:grant(3,'item01') end
 assert(not c:bid(3,'a',200,103));assert(c:withdraw(2,103));assert(c.players[2].cash==10000000)
 c:advance(110);assert(c.players[1].carry==o.uid);assert(c:finish(1,true,111))
 assert(c.players[1].cash==10000000-125 and c.players[1].held==0);invariants(c)
 local tie=fresh(2);o=tie:setOffer('t','item01',100);tie:purchaseAttempt(2,'t',o.token,100);tie:purchaseAttempt(1,'t',o.token,100);tie:advance(101.6);tie:advance(110)
 assert(tie.players[2].carry==o.uid and tie.players[1].held==0);invariants(tie)
 local stalled=fresh(2);o=stalled:setOffer('t','item01',100);stalled:purchaseAttempt(1,'t',o.token,100);stalled:purchaseAttempt(2,'t',o.token,100);stalled:advance(1000)
 assert(o.state=='InTransit' and o.hardEnd==113.5);invariants(stalled)
 results.auctions='Simultaneous completion, deterministic ties, invalid/insufficient bids, incremental escrow, full-base rejection, withdrawal, losing refunds, one winner and fixed deadlines after stalls passed'
 c=fresh(2);uid=c.players[1].slots[1]
 for i=1,6 do c:grant(2,'item01') end
 assert(c:beginSteal(2,uid,100));assert(c:income(1)==0 and c.items[uid].owner==1 and c:free(2)==nil)
 assert(c:grant(2,'item17')==nil);assert(not c:power(2,101,'tag'));invariants(c)
 assert(c:finish(2,false,102));assert(c:income(1)==3 and c:free(2)==8)
 assert(c:beginSteal(2,uid,103));assert(c:finish(2,true,104));assert(c.items[uid].owner==2 and c.players[2].steals==1)
 assert(not c:finish(2,true,104));invariants(c)
 results.theft='Income pause, original ownership until deposit, reserved eighth slot, recovery and single transfer passed'
 c=fresh(1);assert(c:chooseStarter(1,'dash'));assert(not c:chooseStarter(1,'dash'))
 assert(c.players[1].loadout[1]=='tag' and not c:loadPower(1,'dash',1))
 assert(c:shopPower(1,'lightning'));assert(c:loadPower(1,'lightning',2));assert(c:power(1,100,'lightning'));assert(not c:power(1,101,'lightning'));assert(c:power(1,129,'lightning'))
 assert(c:unlockPowerSlot(1) and c.players[1].capacity==8);assert(not c:loadPower(1,'tag',3))
 local ranks={};for _,d in ipairs(Powers.Items) do ranks[d.rank]=true end;for i=1,5 do assert(ranks[i]) end
 results.powers='Free starter once, permanent Tag, five ranks, loadout/price validation, third slot without capacity increase and cooldown enforcement passed'
 local function deposit(c,id,kind,t)
  local key='ex'..c.seq;local offer=c:setOffer(key,kind,t);assert(c:purchaseAttempt(id,key,offer.token,t));c:advance(t+1.6);assert(c:finish(id,true,t+2));return offer.uid
 end
 c=fresh(3);local ids={};for i,kind in ipairs({'item25','item26','item27','item28','item29'}) do ids[i]=deposit(c,1,kind,100+i*5) end
 local reward=c.players[1].pendingReward;assert(reward);c:checkExodia(1,200);assert(c.players[1].pendingReward==reward)
 assert(c:claimExodia(1,reward,'level',200));assert(c.players[1].progression==1 and c.players[1].capacity==8);assert(not c:claimExodia(1,reward,'level',201))
 c:checkExodia(1,1000);assert(not c.players[1].pendingReward)
 for i,uid2 in ipairs(ids) do assert(c:beginSteal(2,uid2,1000+i*3));assert(c:finish(2,true,1001+i*3)) end
 assert(not c.players[2].pendingReward);invariants(c)
 c=fresh(3);c:chooseStarter(1,'dash');for i,kind in ipairs({'item25','item26','item27','item28','item29'}) do deposit(c,1,kind,100+i*5) end
 reward=c.players[1].pendingReward
 o=c:setOffer('pending','item17',200);assert(c:purchaseAttempt(2,'pending',o.token,200));c:advance(202)
 local piece=c.players[1].slots[2];assert(c:beginSteal(3,piece,203));assert(c:claimExodia(1,reward,'respawn',204))
 assert(not c.players[2].carry and not c.players[3].carry and c.players[2].cash==10000000)
 assert(c.items[piece].owner==1 and c.items[piece].state=='Stored' and c.players[1].loadout[2]=='dash')
 assert(c.players[1].capacity==8 and c.players[1].powerOwned.dash);invariants(c)
 results.exodia='Distinct deposited pieces, one reward, retained collection/levels, repeated trigger and transfer farming prevention, safe-respawn refund/recovery and power preservation passed'

 results.regressions=require(package.RegressionTests)(package)
 return results
end


</ProtectedString>
					<string name="ScriptGuid">{e23b2509-448c-459b-90d4-d872373f3146}</string>
					<BinaryString name="AttributesSerialize" />
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Tests</string>
					<BinaryString name="SerializedOverrides" />
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">6d213ac4850387320ae147d10000b542</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX19a4050dbadf4028b9a885360a4baaae">
				<Properties>
					<Content name="LinkedSource"><null /></Content>
					<ProtectedString name="Source">-- Shared server presentation for every live collectible state. No ownership logic.
local P={}
function P.update(model,label,definition,catalog)
 local gui=label.Parent
 local rarity=gui:FindFirstChild('ItemRarity')
 if not rarity then
  -- Pixel-sized billboards stay compact when the camera approaches an item.
  gui.Name='ItemNameplate';gui.Size=UDim2.fromOffset(176,62);gui.MaxDistance=75
  -- Depth-tested labels avoid revealing collectibles through solid base walls.
  gui.AlwaysOnTop=false
  label.Position=UDim2.fromOffset(0,18);label.Size=UDim2.new(1,0,1,-18)
  label.TextSize=12;label.TextScaled=false;label.TextWrapped=true
  rarity=Instance.new('TextLabel');rarity.Name='ItemRarity'
  rarity.Size=UDim2.new(1,0,0,18);rarity.BackgroundColor3=Color3.fromRGB(12,16,29)
  rarity.BackgroundTransparency=.12;rarity.Font=Enum.Font.GothamBold;rarity.TextSize=12;rarity.TextScaled=false
  rarity.TextStrokeTransparency=.6;rarity.Parent=gui
  local corner=Instance.new('UICorner');corner.CornerRadius=UDim.new(0,8);corner.Parent=rarity
 end
 rarity.Text=string.upper(definition.rarity)
 local color=catalog.Colors[definition.tier];rarity.TextColor3=Color3.fromRGB(color[1],color[2],color[3])
 model:SetAttribute('Rarity',definition.rarity);model:SetAttribute('CatalogId',definition.id)
 -- A collectible's geometry is static in every state. Cache the height once
 -- instead of recalculating hundreds of parts on each server heartbeat.
 local height=model:GetAttribute('LabelHeightOffset')
 if not height then
  local cf,size=model:GetBoundingBox();local root=model.PrimaryPart
  if root then
   height=math.max(1.5,cf.Position.Y+size.Y/2-root.Position.Y+.8)
   model:SetAttribute('LabelHeightOffset',height)
  end
 end
 if height then gui.StudsOffset=Vector3.new(0,height,0) end
end
return P

</ProtectedString>
					<string name="ScriptGuid">{e5753861-30db-4d53-b740-6365ab0fb2d1}</string>
					<BinaryString name="AttributesSerialize" />
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">ItemPresentation</string>
					<BinaryString name="SerializedOverrides" />
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">0de57ab99e056af40ae15b5f00001597</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXd6b80ac6e74344118c37064116b1f16c">
				<Properties>
					<Content name="LinkedSource"><null /></Content>
					<ProtectedString name="Source">local MillenniumPuzzle = {}

local GOLD = Color3.fromRGB(213, 157, 45)
local LIGHT_GOLD = Color3.fromRGB(248, 208, 106)
local EDGE_GOLD = Color3.fromRGB(179, 117, 30)
local SEAM = Color3.fromRGB(87, 51, 15)
local EYE_DARK = Color3.fromRGB(42, 27, 11)
local METAL = Enum.Material.Metal

function MillenniumPuzzle.create(parent, options)
    options = options or {}
    local scale = options.scale or 1
    assert(type(scale) == "number" and scale &gt; 0 and scale &lt; math.huge,
        "MillenniumPuzzle scale must be a finite positive number")
    local model = Instance.new("Model")
    model.Name = options.name or "MillenniumPuzzle"
    model:SetAttribute("Kind", options.itemId or "millennium_puzzle")
    model:SetAttribute("ItemId", options.itemId or "millennium_puzzle")
    model:SetAttribute("Procedural", true)
    model:SetAttribute("AnimatedCharacter", false)
    model:SetAttribute("Scale", scale)
    local partCount = 0
    local function vec(x, y, z)
        return Vector3.new(x, y, z) * scale
    end
    local function part(name, size, frame, color, shape)
        local object = Instance.new("Part")
        object.Name = name
        object.Size = size
        object.CFrame = frame
        object.Color = color or GOLD
        object.Material = METAL
        object.Shape = shape or Enum.PartType.Block
        object.Anchored = true
        object.CanCollide = false
        object.CanTouch = false
        object.CanQuery = false
        object.TopSurface = Enum.SurfaceType.Smooth
        object.BottomSurface = Enum.SurfaceType.Smooth
        object.Parent = model
        partCount = partCount + 1
        return object
    end
    local function line(name, a, b, thickness, depth, color)
        local delta = b - a
        if delta.Magnitude &lt; 0.000001 then return nil end
        local up = delta.Unit
        local reference = Vector3.new(0, 0, 1)
        if math.abs(up:Dot(reference)) &gt; 0.95 then
            reference = Vector3.new(1, 0, 0)
        end
        local right = up:Cross(reference).Unit
        local back = right:Cross(up).Unit
        return part(name,
            Vector3.new(thickness * scale, delta.Magnitude, depth * scale),
            CFrame.fromMatrix((a + b) * 0.5, right, up, back), color)
    end
    local root = part("Root", vec(0.12, 0.12, 0.12), CFrame.new(), GOLD)
    root.Transparency = 1
    model.PrimaryPart = root
    local width = 3.1
    local height = 3.3
    local topY = 1.0
    local bottomY = topY - height
    local layerCount = 24
    local step = height / layerCount
    for index = 1, layerCount do
        local t = (index - 0.5) / layerCount
        local layerWidth = width * t
        local y = bottomY + step * (index - 0.5)
        part(string.format("GoldCourse_%02d", index),
            vec(layerWidth, step + 0.002, layerWidth),
            CFrame.new(vec(0, y, 0)), GOLD)
    end
    part("BottomFinial", vec(0.074, 0.16, 0.074),
        CFrame.new(vec(0, bottomY + 0.008, 0)), LIGHT_GOLD, Enum.PartType.Ball)
    part("TopPlate", vec(width + 0.04, 0.12, width + 0.04),
        CFrame.new(vec(0, topY, 0)), EDGE_GOLD)
    part("TopInset", vec(width - 0.24, 0.038, width - 0.24),
        CFrame.new(vec(0, topY + 0.079, 0)), GOLD)
    local half = width * 0.5
    for index = 1, 4 do
        local angle = (index - 1) * math.pi * 0.5
        local frame = CFrame.new(vec(0, topY + 0.092, 0))
            * CFrame.Angles(0, angle, 0)
            * CFrame.new(vec(0, 0, -half + 0.06))
        part("TopRim_" .. index, vec(width - 0.08, 0.07, 0.075), frame, LIGHT_GOLD)
    end
    for _, xSign in ipairs({ -1, 1 }) do
        for _, zSign in ipairs({ -1, 1 }) do
            local suffix = tostring(xSign) .. "_" .. tostring(zSign)
            line("CornerBinding_" .. suffix,
                vec(0, bottomY + 0.02, 0), vec(xSign * half, topY, zSign * half),
                0.052, 0.052, EDGE_GOLD)
            part("CornerStud_" .. suffix, vec(0.14, 0.075, 0.14),
                CFrame.new(vec(xSign * (half - 0.12), topY + 0.11,
                    zSign * (half - 0.12))), LIGHT_GOLD, Enum.PartType.Ball)
        end
    end
    local function facePoint(x, y, outward)
        local side = math.max(0.025, half * ((y - bottomY) / height))
        return vec(x, y, -side - (outward or 0.04))
    end
    local seamRows = { -1.65, -1.08, -0.51, 0.06, 0.63 }
    for face = 0, 3 do
        local rotation = CFrame.Angles(0, face * math.pi * 0.5, 0)
        for row, y in ipairs(seamRows) do
            local side = half * ((y - bottomY) / height)
            local a = rotation * facePoint(-side + 0.035, y, 0.028)
            local b = rotation * facePoint(side - 0.035, y, 0.028)
            line("PanelRow_" .. face .. "_" .. row, a, b, 0.021, 0.015, SEAM)
        end
        for index = 1, 4 do
            local lowerY = seamRows[index] + 0.035
            local upperY = seamRows[index + 1] - 0.035
            local lowerHalf = half * ((lowerY - bottomY) / height)
            local upperHalf = half * ((upperY - bottomY) / height)
            local fraction = index % 2 == 0 and -0.34 or 0.34
            line("PanelJoin_" .. face .. "_" .. index,
                rotation * facePoint(lowerHalf * fraction, lowerY, 0.033),
                rotation * facePoint(upperHalf * fraction, upperY, 0.033),
                0.021, 0.015, SEAM)
        end
    end
    local eyeY = -0.11
    local eyeHalfWidth = 0.77
    local function eyePoint(x, y, offset)
        return facePoint(x, eyeY + y, offset or 0.082)
    end
    local function eyeStroke(name, points, color, thickness)
        for index = 1, #points - 1 do
            local a = points[index]
            local b = points[index + 1]
            line(name .. "_" .. index, eyePoint(a[1], a[2]),
                eyePoint(b[1], b[2]), thickness or 0.06, 0.048, color)
        end
    end
    local upper = {}
    local lower = {}
    for index = 0, 8 do
        local t = index / 8
        local x = -eyeHalfWidth + 2 * eyeHalfWidth * t
        upper[#upper + 1] = { x, 0.21 * math.sin(math.pi * t) }
        lower[#lower + 1] = { x, -0.19 * math.sin(math.pi * t) }
    end
    eyeStroke("EyeUpper", upper, LIGHT_GOLD, 0.075)
    eyeStroke("EyeLower", lower, LIGHT_GOLD, 0.075)
    eyeStroke("EyeBrow", {
        { -0.82, 0.22 }, { -0.60, 0.33 }, { -0.29, 0.40 },
        { 0.04, 0.43 }, { 0.38, 0.37 }, { 0.68, 0.25 }, { 0.91, 0.22 },
    }, LIGHT_GOLD, 0.075)
    eyeStroke("EyeTail", {
        { 0.76, 0.0 }, { 0.95, 0.10 }, { 1.04, 0.20 },
    }, LIGHT_GOLD, 0.065)
    eyeStroke("EyeTear", {
        { 0.33, -0.16 }, { 0.38, -0.40 }, { 0.42, -0.66 }, { 0.50, -0.72 },
    }, LIGHT_GOLD, 0.070)
    eyeStroke("EyeCurl", {
        { -0.29, -0.17 }, { -0.29, -0.43 }, { -0.38, -0.57 },
        { -0.62, -0.64 }, { -0.74, -0.57 }, { -0.73, -0.45 },
        { -0.61, -0.40 }, { -0.52, -0.47 },
    }, LIGHT_GOLD, 0.062)
    local faceTilt = math.atan(half / height)
    part("EyeIris", vec(0.31, 0.37, 0.08),
        CFrame.new(eyePoint(0, 0, 0.095)) * CFrame.Angles(-faceTilt, 0, 0),
        EDGE_GOLD, Enum.PartType.Ball)
    part("EyePupil", vec(0.13, 0.30, 0.08),
        CFrame.new(eyePoint(0, 0, 0.137)) * CFrame.Angles(-faceTilt, 0, 0),
        EYE_DARK, Enum.PartType.Ball)
    local loopY = topY + 0.83
    local radiusX = 0.42
    local radiusY = 0.70
    local ringSegments = 24
    part("LoopMount", vec(0.44, 0.20, 0.32),
        CFrame.new(vec(0, topY + 0.16, 0)), EDGE_GOLD)
    for index = 0, ringSegments - 1 do
        local a = index / ringSegments * math.pi * 2
        local b = (index + 1) / ringSegments * math.pi * 2
        line("PendantLoop_" .. string.format("%02d", index + 1),
            vec(math.cos(a) * radiusX, loopY + math.sin(a) * radiusY, 0),
            vec(math.cos(b) * radiusX, loopY + math.sin(b) * radiusY, 0),
            0.10, 0.14, LIGHT_GOLD)
    end
    for _, object in ipairs(model:GetChildren()) do
        if object:IsA("BasePart") and object ~= root then
            object.CFrame = object.CFrame + vec(0, -bottomY + 0.09, 0)
        end
    end
    model:SetAttribute("PartCount", partCount)
    model:PivotTo(options.cframe or CFrame.new())
    model.Parent = parent
    return model
end
return MillenniumPuzzle

