						<ProtectedString name="Source">-- Complete local geometry. No uploaded meshes, external scripts, or asset dependencies.
local P=require(script.Parent.Primitives)
local N={}
local V,C,A=Vector3.new,CFrame.new,CFrame.Angles
local rgb=Color3.fromRGB
local gold,ivory,dark,blue=rgb(239,185,48),rgb(246,240,222),rgb(30,35,48),rgb(34,91,211)
local metal,plastic,neon=Enum.Material.Metal,Enum.Material.SmoothPlastic,Enum.Material.Neon
local stones={spaceStone=rgb(45,125,255),mindStone=rgb(255,221,62),realityStone=rgb(230,39,59),powerStone=rgb(163,65,241),timeStone=rgb(54,230,117),soulStone=rgb(255,135,36)}
local function box(b,n,x,y,z,sx,sy,sz,c,mat,rot) return b:box(n,V(sx,sy,sz),C(x,y,z)*(rot or C()),c,mat or metal) end
local function face(b,n,x,y,z,sx,sy,c) return b:ball(n,V(sx,sy,.12),C(x,y,z),c,plastic) end
local function star(b,n,cf,r,color,depth)
 local points={};for i=0,9 do local a=math.pi/2+i*math.pi/5;local q=i%2==0 and r or r*.43;points[i+1]=cf*V(math.cos(a)*q,math.sin(a)*q,0) end
 for i=1,10 do b:triangle(n..i,cf.Position,points[i],points[i%10+1],color,depth or .15,metal) end
end
local function gem(b,key)
 local col=stones[key];local ring={};local count=8
 for i=0,count-1 do local a=i*math.pi*2/count;ring[i+1]=V(math.cos(a)*1.02,1.2,math.sin(a)*.76) end
 for i=1,count do
  local j=i%count+1;local h,s,v=col:ToHSV();local c=Color3.fromHSV(h,s,.64+(i%3)*.12)
  b:triangle('CrownFacet'..i,V(.12,2.5,0),ring[i],ring[j],c,.025,Enum.Material.Glass)
  b:triangle('PavilionFacet'..i,V(-.08,0,0),ring[j],ring[i],c:Lerp(ivory,.09),.025,metal)
  b:line('FacetEdge'..i,ring[i],ring[j],.025,.025,col:Lerp(ivory,.5),metal)
 end
 local heart=b:ball('RestrainedGlow',V(.8,1.1,.65),C(0,1.25,0),col,neon);heart.Transparency=.28
 local light=Instance.new('PointLight');light.Color=col;light.Range=4;light.Brightness=.35;light.Shadows=false;light.Parent=heart
 b:line('PrismaticInclusion',V(-.3,.55,-.15),V(.3,1.85,.13),.045,.045,ivory,metal)
end
local function shell(b)
 -- Layered blue dome, thick white rim, radial ivory spikes, paired feathered wings.
 b:ball('BlueDome',V(3.1,2.1,2.75),C(0,1.28,0),blue,plastic)
 b:ball('PaleUnderside',V(2.75,.65,2.5),C(0,.52,0),rgb(236,216,158),plastic)
 b:ring('WhiteShellRim',C(0,.75,0)*A(math.pi/2,0,0),1.48,.22,ivory,28,plastic)
 for i=0,5 do local a=i*math.pi/3
  b:line('HexagonalSeam'..i,V(0,2.32,0),V(math.cos(a)*1.35,1.1,math.sin(a)*1.2),.065,.065,rgb(16,55,145),plastic)
  local pos=V(math.cos(a)*1.18,1.52,math.sin(a)*1.05);local tip=pos+V(math.cos(a)*.48,.65,math.sin(a)*.48)
  for j=0,3 do local q=j*math.pi/2;local q2=(j+1)*math.pi/2
   b:triangle('WhiteSpike'..i..'_'..j,tip,pos+V(math.cos(q)*.27,-.05,math.sin(q)*.27),pos+V(math.cos(q2)*.27,-.05,math.sin(q2)*.27),ivory,.035,plastic)
  end
 end
 for _,side in ipairs({-1,1}) do
  b:ball('WingShoulder'..side,V(.65,1,.65),C(side*1.5,1.5,.35),ivory,plastic)
  for f=1,6 do
   local start=V(side*(1.35+f*.12),1.45+f*.12,.3)
   local finish=V(side*(2.1+f*.15),2.1+(7-f)*.18,.4+(f-1)*.14)
   b:ball('WingFeather'..side..'_'..f,V(.28,(finish-start).Magnitude+.35,.25),C((start+finish)*.5)*A(0,0,-side*.9),ivory:Lerp(rgb(170,191,220),f*.025),plastic)
   b:line('FeatherQuill'..side..'_'..f,start,finish,.045,.045,rgb(202,215,229),plastic)
  end
 end
end
local function kirby(b)
 box(b,'PurpleHandle',0,.5,0,.32,1,.32,rgb(118,50,162),plastic)
 for y=.1,.9,.16 do box(b,'GripBand'..y,0,y,0,.36,.055,.36,gold) end
 box(b,'GoldCrossguard',0,1.1,0,1.6,.22,.48,gold)
 star(b,'StarGuard',C(0,1.15,-.28),.48,gold,.18)
 box(b,'SilverBlade',0,2.35,0,.58,2.25,.15,ivory)
 b:triangle('BladeTip',V(-.29,3.48,0),V(.29,3.48,0),V(0,4,0),ivory,.15,metal)
 b:line('BladeFuller',V(0,1.4,-.1),V(0,3.5,-.1),.045,.03,rgb(140,204,238),metal)
 b:ball('Pommel',.43,C(0,-.02,0),gold,metal)
end
local function spatula(b)
 box(b,'WoodenGrip',0,.45,0,.36,1.1,.3,rgb(137,72,27),Enum.Material.Wood)
 box(b,'GoldShaft',0,1.6,0,.15,1.4,.12,gold)
 b:ball('GripRivet',.1,C(0,.6,-.17),gold)
 box(b,'SpatulaNeck',0,2.35,0,.45,.35,.14,gold)
 for _,x in ipairs({-.65,.65}) do box(b,'OuterFrame'..x,x,2.95,0,.18,1.4,.16,gold) end
 for _,y in ipairs({2.28,3.62}) do box(b,'EndFrame'..y,0,y,0,1.45,.18,.16,gold) end
 for x=-.36,.37,.24 do box(b,'SlottedBlade'..x,x,2.95,0,.12,1.25,.16,gold) end
 b:ring('HandleHangingHole',C(0,-.15,0),.18,.05,gold,12,metal)
end
local function patty(b)
 local tan=rgb(220,151,65)
 b:ball('LowerBun',V(2.9,.55,2.7),C(0,.3,0),tan,plastic)
 b:ball('GrilledPatty',V(2.9,.45,2.7),C(0,.7,0),rgb(92,44,25),Enum.Material.Slate)
 for i=0,7 do local a=i*math.pi/4;b:ball('LettuceRuffle'..i,V(.9,.22,.8),C(math.cos(a)*1.1,.99,math.sin(a)*1.03),rgb(82,168,42),plastic) end
 box(b,'CheeseSlice',0,.9,0,2.6,.09,2.6,rgb(255,198,33),plastic,A(0,.23,0))
 b:ball('Tomato',V(2.55,.2,2.4),C(0,1.14,0),rgb(208,46,31),plastic)
 b:ball('Onion',V(2.4,.15,2.3),C(0,1.29,0),ivory,plastic)
 b:ball('UpperBun',V(3,1.05,2.85),C(0,1.62,0),tan:Lerp(ivory,.15),plastic)
 for i=1,20 do local a=i*2.399;local r=.2+(i%5)*.2;b:ball('SesameSeed'..i,V(.16,.055,.08),C(math.cos(a)*r,2.12-r*r*.16,math.sin(a)*r)*A(0,a,0),ivory,plastic) end
end
local function gary(b)
 b:ball('PinkShell',V(2.8,2.6,1.7),C(0,1.35,0),rgb(231,135,172),plastic)
 local prev
 for i=0,50 do local t=i/50*math.pi*4.2;local r=1.05*(1-i/58);local p=V(math.cos(t)*r,1.35+math.sin(t)*r,-.88)
  if prev then b:line('RedSpiral'..i,prev,p,.105,.06,rgb(161,37,72),plastic) end;prev=p
 end
 for i=0,7 do local a=i*math.pi/4;face(b,'BlueShellSpot'..i,math.cos(a)*1.1,1.35+math.sin(a)*1.05,-.9,.22,.25,rgb(67,119,195)) end
 b:ball('ShellOpening',V(.8,.7,.2),C(.9,.45,-.65),rgb(128,57,93),plastic)
 b:ring('OpeningLip',C(.9,.45,-.78),.4,.09,rgb(255,189,197),18,plastic)
end
local function superstar(b)
 star(b,'GoldStar',C(0,1.6,0),1.6,rgb(255,215,58),.4)
 star(b,'RaisedStarFace',C(0,1.6,-.23),1.38,rgb(255,230,89),.08)
 for _,side in ipairs({-1,1}) do face(b,'BlackEye'..side,side*.34,1.8,-.33,.17,.55,dark);face(b,'EyeGlint'..side,side*.34,1.94,-.4,.065,.12,ivory) end
end
local function flower(b)
 b:line('GreenStem',V(0,0,0),V(0,1.5,0),.26,.25,rgb(32,159,59),plastic)
 for _,side in ipairs({-1,1}) do b:ball('Leaf'..side,V(.95,.45,.22),C(side*.42,.55,0)*A(0,0,side*.45),rgb(49,189,65),plastic) end
 b:ball('OrangePetalRing',V(2.4,2.1,.6),C(0,2.2,0),rgb(251,114,29),plastic)
 for i=0,9 do local a=i*math.pi/5
  b:ball('LayeredPetal'..i,V(.65,.65,.28),C(math.cos(a)*.91,2.2+math.sin(a)*.77,-.3),i%2==0 and rgb(255,119,32) or rgb(241,88,24),plastic)
 end
 b:ball('YellowFlowerFace',V(1.8,1.5,.4),C(0,2.2,-.35),rgb(255,220,55),plastic)
 b:ball('WhiteFace',V(1.25,1.05,.25),C(0,2.22,-.58),ivory,plastic)
 for _,s in ipairs({-1,1}) do
  face(b,'Eye'..s,s*.22,2.25,-.73,.13,.4,dark)
  face(b,'EyeGlint'..s,s*.22,2.36,-.8,.045,.09,ivory)
  b:line('LeafVein'..s,V(s*.16,.47,-.13),V(s*.78,.64,-.13),.035,.035,rgb(24,117,46),plastic)
 end
end
local function shield(b)
 local pts={V(-1.25,3.6,0),V(1.25,3.6,0),V(1.45,1.7,0),V(0,0,0),V(-1.45,1.7,0)}
 for i=1,5 do b:triangle('SteelShield'..i,V(0,2,0),pts[i],pts[i%5+1],rgb(177,193,209),.3,metal);b:line('SilverRim'..i,pts[i]+V(0,0,-.18),pts[i%5+1]+V(0,0,-.18),.13,.1,ivory) end
 for i=1,5 do b:triangle('BlueEnamel'..i,V(0,2,-.2),V(pts[i].X*.85,pts[i].Y*.85+.25,-.2),V(pts[i%5+1].X*.85,pts[i%5+1].Y*.85+.25,-.2),blue,.05,metal) end
 b:triangle('TriforceTop',V(0,3.4,-.3),V(-.3,2.88,-.3),V(.3,2.88,-.3),gold,.045,metal)
 for _,s in ipairs({-1,1}) do b:triangle('TriforceBase'..s,V(s*.3,2.88,-.3),V(s*.3-.3,2.36,-.3),V(s*.3+.3,2.36,-.3),gold,.045,metal)
  b:triangle('RedWing'..s,V(0,1.75,-.32),V(s*1.02,2.3,-.32),V(s*.55,1,-.32),rgb(191,37,45),.06,metal)
  for j=1,3 do b:line('WingCrest'..s..j,V(s*.4,1.7-j*.12,-.34),V(s*(.65+j*.12),1.5-j*.2,-.34),.08,.045,rgb(215,44,52)) end
 end
 box(b,'LeatherBackStrap',0,1.8,.3,.8,.22,.2,rgb(107,59,35),Enum.Material.Fabric)
end
local function cube(b)
 local grey=rgb(149,155,168);box(b,'WeightedCubeCore',0,1.5,0,2.8,2.8,2.8,grey)
 for _,x in ipairs({-1,1}) do for _,y in ipairs({-1,1}) do for _,z in ipairs({-1,1}) do box(b,'CornerArmor'..x..y..z,x*1.23,1.5+y*1.23,z*1.23,.55,.55,.55,rgb(205,209,217)) end end end
 for side=0,3 do local cf=C(0,1.5,0)*A(0,side*math.pi/2,0)*C(0,0,-1.44)
  b:ring('PinkFaceRing'..side,cf,.83,.09,rgb(229,128,176),20,plastic)
  for _,s in ipairs({-1,1}) do b:ball('HeartLobe'..side..s,V(.55,.55,.08),cf*C(s*.22,.12,-.05),rgb(235,139,185),plastic) end
  b:triangle('HeartPoint'..side,cf*V(-.47,.06,-.1),cf*V(.47,.06,-.1),cf*V(0,-.52,-.1),rgb(235,139,185),.04,plastic)
 end
 b:ring('TopPanel',C(0,2.95,0)*A(math.pi/2,0,0),.8,.08,rgb(229,128,176),20,plastic)
end
local function proton(b)
 box(b,'PackBackplate',0,1.9,0,2.2,3.6,.55,dark)
 box(b,'UpperPowerCell',0,2.65,-.48,1.75,1.5,.8,rgb(50,57,64))
 b:cylinder('Cyclotron',V(.65,1.8,1.8),C(0,1,-.65)*A(0,math.pi/2,0),dark,metal)
 b:ring('CyclotronOuterRing',C(0,1,-1),.9,.1,rgb(112,116,125),24,metal)
 for i=0,3 do local a=i*math.pi/2;b:ball('RedCyclotronLight'..i,V(.24,.24,.08),C(math.cos(a)*.58,1+math.sin(a)*.58,-1.05),rgb(255,58,37),neon) end
 for i=1,7 do box(b,'BluePowerMeter'..i,-.42,2.1+i*.13,-.92,.32,.07,.07,rgb(76,159,255),neon) end
 for _,s in ipairs({-1,1}) do box(b,'ShoulderStrap'..s,s*.7,1.9,.4,.2,3.1,.18,rgb(121,100,71),Enum.Material.Fabric) end
 for i=0,15 do local a=i/15*math.pi;b:line('CorrugatedHose'..i,V(1.08+math.sin(a)*.55,2.7-i*.13,-.5),V(1.08+math.sin(a+.2)*.55,2.7-(i+1)*.13,-.5),.14,.14,rgb(89,78,64)) end
 box(b,'NeutronaWand',1.42,1.7,-.3,.38,2.2,.45,dark)
 box(b,'WandGrip',1.42,.7,-.3,.47,.65,.5,rgb(63,66,72))
 for y=2.3,2.8,.1 do box(b,'BarrelCoolingFin'..y,1.42,y,-.3,.5,.045,.52,rgb(152,157,167)) end
 box(b,'WarningStripe',0,3.1,-.91,.65,.14,.03,gold)
end
local function blackLotus(b)
 -- Two cupped whorls form a real flower viewed from any side, with folded petals.
 local green,vein=rgb(34,96,67),rgb(93,151,94)
 b:line('LotusStemLower',V(0,.02,0),V(.13,.56,.02),.16,.16,green,plastic)
 b:line('LotusStemUpper',V(.13,.56,.02),V(0,1.3,0),.14,.14,green,plastic)
 local leafCenter=V(-.1,.43,.04)
 for i=0,11 do
  local a=i*math.pi/6;local c=(i+1)*math.pi/6
  -- The small wedge missing at the front is the characteristic lotus-pad cleft.
  if i~=8 then
   local p=V(math.cos(a)*1.25,.34+math.sin(a)*.04,math.sin(a)*.93)
   local q=V(math.cos(c)*1.25,.34+math.sin(c)*.04,math.sin(c)*.93)
   b:triangle('LotusPad'..i,leafCenter,p,q,i%2==0 and green or rgb(43,112,74),.045,plastic)
   b:line('PadVein'..i,leafCenter,p*.88+leafCenter*.12,.016,.016,vein,plastic)
  end
 end
 local function petal(name,angle,radius,tipY,width,shade)
  local radial=V(math.cos(angle),0,math.sin(angle));local side=V(-math.sin(angle),0,math.cos(angle))
  local base=radial*.13+V(0,1.29,0)
  local left=radial*(radius*.54)+side*width+V(0,1.35,0)
  local right=radial*(radius*.54)-side*width+V(0,1.35,0)
  local ridge=radial*(radius*.58)+V(0,1.58+(tipY-1.9)*.38,0)
  local tip=radial*radius+V(0,tipY,0)
  b:triangle(name..'FoldLeftLower',base,left,ridge,shade,.035,plastic)
  b:triangle(name..'FoldRightLower',base,ridge,right,shade:Lerp(rgb(12,14,23),.27),.035,plastic)
  b:triangle(name..'FoldLeftUpper',left,tip,ridge,shade:Lerp(rgb(114,73,153),.22),.035,plastic)
  b:triangle(name..'FoldRightUpper',ridge,tip,right,shade,.035,plastic)
  b:triangle(name..'PetalBackLeft',base,tip,left,shade:Lerp(rgb(14,16,25),.30),.025,plastic)
  b:triangle(name..'PetalBackRight',base,right,tip,shade:Lerp(rgb(14,16,25),.20),.025,plastic)
  b:line(name..'SilkenRidge',ridge,tip,.018,.018,rgb(129,88,168),plastic)
 end
 for i=0,7 do petal('OuterPetal'..i,i*math.pi/4,1.46,1.94,.43,i%2==0 and rgb(39,29,59) or rgb(52,34,74)) end
 for i=0,4 do petal('InnerPetal'..i,i*math.pi*2/5+.31,.88,2.29,.28,rgb(65,40,91)) end
 b:ball('DarkLotusHeart',V(.55,.22,.55),C(0,1.56,0),rgb(41,31,56),plastic)
 for i=0,8 do
  local a=i*math.pi*2/9;local stem=V(math.cos(a)*.2,1.61,math.sin(a)*.2);local tip=stem+V(math.cos(a)*.07,.29,math.sin(a)*.07)
  b:line('StamenFilament'..i,stem,tip,.025,.025,rgb(176,135,54),plastic)
  b:ball('GoldenAnther'..i,V(.09,.13,.09),C(tip),rgb(244,203,92),metal)
 end
 b.model:SetAttribute('DisplayTitle','Black Lotus')
end
local function deathNote(b)
 local black=rgb(18,20,27);local red=rgb(142,37,43);local page=rgb(232,226,205)
 local tooling=rgb(62,63,68);local leather=Enum.Material.Leather
 -- A complete bound notebook: separate covers, page signatures, rounded spine and tooling.
 box(b,'CreamPageBlock',0,2.35,0,3.55,4.9,.42,page,Enum.Material.Fabric)
 box(b,'BlackLeatherCover',0,2.35,-.29,3.9,5.25,.14,black,leather)
 box(b,'BlackLeatherRearCover',0,2.35,.29,3.9,5.25,.14,black,leather)
 box(b,'LeatherBindingSpine',-1.86,2.35,0,.24,5.25,.68,black,leather)
 b:ball('RoundedSpineShoulder',V(.29,5.15,.65),C(-1.88,2.35,0),rgb(25,26,33),leather)
 for i=0,4 do box(b,'RaisedSpineBand'..i,-1.9,.32+i*1.01,0,.29,.075,.71,rgb(39,40,46),leather) end
 for _,x in ipairs({-1.82,1.82}) do
  for _,y in ipairs({-.11,4.81}) do
   box(b,'TooledCorner'..x..y,x,y,-.37,.22,.22,.035,tooling,leather)
  end
 end
 for _,z in ipairs({-.37,.37}) do
  for _,x in ipairs({-1.74,1.74}) do box(b,'CoverTooledVertical'..x..z,x,2.35,z,.026,4.73,.018,tooling,leather) end
  for _,y in ipairs({-.01,4.71}) do box(b,'CoverTooledHorizontal'..y..z,0,y,z,3.49,.026,.018,tooling,leather) end
 end
 for i=0,22 do
  local y=.11+i*.203
  b:line('SpineStitch'..i,V(-1.66,y,-.377),V(-1.66,y+.062,-.377),.016,.014,rgb(102,99,95),Enum.Material.Fabric)
 end
 box(b,'TitlePlaque',0,3.42,-.381,2.95,1.2,.025,black,leather)
 local plaque=b.model:FindFirstChild('TitlePlaque')
 local gui=Instance.new('SurfaceGui');gui.Name='DeathNoteTitle';gui.Face=Enum.NormalId.Front;gui.CanvasSize=Vector2.new(600,240);gui.LightInfluence=0;gui.Parent=plaque
 local title=Instance.new('TextLabel');title.Name='Title';title.BackgroundTransparency=1;title.Size=UDim2.fromScale(1,1);title.Text='DEATH NOTE';title.TextColor3=rgb(228,220,194);title.TextScaled=true;title.Font=Enum.Font.GothamBold;title.Parent=gui
 for i=0,11 do
  local z=-.19+i*.034
  box(b,'RightPageLeaf'..i,1.782,2.35,z,.018,4.77,.01,i%3==0 and rgb(184,178,160) or rgb(214,208,189),Enum.Material.Fabric)
  box(b,'TopPageLeaf'..i,0,4.81,z,3.51,.016,.01,rgb(204,197,178),Enum.Material.Fabric)
  box(b,'BottomPageLeaf'..i,0,-.105,z,3.51,.016,.01,rgb(204,197,178),Enum.Material.Fabric)
 end
 for i=0,5 do box(b,'PageSignature'..i,1.794,.39+i*.77,.01,.012,.023,.37,rgb(169,164,149),Enum.Material.Fabric) end
 box(b,'BookmarkRibbon',1.25,-.35,-.04,.12,.85,.035,red,Enum.Material.Fabric)
 b:triangle('BookmarkNotchLeft',V(1.19,-.775,-.04),V(1.25,-.72,-.04),V(1.19,-.65,-.04),red,.035,Enum.Material.Fabric)
 b:triangle('BookmarkNotchRight',V(1.31,-.775,-.04),V(1.25,-.72,-.04),V(1.31,-.65,-.04),red,.035,Enum.Material.Fabric)
 b.model:SetAttribute('DisplayTitle','Death Note')
end
local builders={shell=shell,kirbySword=kirby,goldenSpatula=spatula,krabbyPatty=patty,garyShell=gary,superStar=superstar,fireFlower=flower,hylianShield=shield,companionCube=cube,protonPack=proton,blackLotusCollectible=blackLotus,deathNote=deathNote}
function N.supports(key) return builders[key]~=nil or stones[key]~=nil end
function N.create(d,parent)
 local b=P.new(parent,{name=d.name,itemId=d.id,model=d.model,partBudget=240})
 if stones[d.model] then gem(b,d.model) else assert(builders[d.model])(b) end
 return b:finish()
end
return N
</ProtectedString>
						<string name="ScriptGuid">{95a344d3-4622-4071-89fd-ed06127ba72b}</string>
						<BinaryString name="AttributesSerialize" />
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">NewCollectibles</string>
						<BinaryString name="SerializedOverrides" />
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">12007ab00ba39f750ae282b9000003e5</UniqueId>
					</Properties>
				</Item>
			<Item class="ModuleScript" referent="RBX_V70_DetailedArt_SliferArt"><Properties><string name="Name">SliferArt</string><ProtectedString name="Source">-- Native, decorative Slifer geometry. Its original statue site stays outside play.
-- Motion metadata is consumed by the client; no physics or server animation runs.
local P=require(script.Parent.Primitives)
local M={}
local V,C,A=Vector3.new,CFrame.new,CFrame.Angles
local rgb=Color3.fromRGB
local crimson,scarlet,shadow=rgb(171,29,43),rgb(228,52,58),rgb(79,15,31)
local belly,gold,ivory=rgb(213,148,102),rgb(255,211,72),rgb(246,229,192)
local metal,plastic,neon=Enum.Material.Metal,Enum.Material.SmoothPlastic,Enum.Material.Neon
local function tagged(part,group)
 if part then part:SetAttribute('SliferMotionGroup',group) end
 return part
end
local function frameAlong(mid,direction,radial)
 local up=direction.Unit
 local back=radial-up*radial:Dot(up)
 if back.Magnitude&lt;.001 then back=V(0,0,1)-up*up.Z end
 back=back.Unit
 local right=up:Cross(back).Unit
 return CFrame.fromMatrix(mid,right,up,right:Cross(up).Unit)
end
function M.create(parent)
 -- Former godSlifer statue was rooted at (-105,34,155). Lift the coils so the
 -- entire animated silhouette clears the perimeter, and face the arena (-Z).
 local origin=V(-105,63,155)
 local b=P.new(parent,{name='SliferAnimatedLandmark',alignBase=false,cframe=C(origin),partBudget=480})
 local points,segments={},38
 for i=0,segments do
  local t=i/segments;local angle=t*math.pi*3.1
  local radius=8.8+math.sin(t*math.pi)*3.1+t*1.8
  points[i+1]=V(math.cos(angle)*radius,-27+t*54,math.sin(angle)*radius)
 end
 for i=1,segments do
  local t=i/segments;local first,last=points[i],points[i+1]
  local mid=(first+last)*.5;local along=last-first
  local radius=.23+2.05*math.min(1,t*4)
  local cf=frameAlong(mid,along,V(mid.X,0,mid.Z))
  local group='Body'..i
  tagged(b:ball('CoilScale_'..i,V(radius*2,along.Magnitude+1.2,radius*2.12),cf,i%3==0 and scarlet or crimson,plastic),group)
  tagged(b:ball('BellyPlate_'..i,V(radius*1.5,along.Magnitude+.5,.22),cf*C(0,0,-radius*.99),belly,metal),group)
  if i&gt;3 then
   tagged(b:wedge('BackSpine_'..i,V(.7,1.7+radius*.45,.8),cf*C(0,0,radius+.6)*A(math.pi/2,0,0),scarlet,metal),group)
   for _,side in ipairs({-1,1}) do
    tagged(b:line('ScaleEdge_'..i..'_'..side,cf*V(side*radius*.72,-along.Magnitude*.24,-radius*.75),cf*V(side*radius*.72,along.Magnitude*.24,-radius*.75),.1,.12,shadow,metal),group)
   end
  end
 end
 -- A single head with Slifer's two stacked mouths, rather than a head on each end.
 local head=C(points[#points]+V(0,2,-1))
 local function hbox(name,size,cf,color,mat)
  return tagged(b:box(name,size,head*cf,color,mat or plastic),'Head')
 end
 local function hball(name,size,cf,color,mat)
  return tagged(b:ball(name,size,head*cf,color,mat or plastic),'Head')
 end
 local function hline(name,a,c,width,color,mat)
  return tagged(b:line(name,head*a,head*c,width,width,color,mat or metal),'Head')
 end
 local function htriangle(name,a,c,d,color,thickness)
  local before=#b.model:GetChildren()
  b:triangle(name,head*a,head*c,head*d,color,thickness or .22,metal)
  local children=b.model:GetChildren()
  for i=before+1,#children do tagged(children[i],'Head') end
 end
 hball('SliferCranium',V(7.2,5.1,8),C(0,1.6,.6),crimson)
 hbox('UpperMouthCavity',V(5.3,1.25,3.6),C(0,1.5,-4),shadow)
 hbox('UpperSnoutBridge',V(6.3,1.1,4.2),C(0,2.75,-3.5),scarlet)
 hbox('UpperMouthLowerJaw',V(5.6,.65,4),C(0,.48,-3.9),crimson)
 hbox('LowerMouthCavity',V(6.1,1.9,5.3),C(0,-1.1,-3.35),shadow)
 hball('LowerJawMandible',V(6.3,.8,5.4),C(0,-2.45,-3.4),crimson)
 hball('LowerJawChin',V(4.9,1.2,3.2),C(0,-2.7,-2),scarlet)
 for _,side in ipairs({-1,1}) do
  hball('ArmoredCheek_'..side,V(1.8,4.4,5.6),C(side*2.9,.1,-.65),crimson)
  hbox('CheekRidge_'..side,V(.62,.7,5.8),C(side*3.65,1,-.8)*A(0,side*.12,side*.16),scarlet,metal)
  hball('GoldenEye_'..side,V(.65,.72,1.3),C(side*3.38,2.7,-1.9),gold,neon)
  hball('SlitPupil_'..side,V(.13,.59,.56),C(side*3.68,2.69,-2.05),shadow)
  hbox('EyeBrow_'..side,V(.7,.35,2.6),C(side*3.35,3.24,-1.8)*A(0,0,side*-.18),scarlet,metal)
  -- Curved crimson crown horns and smaller cheek horns.
  hline('CrownHornRoot_'..side,V(side*2.35,3.6,1),V(side*3.05,6.8,2.4),1.1,scarlet)
  hline('CrownHornBlade_'..side,V(side*3.05,6.8,2.4),V(side*3.65,9.4,4.3),.7,crimson)
  htriangle('CrownHornTip_'..side,V(side*3.2,8.5,3.7),V(side*4.05,8.5,3.7),V(side*4.15,11,5.4),scarlet,.65)
  hline('CheekHorn_'..side,V(side*3.5,.5,1),V(side*5.8,2.6,4.8),.65,scarlet)
  hline('JawWhisker_'..side,V(side*2.75,-2,-1.4),V(side*5.1,-1.8,.5),.22,belly)
  for row=1,2 do
   local y=row==1 and 1.82 or -.25
   local width=row==1 and 1.7 or 2.2
   for tooth=0,3 do
    local x=side*(.45+tooth*width/3)
    htriangle('Mouth'..row..'UpperFang_'..side..'_'..tooth,V(x-.16,y+.38,-5.6),V(x+.16,y+.38,-5.6),V(x,y-.5,-5.6),ivory)
    htriangle('Mouth'..row..'LowerFang_'..side..'_'..tooth,V(x-.14,y-1.6,-5.6),V(x+.14,y-1.6,-5.6),V(x,y-1.08,-5.6),ivory)
   end
  end
  hball('Nostril_'..side,V(.6,.2,.45),C(side*1.45,3.32,-4.6),shadow)
 end
 for i=0,3 do
  hbox('ForeheadArmor_'..i,V(3.6-i*.5,.35,1.1),C(0,4.1+i*.17,.2+i*1.1),scarlet,metal)
 end
 -- Red membranous wings hinge at the upper torso, with clearly visible bones.
 local shoulder=head* C(0,-5.5,2)
 for _,side in ipairs({-1,1}) do
  local group='Wing'..side
  local hinge=shoulder*C(side*2.2,0,0)
  local wingStart=#b.model:GetChildren()
  local root=V(side*2.2,0,0)
  local elbow=V(side*10.5,5.8,1.3)
  local tip=V(side*21,7.1,6)
  local lower=V(side*14,-6.2,8)
  b:triangle('WingUpperMembrane_'..side,shoulder*root,shoulder*elbow,shoulder*lower,crimson,.25,plastic)
  b:triangle('WingOuterMembrane_'..side,shoulder*elbow,shoulder*tip,shoulder*lower,scarlet,.25,plastic)
  b:triangle('WingLowerMembrane_'..side,shoulder*root,shoulder*lower,shoulder*V(side*6,-8.5,4),crimson,.25,plastic)
  tagged(b:line('WingShoulderBone_'..side,shoulder*root,shoulder*elbow,.65,.65,scarlet,metal),group)
  tagged(b:line('WingLeadingBone_'..side,shoulder*elbow,shoulder*tip,.48,.48,belly,metal),group)
  for rib=0,3 do
   local endPoint=elbow:Lerp(tip,rib/3):Lerp(lower,.84)
   tagged(b:line('WingFinger_'..side..'_'..rib,shoulder*elbow,shoulder*endPoint,.24,.24,scarlet,metal),group)
  end
  local children=b.model:GetChildren()
  for i=wingStart+1,#children do
   tagged(children[i],group)
   children[i]:SetAttribute('SliferHinge',hinge)
  end
  -- Small clawed forelimbs distinguish the winged dragon from an ordinary snake.
  local armA=head*V(side*2.1,-5.7,.6)
  local armB=head*V(side*5.4,-8.6,-.1)
  local armC=head*V(side*4.8,-10.1,-2)
  tagged(b:line('Forearm_'..side,armA,armB,.9,.9,crimson,plastic),'Head')
  tagged(b:line('ClawedWrist_'..side,armB,armC,.68,.68,scarlet,plastic),'Head')
  for claw=0,2 do
   tagged(b:line('IvoryClaw_'..side..'_'..claw,armC+V((claw-1)*.5,0,0),armC+V((claw-1)*.7,-1.2,-.8),.22,.22,ivory,metal),'Head')
  end
 end
 -- Hinges are stored in the original model-local frame, before its world pivot.
 for _,part in ipairs(b.model:GetChildren()) do
  if part:GetAttribute('SliferMotionGroup')=='Head' then part:SetAttribute('SliferHinge',head) end
 end
 local model=b:finish()
 model:SetAttribute('OrbitOrigin',origin)
 model:SetAttribute('OrbitPeriod',36)
 model:SetAttribute('FormerStatueOrigin',V(-105,34,155))
 model:SetAttribute('DecorativeOnly',true)
 model:SetAttribute('SliferArtVersion',2)
 return model
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_V72_DetailedArt_BasePolish"><Properties><string name="Name">BasePolish</string><ProtectedString name="Source">-- A coherent relic-vault finish around the original eight functional displays.
-- This module owns only cosmetic geometry. It never changes gameplay anchors.
local P=require(script.Parent.Primitives)
local M={}
local V,C,A=Vector3.new,CFrame.new,CFrame.Angles
local rgb=Color3.fromRGB
local navy=rgb(26,34,52)
local slate=rgb(68,78,94)
local shadow=rgb(31,40,57)
local bronze=rgb(157,121,65)
local gold=rgb(219,180,100)
local ivory=rgb(229,221,199)
local stone,metal=Enum.Material.Slate,Enum.Material.Metal

local function inscription(part,value,textColor)
 local gui=Instance.new('SurfaceGui');gui.Name='VaultInscription'
 gui.Face=Enum.NormalId.Front;gui.CanvasSize=Vector2.new(560,160)
 gui.LightInfluence=.3;gui.AlwaysOnTop=false;gui.Parent=part
 local t=Instance.new('TextLabel');t.BackgroundTransparency=1
 t.Size=UDim2.fromScale(.94,.86);t.Position=UDim2.fromScale(.03,.07)
 t.Text=value;t.TextColor3=textColor or ivory;t.TextSize=66
 t.Font=Enum.Font.GothamBold;t.TextWrapped=false;t.Parent=gui
 return gui
end

local function finishBase(parent,base,index,total)
 local accent=Color3.fromHSV((index-1)/total,.56,.92)
 local b=P.new(parent,{name='RelicVault'..index,alignBase=false,cframe=base.cf,partBudget=140})
 local function box(name,size,cf,color,material)
  return b:box(name,size,cf,color,material or metal)
 end
 -- Flush inlays sit just above the retained solid floor. The complete green
 -- entrance strip, delivery pad and upgrade workstation remain uncovered.
 for _,side in ipairs({-1,1}) do
  box('FloorPerimeterInlayX'..side,V(.12,.022,39),C(side*22.4,1.018,1.5),bronze)
  box('AisleInlay'..side,V(.07,.022,27),C(side*1.2,1.018,5.5),bronze)
  for _,z in ipairs({-18,21}) do
   box('FloorCorner'..side..'_'..z,V(.5,.024,.5),C(side*22.4,1.02,z)*A(0,math.pi/4,0),gold)
  end
 end
 for _,z in ipairs({-18,21}) do
  box('FloorPerimeterInlayZ'..z,V(44.8,.022,.12),C(0,1.018,z),bronze)
 end
 for _,z in ipairs({-8.7,1.8,12}) do
  box('FloorCourse'..z,V(43.7,.018,.055),C(0,1.013,z),slate,stone)
 end
 -- Six tightly fitted parts per existing pedestal, all below its item pivot.
 -- The original plinth, neon ownership band and stored item stay untouched.
 local numerals={'I','II','III','IV','V','VI','VII','VIII'}
 for slot,slotCF in ipairs(base.slots) do
  local pos=base.cf:PointToObjectSpace(slotCF.Position)
  for _,side in ipairs({-1,1}) do
   box('DisplaySideFrame'..slot..'_'..side,V(.12,.7,7.24),C(pos.X+side*3.55,1.63,pos.Z),slate,stone)
   box('DisplayEndFrame'..slot..'_'..side,V(7.12,.7,.12),C(pos.X,1.63,pos.Z+side*3.55),slate,stone)
  end
  local plate=box('DisplayNumberPlate'..slot,V(1.42,.5,.08),C(pos.X,1.7,pos.Z-3.64),bronze)
  inscription(plate,numerals[slot] or tostring(slot),ivory)
  box('DisplayCrest'..slot,V(.24,.24,.09),C(pos.X-1.1,1.7,pos.Z-3.65)*A(0,0,math.pi/4),gold)
 end
 -- Interior wall piers carry one shared architectural language: dark stone,
 -- restrained bronze capitals and a single owner-colored inset per pier.
 for _,side in ipairs({-1,1}) do
  for j,z in ipairs({-12,2,16}) do
   box('InteriorPier'..side..'_'..j,V(.28,10.8,1.05),C(side*23.34,7.3,z),slate,stone)
   box('PierFoot'..side..'_'..j,V(.38,.22,1.35),C(side*23.28,1.94,z),bronze)
   box('PierCapital'..side..'_'..j,V(.38,.22,1.35),C(side*23.28,12.62,z),gold)
   box('PierOwnerInset'..side..'_'..j,V(.025,.9,.19),C(side*23.13,9.8,z),accent,Enum.Material.SmoothPlastic)
  end
  for j,z in ipairs({-5,9}) do
   box('InteriorWallPanel'..side..'_'..j,V(.055,5.7,10),C(side*23.46,7.5,z),shadow)
   box('InteriorPanelCrown'..side..'_'..j,V(.075,.1,9.5),C(side*23.42,10.42,z),bronze)
  end
 end
 -- Five embossed rear panels use shallow geometry rather than bright posters.
 for j=-2,2 do
  local x=j*8.6
  box('RearRecess'..j,V(6.8,6.1,.075),C(x,7.6,23.46),shadow)
  box('RearPanelCrown'..j,V(6.35,.12,.1),C(x,10.72,23.4),bronze)
  box('RearPanelGlyph'..j,V(.72,.72,.11),C(x,8,23.36)*A(0,0,math.pi/4),bronze)
 end
 -- Narrow front-jamb highlights stop above the entrance/protection line.
 -- No new lintel, sign in the ownership label, roof slab or blocking collider.
 for _,side in ipairs({-1,1}) do
  for _,offset in ipairs({-1.55,1.55}) do
   box('EntryJambInlay'..side..'_'..offset,V(.12,8.5,.09),C(side*20+offset,8.3,-25.13),bronze)
  end
  local plate=box('VaultIndexPlate'..side,V(2.6,1.18,.14),C(side*20,10.6,-25.22),navy)
  inscription(plate,string.format('VAULT %02d',index),gold)
  box('VaultIndexUnderline'..side,V(2.35,.09,.07),C(side*20,9.95,-25.31),accent,Enum.Material.SmoothPlastic)
 end
 local model=b:finish()
 model:SetAttribute('Kind',nil);model:SetAttribute('DecorativeOnly',true)
 model:SetAttribute('BaseIndex',index);model:SetAttribute('ArtVersion',72)
 model:SetAttribute('PresentationTheme','Relic Vault')
 return model
end

function M.build(world)
 local previous=world.folder:FindFirstChild('BasePresentation')
 if previous then previous:Destroy() end
 local root=Instance.new('Folder');root.Name='BasePresentation';root.Parent=world.folder
 root:SetAttribute('ArtVersion',72);root:SetAttribute('DecorativeOnly',true)
 for index,base in ipairs(world.bases) do finishBase(root,base,index,#world.bases) end
 return root
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_V72_DetailedArt_PlazaPolish"><Properties><string name="Name">PlazaPolish</string><ProtectedString name="Source">-- Shared market finishes. This module owns presentation only; interaction anchors
-- and every original collision surface stay with their existing builders.
local P=require(script.Parent.Primitives)
local M={}
local V,C,A=Vector3.new,CFrame.new,CFrame.Angles
local rgb=Color3.fromRGB
local navy=rgb(29,39,57)
local slate=rgb(75,87,104)
local seam=rgb(48,60,78)
local bronze=rgb(179,141,78)
local pale=rgb(211,214,202)
local teal=rgb(79,148,157)
local metal,stone=Enum.Material.Metal,Enum.Material.Slate

local function builder(parent,name,budget)
 return P.new(parent,{name=name,alignBase=false,partBudget=budget})
end
local function box(b,name,size,cf,color,material)
 return b:box(name,size,cf,color,material or metal)
end
local function flat(b,name,size,cf,color,material)
 local part=box(b,name,size,cf,color,material or stone)
 part.CastShadow=false
 return part
end
local function finish(b)
 local model=b:finish()
 model:SetAttribute('Kind',nil)
 model:SetAttribute('DecorativeOnly',true)
 model:SetAttribute('ArtVersion',72)
 return model
end
local function label(part,value)
 local gui=Instance.new('SurfaceGui')
 gui.Name='InsetPowerLabTitle';gui.Face=Enum.NormalId.Front
 gui.CanvasSize=Vector2.new(900,140);gui.LightInfluence=.35
 gui.AlwaysOnTop=false;gui.MaxDistance=70;gui.Parent=part
 local text=Instance.new('TextLabel')
 text.Name='Title';text.BackgroundTransparency=1
 text.Size=UDim2.fromScale(.92,.84);text.Position=UDim2.fromScale(.04,.08)
 text.Font=Enum.Font.GothamBold;text.Text=value;text.TextSize=80
 text.TextColor3=pale;text.TextStrokeTransparency=1;text.Parent=gui
end

local function promenades(parent)
 local b=builder(parent,'MarketPromenades',100)
 for _,side in ipairs({-1,1}) do
  local z=side*21.5
  flat(b,'StonePromenade'..side,V(216,.10,19),C(0,.08,z),slate)
  for _,edge in ipairs({12.08,30.92}) do
   flat(b,'BronzePromenadeEdge'..side..edge,V(216,.045,.11),C(0,.158,side*edge),bronze,metal)
   flat(b,'InsetPromenadeReveal'..side..edge,V(216,.035,.22),C(0,.147,side*(edge==12.08 and 12.38 or 30.62)),seam)
  end
  for x=-90,90,18 do
   flat(b,'StoneExpansionJoint'..side..x,V(.07,.025,18.4),C(x,.144,z),seam)
  end
  -- These flush approach marks finish before the delivery/protection lines.
  for _,x in ipairs({-84,-28,28,84}) do
   flat(b,'VaultApproachInset'..side..x,V(8.8,.045,4.8),C(x,.153,side*30.3),navy)
   for _,offset in ipairs({-4.3,4.3}) do
    flat(b,'VaultApproachEdge'..side..x..offset,V(.10,.035,4.8),C(x+offset,.19,side*30.3),bronze,metal)
   end
   for _,offset in ipairs({-1,1}) do
    flat(b,'ApproachChevron'..side..x..offset,V(.105,.035,1.25),C(x+offset*.39,.195,side*30.25)*A(0,side*offset*.7,0),pale,metal)
   end
  end
 end
 return finish(b)
end

local function medallions(parent)
 local b=builder(parent,'RelicMedallions',150)
 -- Alternating placements keep a clear approach to the central workstation.
 local sites={{-76,-21.5},{-38,-21.5},{76,-21.5},{-76,21.5},{38,21.5},{76,21.5}}
 for index,site in ipairs(sites) do
  local origin=C(site[1],.19,site[2])
  b:cylinder('MedallionStone'..index,V(.065,5.7,5.7),origin*A(0,0,math.pi/2),navy,stone)
  b:ring('BronzeRelicDial'..index,origin*A(math.pi/2,0,0),2.55,.065,bronze,12,metal)
  local function mark(name,size,x,z,angle,color)
   return flat(b,'Relic'..index..name,size,origin*C(x,.065,z)*A(0,angle or 0,0),color or bronze,metal)
  end
  if index==1 then
   -- An open archive, a relic rather than a card billboard.
   mark('BookLeft',V(1.18,.05,1.75),-.64,0,-.08)
   mark('BookRight',V(1.18,.05,1.75),.64,0,.08)
   mark('Binding',V(.09,.07,1.9),0,0,0,pale)
   for _,x in ipairs({-.64,.64})do mark('PageRule'..x,V(.68,.08,.07),x,-.38,0,navy)end
  elseif index==2 then
   -- A geometric machine core echoes the new technological collectibles.
   mark('MachineCore',V(1.65,.06,1.65),0,0,math.pi/4)
   mark('CoreInset',V(.75,.09,.75),0,0,math.pi/4,teal)
   for _,x in ipairs({-1,1})do
    mark('CoreContact'..x,V(.5,.06,.12),x*1.36,0,0)
    mark('CoreContactZ'..x,V(.12,.06,.5),0,x*1.36,0)
   end
  elseif index==3 then
   mark('Blade',V(.30,.065,2.1),0,-.35,0,pale)
   mark('SwordGuard',V(1.5,.065,.18),0,.54)
   mark('SwordGrip',V(.24,.065,.75),0,1.0)
   mark('SwordPommel',V(.42,.065,.22),0,1.42)
  elseif index==4 then
   b:ring('OrbitalInset',origin*C(0,.065,0)*A(math.pi/2,0,0),1.15,.085,pale,8,metal)
   mark('OrbitAxis',V(.10,.065,3.25),0,0,.6)
   mark('OrbitCore',V(.65,.085,.65),0,0,math.pi/4,teal)
  elseif index==5 then
   for edge=0,2 do
    local angle=edge*math.pi*2/3
    local nextAngle=(edge+1)*math.pi*2/3
    b:line('RuneTriangle'..edge,origin*V(math.cos(angle)*1.4,.065,math.sin(angle)*1.4),
     origin*V(math.cos(nextAngle)*1.4,.065,math.sin(nextAngle)*1.4),.08,.08,bronze,metal)
   end
   mark('RuneHeart',V(.7,.07,.7),0,0,math.pi/4,pale)
  else
   mark('CrownBand',V(2.65,.065,.28),0,.85)
   for _,x in ipairs({-1,0,1})do
    mark('CrownPoint'..x,V(.50,.065,1.2+(.35-math.abs(x)*.35)),x*.87,.07,0,bronze)
   end
  end
 end
 local model=finish(b)
 for _,part in ipairs(model:GetDescendants())do if part:IsA('BasePart')then part.CastShadow=false end end
 return model
end

local function powerLab(parent)
 local b=builder(parent,'PowerLabSurround',65)
 flat(b,'PowerLabFoundation',V(14.8,.12,12.6),C(0,.18,20.4),navy)
 flat(b,'PowerLabInsetFloor',V(13.8,.045,11.6),C(0,.265,20.4),slate)
 for _,side in ipairs({-1,1})do
  flat(b,'PowerLabFloorRail'..side,V(.13,.045,12.2),C(side*7.12,.30,20.4),bronze,metal)
  flat(b,'PowerLabThreshold'..side,V(14.2,.045,.13),C(0,.30,20.4+side*6.1),bronze,metal)
  box(b,'LabRearPier'..side,V(.65,4.8,.65),C(side*5.4,2.65,25.35),navy,stone)
  box(b,'LabPierCap'..side,V(.9,.18,.9),C(side*5.4,5.1,25.35),bronze)
  box(b,'LabPierFoot'..side,V(.9,.30,.9),C(side*5.4,.43,25.35),slate,stone)
  box(b,'PierInset'..side,V(.08,3.55,.06),C(side*5.4,2.8,24.99),bronze)
  box(b,'LabLowReturn'..side,V(2.0,1.0,.45),C(side*4.0,.84,25.35),slate,stone)
 end
 box(b,'LabBacksplash',V(10.1,3.2,.28),C(0,2.9,25.35),navy,stone)
 box(b,'LabBacksplashInset',V(9.65,2.72,.055),C(0,2.9,25.17),seam)
 for _,y in ipairs({1.44,4.37})do box(b,'BacksplashRail'..y,V(10.2,.075,.08),C(0,y,25.12),bronze)end
 local sign=box(b,'PowerLabNameplate',V(7.4,1.15,.07),C(0,3.65,25.10),navy)
 label(sign,'POWER LAB')
 for index=-2,2 do
  box(b,'LabPanelDivision'..index,V(.055,1.15,.07),C(index*1.7,2.12,25.09),slate)
 end
 -- Two restrained indicators on the rear trim, without lights or particles.
 for _,side in ipairs({-1,1})do
  box(b,'LabStatusAccent'..side,V(.55,.08,.08),C(side*4.42,4.1,25.08),teal,Enum.Material.Neon)
 end
 return finish(b)
end

local function portalArrival(parent)
 local b=builder(parent,'PortalArrivalTrim',55)
 flat(b,'ArrivalStoneApron',V(13.0,.14,30),C(117.15,.12,0),slate)
 flat(b,'ArrivalInnerApron',V(11.9,.045,28.8),C(117.15,.215,0),navy)
 for _,side in ipairs({-1,1})do
  flat(b,'PortalApronLongEdge'..side,V(.12,.045,29.2),C(117.15+side*6.20,.255,0),bronze,metal)
  flat(b,'PortalApronEndEdge'..side,V(12.5,.045,.12),C(117.15,.255,side*14.6),bronze,metal)
  -- Existing pylon and crystal remain visible within a finished bronze socket.
  flat(b,'PylonFootReveal'..side,V(5.5,.075,4.95),C(119,.26,side*10),bronze,metal)
  flat(b,'PylonFootInset'..side,V(5.1,.065,4.55),C(119,.33,side*10),seam)
  for _,edge in ipairs({-1,1})do
   flat(b,'PylonStoneJoint'..side..edge,V(.08,.045,4.4),C(119+edge*2.35,.375,side*10),bronze,metal)
  end
 end
 -- A shallow approach motif terminates beside the original rift ring.
 for index=0,3 do
  for _,side in ipairs({-1,1})do
   flat(b,'ArrivalChevron'..index..side,V(.12,.045,1.8),C(111.35+index*1.35,.285,side*.58)*A(0,side*math.pi/4,0),pale,metal)
  end
 end
 return finish(b)
end

function M.build(world)
 assert(world and world.folder,'PlazaPolish requires the existing world')
 local previous=world.folder:FindFirstChild('PlazaPresentation')
 if previous then previous:Destroy()end
 local root=Instance.new('Folder');root.Name='PlazaPresentation';root.Parent=world.folder
 root:SetAttribute('ArtVersion',72)
 root:SetAttribute('DecorativeOnly',true)
 root:SetAttribute('Style','Relic market: slate, navy, bronze')
 promenades(root);medallions(root);powerLab(root);portalArrival(root)
 local count=0
 for _,part in ipairs(root:GetDescendants())do
  if part:IsA('BasePart')then
   count=count+1
   assert(part.Anchored and not part.CanCollide and not part.CanQuery and not part.CanTouch,'Market art must remain noninteractive')
  end
 end
 assert(count&lt;=350,'Market presentation exceeds its geometry budget')
 root:SetAttribute('PartCount',count)
 return root
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_V75_DetailedArt_UpperFloor"><Properties><string name="Name">UpperFloor</string><ProtectedString name="Source">-- Server-built level-five extension. Slots and stairs are part of the same
-- vault; only ownership/level transitions build or remove geometry.
local P=require(script.Parent.Primitives)
local M={UnlockLevel=5,FloorHeight=20,RoofHeight=36.5}
local V,C=Vector3.new,CFrame.new
local rgb=Color3.fromRGB
local navy,slate,shadow=rgb(26,34,52),rgb(68,78,94),rgb(31,40,57)
local bronze,gold,ivory=rgb(157,121,65),rgb(219,180,100),rgb(229,221,199)
local stone,metal=Enum.Material.Slate,Enum.Material.Metal
local function plate(part,value)
 local gui=Instance.new('SurfaceGui');gui.Name='UpperVaultInscription'
 gui.Face=Enum.NormalId.Front;gui.CanvasSize=Vector2.new(600,180)
 gui.LightInfluence=.3;gui.AlwaysOnTop=false;gui.Parent=part
 local text=Instance.new('TextLabel');text.BackgroundTransparency=1
 text.Size=UDim2.fromScale(.94,.86);text.Position=UDim2.fromScale(.03,.07)
 text.Text=value;text.TextColor3=ivory;text.TextSize=65;text.Font=Enum.Font.GothamBold
 text.TextWrapped=false;text.Parent=gui
end
local function roofPart(name)
 return name=='SolidFittedRoof' or name=='SolidRaisedRoof' or name:match('^Roof')
  or name:match('^SideRoofGlow') or name:match('^VentGem') or name:match('^EntranceRune')
end
local function findRoof(world,index)
 local aesthetics=world.folder:FindFirstChild('Aesthetics')
 local roofs=aesthetics and aesthetics:FindFirstChild('VaultRoofs')
 return roofs and roofs:FindFirstChild('BaseRoof'..index)
end
local function moveRoof(roof,record,up)
 if not roof then return end
 if up then
  record.roof=roof;record.roofParts={}
  record.oldHeight=roof:GetAttribute('RoofHeight');record.oldUnlocked=roof:GetAttribute('UpperFloorUnlocked')
  for _,part in ipairs(roof:GetDescendants()) do
   if part:IsA('BasePart') and roofPart(part.Name) then
    record.roofParts[part]=part.CFrame;part.CFrame=part.CFrame+V(0,19,0)
   end
  end
  roof:SetAttribute('RoofHeight',M.RoofHeight);roof:SetAttribute('UpperFloorUnlocked',true)
 else
  for part,cf in pairs(record.roofParts or {}) do if part.Parent then part.CFrame=cf end end
  roof:SetAttribute('RoofHeight',record.oldHeight);roof:SetAttribute('UpperFloorUnlocked',record.oldUnlocked)
 end
end
local function build(parent,base,index,total)
 local accent=Color3.fromHSV((index-1)/total,.56,.92)
 local b=P.new(parent,{name='UpperFloor'..index,alignBase=false,cframe=base.cf,partBudget=420})
 local function box(name,size,cf,color,material,solid)
  return b:box(name,size,cf,color,material or metal,solid)
 end
 -- Two slabs leave a real rear-left stairwell; no invisible collider spans it.
 box('UpperFloorFrontSlab',V(48,1,36),C(0,19.5,-6),navy,stone,true)
 box('UpperFloorRearRightSlab',V(20.5,1,12),C(13.75,19.5,18),navy,stone,true)
 for _,x in ipairs({-22.5,22.5}) do box('GalleryFloorBorderX'..x,V(.12,.025,34),C(x,20.02,-6),bronze) end
 for _,z in ipairs({-22.5,11.4}) do box('GalleryFloorBorderZ'..z,V(45,.025,.12),C(0,20.02,z),bronze) end
 for _,x in ipairs({-1.1,1.1}) do box('GalleryAisleInlay'..x,V(.07,.025,30),C(x,20.02,-5),gold) end
 local numerals={'IX','X','XI','XII','XIII','XIV','XV','XVI'}
 for n=1,8 do
  local x=-16.5+((n-1)%4)*11;local z=-3+math.floor((n-1)/4)*10
  base.slots[8+n]=base.cf*C(x,21.9,z)
  box('UpperDisplayPedestal'..n,V(7,1.2,7),C(x,20.6,z),shadow,stone,true)
  box('UpperDisplayOwnershipTrim'..n,V(7.12,.12,7.12),C(x,21.25,z),accent,Enum.Material.Neon)
  for _,side in ipairs({-1,1}) do
   box('UpperDisplaySideFrame'..n..'_'..side,V(.12,.7,7.24),C(x+side*3.55,20.63,z),slate,stone)
   box('UpperDisplayEndFrame'..n..'_'..side,V(7.12,.7,.12),C(x,20.63,z+side*3.55),slate,stone)
  end
  local plaque=box('UpperDisplayNumber'..n,V(1.6,.5,.08),C(x,20.7,z-3.64),bronze)
  plate(plaque,numerals[n])
 end
 -- Comfortable 0.475-stud rises, 1.15-stud treads and a 4.5-stud turn landing.
 -- Both flights occupy the clear strip behind the ground floor's displays.
 local run,rise,count=23,.475,20
 local tread=run/count
 for flight=1,2 do
  local z=flight==1 and 14.5 or 20.5
  local bottom=flight==1 and 1 or 10.5
  for step=1,count do
   local x=flight==1 and 3.5-(step-.5)*tread or -19.5+(step-.5)*tread
   local top=bottom+step*rise
   box('StairTread'..flight..'_'..step,V(tread+.04,rise,4),C(x,top-rise*.5,z),slate,stone,true)
   local edge=flight==1 and x-tread*.5 or x+tread*.5
   box('StairBronzeNosing'..flight..'_'..step,V(.065,.035,4.03),C(edge,top+.018,z),gold)
  end
  local start=flight==1 and V(3.5,1,0) or V(-19.5,10.5,0)
  local finish=flight==1 and V(-19.5,10.5,0) or V(3.5,20,0)
  for _,side in ipairs({-1,1}) do
   local railZ=z+side*2.12
   b:line('StairHandrail'..flight..'_'..side,V(start.X,start.Y+3.1,railZ),V(finish.X,finish.Y+3.1,railZ),.16,.16,gold,metal,true)
   b:line('StairStringer'..flight..'_'..side,V(start.X,start.Y-.15,z+side*1.65),V(finish.X,finish.Y-.15,z+side*1.65),.22,.34,shadow,metal)
   for post=0,4 do
    local t=post/4;local x=start.X+(finish.X-start.X)*t;local y=start.Y+(finish.Y-start.Y)*t
    box('StairBaluster'..flight..'_'..side..'_'..post,V(.13,2.85,.13),C(x,y+1.65,railZ),bronze,metal,true)
   end
  end
 end
 box('StairTurnLanding',V(4.5,.6,10),C(-21.25,10.2,17.5),slate,stone,true)
 box('StairLandingGoldEdge',V(.1,.04,9.6),C(-23.3,10.52,17.5),gold)
 -- Upstairs has the same accessible full-width arrival/protection line.
 local line=box('UpperDeliveryProtectionLine',V(3,.16,4.6),C(4.2,20.09,20.5),rgb(63,221,154),Enum.Material.Neon)
 line:SetAttribute('ProtectionLine',true);line:SetAttribute('BaseIndex',index)
 local galleryPlaque=box('UpperGalleryNameplate',V(13,1.8,.18),C(13.6,23,-23.32),bronze)
 plate(galleryPlaque,'RELIC GALLERY  •  II')
 local model=b:finish()
 model:SetAttribute('Kind',nil);model:SetAttribute('DecorativeOnly',true);model:SetAttribute('ArtVersion',75)
 model:SetAttribute('BaseCF',base.cf);model:SetAttribute('BaseIndex',index)
 model:SetAttribute('UpperFloorUnlocked',true);model:SetAttribute('FloorHeight',M.FloorHeight);model:SetAttribute('RoofHeight',M.RoofHeight)
 model:SetAttribute('StairRise',rise);model:SetAttribute('StairTreadDepth',tread);model:SetAttribute('StairWidth',4)
 local shell=P.new(model,{name='UpperFloorShell',alignBase=false,cframe=base.cf,partBudget=150})
 local function wall(name,size,cf,color,mat,solid) return shell:box(name,size,cf,color,mat or stone,solid) end
 -- Side/rear walls overlap the retained lower walls; the upper facade has
 -- fitted solid glass windows, framed in the same restrained bronze palette.
 wall('UpperSolidBackWall',V(48,19,1),C(0,27,24),navy,stone,true)
 for _,side in ipairs({-1,1}) do
  wall('UpperSolidSideWall'..side,V(1,19,48),C(side*24,27,0),navy,stone,true)
  for z=-16,16,8 do
   wall('UpperWallPier'..side..'_'..z,V(.45,16,1),C(side*23.3,28,z),slate)
   wall('UpperWallCapital'..side..'_'..z,V(.6,.2,1.25),C(side*23.2,35.7,z),gold,metal)
   wall('UpperWallRecess'..side..'_'..z,V(.06,8,5.3),C(side*23.45,28,z+3.2),shadow,metal)
  end
 end
 wall('UpperFrontKneeWall',V(48,3,1),C(0,21.5,-24),navy,stone,true)
 wall('UpperFrontCrownBeam',V(48,4,1),C(0,34.5,-24),navy,stone,true)
 for n=-2,2 do
  local x=n*9
  local glass=wall('UpperSolidWindow'..n,V(8,9.5,.3),C(x,27.75,-24),rgb(98,139,156),Enum.Material.Glass,true)
  glass.Transparency=.32
  for _,side in ipairs({-1,1}) do wall('UpperWindowJamb'..n..'_'..side,V(.22,9.7,.5),C(x+side*4.1,27.75,-24.05),bronze,metal,true) end
  for _,y in ipairs({23,32.5}) do wall('UpperWindowSill'..n..'_'..y,V(8.45,.22,.6),C(x,y,-24.05),gold,metal,true) end
 end
 for _,x in ipairs({-13.5,-4.5,4.5,13.5}) do wall('UpperFacadePier'..x,V(1,9.5,1),C(x,27.75,-24),slate,stone,true) end
 for _,x in ipairs({-23,23}) do wall('UpperFacadeEndPier'..x,V(2,9.5,1),C(x,27.75,-24),slate,stone,true) end
 -- Guard the stairwell without closing the four-stud stair arrival opening.
 wall('StairwellFrontGuard',V(26.5,3,.18),C(-10.25,21.5,11.85),shadow,metal,true)
 wall('StairwellFrontHandrail',V(26.7,.18,.35),C(-10.25,23.05,11.85),gold,metal,true)
 wall('StairwellEntryGuard',V(.18,3,6),C(3.42,21.5,15),shadow,metal,true)
 wall('StairwellEntryHandrail',V(.35,.18,6.1),C(3.42,23.05,15),gold,metal,true)
 local shellModel=shell.model
 shellModel:SetAttribute('Kind',nil);shellModel:SetAttribute('DecorativeOnly',true)
 shellModel:SetAttribute('BaseCF',base.cf);shellModel:SetAttribute('RoofHeight',M.RoofHeight);shellModel:SetAttribute('FloorHeight',M.FloorHeight)
 shellModel:SetAttribute('OcclusionShell',true);shellModel:SetAttribute('UpperFloorUnlocked',true)
 shell:finish()
 local parts=0;for _,v in ipairs(model:GetDescendants()) do if v:IsA('BasePart') then parts=parts+1 end end
 model:SetAttribute('PartCount',parts)
 return model
end
function M.sync(world,states)
 if not world or not world.folder or not states then return end
 local cache=world._upperFloorState
 if not cache then
  local folder=Instance.new('Folder');folder.Name='UpperFloorUpgrades';folder.Parent=world.folder
  folder:SetAttribute('ArtVersion',75)
  cache={folder=folder,records={}};world._upperFloorState=cache
 end
 for index,base in ipairs(world.bases) do
  local state=base.owner and states[base.owner]
  local enabled=state and (state.progression or 0)&gt;=M.UnlockLevel and state.capacity&gt;=16
  local key=enabled and base.owner or nil
  local record=cache.records[index]
  if (record and record.owner or nil)~=key then
   if record then
    if record.model then record.model:Destroy() end
    moveRoof(record.roof,record,false)
    for slot=9,16 do base.slots[slot]=nil end
    cache.records[index]=nil
   end
   if key then
    record={owner=key}
    moveRoof(findRoof(world,index),record,true)
    record.model=build(cache.folder,base,index,#world.bases)
    cache.records[index]=record
   end
  end
 end
 return cache.folder
end
return M
</ProtectedString></Properties></Item></Item>
			<Item class="ModuleScript" referent="RBX_OP66_Module_1">
				<Properties>
					<Content name="LinkedSource"><null /></Content>
					<ProtectedString name="Source">-- Structural art checks; visual likeness still needs an in-person Studio review.
return function(package)
 local catalog=require(package.Catalog);local factory=require(package.ModelFactory);local counts={}
 local details={
  krabby_patty={'SingleDomedSesameBun','GrilledPattyCore','SurfaceFittedSesameSeed32','TomatoSkin','PickleRind1','OnionOuterRing0'},
  black_lotus={'LotusStemLower','DarkLotusHeart','GoldenAnther8','OuterPetal0FoldLeftLower_A'},
  death_note={'BlackLeatherRearCover','LeatherBindingSpine','SpineStitch22','RightPageLeaf11','BookmarkRibbon','TitlePlaque'},
  krabby_patty_formula={'GreenGlassBottleBody','FittedCorkStopper','RolledSecretRecipe','FormulaLabel','RedWaxSeal','SealAnchorStem'},
  gary_shell={'SmoothPinkSpiralShell','FrontSurfaceRedSpiral72','BackSurfaceRedSpiral54','FrontFittedVioletSpot5','RoundedOpeningLip23','RecessedOpeningWall23','DeepOpeningBowl'},
  transformers_allspark={'AllSparkClosedMetalCore','ChamferedXEdge1','AllSparkFrontCybertronianGlyph1Stroke1','AllSparkBackCybertronianGlyph6Stroke4','AllSparkTopRecessedFacePanel','AllSparkBottomRecessedFacePanel'},
  transformers_matrix={'BlueEnergyCore','LeftOpenHandleCast_1','RightOpenHandleCast_8','GoldenOuterEnergyRing_0','ChassisRadialRib_11','CrownCentralKeystone'},
  optimus_energon_axe={'RedForearmEmitter','SharpLuminousEdge11','OptimusSilverFaceplate','CurvedOrangeBladeSpine11','EnergonHubCore1','RecessedGripBand7'},
 }
 local function finite(value) return value==value and math.abs(value)&lt;math.huge end
 for index,d in ipairs(catalog.Items) do
  local model=factory.create(d,nil);assert(model.PrimaryPart,'Missing pivot: '..d.id)
  assert(model:GetAttribute('Kind')==d.id and model.Name==d.name,'Collectible identity mismatch: '..d.id)
  local count=0
  for _,p in ipairs(model:GetDescendants()) do if p:IsA('BasePart') then
   count=count+1;assert(p.Anchored and not p.CanCollide and not p.CanTouch and not p.CanQuery,'Unsafe collectible physics: '..d.id)
   for _,value in ipairs({p.CFrame:GetComponents()}) do assert(finite(value),'Invalid collectible transform: '..d.id) end
   for _,value in ipairs({p.Size.X,p.Size.Y,p.Size.Z}) do assert(finite(value) and value&gt;0,'Invalid collectible dimensions: '..d.id) end
  end end
  assert(count&gt;=21 and count&lt;=240,'Incomplete or excessive collectible geometry: '..d.id)
  for _,name in ipairs(details[d.id] or {}) do assert(model:FindFirstChild(name,true),'Missing collectible detail: '..d.id..' / '..name) end
  if d.id=='transformers_allspark' then
   assert(model:GetAttribute('AllSparkFaceCount')==6 and model:GetAttribute('GlyphStrokeCount')==144,'AllSpark needs six complete engraved faces')
  end
  if d.id=='transformers_matrix' then
   assert(model:GetAttribute('OpenFingerHandles') and model:GetAttribute('NativeFacetedEnergyCrystal'),'Matrix handles or crystal missing')
  end
  if d.id=='krabby_patty_formula' then
   local glass=model:FindFirstChild('GreenGlassBottleBody')
   assert(glass.Material==Enum.Material.Glass and glass.Transparency&gt;.5 and glass.Transparency&lt;.9,'Formula recipe must be visible through glass')
   local label=model:FindFirstChild('FormulaLabel');local brand=model:FindFirstChild('FormulaBrand')
   assert(label:FindFirstChildOfClass('SurfaceGui') and brand:FindFirstChildOfClass('SurfaceGui'),'Formula surface labels missing')
  end
  if d.id=='item08' then assert(count==137 and model:FindFirstChild('EyePupil') and model:FindFirstChild('PendantLoop_24'),'Millennium Puzzle changed') end
  if d.model=='shell' then assert(model:GetAttribute('FreeModelKey')=='blue_shell' and model:FindFirstChild('SapphireShellBody') and model:FindFirstChild('ThickIvoryRim0') and model:FindFirstChild('LongFlightFeather1_5'),'Supplied Blue Shell details missing') end
  if d.infinityStone then assert(d.tier==5 and model:FindFirstChild('CrystalFacet1_1A_A') and model:FindFirstChild('TerminalFacet1_1_A') and model:FindFirstChild('IlluminatedGirdle3'),'Supplied stone facets/glow missing') end
  counts[d.id]=count;model:Destroy();if index%8==0 then task.wait() end
 end
 return {models=#catalog.Items,counts=counts}
end
