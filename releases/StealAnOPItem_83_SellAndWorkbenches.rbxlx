				<Item class="ModuleScript" referent="RBX181a6d0d0af24174abbb58eea6e13884">
					<Properties>
						<Content name="LinkedSource"><null /></Content>
						<ProtectedString name="Source">-- Four overlapping barriers enclose the original 252 x 188 plaza.
local B={}
B.WallHeight=24
B.WallThickness=3
function B.build(world)
 local previous=world.folder:FindFirstChild('ArenaBounds'); if previous then previous:Destroy() end
 local root=Instance.new('Folder'); root.Name='ArenaBounds'; root.Parent=world.folder
 local function wall(name,size,pos)
  local p=Instance.new('Part'); p.Name=name; p.Size=size; p.Position=pos
  p.Anchored=true; p.CanCollide=true; p.CanTouch=false; p.CanQuery=true
  p.Material=Enum.Material.Slate; p.Color=Color3.fromRGB(42,40,62)
  p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth; p.Parent=root
  local trim=Instance.new('Part'); trim.Name='DimensionalCoping'; trim.Anchored=true
  trim.CanCollide=false; trim.CanTouch=false; trim.CanQuery=false
  trim.Size=Vector3.new(size.X,.25,size.Z); trim.Position=pos+Vector3.new(0,size.Y/2+.15,0)
  trim.Material=Enum.Material.Neon; trim.Color=Color3.fromRGB(121,137,221); trim.Parent=root
 end
 wall('NorthBarrier',Vector3.new(253,24,3),Vector3.new(0,11,-93))
 wall('SouthBarrier',Vector3.new(253,24,3),Vector3.new(0,11,93))
 wall('WestBarrier',Vector3.new(3,24,189),Vector3.new(-125,11,0))
 wall('EastBarrier',Vector3.new(3,24,189),Vector3.new(125,11,0))
 for _,z in ipairs({-93,93}) do for _,x in ipairs({-112,-56,0,56,112}) do
  local column=Instance.new('Part');column.Name='SolidArenaButtress';column.Size=Vector3.new(4,44,4);column.Position=Vector3.new(x,21,z)
  column.Anchored=true;column.CanCollide=true;column.CanTouch=false;column.CanQuery=true;column.Material=Enum.Material.Slate;column.Color=Color3.fromRGB(67,62,89);column.Parent=root
  local cap=Instance.new('Part');cap.Name='ButtressCrown';cap.Size=Vector3.new(5,2,5);cap.Position=Vector3.new(x,44,z)
  cap.Anchored=true;cap.CanCollide=true;cap.CanTouch=false;cap.CanQuery=true;cap.Material=Enum.Material.Metal;cap.Color=Color3.fromRGB(211,173,85);cap.Parent=root
 end end
 return root
end
return B
</ProtectedString>
						<string name="ScriptGuid">{9d375e79-0fb8-4b78-b58c-fcd01be780e7}</string>
						<BinaryString name="AttributesSerialize" />
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">312213925c58c9a30ae131cb00005f78</UniqueId>
						<string name="Name">ArenaBounds</string>
						<BinaryString name="SerializedOverrides" />
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">6d213ac4850387320ae147d100007fd7</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXecac422444334db9b8e973157921f33a">
					<Properties>
						<Content name="LinkedSource"><null /></Content>
						<ProtectedString name="Source">-- Original small procedural collectibles; no scripts inside art or external assets.
local M={}
local gold=Color3.fromRGB(232,182,64); local silver=Color3.fromRGB(178,194,211)
local dark=Color3.fromRGB(32,38,52); local teal=Color3.fromRGB(55,220,212)
local green=Color3.fromRGB(57,224,120); local purple=Color3.fromRGB(171,102,245)
local wood=Color3.fromRGB(113,67,38)
function M.build(d,m,F)
 local function p(n,x,y,z,sx,sy,sz,c,mat,rot)
  return F.part(m,n,Vector3.new(sx,sy,sz),CFrame.new(x,y,z)*(rot or CFrame.new()),c or silver,mat or Enum.Material.Metal)
 end
 local function ball(n,x,y,z,size,c,mat)
  local a=p(n,x,y,z,size,size,size,c,mat); a.Shape=Enum.PartType.Ball; return a
 end
 local function beam(n,a,b,w,c,mat)
  return F.part(m,n,Vector3.new(w,w,(b-a).Magnitude),CFrame.lookAt((a+b)/2,b),c,mat or Enum.Material.Metal)
 end
 local function ring(n,x,y,z,r,c,segments)
  for i=0,(segments or 20)-1 do
   local a=i*math.pi*2/(segments or 20); local b=(i+1)*math.pi*2/(segments or 20)
   beam(n,Vector3.new(x+math.cos(a)*r,y+math.sin(a)*r,z),Vector3.new(x+math.cos(b)*r,y+math.sin(b)*r,z),.09,c)
  end
 end
 local function wedge(n,size,cf,c)
  local a=Instance.new('WedgePart'); a.Name=n; a.Size=size; a.CFrame=cf
  a.Anchored=true; a.CanCollide=false; a.CanTouch=false; a.CanQuery=false
  a.Material=Enum.Material.Metal; a.Color=c; a.Parent=m; return a
 end
 local k=d.model
 if k=='ironArmor' then
  local red=Color3.fromRGB(163,38,44);local pale=Color3.fromRGB(160,235,255)
  p('ChestArmor',0,2.15,0,1.2,1.2,.65,red)
  p('ChestFacet',0,2.45,-.36,1.05,.3,.12,gold)
  ball('ReactorHousing',0,2.25,-.36,.4,silver)
  ball('ArcReactor',0,2.25,-.53,.24,pale,Enum.Material.Neon)
  p('CompleteHelmet',0,3.13,0,.82,.85,.7,red)
  p('GoldFaceplate',0,3.12,-.38,.65,.68,.12,gold)
  for _,side in ipairs({-1,1}) do
   p('HelmetEye',side*.17,3.22,-.46,.2,.06,.04,pale,Enum.Material.Neon)
   p('ShoulderArmor',side*.83,2.62,0,.55,.55,.7,red)
   p('UpperArm',side*.9,2.13,0,.38,.65,.42,gold)
   p('ForearmGauntlet',side*.96,1.58,0,.45,.6,.52,red)
   p('Hand',side*.96,1.2,-.02,.4,.3,.45,red)
   ball('PalmRepulsor',side*.96,1.25,-.27,.16,pale,Enum.Material.Neon)
   p('ThighArmor',side*.34,1.13,0,.48,.68,.52,gold)
   p('KneeArmor',side*.34,.73,-.1,.51,.28,.55,red)
   p('ShinArmor',side*.34,.35,0,.5,.65,.58,red)
   p('Boot',side*.34,-.02,-.15,.54,.25,.85,red)
  end
  p('WaistArmor',0,1.5,0,1,.3,.65,red)
 elseif k=='buster' then
  p('WrappedGrip',0,.2,0,.28,1,.32,dark)
  for i=0,5 do p('GripBand',0,-.2+i*.14,0,.3,.045,.34,wood) end
  p('Guard',0,.76,0,1.6,.18,.5,dark)
  p('BroadBladeSpine',-.15,2,0,1.05,2.3,.23,Color3.fromRGB(113,133,153))
  -- Real triangular wedges taper each blade face down to a narrow cutting ridge.
