end
function S:menuPlayers()
 local players={}
 for id,state in pairs(self.ctx.core.players) do
  local rt=self.ctx.runtime[id];local player=rt and rt.player
  if player and player.Parent then players[#players+1]={userId=id,name=player.Name or tostring(id),displayName=player.DisplayName or player.Name or tostring(id),level=state.progression or state.level or 0,cash=state.cash,capacity=state.capacity,carry=state.carry} end
 end
 table.sort(players,function(a,b)if a.name==b.name then return a.userId&lt;b.userId end;return a.name&lt;b.name end)
